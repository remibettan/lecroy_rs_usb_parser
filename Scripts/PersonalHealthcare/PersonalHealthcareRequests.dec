%include "CATCScriptAPI.inc"             #.inc files that are included
%include "UsbCommon.inc"


 #----  Input
 # in.Data       - Data_block to decode
 # in.DataLength - Length of Data_block

 #----  Output
 # out.Decoded   - amount of data has been decoded

#############################################################################
#                               View Settings                               #
#############################################################################
#
#    In this section user can set up which fields are to be shown and
#    which are to be hidden in expanded and collapsed states.
#    Zero-value everywhere means that fields will not be shown,
#    otherwise means opposite.
#
#
# ----------------------- All Field View Settings ---------------------------
#   These settings have priority above separate field View Settings in
#   expanded state ONLY.
#   In order separate field View Settings to work properly
#   BOTH All Field View Settings should be set to 0.
#
#   Due to the fact that ViewAll-setting and HideAll-setting are
#   exceptive propositions - ViewAll has been set a higher priority.
# ---------------------------------------------------------------------------

const PHDC_ViewAll = 0;
const PHDC_HideAll = 0;

# ---------------------------------------------------------------------------


# -----------------------  Separate Field View Settings ---------------------
# The FIRST value in list-variables defines if the field is to be shown or
# hidden in COLLAPSED state.
# 0 - means the field is to be shown.
# 1 - means the field is to be hidden.
#
# The SECOND value in list-variables defines if the field is to be shown or
# hidden in EXPANDED state.
# 0 - means the field is to be shown.
# 1 - means the field is to be hidden.
#
# i.e.  const RPD_Field = [0, 1]# - means that field 'Field' will be hidden
# in collapsed state and will be shown in expanded state.
#

#                                 [collapsed, expanded]
const PHDC_bmRequestType                = [1, 1];
const PHDC_wValue                       = [1, 1];
const PHDC_wIndex                       = [1, 1];
const PHDC_wLength                      = [1, 1];

#-----------------------------------------------------------------------------

set OutputType      = "Personal Healthcare Requests";
set UsbDecodeType   = "Request";
set UsbReqType      = "Class";
set UsbClassCode    = 0x0F;     # Class code for Personal Healthcare Devices
set UsbScriptDecodeType = 1;    # Combined decoding for Cells and Text decoding
set UsbProtocol     = 1;        # this is used for separation from possible different PHDC requests

set bReqType  = 0;              #Declaring global variables
set bRequest  = 0;
set wValue    = 0;
set wIndex    = 0;
set wLength   = 0;
set wData     = 0;

set AttributeString  = "";      #Holds Text Data

#Colors for Requests (Currently all same color, can be changed if desired)

set PHDC_GetStatusReqColor      = 0xB066BB;     #Request 0x00
set PHDC_ClearFeatureReqColor   = 0xB066BB;     #Request 0x01
set PHDC_SetFeatureReqColor     = 0xB066BB;     #Request 0x03
set PHDC_CaptionColor           = 0xFFAF11;     #Caption Cell (Expansion Indicator)

set FullyDecoded = 1;  # Variable that will determine if request has been fully decoded

set RestoreBitCurrentFieldOffset = 0;           #Temp Variables to store a restore value
set RestoreBitCurrentFieldLength = 0;

const Tabular_Def_Table = Map( 
[   
    #-----------------------------------------------------------------------------------------------------
    #       id            ,      colId                          , 		containerCellId
    #-----------------------------------------------------------------------------------------------------
    [ CELL_REQUEST        , TABULAR_SCRIPT_COLUMN_ID_SUBTYPE   , TABULAR_SCRIPT_CONTAINER_CELL_ID_NONE ],
    [ CELL_WVALUE         , TABULAR_SCRIPT_COLUMN_ID_NONE      , TABULAR_SCRIPT_CONTAINER_CELL_ID_MISC ],
    [ CELL_HBWVALUE       , TABULAR_SCRIPT_COLUMN_ID_NONE      , TABULAR_SCRIPT_CONTAINER_CELL_ID_MISC ],
    [ CELL_LBWVALUE       , TABULAR_SCRIPT_COLUMN_ID_NONE      , TABULAR_SCRIPT_CONTAINER_CELL_ID_MISC ]
] );


ProcessData()
{

    CommonDecoderInit();        # Initialization of SRP common global variables [found in CATCScriptAPI.inc]

    UnitDecoderInit("PHDC");    # This function must be called before starting unit decoding. [found in CATCScriptAPI.inc]
                                # It performs a necessary initialization routine for "unit" decoder.
                                # Unit has its own prefix, view settings and may have its own color.

    SetCellColor(PHDC_CaptionColor);
    AddCaptionCell("Personal Healthcare","Class","This data payload represents a Personal Healthcare Device Request.",_MONOCOLOR);  # Will allow for the expansion of certain fields
    RestoreCellColor();

    AddSeparator();

    FullyDecoded = 1;
    out.Decoded  = 0;           # Nothing has been decoded yet

    if ( in.DataLength < 8 )    # Checking for Illegal Payload
    {
        if( !AddSpecPLCellMonoNoDlg( "Error", "Illegal Payload", "Nothing is being decoded", __ERROR ) )
            AddErrorMonoCell( "Error", "Illegal Payload", "Nothing is being decoded" );    #[found in CATCScriptAPI.inc]

        return Complete();
    }

    GetNBits( in.Data, 0, 0 );      #Initialize pointer/counter for NextNBits_()

    bReqType = NextNBits_(8);       #0-7
    bRequest = NextNBits_(8);       #8-15
    wValue   = NextDataWord_();     #16-31
    wIndex   = NextDataWord_();     #32-47
    wLength  = NextDataWord_();     #48-63

    out.Decoded = 8;                # "Decoded" 8 bytes

    _row = Find( PHDCRequestTable, bRequest );  # will determine which request is being used

    AddShortDataHeader( _row[1] );

    if ( _row[0] == 0xFF )
    {
        AddSeparator();
        AddDecodedTextHeader();     # header for the text decoding
        SetFieldOffsetLen(8,8);
        FieldColor = bRequestColor;
        AddPayLoadCell( "bmRequestType", Format( "0x%02X",bReqType ), Format( "Bitmap with decimal value of %d", bReqType ) + "\n\nCharacteristics of Request:\n   D7      Data xfer direction\n\t   0 = Host to Device\n\t   1=Device to host\n\n   D6..5   Type\n\t   0 = Standard\n\t   1 = Class\n\t   2 = Vendor\n\t   3 = Reserved\n\n   D4..0   Recipient\n\t   0 = Device\n\t   1 = Interface\n\t   2 = Endpoint\n\t   3 = Other\n\t   4..31 = Reserved\n" );
        SetFieldOffsetLen(16,8);
        FieldColor = bRequestColor;
        AddPayLoadCell( "bRequest", _row[1], Format( "bRequest HexVal: 0x%04X", bRequest ), FieldColor, [_TABULARCELL, CELL_REQUEST]);
        SetFieldOffsetLen(32,16);
        FieldColor = wValueColor;
        AddPayLoadCell( "wValue", wValue, "" , FieldColor, [_TABULARCELL, CELL_WVALUE, "TEXT_CAPTION"]);
        SetFieldOffsetLen(48,16);
        FieldColor = wIndexColor;
        AddPayLoadCell( "wIndex", wIndex, "" );
        SetFieldOffsetLen(64,16);
        FieldColor = wLengthColor;
        AddPayLoadCell( "wLength", wLength, "" );

        if( ( in.DataLength - out.Decoded )!=0 )
          ShowDataBlockReOrder( in.DataLength-out.Decoded );
    }
    if ( _row[0] != 0xFF )
    {
        AttributeString = _row[1];

        AddSeparator();                       # Adding Separator between what will be decoded and what is already visible
        Call ( _row[1], [ in.DataLength ] );  # will call function for the specified request
        if( FullyDecoded == 1 )               # if the request is fully decoded
        {
            out.Decoded = in.DataLength;
        }
        else if(FullyDecoded == 0)
        {
            #Currently not doing anything, The last commented line for this statement was original, but
            #wasn't working, however, don't need it since out.Decoded is kept track of throughout this script.
            #The next commented line can be uncommented to show all undecoded data as a 'Data' block.
            #ShowDataBlock(in.DataLength-out.Decoded);
            # out.Decoded = BitCurrentFieldOffset/8;
            ShowDataBlockReOrder(in.DataLength-out.Decoded);
        }
    }

    AddSeparator();

    ############ for Debug purposes#########
    # GetNBits(in.Data, 0, 0);             #
    # ShowDataBlock(in.DataLength);        #
    ########################################

    return Complete();
}

# Add Request Decoding by Application [request table in Dialog View]
DecodeRequestToText()
{
    return DecodeRequestToTextCommon( PHDCRequestTable );
}

# Request List/Table for PHDC
set PHDCRequestTable =
[
  [ 0xFF, "UNDEFINED" ],
  [ 0x00, "GET_STATUS" ],
  [ 0x01, "CLEAR_FEATURE" ],
  [ 0x03, "SET_FEATURE" ]
];

SET_FEATURE()
{
    FieldColor = PHDC_SetFeatureReqColor;       #Set the Cell Color for Cells

    if( bReqType != 0x21 )                      # != 00100001B  ---- Verifying correct bmRequestType for Request and adding Cell
    {
        SetCellColor(WarningColor);
        SetFieldOffsetLen_PHDC( 8, 8 );
        AddPayLoadCell( "bmRequestType", Format( "0x%02X", bReqType ), FormatEx( "!!!WARNING!!!\nFor a SET_FEATURE Request, bmRequestType should only\nbe 0x21 (00100001B), but it is 0x%02X (%sB).", bReqType, ToBitString( bReqType, 8 ) ), _ERROR );
        RestoreFieldOffsetLen_PHDC();
        RestoreCellColor();
    }
    else
    {
        if( SimpleShowItem() )
            AddReqTypeCell_PHDC();
    }

    AddRequestCell_PHDC( AttributeString );     #Adding Request Cell

    hbwValue = (wValue>>8) & 0xFF;
    lbwValue = wValue & 0xFF;

    if( SimpleShowItem() || (hbwValue!=1) )     #Adding Value Cell
    {
        if( hbwValue != 1 )
        {
            SetCellColor( WarningColor );
            SetFieldOffsetLen_PHDC( 24, 8 );
            AddPayLoadCell("bQoSEncodingVersion", Format( "0x%02X", hbwValue ), FormatEx( "!!!WARNING!!! - bQoSEncodingVersion is NOT 01h.\nbQoSEncodingVersion (High Byte of wValue) = 0x%02X\twValue = 0x%04X", hbwValue, wValue ), _ERROR, FieldColor, [_TABULARCELL, CELL_HBWVALUE, "TEXT_CAPTION"] );
            RestoreFieldOffsetLen_PHDC();
            RestoreCellColor();
            SetCellColor( wValueColor );
        }
        else
        {
            SetCellColor( wValueColor );
            SetFieldOffsetLen_PHDC( 24, 8 );
            AddPayLoadCell("bQoSEncodingVersion", Format( "0x%02X", hbwValue ), FormatEx( "bQoSEncodingVersion (High Byte of wValue) = 0x%02X\twValue = 0x%04X", hbwValue, wValue ), FieldColor, [_TABULARCELL, CELL_HBWVALUE, "TEXT_CAPTION"] );
            RestoreFieldOffsetLen_PHDC();
        }

        SetFieldOffsetLen_PHDC( 32, 8 );
        AddPayLoadCell("FEATURE_PHDC_META_DATA", Format( "0x%02X", lbwValue ), FormatEx( "FEATURE_PHDC_META_DATA (Low Byte of wValue) = 0x%02X\twValue = 0x%04X", lbwValue, wValue ), FieldColor, [_TABULARCELL, CELL_LBWVALUE, "TEXT_CAPTION"] );
        RestoreFieldOffsetLen_PHDC();
        RestoreCellColor();
    }
    else
    {
        AddCell( "wValue", Format( "0x%04X", wValue ), FormatEx( "wValue = 0x%04X\n\tbQoSEncodingVersion ( High Byte of wValue ) = 0x%02X\n\tFEATURE_PHDC_META_DATA ( Low Byte of wValue ) = 0x%02X\t", wValue, hbwValue, lbwValue ), FieldColor, [_TABULARCELL, CELL_WVALUE, "TEXT_CAPTION"] );
    }

    AddWIndexCell_PHDC();                       #Adding Index Cell

    if(wLength != 0x0000)
    {
        SetCellColor(WarningColor);
        SetFieldOffsetLen_PHDC( 64, 16 );
        AddPayLoadCell("wLength*", Format( "%u", wLength ), "!!!WARNING!!!\nNO DATA EXPECTED. SET_FEATURE Requests should not\nhave any data. The Data is not being decoded.\nSee 'Data' for raw bytes.", _ERROR );
        RestoreFieldOffsetLen_PHDC();
        RestoreCellColor();
        FullyDecoded = 0;
    }
    else if( SimpleShowItem() )                 #If expanded, adding wLength Cell
        AddWLengthCell_PHDC( "Data Length" );

    out.Decoded = 8;

    datLength = in.DataLength - out.Decoded;    #This value should be the same as wLength (but in case wLength or rawdata is corrupted, we're using this value);

    if( datLength != wLength )
    {
        SetCellColor(RED);
        AddPayLoadCell( "WARNING", "Data Discrepancy", FormatEx( "Data discrepancy found between wLength (%d) and actual data length (%d).\nNOTE: No Data is Expected for the SET_FEATURE Request.", wLength, datLength ), _ERROR );
        AddShortDataHeader( FormatEx( "!!!WARNING!!! Data discrepancy found between wLength (%d) and actual data length (%d).\nNOTE: No Data is Expected for the SET_FEATURE Request.", wLength, datLength ) );
        RestoreCellColor();
        FullyDecoded = 0;
    }
}

CLEAR_FEATURE()
{
    FieldColor = PHDC_ClearFeatureReqColor;     #Set the Cell Color for Cells

    if( bReqType != 0x21 )                      # != 00100001B  ---- Verifying correct bmRequestType for Request and adding Cell
    {
        SetCellColor(WarningColor);
        SetFieldOffsetLen_PHDC( 8, 8 );
        AddPayLoadCell( "bmRequestType", Format( "0x%02X", bReqType ), FormatEx( "!!!WARNING!!!\nFor a CLEAR_FEATURE Request, bmRequestType should only\nbe 0x21 (00100001B), but it is 0x%02X (%sB).", bReqType, ToBitString( bReqType, 8 ) ), _ERROR );
        RestoreFieldOffsetLen_PHDC();
        RestoreCellColor();
    }
    else
    {
        if( SimpleShowItem() )
            AddReqTypeCell_PHDC();
    }

    AddRequestCell_PHDC( AttributeString );     #Adding Request Cell

    hbwValue = (wValue>>8) & 0xFF;
    lbwValue = wValue & 0xFF;

    if( SimpleShowItem() || (hbwValue!=0) )     #Adding Value Cell
    {
        if( hbwValue != 0 )
        {
            SetCellColor( WarningColor );
            SetFieldOffsetLen_PHDC( 24, 8 );
            AddPayLoadCell("RESERVED", Format( "0x%02X", hbwValue ), FormatEx( "!!!WARNING!!! - RESERVED, must be zero.\n(High Byte of wValue) = 0x%02X\twValue = 0x%04X", hbwValue, wValue ), _ERROR, FieldColor, [_TABULARCELL, CELL_HBWVALUE, "TEXT_CAPTION"] );
            RestoreFieldOffsetLen_PHDC();
            RestoreCellColor();
            SetCellColor( wValueColor );
        }
        else
        {
            SetCellColor( wValueColor );
            SetFieldOffsetLen_PHDC( 24, 8 );
            AddPayLoadCell("RESERVED", Format( "0x%02X", hbwValue ), FormatEx( "RESERVED (High Byte of wValue) = 0x%02X\twValue = 0x%04X", hbwValue, wValue ), FieldColor, [_TABULARCELL, CELL_HBWVALUE, "TEXT_CAPTION"] );
            RestoreFieldOffsetLen_PHDC();
        }

        SetFieldOffsetLen_PHDC( 32, 8 );
        AddPayLoadCell("FEATURE_PHDC_META_DATA", Format( "0x%02X", lbwValue ), FormatEx( "FEATURE_PHDC_META_DATA (Low Byte of wValue) = 0x%02X\twValue = 0x%04X", lbwValue, wValue ), FieldColor, [_TABULARCELL, CELL_LBWVALUE, "TEXT_CAPTION"] );
        RestoreFieldOffsetLen_PHDC();
        RestoreCellColor();
    }
    else
    {
        AddCell( "wValue", Format( "0x%04X", wValue ), FormatEx( "wValue = 0x%04X\n\tRESERVED ( High Byte of wValue ) = 0x%02X\n\tFEATURE_PHDC_META_DATA ( Low Byte of wValue ) = 0x%02X\t", wValue, hbwValue, lbwValue ), FieldColor, [_TABULARCELL, CELL_WVALUE, "TEXT_CAPTION"] );
    }

    AddWIndexCell_PHDC();                       #Adding Index Cell

    if( wLength != 0x0000 )
    {
        SetCellColor(WarningColor);
        SetFieldOffsetLen_PHDC( 64, 16 );
        AddPayLoadCell( "wLength*", Format( "%u", wLength ), "!!!WARNING!!!\nNO DATA EXPECTED. CLEAR_FEATURE Requests should not\nhave any data. The Data is not being decoded.\nSee 'Data' for raw bytes.", _ERROR );
        RestoreFieldOffsetLen_PHDC();
        RestoreCellColor();
        FullyDecoded = 0;
    }
    else
    {
        if( SimpleShowItem() )                  #If expanded, adding wLength Cell
            AddWLengthCell_PHDC( "Data Length" );
    }

    out.Decoded = 8;

    datLength = in.DataLength - out.Decoded;    #This value should be the same as wLength (but in case wLength or rawdata is corrupted, we're using this value);

    if( datLength != wLength )
    {
        SetCellColor(RED);
        AddPayLoadCell( "WARNING", "Data Discrepancy", FormatEx( "Data discrepancy found between wLength (%d) and actual data length (%d).\nNOTE: No Data is Expected for the CLEAR_FEATURE Request.", wLength, datLength ), _ERROR );
        AddShortDataHeader( FormatEx( "!!!WARNING!!! Data discrepancy found between wLength (%d) and actual data length (%d).\nNOTE: No Data is Expected for the CLEAR_FEATURE Request.", wLength, datLength ) );
        RestoreCellColor();
        FullyDecoded = 0;
    }
}

GET_STATUS()
{
    FieldColor = PHDC_ClearFeatureReqColor;     #Set the Cell Color for Cells

    if(bReqType != 0xA1)                        # != 10100001B  ---- Verifying correct bmRequestType for Request and adding Cell
    {
        SetCellColor(WarningColor);
        SetFieldOffsetLen_PHDC( 8, 8 );
        AddPayLoadCell("bmRequestType",Format( "0x%02X", bReqType ), FormatEx("!!!WARNING!!!\nFor a GET_STATUS Request, bmRequestType should only \nbe 0xA1 (10100001B), but it is 0x%02X (%sB).", bReqType, ToBitString( bReqType, 8 ) ), _ERROR );
        RestoreFieldOffsetLen_PHDC();
        RestoreCellColor();
    }
    else
    {
        if( SimpleShowItem() )
            AddReqTypeCell_PHDC();
    }

    AddRequestCell_PHDC( AttributeString );     #Adding Request Cell

    if( wValue != 0 )
    {
        SetCellColor( WarningColor );
        str_wValue = FormatEx( "!!!WARNING!!!\nwValue must be 0, but it is 0x%04X.", wValue );
        AddWValueCell_PHDC( "", str_wValue, 1 );  #Adding Value Cell
        RestoreCellColor();
    }
    else if( SimpleShowItem() )
    {
        AddWValueCell_PHDC();                   #Adding Value Cell
    }

    AddWIndexCell_PHDC();                       #Adding Index Cell

    GetStatusDataReady = 1;

    if( wLength != 0x0002 )
    {
        SetCellColor(WarningColor);
        SetFieldOffsetLen_PHDC( 64, 16 );

        if( wLength < 2 )
        {
            AddPayLoadCell( "wLength*", Format( "%u", wLength ), FormatEx( "!!!WARNING!!!\nA GET_STATUS Request is expected to have 2 bytes of data,\nwLength is only %d.", wLength ) , _ERROR );
            GetStatusDataReady = 0;
        }
        else
            AddPayLoadCell( "wLength*", Format( "%u", wLength ), FormatEx( "!!!WARNING!!!\nExpect only 2 bytes for a GET_STATUS Request.\nwLength is %d.", wLength ), _ERROR );

        RestoreFieldOffsetLen_PHDC();
        RestoreCellColor();
        out.Decoded = 8;
    }
    else if( SimpleShowItem() )                 #If expanded, adding wLength Cell
    {
        AddWLengthCell_PHDC( "Data Length" );
    }

    datLength = in.DataLength - out.Decoded;    #This value should be the same as wLength (but in case wLength or rawdata is corrupted, we're using this value);

    if(datLength != wLength)
    {
        SetCellColor(RED);
        AddPayLoadCell( "WARNING", "Data Discrepancy", FormatEx( "Data discrepancy found between wLength (%d) and actual data length (%d).\nNOTE: 2 bytes are expected for the GET_STATUS Request.", wLength, datLength ), _ERROR );
        AddShortDataHeader( FormatEx( "!!!WARNING!!! Data discrepancy found between wLength (%d) and actual data length (%d).\nNOTE: 2 bytes are expected for the GET_STATUS Request.", wLength, datLength ) );
        RestoreCellColor();
        FullyDecoded = 0;

        if( datLength > 1 )
            GetStatusDataReady = 1;
        else
            GetStatusDataReady = 0;
    }

    AddSeparator();

    if(!GetStatusDataReady)
    {
        AddCell( "Data Status", "NOT ENOUGH DATA", "***ERROR***\nThere is not enough data!", RED, 1 );
        FullyDecoded = 0;
    }
    else
    {
        wData  = NextDataWord_();               #64-79

        str_wData = Format( "0x%04X", wData );
        AddWDataCell_PHDC(str_wData, "");
        out.Decoded = 10;
    }
}

### These are general functions to decrease code length
### (copied from UsbCommon.inc and removed FieldColor setting plus minor tweaking where necessary/desired)

AddReqTypeCell_PHDC()
{
    SetFieldOffsetLen_PHDC( 8, 8 );
    AddPayLoadCell( "bmRequestType", Format( "0x%02X",bReqType ), Format( "Bitmap with decimal value of %d", bReqType ) + "\n\nCharacteristics of Request:\n   D7      Data xfer direction\n\t   0 = Host to Device\n\t   1=Device to host\n\n   D6..5   Type\n\t   0 = Standard\n\t   1 = Class\n\t   2 = Vendor\n\t   3 = Reserved\n\n   D4..0   Recipient\n\t   0 = Device\n\t   1 = Interface\n\t   2 = Endpoint\n\t   3 = Other\n\t   4..31 = Reserved\n" );
    RestoreFieldOffsetLen_PHDC();
}

AddRequestCell_PHDC( req_text )
{
    SetFieldOffsetLen_PHDC( 16, 8 );
    AddPayLoadCell( "bRequest", req_text, Format( "bRequest HexVal: 0x%04X", bRequest ), FieldColor, [_TABULARCELL, CELL_REQUEST]);
    RestoreFieldOffsetLen_PHDC();
}

AddWValueCell_PHDC( val_text, val_tooltip, error )
{
    SetFieldOffsetLen_PHDC( 32, 16 );

    if( val_text == null || val_text == "" )
        val_text = Format( "0x%04X", wValue );

    if( val_tooltip == null || val_tooltip == "" )
        val_tooltip = "wValue";

    if( error == null)
        AddPayLoadCell( "wValue", val_text, val_tooltip , FieldColor, [_TABULARCELL, CELL_WVALUE, "TEXT_CAPTION"]);
    else
        AddPayLoadCell( "wValue", val_text, val_tooltip, _ERROR , FieldColor, [_TABULARCELL, CELL_WVALUE, "TEXT_CAPTION"]);

    RestoreFieldOffsetLen_PHDC();
}

AddWIndexCell_PHDC( idx_text, idx_tooltip )
{
    SetCellColor( wIndexColor );
    SetFieldOffsetLen_PHDC( 48, 16 );

    if( idx_text == null || idx_text == "" )
        idx_text = Format( "%d", wIndex );

    if(idx_tooltip == null || idx_tooltip == "")
        idx_tooltip = FormatEx( "Target Interface (wIndex = 0x%04X)", wIndex );

    AddPayLoadCell("Interface", idx_text, idx_tooltip );
    RestoreFieldOffsetLen_PHDC();
    RestoreCellColor();
}

AddWLengthCell_PHDC( len_tooltip )
{
    SetFieldOffsetLen_PHDC( 64, 16 );
    AddPayLoadCell( "wLength", Format( "%u", wLength ), len_tooltip );
    RestoreFieldOffsetLen_PHDC();
}

AddWDataCell_PHDC( data_text, dat_tooltip )
{
    SetFieldOffsetLen_PHDC( 80, 16 );

    if(dat_tooltip == null || dat_tooltip == "")
    {
        dat_tooltip  = "Bit  0: Reserved, must be zero EP0 not tracked.\n";
        dat_tooltip += "Bit  1: 1 if endpoint 01h has data; 0 if not. \n";
        dat_tooltip += "Bit  2: 1 if endpoint 02h has data; 0 if not. \n";
        dat_tooltip += "Bit  3: 1 if endpoint 03h has data; 0 if not. \n";
        dat_tooltip += "Bit  4: 1 if endpoint 04h has data; 0 if not. \n";
        dat_tooltip += "Bit  5: 1 if endpoint 05h has data; 0 if not. \n";
        dat_tooltip += "Bit  6: 1 if endpoint 06h has data; 0 if not. \n";
        dat_tooltip += "Bit  7: 1 if endpoint 07h has data; 0 if not. \n";
        dat_tooltip += "Bit  8: 1 if endpoint 08h has data; 0 if not. \n";
        dat_tooltip += "Bit  9: 1 if endpoint 09h has data; 0 if not. \n";
        dat_tooltip += "Bit 10: 1 if endpoint 0Ah has data; 0 if not. \n";
        dat_tooltip += "Bit 11: 1 if endpoint 0Bh has data; 0 if not. \n";
        dat_tooltip += "Bit 12: 1 if endpoint 0Ch has data; 0 if not. \n";
        dat_tooltip += "Bit 13: 1 if endpoint 0Dh has data; 0 if not. \n";
        dat_tooltip += "Bit 14: 1 if endpoint 0Eh has data; 0 if not. \n";
        dat_tooltip += "Bit 15: 1 if endpoint 0Fh has data; 0 if not.";
    }

    AddPayLoadCell( "Data", data_text, dat_tooltip );
    RestoreFieldOffsetLen_PHDC();
}

SetFieldOffsetLen_PHDC( offset, len )
{
    RestoreBitCurrentFieldOffset = BitCurrentFieldOffset;
    RestoreBitCurrentFieldLength = BitCurrentFieldLength;
    BitCurrentFieldOffset = offset;
    BitCurrentFieldLength = len;
}

RestoreFieldOffsetLen_PHDC()
{
    BitCurrentFieldOffset = RestoreBitCurrentFieldOffset;
    BitCurrentFieldLength = RestoreBitCurrentFieldLength;
}


####################################################################################
#                       USBTracer specific caption cell                            #
####################################################################################

AddSpecCaptionCell(caption, text, tooltip, FieldColor, addparam, addparam1, addparam2 )
{
    AddCell(caption, text, tooltip, FieldColor, _USBBULK_HEADER, addparam, addparam1, addparam2 );
    return 1;
}