    [0x74,      "MDLM_SEMANTIC_MODEL_REQUEST"                     ],
    [0x75,      "MDLM_SEMANTIC_MODEL_REQUEST"                     ],
    [0x76,      "MDLM_SEMANTIC_MODEL_REQUEST"                     ],
