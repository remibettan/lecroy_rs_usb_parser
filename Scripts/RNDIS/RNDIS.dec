#-----------------------------------------------------------------------------
 

set OutputType      = "RNDIS Requests";      
set UsbDecodeType   = "Request";
set UsbReqType      = "Class";
set UsbClassCode    = 0xE0;    # Communication Interface Class code.
set UsbSubClass     = 0x01;    # Communication Interface Class SubClass code for Abstract Control Model.
set UsbProtocol     = 0x03;
set UsbScriptDecodeType = 1;   # Combined decoding for Cells and Text decoding
set UsbEndpId = 4;






