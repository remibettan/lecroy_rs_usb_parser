#*******************************************************************************
# MDLM_SEMANTIC_MODEL_REQUEST : This request is an MDLM request. MDLM is part of
#                 the CDC Wireless Mobile Communication Devices spec. Requests
#                 for MDLM are Semantic-Model specific, they are defined by the
#                 model being used by the Interface reported in wIndex.
#                 [Currently no explicit decoding tables available].
#
# bmRequestType : 0x??
# bRequest      : 0x60-0x7F
# wValue        : 0x????
# wIndex        : Interface (????)
# wLength       : 0x????
# Data          : ?
#*******************************************************************************
# start MDLM_SEMANTIC_MODEL_REQUEST
MDLM_SEMANTIC_MODEL_REQUEST()
{
    wValue = NextDataWord_();
    text = "Defined by semantic model of MDLM interface identified by wIndex";
    AddPayLoadCell("wValue", Format("0x%04X",wValue), Format("wValue = 0x%04X\n", wValue) + text, FieldColor, [_TABULARCELL, CELL_WVALUE, "TEXT_CAPTION"]);

    wIndex   = NextDataWord_();
    FieldColor = wIndexColor;
    AddPayLoadCell("wIndex", Format("Interface %d", wIndex), "MDLM Interface");

    wLength  = NextDataWord_();
    FieldColor = wLengthColor;
    if(wLength>0)
        text = "\nData for designated operation as defined\nby the semantic model of the MDLM \ninterface identified by wIndex";
    else
        text = "";

    if(wLength != in.DataLength - 8)
    {
        AddPayLoadCell("wLength", Format("%d", wLength), "!!! WARNING !!! \n" + FormatEx("Data Length discrepancy between wLength (%d)\n and actual data in PayLoad (%d)...\n\n",wLength,in.DataLength - 8) + "Length of the data." + text,_ERROR);
    }
    else
        AddPayLoadCell("wLength", Format("%d", wLength), "Length of the data." + text);

      out.Decoded = 8;
}
# end MDLM_SEMANTIC_MODEL_REQUEST
#*******************************************************************************
# GET_NTB_PARAMETERS :
#                 This request retrieves the parameters that describe NTBs for each direction.
#                 In response to this request, the function shall return these elements
#
# bmRequestType :
# bmRequestType : 0xA1
# bRequest      : 0x80
# wValue        : 0x0000
# wIndex        : Interface
# wLength       : Amount of data in bytes associated with this recipient
# Data          : NTB Parameter Structure
#*******************************************************************************
# start GET_NTB_PARAMETERS
GET_NTB_PARAMETERS()
{
    if (bRequest == 0x80)
    {
        wValue   = GetDataWord(2); # Now that Endian is set...
        wIndex   = GetDataWord(4);
        wLength  = GetDataWord(6);

        val_text =  Format("0x%04X", wValue);
        val_text_Tooltip =  Format("wValue HexVal: 0x%04X", wValue);
        AddWValueCell (val_text, val_text_Tooltip);

        wIndex_text =  Format("0x%04X", wIndex);
        wIndex_text_Tooltip =  Format("wIndex HexVal: 0x%04X", wIndex);
        AddWIndexCell (wIndex_text, wIndex_text_Tooltip);

        wLength_text =  Format("wLength HexVal: 0x%04X", wLength);
        wLength_text_Tooltip =  Format("wLength HexVal: 0x%04X", wLength);
        AddWLengthCell(wLength_text, wLength_text_Tooltip);

        GetNBits( in.Data, 0, 0 );

        NTB_Parameter_Structure_ToolTip = NTB_Parameter_Structure();
        AddPayLoadCell("NTB_Parameter",   "Parameters",
                        NTB_Parameter_Structure_ToolTip, FieldColor);

        out.Decoded = in.DataLength;
    }
}
# end GET_NTB_PARAMETERS
#*******************************************************************************
# GET_NET_ADDRESS :
#                 This request returns the function’s current EUI-48 station address.
#
# bmRequestType : 0xA1
# bRequest      : 0x81
# wValue        : 0x0000
# wIndex        : Interface
# wLength       : Amount of data in bytes associated with this recipient
# Data          : The EUI-48 current address, in net-work byte order
#*******************************************************************************
# start GET_NET_ADDRESS
GET_NET_ADDRESS()
{
    if (bRequest == 0x81)
    {
        wValue   = GetDataWord(2); # Now that Endian is set...
        wIndex   = GetDataWord(4);
        wLength  = GetDataWord(6);

        val_text =  Format("0x%04X", wValue);
        val_text_Tooltip =  Format("wValue HexVal: 0x%04X", wValue);
        AddWValueCell (val_text, val_text_Tooltip);

        wIndex_text =  Format("0x%04X", wIndex);
        wIndex_text_Tooltip =  Format("wIndex HexVal: 0x%04X", wIndex);
        AddWIndexCell (wIndex_text, wIndex_text_Tooltip);

        wLength_text =  Format("wLength HexVal: 0x%04X", wLength);
        wLength_text_Tooltip =  Format("wLength HexVal: 0x%04X", wLength);
        AddWLengthCell(wLength_text, wLength_text_Tooltip);

        GetNBits( in.Data, 0, 0 );
        dummy = NextNBits(6*8);
        Len = NextNBits(8);
        dummy = NextNBits(8);
        i = 0;
        st = "";
        while (i < Len)
        {
            F1 = NextNBits(8);
            st += FormatEx("%02X", F1);
            st += " ";
            i += 1;
        }

        Current_Address_ToolTip = st;

        AddPayLoadCell("Current_Address",  st,
            Format ("Current Net Address is = %s", Current_Address_ToolTip), FieldColor);
        out.Decoded = in.DataLength;
    }
}
# end GET_NET_ADDRESS

#*******************************************************************************
# SET_NET_ADDRESS :
#                 This request sets the function’s current EUI-48 station address.
#
# bmRequestType : 0x21
# bRequest      : 0x82
# wValue        : 0x0000
# wIndex        : Interface
# wLength       : Amount of data in bytes associated with this recipient
# Data          : The EUI-48 address, in network byte order
#*******************************************************************************
# start SET_NET_ADDRESS
SET_NET_ADDRESS()
{
    if (bRequest == 0x82)
    {
        wValue   = GetDataWord(2); # Now that Endian is set...
        wIndex   = GetDataWord(4);
        wLength  = GetDataWord(6);

        val_text =  Format("0x%04X", wValue);
        val_text_Tooltip =  Format("wValue HexVal: 0x%04X", wValue);
        AddWValueCell (val_text, val_text_Tooltip);

        wIndex_text =  Format("0x%04X", wIndex);
        wIndex_text_Tooltip =  Format("wIndex HexVal: 0x%04X", wIndex);
        AddWIndexCell (wIndex_text, wIndex_text_Tooltip);

        wLength_text =  Format("wLength HexVal: 0x%04X", wLength);
        wLength_text_Tooltip =  Format("wLength HexVal: 0x%04X", wLength);
        AddWLengthCell(wLength_text, wLength_text_Tooltip);

        GetNBits( in.Data, 0, 0 );
        dummy = NextNBits(6*8);
        Len = NextNBits(8);
        dummy = NextNBits(8);
        i = 0;
        st = "";
        while (i < Len)
        {
            F1 = NextNBits(8);
            st += FormatEx("%02X", F1);
            st += " ";
            i += 1;
        }

        Net_Address = st;

        AddPayLoadCell("Net_Address",  st,
            Format ("Set Net Address to = %s", Net_Address), FieldColor);

        out.Decoded = in.DataLength;
    }
}
# end SET_NET_ADDRESS

#*******************************************************************************
# GET_NTB_FORMAT :
#                 This request returns the NTB data format currently being used by the function.
#
# bmRequestType : 0xA1
# bRequest      : 0x83
# wValue        : 0x0000
# wIndex        : Interface
# wLength       : Amount of data in bytes associated with this recipient
# Data          : The NTB format code (2 bytes, little-endian), as defined under wValue in SetNtbFormat
#*******************************************************************************
# start GET_NTB_FORMAT
GET_NTB_FORMAT()
{
    if (bRequest == 0x83)
    {
        wValue   = GetDataWord(2); # Now that Endian is set...
        wIndex   = GetDataWord(4);
        wLength  = GetDataWord(6);

        val_text =  Format("0x%04X", wValue);
        val_text_Tooltip =  Format("wValue HexVal: 0x%04X", wValue);
        AddWValueCell (val_text, val_text_Tooltip);

        wIndex_text =  Format("0x%04X", wIndex);
        wIndex_text_Tooltip =  Format("wIndex HexVal: 0x%04X", wIndex);
        AddWIndexCell (wIndex_text, wIndex_text_Tooltip);

        wLength_text =  Format("wLength HexVal: 0x%04X", wLength);
        wLength_text_Tooltip =  Format("wLength HexVal: 0x%04X", wLength);
        AddWLengthCell(wLength_text, wLength_text_Tooltip);

        GetNBits( in.Data, 0, 0 );
        dummy = NextNBits(6*8);
        Len = NextNBits(8);
        dummy = NextNBits(8);

        NTB_Format_Code = NextNBits(Len*8);

        AddPayLoadCell("NTB_Format_Code",   Format("0x%X", NTB_Format_Code),
            Format ("NTB Format Code is = 0x%X", NTB_Format_Code), FieldColor);
        out.Decoded = in.DataLength;
    }
}
# end GET_NTB_FORMAT

