    [ 0xFF,  "UNKNOWN",   _ERROR    ],
    [ 0x00,  "ON_HOOK",   null      ],
    [ 0x1,   "OFF_HOOK",  null      ],
    [ 0x2,   "SNOOPING",  null      ]
];

