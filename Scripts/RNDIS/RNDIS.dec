const CCT_Ringer              = [1, 1];
const CCT_Ringer_Volume       = [1, 1];
const CCT_Ringer_Pattern      = [1, 1];
const CCT_Operation_Mode      = [1, 1];
const CCT_Length              = [1, 1];
const CCT_Active_Flag         = [1, 1];
const CCT_Index               = [1, 1];
const CCT_Change_Value        = [1, 1];
const CCT_Ringback_Type       = [1, 1];
const CCT_Connection_Type     = [1, 1];
const CCT_Ringing_Type        = [1, 1];
const CCT_Time_Str_size       = [1, 1];
const CCT_Time_Str            = [1, 1];
const CCT_PN_Str_size         = [1, 1];
const CCT_PN_Str              = [1, 1];
const CCT_Name_Str_size       = [1, 1];
const CCT_Name_Str            = [1, 1];
