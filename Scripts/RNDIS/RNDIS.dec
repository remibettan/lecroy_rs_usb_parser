#
# Parsing entry point
#

set bmRequestType   = 0;  
set bRequest        = 0;
set wValue          = 0;
set wIndex          = 0;
set wLength         = 0;

ProcessData()
{    
    bmRequestType   = 0;  
    bRequest        = 0;
    wValue          = 0;
    wIndex          = 0;
    wLength         = 0;
    
    CommonDecoderInit();
    UnitDecoderInit("CCT");
    FieldColor = 0x5499AC;
    
    FullyDecoded = 1;
  
    out.Decoded = 0;    

    if (in.DataLength < 8)
    {
        #SetCellColor(0x5499AC);
        AddCaptionCell("RNDIS","CDC","This data payload represents an RNDIS Comm Class Request.",_MONOCOLOR);  # Will allow for the expansion of certain fields
        #RestoreCellColor();
        AddSeparator();      
        AddPLCellMonoNoDlg("Error", "Illegal Payload", "Nothing is being decoded", _ERROR);
        return Complete();
    }
    
    bmRequestType = NextNBits_(8);
    
    bRequest = NextNBits_(8);

    _row = Find(RequestTypeTable, bRequest);  # will determine which request is being used  
    
    if((bRequest == 0x00)||(bRequest == 0x01)||(_row[1]=="RESERVED"))
    {
        #SetCellColor(0x5499AC);
        AddCaptionCell("RNDIS","CDC","This data payload represents an RNDIS Comm Class Request.",_MONOCOLOR);  # Will allow for the expansion of certain fields
        #RestoreCellColor();
        AddSeparator();
    }
    else
    {
        SetCellColor(0x349933);
        AddCaptionCell("Comm","Class","This data payload represents a Comm Class Request.",_MONOCOLOR);  # Will allow for the expansion of certain fields
        RestoreCellColor();
        AddSeparator();
    }
    
    AddShortDataHeader(_row[1]);
    SetFieldOffsetLen(8,8);
    
    if(SimpleShowItem())
    {
        SetCellColor(bRequestColor);
        AddPayLoadCell("bmRequestType", Format("0x%02X", bmRequestType), "Request Type bitmap");
        RestoreCellColor();
    }
    
    SetFieldOffsetLen(16,8);
    SetCellColor(FieldColor);   #Backing up FieldColor because AddRequestCell changes it.
    AddRequestCell (_row[1]);
    RestoreCellColor();
    
    Call( _row[1] );
    
    return Complete();
}

DecodeRequestToText()
{
    return DecodeRequestToTextCommon( RequestTypeTable );    
}
#*******************************************************************************
# RESERVED : 
#                 This request is used for all unknown requests
# bmRequestType : Ignored
# bRequest      : Out of Range
# wValue        : Ignored
# wIndex        : Ignored
# wLength       : Ignored
# Data          : Ignored
#*******************************************************************************
RESERVED()
{
    out.Decoded = 2;
}

#*******************************************************************************
# SEND_ENCAPSULATED_COMMAND : 
#                 This request is used to issue a command in the form of the 
#                 supported control protocol of the communication class interface
# bmRequestType : 0x21/0x22
# bRequest      : 0x00
# wValue        : 0x0000
# wIndex        : Interface / Endpoint
# wLength       : Amount of data in bytes associated with this recipient
# Data          : Control Protocol-based Command
#*******************************************************************************
# start SEND_ENCAPSULATED_COMMAND
SEND_ENCAPSULATED_COMMAND()
{
    PLReservedCheck(16); # wValue reserved to be zero
    wIndex   = NextDataWord_();
    if (bmRequestType == 0x21 )
    {
        AddPayLoadCell("wIndex", Format("Interface %d", wIndex), "Interface ID");
    }
    else if (bmRequestType == 0x22)
    {
        AddPayLoadCell("wIndex", Format("Endpoint %d", wIndex), "Endpoint ID");
    }
    else
    {
        err_tooltip = Format("Unknown bmRequestType (0x%02X)! ", bmRequestType);
        AddPayLoadCell("wIndex", Format("0x%04X", wIndex), AddErrorTooltip(), _ERROR);        
    }
    wLength  = NextDataWord_();
    if (wLength >= 0)
    {
        if(wLength != in.DataLength - 8)
        {
            SetCellColor(RED);
            AddPayLoadCell("wLength", Format("%u", wLength), "!!! WARNING !!!\n\nwLength value mismatched with actual data\nlength in Payload!",_ERROR);
            AddCell("WARNING","Data Discrepancy",FormatEx("Data Length discrepancy between wLength (%d)\n and actual data in PayLoad (%d)...",wLength,in.DataLength - 8),WarningColor,_ERROR);            
            RestoreCellColor();
        }      
        else
            AddPayLoadCell("wLength", Format("%d", wLength), "Length of the data");
        AddSeparator();
        DecodeNDIS();
        rmLen=in.DataLength - out.Decoded - 8;
        if (rmLen > 0) {
            ShowDataBlockReOrder(rmLen);
        }
        out.Decoded = in.DataLength;
    }
    else
    {
        err_tooltip = "Illegal wLength Value" ;
        AddPayLoadCell("wLength", Format("%d", wLength), AddErrorTooltip(), _ERROR);             
        out.Decoded = 8;
    }
}

# end SEND_ENCAPSULATED_COMMAND

#*******************************************************************************
# GET_ENCAPSULATED_RESPONSE : 
#                 This request is used to request a response in the form of the 
#                 supported control protocol of the communication class interface
# bmRequestType : 0xA1/0xA2
# bRequest      : 0x00
# wValue        : 0x0000
# wIndex        : Interface / Endpoint
# wLength       : Amount of data in bytes associated with this recipient
# Data          : Protocol Dependent Data
#*******************************************************************************
# start GET_ENCAPSULATED_RESPONSE
GET_ENCAPSULATED_RESPONSE()
{
    wValue   = NextDataWord_();
    if (wValue == 0)
    {
        if(SimpleShowItem())
            AddPayLoadCell("wValue", Format("0x%04X", wValue), "wValue is zero");
    }
    else
    {
        err_tooltip = "Illegal wValue value, should set to zero!";
        SetCellColor(WarningColor);
        AddPayLoadCell("wValue", Format("0x%04X", wValue), AddErrorTooltip(), _ERROR);
        RestoreCellColor();
    }
    
    wIndex   = NextDataWord_();
    if (bmRequestType == 0xA1 )
    {
        AddPayLoadCell("wIndex", Format("Interface %d", wIndex), "Interface ID");
    }
    else if (bmRequestType == 0xA2)
    {
        AddPayLoadCell("wIndex", Format("Endpoint %d", wIndex), "Endpoint ID");
    }
    else
    {
        err_tooltip = Format("Unknown bmRequestType (0x%02X)! ", bmRequestType);
        SetCellColor(WarningColor);
        AddPayLoadCell("wIndex", Format("0x%04X", wIndex), AddErrorTooltip(), _ERROR);        
        RestoreCellColor();
    }
    
    wLength  = NextDataWord_();
    
    if (wLength >= 0)
    {
    /*  if(wLength != in.DataLength - 8)
        {
            SetCellColor(RED);
            AddPayLoadCell("wLength", Format("%u", wLength), "!!! WARNING !!!\n\nwLength value mismatched with actual data\nlength in Payload!",_ERROR);
            AddCell("WARNING","Data Discrepancy",FormatEx("Data Length discrepancy between wLength (%d)\n and actual data in PayLoad (%d)...",wLength,in.DataLength - 8),WarningColor,_ERROR);            
            RestoreCellColor();
        }
        else if(SimpleShowItem())
    */
            AddPayLoadCell("wLength", Format("%u", wLength), "Maximum Incoming Buffer Size\n Not necessarily the length\n of the data.");
        AddSeparator();
        DecodeNDIS();
        rmLen=in.DataLength - out.Decoded - 8;        
        if (rmLen > 0) {
            ShowDataBlockReOrder(rmLen);
        }
        
        out.Decoded = in.DataLength;
    }
    else
    {
        err_tooltip = "Illegal wLength Value" ;
        AddPayLoadCell("wLength", Format("%d", wLength), AddErrorTooltip(), _ERROR);             
        out.Decoded = 8;
    }
}

# end GET_ENCAPSULATED_RESPONSE

#*******************************************************************************
# SET_COMM_FEATURE : This request controls the settings for a particular 
#                 communication feature of a particular target
# bmRequestType : 0x21/0x22
# bRequest      : 0x02
# wValue        : Feature Selector
# wIndex        : Interface / Endpoint
# wLength       : Length of State Data
# Data          : State
#*******************************************************************************
set CommFeatureSelectorTable = 
[
    #------------------------------------------------------------------------------------------
    # type, Feature name,   wLength, Error cell                                               |
    #------------------------------------------------------------------------------------------
    [ 0xF,  "UNKNOWN",        0,      _ERROR],
    [ 0x0,  "Reserved",       0,      null],
    [ 0x1,  "ABSTRACT_STATE", 2,      null],
    [ 0x2,  "COUNTRY_SETTING",2,      null]
];

# start SET_COMM_FEATURE & GET_COMM_FEATURE
SET_COMM_FEATURE()
{
    wValue   = NextDataWord_();
    _row = Find(CommFeatureSelectorTable, wValue);
    AddPayLoadCell("wValue", _row[1], Format("wValue = 0x%04X", wValue), _row[3]);
    wIndex   = NextDataWord_();
    if (bmRequestType == 0x21 )
    {
        AddPayLoadCell("wIndex", Format("Interface %d", wIndex), "Interface ID");
    }
    else if (bmRequestType == 0x22)
    {
        AddPayLoadCell("wIndex", Format("Endpoint %d", wIndex), "Endpoint ID");
    }
    else
    {
        err_tooltip = Format("Unknown bmRequestType (0x%02X)! ", bmRequestType);
        AddPayLoadCell("wIndex", Format("0x%04X", wIndex), AddErrorTooltip(), _ERROR);        
    }
    wLength  = NextDataWord_();
    if (wLength == _row[2])
    {
        AddPayLoadCell("wLength", Format("%d", wLength), "Length of the status data");
        if (wValue == 0x1 ) # ABSTRACT_STATE
        {
            PLReservedCheck (15);
            multiState = NextNBits_(1);
            if ( multiState)
                text = "Enabled";
            else
                text = "Disabled";
            AddPayLoadCell("DMS", text, "Data Multiplexed State" + text + Format(" - 0x%X", multiState));
        }
        else if (wValue == 0x2)
        {
            code = NextDataWord_();
            AddPayLoadCell("Country Code", Format("0x%04X", code), "Country code specified in ISO 3166");
        }
            
        
        out.Decoded = 8 + wLength;
    }
    else
    {
        err_tooltip = Format("Illegal wLength Value! The length for should be %d", _row[2]);
        AddPayLoadCell("wLength", Format("%d", wLength), AddErrorTooltip(), _ERROR);
        /*
        if (wLength > 0)
        {
            AddExtraBytesPayloadCell(wLength);
            out.Decoded = 8 + wLength;
        }
        else
        */
            out.Decoded = 8;
    }
}

GET_COMM_FEATURE()
{
    wValue   = NextDataWord_();
    _row = Find(CommFeatureSelectorTable, wValue);
    AddPayLoadCell("wValue", _row[1], Format("wValue = 0x%04X", wValue), _row[3]);
    wIndex   = NextDataWord_();
    if (bmRequestType == 0xA1 )
    {
        AddPayLoadCell("wIndex", Format("Interface %d", wIndex), "Interface ID");
    }
    else if (bmRequestType == 0xA2)
    {
        AddPayLoadCell("wIndex", Format("Endpoint %d", wIndex), "Endpoint ID");
    }
    else
    {
        err_tooltip = Format("Unknown bmRequestType (0x%02X)! ", bmRequestType);
        AddPayLoadCell("wIndex", Format("0x%04X", wIndex), AddErrorTooltip(), _ERROR);        
    }
    wLength  = NextDataWord_();
    if (wLength == _row[2])
    {
        AddPayLoadCell("wLength", Format("%d", wLength), "Length of the status data");
        if (wValue == 0x1 ) # ABSTRACT_STATE
        {
            PLReservedCheck (15);
            multiState = NextNBits_(1);
            if ( multiState)
                text = "Enabled";
            else
                text = "Disabled";
            AddPayLoadCell("DMS", text, "Data Multiplexed State" + text + Format(" - 0x%X", multiState));
        }
        else if (wValue == 0x2)
        {
            code = NextDataWord_();
            AddPayLoadCell("Country Code", Format("0x%04X", code), "Country code specified in ISO 3166");
        }
            
        
        out.Decoded = 8 + wLength;
    }
    else
    {
        err_tooltip = Format("Illegal wLength Value! The length for should be %d", _row[2]);
        AddPayLoadCell("wLength", Format("%d", wLength), AddErrorTooltip(), _ERROR);
        /*
        if (wLength > 0)
        {
            AddExtraBytesPayloadCell(wLength);
            out.Decoded = 8 + wLength;
        }
        else
        */
            out.Decoded = 8;
    }
}


# end SET_COMM_FEATURE & GET_COMM_FEATURE


#*******************************************************************************
# CLEAR_COMM_FEATURE : This request controls the settings for a particular 
#                 communication feature of a particular target, setting the selected
#                 feature to its default state
# bmRequestType : 0x21/0x22
# bRequest      : 0x04
# wValue        : Feature Selector
# wIndex        : Interface / Endpoint
# wLength       : 0x0000
# Data          : None
#*******************************************************************************
# start CLEAR_COMM_FEATURE
CLEAR_COMM_FEATURE()
{
    wValue   = NextDataWord_();
    _row = Find(CommFeatureSelectorTable, wValue);
    AddPayLoadCell("wValue", _row[1], Format("wValue = 0x%04X", wValue));
    wIndex   = NextDataWord_();
    if (bmRequestType == 0x21 )
    {
        AddPayLoadCell("wIndex", Format("Interface %d", wIndex), "Interface ID");
    }
    else if (bmRequestType == 0x22)
    {
        AddPayLoadCell("wIndex", Format("Endpoint %d", wIndex), "Endpoint ID");
    }
    else
    {
        err_tooltip = Format("Unknown bmRequestType (0x%02X)! ", bmRequestType);
        AddPayLoadCell("wIndex", Format("0x%04X", wIndex), AddErrorTooltip(), _ERROR);        
    }
    wLength  = NextDataWord_();
    if (wLength == 0)
    {
        isError = null;
    }
    else
    {
        isError = _ERROR;
    }
    AddPayLoadCell("wLength", Format("%d", wLength), "Length of the data", isError);
    out.Decoded = 8;
/*
    if (wLength == 0)
    {
        AddPayLoadCell("wLength", Format("%d", wLength), "Length of the data");
        out.Decoded = 8;
    }
    else
    {
        err_tooltip = "Illegal wLength Value" ;
        AddPayLoadCell("wLength", Format("%d", wLength), AddErrorTooltip(), _ERROR);

        if (wLength > 0)
        {
            AddExtraBytesPayloadCell(wLength);
            out.Decoded = 8 + wLength;
        }
        else

            out.Decoded = 8;
    }
*/
}

# end CLEAR_COMM_FEATURE

#*******************************************************************************
# SET_AUX_LINE_STATE : This request is used to connect or disconnect a secondary 
#                    jack to PORTS circuit or CODEC, depending on hook state
# bmRequestType : 0x21/0x22
# bRequest      : 0x10
# wValue        : Disconnect/Connect
# wIndex        : Interface / Endpoint
# wLength       : 0x0000
# Data          : None
#*******************************************************************************
# start SET_AUX_LINE_STATE
SET_AUX_LINE_STATE()
{
    wValue   = NextDataWord_();
    if (wValue == 0)
        text = "Disconnect";
    else if (wValue == 1)
        text = "Connect";
    else
        text = "UNKNOWN";
    if (wValue == 0 || wValue == 1)
        AddPayLoadCell("wValue", text, Format("wValue = 0x%04X", wValue));
    else
    {
        err_tooltip = Format("Unknown wValue (0x%04X)! ", wValue);
        AddPayLoadCell("wIndex", Format("0x%04X", wIndex), AddErrorTooltip(), _ERROR);        
    }
    wIndex   = NextDataWord_();
    if (bmRequestType == 0x21 )
    {
        AddPayLoadCell("wIndex", Format("Interface %d", wIndex), "Interface ID");
    }
    else if (bmRequestType == 0x22)
    {
        AddPayLoadCell("wIndex", Format("Endpoint %d", wIndex), "Endpoint ID");
    }
    else
    {
        err_tooltip = Format("Unknown bmRequestType (0x%02X)! ", bmRequestType);
        AddPayLoadCell("wIndex", Format("0x%04X", wIndex), AddErrorTooltip(), _ERROR);        
    }
    wLength  = NextDataWord_();
    if (wLength == 0)
    {
        isError = null;
    }
    else
    {
        isError = _ERROR;
    }
    AddPayLoadCell("wLength", Format("%d", wLength), "Length of the data", isError);
    out.Decoded = 8;
/*
    if (wLength == 0)
    {
        AddPayLoadCell("wLength", Format("%d", wLength), "Length of the data");
        out.Decoded = 8;
    }
    else
    {
        err_tooltip = "Illegal wLength Value" ;
        AddPayLoadCell("wLength", Format("%d", wLength), AddErrorTooltip(), _ERROR);
        if (wLength > 0)
        {
            AddExtraBytesPayloadCell(wLength);
            out.Decoded = 8 + wLength;
        }
        else
            out.Decoded = 8;
    }
*/
}

# end SET_AUX_LINE_STATE

#*******************************************************************************
