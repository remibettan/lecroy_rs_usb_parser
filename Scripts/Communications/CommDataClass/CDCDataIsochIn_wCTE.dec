%include "CATCScriptAPI.inc"
%include "UsbCommon.inc"

#----  Input
# in.Data       - Data_block to decode
# in.DataLength - Length of Data_block
#
#----  Output
# out.Decoded   - amount of data has been decoded
#

set OutputType      = "CDC Data Isoch In w/ Cmd Wrapper";
set UsbDecodeType   = "Endpoint";
set UsbEndpId       = 31;           # Just a unique value for each endpoint of the same Class/Vendor/Product
                                    # to distinguish them.
set UsbClassCode    = 0x0A;         # Data Interface Class (CDC Data)
set UsbEndpType     = "Isochronous";
set UsbEndpDir      = "In";
set UsbScriptDecodeType = 2;        # Combined decoding for Cells and Text decoding.
set UsbMaxXferSize    = 0x7FFFFFFF; # Trying largest possible positive value.
set UsbMaxPktSize     = 512;        # Will automatically be reduced to 64 if branch is Full Speed.
set UsbMaxXferDecodeSize = 0xFF;    # Max bytes that we will be decoding. User can up this if desired.


# Necessary Variables to Include and Run CDCData.inc

set ProtocolWrapper_FLAG    = 0;
set CommandTypeEncode_FLAG  = 1;
set msg_type                = "Isochronous IN";

%include "CDCData.inc"