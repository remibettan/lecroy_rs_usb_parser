#*******************************************************************************
# Specify the name for this set of requests as GroupName. This name is listed
# under Decode Vendor/Class Request menu depending on the GroupType specified
# and the Type field of the request you are trying to decode.
#*******************************************************************************


%include "CATCScriptAPI.inc"             #.inc files that are included
%include "UsbCommon.inc"
%include "CDCRequests.inc" 




#----  Input
# in.Data       - Data_block to decode
# in.DataLength - Length of Data_block
#
#----  Output
# out.Decoded   - amount of data has been decoded
#

const Tabular_Def_Table = Map(
[
    #-----------------------------------------------------------------------------------------------------
    #       id            ,      colId                          , 		containerCellId
    #-----------------------------------------------------------------------------------------------------
    [ CELL_REQUEST        , TABULAR_SCRIPT_COLUMN_ID_SUBTYPE   , TABULAR_SCRIPT_CONTAINER_CELL_ID_NONE ],
    [ CELL_WVALUE         , TABULAR_SCRIPT_COLUMN_ID_NONE      , TABULAR_SCRIPT_CONTAINER_CELL_ID_MISC ]

] );

#############################################################################
#                               View Settings                               #
#############################################################################
#
#    In this section user can set up which fields are to be shown and
#    which are to be hidden in expanded and collapsed states.
#    Zero-value everywhere means that fields will not be shown,
#    otherwise means opposite.
#


# ----------------------- All Field View Settings ---------------------------
#   These settings have priority above separate field View Settings in
#   expanded state ONLY.
#   In order separate field View Settings to work properly
#   BOTH All Field View Settings should be set to 0.
#
#   Due to the fact that ViewAll-setting and HideAll-setting are
#   exceptive propositions - ViewAll has been set a higher priority.
# ---------------------------------------------------------------------------

const CCT_ViewAll              = 0;
const CCT_HideAll              = 0;
# ---------------------------------------------------------------------------


# -----------------------  Separate Field View Settings ---------------------
# The FIRST value in list-variables defines if the field is to be shown or
# hidden in COLLAPSED state.
# 0 - means the field is to be shown.
# 1 - means the field is to be hidden.
#
# The SECOND value in list-variables defines if the field is to be shown or
# hidden in EXPANDED state.
# 0 - means the field is to be shown.
# 1 - means the field is to be hidden.
#
# i.e.  const RPD_Field = [0, 1]# - means that field 'Field' will be hidden
# in collapsed state and will be shown in expanded state.
#

#                       [collapsed, expanded]
const CCT_bmRequestType       = [1, 1];
const CCT_wIndex              = [1, 1];
const CCT_wValue              = [1, 1];
const CCT_wLength             = [1, 1];
const CCT_DMS                 = [1, 1];
const CCT_Country_Code        = [1, 1];
const CCT_dwDTERate           = [1, 1];
const CCT_Stop_Bits           = [1, 1];
const CCT_Parity              = [1, 1];
const CCT_Data_Bits           = [1, 1];
const CCT_Ringer              = [1, 1];
const CCT_Ringer_Volume       = [1, 1];
const CCT_Ringer_Pattern      = [1, 1];
const CCT_Operation_Mode      = [1, 1];
const CCT_Length              = [1, 1];
const CCT_Active_Flag         = [1, 1];
const CCT_Index               = [1, 1];
const CCT_Change_Value        = [1, 1];
const CCT_Ringback_Type       = [1, 1];
const CCT_Connection_Type     = [1, 1];
const CCT_Ringing_Type        = [1, 1];
const CCT_Time_Str_size       = [1, 1];
const CCT_Time_Str            = [1, 1];
const CCT_PN_Str_size         = [1, 1];
const CCT_PN_Str              = [1, 1];
const CCT_Name_Str_size       = [1, 1];
const CCT_Name_Str            = [1, 1];
const CCT_Dialing_str         = [1, 1];
const CCT_Profile             = [1, 1];
const CCT_Multicast           = [1, 1];
const CCT_Mask_Size           = [1, 1];
const CCT_Match_Str           = [1, 1];
const CCT_Pattern_Active      = [1, 1];
const CCT_Data                = [1, 1];
const CCT_VPI                 = [1, 1];
const CCT_VCI                 = [1, 1];

#-----------------------------------------------------------------------------


set OutputType      = "Communication Class Requests";
set UsbDecodeType   = "Request";
set UsbReqType      = "Class";
set UsbClassCode    = 0x02;    # Class code Communication device and communication interface
set UsbScriptDecodeType = 1;   # Combined decoding for Cells and Text decoding

#
# Parsing entry point
#

set CDC_CELL_COLOR = 0xBBAA22;

set bmRequestType   = 0;
set bRequest        = 0;
set wValue          = 0;
set wIndex          = 0;
set wLength         = 0;

ProcessData()
{
    CommonDecoderInit();
    UnitDecoderInit("CCT");
    SetCellColor(CDC_CELL_COLOR);

    FullyDecoded = 1;

    out.Decoded = 0;

    AddCaptionCell("Comm","Request","This data payload represents a Communication Class Request.",_MONOCOLOR);  # Will allow for the expansion of certain fields
    RestoreCellColor();
    AddSeparator();

    if (in.DataLength < 8)
    {
        AddPLCellMonoNoDlg("Error", "Illegal Payload", "Nothing is being decoded", _ERROR);
        AddShortDataHeader("<font color=RED>ILLEGAL (SHORT) PAYLOAD - Nothing is being decoded!</font>");
        return Complete();
    }

    bmRequestType = NextNBits_(8);
    bRequest = NextNBits_(8);

    _row = Find(RequestTypeTable, bRequest);  # will determine which request is being used

    AddShortDataHeader(_row[1]);
    SetFieldOffsetLen(8,8);

    if(SimpleShowItem())
    {
	    SetCellColor(bRequestColor);
	    AddPayLoadCell("bmRequestType", Format("0x%02X", bmRequestType), "Request Type bitmap");
	    RestoreCellColor();
    }

    SetFieldOffsetLen(16,8);
    SetCellColor(CDC_CELL_COLOR);
	
    AddRequestCell (_row[1]);
    RestoreCellColor();
    Call( _row[1] );
	
    return Complete();
}

DecodeRequestToText()
{
    return DecodeRequestToTextCommon( RequestTypeTable );
}

####################################################################################
#                       USBTracer specific caption cell                            #
####################################################################################

AddSpecCaptionCell(caption, text, tooltip, FieldColor, addparam, addparam1, addparam2 )
{   
    AddCell(caption, text, tooltip, FieldColor, _USBBULK_HEADER, addparam, addparam1, addparam2 );        
    return 1;        
}