    ShowCatcParkMode(HCIeventColor);
}


Catc_TimingAccuracyRequest()
{
    ShowConnection_Handle();

    data = NextNBits(8);
    if (data & 0x80)
      data = 0xFFFFFF00 | data;
    AddCell("Drift", Format("%d", data), "", HCIeventColor);

    ShowTciTxJitter(HCIeventColor);
}


