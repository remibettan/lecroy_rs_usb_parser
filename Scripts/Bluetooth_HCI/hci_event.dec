    ShowNum_Broadcast_Retran(HCIeventColor);
}

Read_Hold_Mode_Activity()
{
    ShowHold_Mode_Activity(HCIeventColor);
}

Read_Transmit_Power_Level()
{
    ShowConnection_Handle();
    data = NextNBits(8);
    if (data & 0x80)
    {
        # this value is below zero
        data = data | 0xffffff00;
    }
    AddCell("Transmit_Power_Level", Format ("%d dBm", data), 
            "Transmit_Power_Level\nRange: -30 >= N <= 20", 
             HCIeventColor,
             select { ((data > 20) || (data < (0-30))) : _ERROR; });
}

Read_SCO_Flow_Control_Enable()
{
    ShowSCO_Flow_Control_Enable(HCIeventColor);
}

Read_Link_Supervision_Timeout()
{
    ShowConnection_Handle();
    ShowLink_Supervision_Timeout(HCIeventColor);
}


Write_Link_Supervision_Timeout()
{
    ShowConnection_Handle();
}

Read_Number_Of_Supported_IAC()
{
    data = NextNBits(8);
    AddCell("Num_Support_IAC", Format ("%d", data), 
            "Specifies the number of Supported IAC that the local Bluetooth device can\nsimultaneous listen for during an Inquiry Scan.\nRange: 0x01-0x40", 
             HCIeventColor,
             select { ((data > 0x40) || (data < 1)) : _ERROR; });
}

Read_Current_IAC_LAP()
{
    num = NextNBits(8);
    AddCell("Num_Current_IAC", Format("%d", num),
            "Specifies the number of IACs which are currently in use by the local Bluetooth\ndevice to simultaneously listen for during an Inquiry Scan.\nRange: 0x01-0x40",
             HCIeventColor,
             select { ((num > 0x40) || (num < 1)) : _ERROR; });

    for (i = 0; i < num; i++)
    {
        AddCell("IAC_LAP", Format("0x%06X", Next24Bits()), "", HCIeventColor ); 
    }
}

Read_Page_Scan_Period_Mode()
{
    ShowPage_Scan_Period_Mode(HCIeventColor);
}

Read_Page_Scan_Mode()
{
    ShowPage_Scan_Mode(HCIeventColor);
}

Read_Local_Version_Information()
{
    data = NextNBits(8);
    select {
      data == 0x00: AddCell("HCI_Version", "1.0B", "Bluetooth HCI Specification 1.0B.", HCIeventColor);
      data == 0x01: AddCell("HCI_Version", "1.1", "Bluetooth HCI Specification 1.1.", HCIeventColor);
      default:      AddCell("HCI_Version", Format("0x%02X", data), "Reserved for future use.", HCIeventColor);
    };

    data = Next16Bits();
    AddCell("HCI_Revision", Format("0x%02X", data), "Revision of the Current HCI in the Bluetooth hardware.", HCIeventColor);

    ShowLMP_Version();
    ShowManufacturer_Name();

    data = Next16Bits();
    AddCell("LMP_Subversion", Format("0x%04X", data), "", HCIeventColor);
}

Read_Local_Supported_Features()
{
    ShowLmpFeatures(HCIeventColor);
}

Read_Buffer_Size()
{
    data = Next16Bits();
    AddCell("HC_ACL_Data_Packet_Length", Format("%d", data), "Maximum length (in bytes) of the data portion of each HCI ACL Data\nPacket that the Host Controller is able to accept.", HCIeventColor);

    AddCell("HC_SCO_Data_Packet_Length", Format("%d", NextNBits(8)), "Maximum length (in bytes) of the data portion of each HCI SCO Data\nPacket that the Host Controller is able to accept.", HCIeventColor);

    data = Next16Bits();
    AddCell("HC_Total_Num_ACL_Data_Packets", Format("%d", data), "Total number of HCI ACL Data Packets that can be stored in the data\nbuffers of the Host Controller.", HCIeventColor);

    data = Next16Bits();
    AddCell("HC_Total_Num_SCO_Data_Packets", Format("%d", data), "Total number of HCI SCO Data Packets that can be stored in the data\nbuffers of the Host Controller.", HCIeventColor);
}

Read_Country_Code()
{
    data = NextNBits(8);
    select {
      data == 0x00: AddCell("Country_Code", "0x00", "North America & Europe (except France) and Japan", HCIeventColor);
      data == 0x01: AddCell("Country_Code", "France", "", HCIeventColor);
      default:     AddCell("Country_Code", Format("0x%02X", data), "Reserved for future use.", HCIeventColor);
    };
}


Read_BD_ADDR()
{
    ShowBD_ADDR(HCIeventColor);
}

Read_Failed_Contact_Counter()
{
    ShowConnection_Handle();

    data = Next16Bits();
    AddCell("Failed_Contact_Counter", Format("0x%04X", data), "Number of consecutive failed contacts for a connection corresponding to\nthe connection handle.", HCIeventColor);
}

Reset_Failed_Contact_Counter()
{
    ShowConnection_Handle();
}

Read_Link_Quality()
{
    ShowConnection_Handle();
    AddCell("Link_Quality", Format("0x%02X", NextNBits(8)), "The current quality of the Link connection between the local device and\nthe remote device specified by the Connection Handle\nRange: 0x00 - 0xFF\nThe higher the value, the better the link quality is.", HCIeventColor);
}

Read_RSSI()
{
    ShowConnection_Handle();
    ShowRSSI();
}


Read_Loopback_Mode()
{
    ShowLoopback_Mode(HCIeventColor);
}


############ CATC specific commands

CATC_Read_HW_FIFO() 
{
    length = NextNBits(8);
    AddCell("length", length, "", HCIeventColor);
    ShowDataBlock(length);
}

CATC_Write_HW_FIFO(){}

CATC_Read_HW_Register() 
{
    AddCell("Data", Format("0x%04X", Next16Bits()), "", HCIeventColor);
}

CATC_Write_HW_Register() {}

CATC_Read_I2C()
{
    AddCell("Data", Format("0x%02X", NextNBits(8)), "", HCIeventColor);
}

CATC_Write_I2C() {}
CATC_Write_PCM_Settings() {}
CATC_Write_Country_Code() {}

CATC_Read_Revision_Information() 
{
