ShowManufacturer_Name()
{
    data= NextNBits(8);
    _row = Find(Manufacturer_NameTable, data);
    AddCell("Manufacturer_Name",  _row[1], Format("0x%02X - " , data) + _row[1], HCIeventColor);
}

set Service_TypeTable = 
[
  [0xFF , "Reserved"   ],
  [0x00 , "No Traffic Available" ],
  [0x01 , "Best Effort Available"],
  [0x02 , "Guaranteed Available" ]
];

ShowService_Type()
{
    data = NextNBits(8);
    _row = Find(Service_TypeTable, data);
    AddCell("Service_Type",  _row[1], Format("0x%02X - ", data) + _row[1], HCIeventColor);
}

ShowNum_HCI_Command_Packets()
{
    AddCell("Num_HCI_Command_Packets", Format("%d", NextNBits(8) ), "The Number of HCI command packets which are allowed to be sent to the Host Controller from the Host", HCIeventColor);
}


const Key_TypeTable = 
[
  [ 0xFF , "Reserved"         ],
  [ 0x00 , "Combination Key"  ],
  [ 0x01 , "Local Unit Key"   ],
  [ 0x02 , "Remote Unit Key"  ]
];

ShowKey_Type()
{
    data = NextNBits(8);
    _row = Find(Key_TypeTable, data);
    AddCell("Key_Type",  _row[1], Format("0x%02X - ", data) + _row[1], HCIeventColor);
}

ShowClock_Offset()
{
    data = Next16Bits();
    data = data & 0x7FFF;
    AddCell("Clock_Offset", Format("0x%04X", data), "Bit 16.2 of CLKslave-CLKmaster.", HCIeventColor);
}

ShowRSSI()
{
    data = NextNBits(8);
    if (data & 0x80)
    {
        # this value is below zero
        data = data | 0xffffff00;
    }
    AddCell("RSSI", Format ("%d dB", data), "",  HCIeventColor);
}


######################## Return parameters

Create_Connection_Cancel()
{
    ShowBD_ADDR(HCIeventColor);
}


Link_Key_Request_Reply()
{
    ShowBD_ADDR(HCIeventColor);
}

Link_Key_Request_Negative_Reply()
{
    ShowBD_ADDR(HCIeventColor);
}

PIN_Code_Request_Reply()
{
    ShowBD_ADDR(HCIeventColor);
}

PIN_Code_Request_Negative_Reply()
{
    ShowBD_ADDR(HCIeventColor);
}

Role_Discovery()
{
    ShowConnection_Handle();
    data = NextNBits(8);
    select {
      data == 0 : AddCell("Current_Role", "master", "Current Role is Master for this Connection Handle.", HCIeventColor);
      data == 1 : AddCell("Current_Role", "slave", "Current Role is Slave for this Connection Handle.", HCIeventColor);
      default   : AddCell("Current_Role", "unknown", Format("0x%02X", data) + " - unknown value", HCIeventColor, _ERROR);
    };
}

Read_Link_Policy_Settings()
{
    ShowConnection_Handle();
    ShowLink_Policy_Settings(HCIeventColor);
}

Write_Link_Policy_Settings()
{
    ShowConnection_Handle();
}

Flush()
{
    ShowConnection_Handle();
}

Read_PIN_Type()
{
    ShowPIN_Type(HCIeventColor);
}

Read_Stored_Link_Key()
{
    data = Next16Bits();
    AddCell("Max_Num_Keys", Format("%d", data), "Total Number of Link Keys that the Host Controller can store.", HCIeventColor);

    data = Next16Bits();
    AddCell("Num_Keys_Read", Format("%d", data), "Number of Link Keys Read.", HCIeventColor);
}

Write_Stored_Link_Key()
{
    data = NextNBits(8);
    AddCell("Num_Keys_Written", Format("%d", data), 
            "Number of Link Keys successfully written.\nRange: 0x00 - 0x0B", HCIeventColor,
             select {(data > 0xb): _ERROR; } );

}

Delete_Stored_Link_Key()
{
    data = Next16Bits();
    AddCell("Num_Keys_Deleted", Format("%d", data), "Number of Link Keys Deleted.", HCIeventColor);
}

Read_Local_Name()
{
    ShowName(HCIeventColor);
}

Remote_Name_Request_Cancel()
{
    ShowBD_ADDR(HCIeventColor);
}

Read_LMP_Handle()
{
    ShowConnection_Handle();
    AddCell("LMP_Handle", Format("%d", NextNBits(8)), "" , HCIeventColor); 

    data = Next32Bits();
    AddCell("Reserved", Format("0x%08X", data), "Reserved, must be zero", 
             HCIeventColor, 
             select { (data != 0): _ERROR; } );
}


Read_Connection_Accept_Timeout()
{
    data = Next16Bits();
    AddCell("Conn_Accept_Timeout", Format("%d", data), 
            "Connection Accept Timeout measured in Number of Baseband slots.\nInterval Length = N * 0.625 msec (1 Baseband slot)\nRange for N: 0x0001 - 0xB540\nTime Range: 0.625 msec -29 seconds", 
             HCIeventColor, 
             select { ((data < 1) || (data > 0xB540)): _ERROR; } );
}

Read_Page_Timeout()
{
    data = Next16Bits();
    AddCell("Page_Timeout", Format("%d", data), 
            "Page Timeout measured in Number of Baseband slots.\nInterval Length = N * 0.625 msec (1 Baseband slot)\nRange for N: 0x0001 - 0xFFFF\nTime Range: 0.625 msec -40.9 Seconds", 
             HCIeventColor,
             select { (data < 1): _ERROR; } );
}

Read_Scan_Enable()
{
   ShowScan_Enable(HCIeventColor);
}

