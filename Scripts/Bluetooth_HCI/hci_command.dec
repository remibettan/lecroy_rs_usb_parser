 [ 0x02 , "Respond to the first ID packet and the second \nreceived FHS packet from the Paging device according to \nTP/PHYS/PAG/BV-03-C and TP/PHYS/PAG/BV-04-C test cases depending on the current Country Code settings" ],
 [ 0x03 , "Respond to the second ID packet and the second \nreceived FHS packet from the Paging device according to \nTP/PHYS/PAG/BV-05-C and TP/PHYS/PAG/BV-06-C test cases depending on the current Country Code settings" ]
