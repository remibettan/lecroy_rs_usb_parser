Read_Number_Of_Supported_IAC()  {}
Read_Current_IAC_LAP()          {}

Write_Current_IAC_LAP()
{
    num = NextNBits(8);
    AddCell("Num_Current_IAC", Format("%d", num),
            "Specifies the number of IACs which are currently in use by the local Bluetooth\ndevice to simultaneously listen for during an Inquiry Scan.\nRange: 0x01-0x40",
             HCIcommandColor,
             select {((num < 1) || (num > 0x40)): _ERROR; } );

    for (i = 0; i < num; i++)
    {
        iac_lap = Next24Bits();

        AddCell("IAC_LAP", Format("0x%06X", iac_lap), "LAP(s) used to create IAC which is currently in use by the local Bluetooth\ndevice to simultaneously listen for during an Inquiry Scan.\nRange: 0x9E8B00-0x9E8B3F."
                , HCIcommandColor,
              select {((iac_lap < 0x9E8B00) || (iac_lap > 0x9E8B3F)): _ERROR; } );
    }
}

