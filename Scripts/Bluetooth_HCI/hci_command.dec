Write_Stored_Link_Key()
{
    num = NextNBits(8);
    AddCell("Num_Keys_To_Write", Format("%d", num),
            "Number of Link Keys to Write.\nRange: 0x01 - 0x0B",
             HCIcommandColor,
             select {((num < 1) || (num > 0xB)): _ERROR; } );
    for (i = 0; i < num; i++)
    {
        ShowBD_ADDR(HCIcommandColor);
    }
    for (i = 0; i < num; i++)
    {
        ShowLink_Key(HCIcommandColor);
    }
}

