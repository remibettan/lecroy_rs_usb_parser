%include "DecoderTools.inc"    #include usefull decoder functions
%include "hci_common.inc"
%include "hci_command_table.inc"

#----  Input
# in.Data       - Data_block to decode
# in.DataLength - Length of Data_block 
#
#----  Output
# out.Decoded   - amount of data has been decoded
#

%include "SharedTabularCellId.inc"

const Tabular_Def_Table = Map( 
[   
    #-----------------------------------------------------------------------------------------------------
    #       id              ,      colId                          , 		containerCellId
    #-----------------------------------------------------------------------------------------------------
    [ HCI_CELL_COMMAND      , TABULAR_SCRIPT_COLUMN_ID_SUBTYPE    , TABULAR_SCRIPT_CONTAINER_CELL_ID_NONE ],
    [ HCI_CELL_LENGTH       , TABULAR_SCRIPT_COLUMN_ID_NONE       , TABULAR_SCRIPT_CONTAINER_CELL_ID_MISC ]
] );


set ModuleType  = "DataBlock Decoder";
set OutputType  = "HCI command";

# These values are for decoding on USB Analyzers
set UsbDecodeType = "Request";
set UsbClassCode = 0xE0;
set UsbSubClass  = 0x01;
set UsbProtocol  = 0x01;

# This variable defines that the script which includes this file
# belongs to the USB script decoding family.
set ScriptFamily = "USB";



set UsbReqType   = "Class";
set UsbIgnoreSetupData = 1;


#
# Parsing entry point
#
const HCIcommandColor = 0x8854ff;

set HciLength = 0;



ProcessData()
{
    command = ( GetNBits(in.Data, 8, 8) << 8 ) | GetNBits(in.Data, 0, 8);
    HciLength= GetNBits(in.Data, 16, 8);
    _row = Find(HciCommandTable, command);
    
    AddCell("Command", _row[1], Format("0x%04X - ", command) + _row[2], HCIcommandColor, [_TABULARCELL, HCI_CELL_COMMAND]);
    
    AddCell("Length", Format("%d", HciLength), "",  HCIcommandColor, [_TABULARCELL, HCI_CELL_LENGTH, "TEXT_CAPTION"]);

#    NextNBits(8);

    Call ( _row[1], [ in.DataLength - 2 ] );

    AddSeparator();

###### uncomment the following lines if you need the original data of HCI
#    GetNBits(in.Data, 0, 0);
#    ShowDataBlock(in.DataLength);
#########################################################################

    out.Decoded = in.DataLength;
    
    return Complete();
}



##################### OGF = 0x01 - Link Control commands
Inquiry()
{
    ShowLAP();
    ShowInquiry_Length();
    ShowNum_Responses();
}

Inquiry_Cancel() {}

Periodic_Inquiry_Mode()
{
    data = Next16Bits();
    AddCell ("Max_Period_Length", Format("%d", data), 
             "Maximum amount of time specified between consecutive inquiries.\nRange: 0x03 - 0xFFFF\nTime = N * 1.28 sec\nRange: 3.84 - 83884.8 Sec\n0.0 - 23.3 hours",
              HCIcommandColor, 
              select { ( data < 0x03 ) : _ERROR; } );

    data = Next16Bits();
    AddCell ("Min_Period_Length", Format("%d", data), 
             "Minimum amount of time specified between consecutive inquiries.\nRange: 0x02 - 0xFFFE\nTime = N * 1.28 sec\nRange: 2.56 - 83883.52 Sec\n0.0 - 23.3 hours",
              HCIcommandColor, 
              select { ( data < 0x02 ) : _ERROR; } );

    ShowLAP();
    ShowInquiry_Length();
    ShowNum_Responses();
}

Exit_Periodic_Inquiry_Mode()  {}

