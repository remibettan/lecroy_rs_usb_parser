Catc_Disconnect()
{
    ShowConnection_Handle();

    data = NextNBits(8);
    select {
      data == 0: AddCell("Mode", "Tester Detach"            , "0 - Tester Detach"           ,  HCIcommandColor);
      data == 1: AddCell("Mode", "IUT Detach"               , "1 - IUT Detach"              ,  HCIcommandColor);
      data == 2: AddCell("Mode", "Link Supervision( Slave)" , "2 - Link Supervision (Slave)",  HCIcommandColor);
      data == 3: AddCell("Mode", "Link Supervision( Master)", "3 - Link Supervision (Master)", HCIcommandColor);
      default:   AddCell("Mode", Format("0x%02X", data)     , "reserved value"              ,  HCIcommandColor, _ERROR);
    };

    data = NextNBits(8);
    AddCell("TimeOut", Format("%d", data), "TimeOut value\nUsed only in IUT Detach mode\nWait for this time period for detach request from IUT.\nIf no detach received, time out as nothing happened",  HCIcommandColor);


}

Catc_ScoErrorInjection()
{
    ShowConnection_Handle();

    data = NextNBits(8);
    select {
      data == 0: AddCell("Test Scenario", "DV retransmittion", "0 - Retransmission of DV packet",  HCIcommandColor);
      data == 1: AddCell("Test Scenario", "Uncorrectable DV", "1 - Uncorrectable DV packet",  HCIcommandColor);
      default:   AddCell("Test Scenario", Format("0x%02X", data), "reserved value",  HCIcommandColor, _ERROR);
    };

}

Catc_QoS()
{
    ShowConnection_Handle();

    data = Next16Bits();
    AddCell("poll interval", Format("%d slots", data), Format("Poll Interval = 0x%04X", data), HCIcommandColor); 

    data = NextNBits(8);
    AddCell("Nbc", Format("%d", data), "number of repetitions for broadcast packets", HCIcommandColor); 
}

