Catc_QoSResponse()
{
    data = NextNBits(8);
    select {
      data == 0: AddCell("Mode", "reject", "0 - Reject all incoming LMP_Quality_Of_Service",  HCIcommandColor);
      data == 1: AddCell("Mode", "accept", "1 - Accept",  HCIcommandColor);
      default:   AddCell("Mode", Format("0x%02X", data), "reserved value",  HCIcommandColor, _ERROR);
    };
}

Catc_MaxSlotResponse()
{
    ShowConnection_Handle();

    data = NextNBits(8);
    select {
      data == 0: AddCell("Action", "reject", "0 - Reject",  HCIcommandColor);
      data == 1: AddCell("Action", "accept", "1 - Accept",  HCIcommandColor);
      default:   AddCell("Action", Format("0x%02X", data), "reserved value",  HCIcommandColor, _ERROR);
    };

    data = NextNBits(8);
    select {
      data == 0: AddCell("Event", "enable" , "0-EnableCatcMaxSlotRequestEvent" ,  HCIcommandColor);
      data == 1: AddCell("Event", "disable", "1-DisableCatcMaxSlotRequestEvent",  HCIcommandColor);
      default:   AddCell("Event", Format("0x%02X", data), "reserved value",  HCIcommandColor, _ERROR);
    };
}


