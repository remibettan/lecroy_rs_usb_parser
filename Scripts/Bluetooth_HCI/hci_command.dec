      data == 1 : AddCell("Inquiry_Mode", "with RSSI", "1 - Inquiry Result format with RSSI",  HCIcommandColor);
      default   : AddCell("Inquiry_Mode", Format("0x%02X", data) , "Reserved value.",  HCIcommandColor);
    };
}

