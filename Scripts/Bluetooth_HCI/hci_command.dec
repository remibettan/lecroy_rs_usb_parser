Host_Buffer_Size()
{

    data = Next16Bits();
    AddCell ("Host_ACL_Data_Packet_Length", Format("%d", data), "Maximum length (in bytes) of the data portion of each HCI ACL Data Packet that the Host is able to accept.", HCIcommandColor);

    data = NextNBits(8);
    AddCell ("Host_SCO_Data_Packet_Length", Format("%d", data), "Maximum length (in bytes) of the data portion of each HCI synchronous Data Packets that the Host is able to accept.", HCIcommandColor);

    data = Next16Bits();
    AddCell ("Host_Total_Num_ACL_Data_Packets", Format("%d", data), "Total number of HCI ACL Data Packets that can be stored in the data buffers of the Host." , HCIcommandColor);

    data = Next16Bits();
    AddCell ("Host_Total_Num_SCO_Data_Packets", Format("%d", data), "Total number of HCI synchronous Data Packets that can be stored in the data buffers of the Host." , HCIcommandColor);
}

Host_Number_Of_Completed_Packets()
{
    num = NextNBits(8);
    AddCell("Number_Of_Handles", Format("%d", num),
            "The number of Connection Handles and Host_Num_Of_Completed_Packets\nparameters pairs contained in this command.",
             HCIcommandColor );

    for (i = 0; i < num; i++)
    {
        ShowConnection_Handle();
    }
    for (i = 0; i < num; i++)
    {
        data = Next16Bits();
        AddCell( "Host_Num_Of_Completed_Packets",
                 Format("%d", data), 
                 "The number of HCI Data Packets that have been completed for the associated\nConnection Handle since the previous time the event was returned.",
             HCIcommandColor );
    }
}

