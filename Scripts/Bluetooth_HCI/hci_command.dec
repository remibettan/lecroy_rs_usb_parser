ShowNumberOfTimes()
{
    AddCell("Times",  Next16Bits(), "Number of times to repeat the test", HCIcommandColor);
}

ShowNumberOfPackets()
{
    AddCell("NumOfPackets", Next16Bits(), "", HCIcommandColor);
}

ShowTimeLength()
{
    AddCell("TimeLength", Format("%d ms", Next16Bits()), "", HCIcommandColor);
}

ShowTciPacketData()
{
    data = Next16Bits();
    AddCell("PacketLength", data, "", HCIcommandColor);
    ShowDataBlock(data);
}

ShowTciErrorType( table )
{
    data = Next16Bits();
    _row = Find(table, data);
    AddCell("ErrorType",  Format("0x%04X", data), _row[1], HCIcommandColor);
}

ShowTciErrorMask()
{
    AddCell("ErrorMask", Format("0x%04X", Next16Bits()), "", HCIcommandColor);
}


ShowTciL_CH()
{
    data = NextNBits(8);
    select {
        data == 1: AddCell("L_CH", "Cont" ,"L_CH = 1\nContinuation fragment of an L2CAP message\nDefines payload header L_CH value and type of the payload to be sent.", HCIcommandColor); 
        data == 2: AddCell("L_CH", "Start","L_CH = 2\nStart of an L2CAP message or no fragmentation\nDefines payload header L_CH value and type of the payload to be sent.", HCIcommandColor); 
        data == 3: AddCell("L_CH", "LMP"  ,"L_CH = 3\nLMP Message\nDefines payload header L_CH value and type of the payload to be sent.", HCIcommandColor); 
        default:   AddCell("L_CH", Format("0x%02X", data) ,"reserved value.", HCIcommandColor, _ERROR); 
    };
}



const PagingScheme_Table = [
  [ "mandatory"  , "0 - mandatory scheme"  ],
  [ "optional 1" , "1 - optional scheme 1" ],
  [ "optional 2" , "2 - optional scheme 2" ],
  [ "optional 3" , "3 - optional scheme 3" ]
];

const PagingSchSettings_Table = [
  [ "R0"       , "0 - R0" ],
  [ "R1"       , "1 - R1" ],
  [ "R2"       , "2 - R2" ]
];

const PagingSchSettingsOS1_Table = [
  [ "Reserved" , "0 - Reserved for scheme 1" ],
  [ "R1"       , "1 - R1" ],
  [ "R2"       , "2 - R2" ]
];

ShowPagingSchemeAndSettings()
{
    page_sch = NextNBits(8);
    page_sch_set = NextNBits(8);

    if (page_sch < sizeof(PagingScheme_Table))
    {
        AddCell("PagingScheme", PagingScheme_Table[page_sch][0], PagingScheme_Table[page_sch][1], HCIcommandColor); 

        if (page_sch_set < sizeof(PagingSchSettings_Table))
        {
            if (page_sch == 1)
                AddCell("PagingSchemeSettings", PagingSchSettingsOS1_Table[page_sch_set][0], PagingSchSettingsOS1_Table[page_sch_set][1], HCIcommandColor); 
            else 
                AddCell("PagingSchemeSettings", PagingSchSettings_Table[page_sch_set][0], PagingSchSettings_Table[page_sch_set][1], HCIcommandColor); 
        }
        else
            AddCell("PagingSchemeSettings", Format("0x%02X", data), "reserved value", HCIcommandColor, _ERROR); 
    }
    else
    {
        AddCell("PagingScheme", Format("0x%02X", page_sch), "reserved value", HCIcommandColor, _ERROR); 
        AddCell("PagingSchemeSettings", Format("0x%02X", data), "", HCIcommandColor); 
    }
}



################### Specific fields
ShowLAP()
{
    data = Next24Bits();
    AddCell ("LAP", Format("0x%06X", data), 
             "This is the LAP from which the inquiry access code should be derived when the inquiry procedure is made.\n Range 0x9E8B00 - 0x9E8B3F", 
              HCIcommandColor, 
              select { (( data < 0x9E8B00) || (data > 0x9E8B3F)): _ERROR; });
}



ShowInquiry_Length()
{
    data = NextNBits(8);
    AddCell ("Inquiry_Length", Format("%d", data), 
             "Maximum amount of time specified before the Inquiry is halted.\nRange: 0x01 - 0x30\nTime = N * 1.28 sec\nRange: 1.28 - 61.44 Sec", 
              HCIcommandColor, 
              select { ( ( data < 0x01) || (data> 0x30) ): _ERROR; });
}

ShowNum_Responses()
{
    data = NextNBits(8);
    if ( data== 0 )
      AddCell ("Num_Responses", Format("%d", data), "Unlimited number of responses.", HCIcommandColor);
    else
      AddCell ("Num_Responses", Format("%d", data), "Maximum number of responses from the Inquiry before the Inquiry is halted.", HCIcommandColor);
}



ShowClock_Offset()
{
    data = Next16Bits();

    AddCell("Clock_Offset_Valid_Flag", select { data & 0x8000: "Valid"; default: "Invalid"; }, "", HCIcommandColor);
    
    data = data & 0x7FFF;
    AddCell("Clock_Offset", Format("0x%04X", data), "Bit 16.2 of CLKslave-CLKmaster.", HCIcommandColor);
}


set Allow_Role_SwitchTable = 
[
  [0xFF  , "Reserved for future use." ],
  [0x00  , "The local device will be a master, and will not accept a master-slave\nswitch requested by the remote device at the connection setup." ],
  [0x01  , "The local device may be a master, or may become a slave after\naccepting a master-slave switch requested by the remote device\nat the connection setup." ]
];

ShowAllow_Role_Switch()
{
    data = NextNBits(8);
    _row = Find(Allow_Role_SwitchTable, data);
    AddCell("Allow_Role_Switch", Format("0x%02X", data), _row[1], HCIcommandColor);
}


ShowReason()
{
  data = NextNBits(8);
  _row = Find(HciErrorCodes, data);
  AddCell("Reason", _row[1], Format("0x%02X - ", data) + _row[2], HCIcommandColor);
}

ShowRole()
{
    data = NextNBits(8);
    select {
      data == 0 : AddCell("Role", "master", "Become the Master for this connection. The LM will perform the Master/Slave switch.", HCIcommandColor);
      data == 1 : AddCell("Role", "slave", "Remain the Slave for this connection. The LM will NOT perform the Master/Slave switch.", HCIcommandColor);
      default: AddCell("Role", "unknown", Format("0x%02X", data) + " - unknown value", HCIcommandColor, _ERROR);
    };
}

ShowRoleSw()
{
    data = NextNBits(8);
    select {
      data == 0 : AddCell("Role", "master", "Change own Role to Master for this BD_ADDR.", HCIcommandColor);
      data == 1 : AddCell("Role", "slave", "Change own Role to Slave for this BD_ADDR.", HCIcommandColor);
      default: AddCell("Role", "unknown", Format("0x%02X", data) + " - unknown value", HCIcommandColor, _ERROR);
    };
}



ShowPin_Code()
{
    len = NextNBits(8);
    AddCell ("PIN_Code_Length", Format("%d", len), 
             "The PIN code length specifics the length, in bytes, of the PIN code to be used.\nRange: 0x01-0x10", 
              HCIcommandColor,
              select { ((len < 1)  || (len > 0x10)) : _ERROR; } 
            );

   ascii_enable = 1;
   for (i = 0; i < len; i++ )
   {
      data = NextNBits(8);
      if ((data > 0x1F) && (data < 0x7F))
        ascii_enable = 0;
      hex_str = hex_str + Format(" %02X", data);
      ascii_str = ascii_str + Format("%c", data);
   }
  
   AddCell("PIN_Code", select { ascii_enable : ascii_str; default : hex_str; },
           "PIN code for the device that is to be connected.", HCIcommandColor);

}


ShowEncryption_Enable()
{
    data = NextNBits(8);
    select {
      data == 0 : AddCell("Encryption_Enable", "turn off", "Turn Link Level Encryption OFF.", HCIcommandColor);
      data == 1 : AddCell("Encryption_Enable", "turn on", "Turn Link Level Encryption ON.", HCIcommandColor);
      default: AddCell("Encryption_Enable", "unknown", Format("0x%02X", data) + " - unknown value", HCIcommandColor, _ERROR);
    };
}

ShowKey_Flag()
{
    data = NextNBits(8);
    select {
      data == 0 : AddCell("Key_Flag", "use semi-permanent", "Use semi-permanent Link Keys.", HCIcommandColor);
      data == 1 : AddCell("Key_Flag", "use Temporary", "Use Temporary Link Key.", HCIcommandColor);
      default: AddCell("Key_Flag", "unknown", Format("0x%02X", data) + " - unknown value", HCIcommandColor, _ERROR);
    };
}

ShowHold_Mode_Max_Interval()
{
    data = Next16Bits();
    AddCell("Hold_Mode_Max_Interval", Format("%d slots", data),
            "Maximum acceptable number of Baseband slots to wait in Hold Mode.\nTime Length of the Hold = N * 0.625 msec (1 Baseband slot)\nRangefor N: 0x0002-0xFFFE (1.25ms - 40.9 sec);\nMandatory Range: 0x0014 to 0x8000\nonly even values are valid",
             HCIcommandColor,
             select { ( (data < 0x0002) || ((data & 1) == 1) ): _ERROR; } );
}


ShowHold_Mode_Min_Interval()
{
    data = Next16Bits();
    AddCell("Hold_Mode_Min_Interval", Format("%d slots", data),
            "Minimum acceptable number of Baseband slots to wait in Hold Mode.\nTime Length of the Hold = N * 0.625 msec (1 Baseband slot)\nRangefor N: 0x0002-0xFF00\nMandatory Range: 0x0014 to 0x8000\nonly even values are valid",
             HCIcommandColor,
             select {( (data < 0x0002) || (data > 0xFF00) || ((data & 1) == 1) ): _ERROR; } );
}


ShowSniff_Max_Interval()
{
    data = Next16Bits();
    AddCell("Sniff_Max_Interval", Format("%d slots", data),
             "Maximum acceptable number of Baseband slots between each sniff period.\n(Sniff_Max_Interval >= Sniff_Min_Interval)\nLength = N * 0.625 msec (1 Baseband slot)\nRangefor N: 0x0002 - 0xFFFE (1.25 msec to 40.9 sec)\nMandatory Range: 0x0006 to 0x0540\nonly even values are valid",
             HCIcommandColor,
             select {( (data < 0x0002) || ((data & 1) == 1) ): _ERROR; } );
}

ShowSniff_Min_Interval()
{
    data = Next16Bits();
    AddCell("Sniff_Min_Interval", Format("%d slots", data),
            "Minimum acceptable number of Baseband slots between each sniff period.\n(Sniff_Max_Interval >= Sniff_Min_Interval)\nLength = N * 0.625 msec (1 Baseband slot)\nRange for N: 0x0002 - 0xFFFE (1.25 msec to 40.9 sec)\nMandatory Range: 0x0006 to 0x0540\nonly even values are valid",
             HCIcommandColor,
             select {( (data < 0x0002) || ((data & 1) == 1) ): _ERROR; } );
}

ShowSniff_Attempt()
{
    data = Next16Bits();
    AddCell("Sniff_Attempt", Format("%d slots", 2 * data - 1),
            "Number of Baseband receive slots for sniff attempt.\nLength = N* 1.25 msec\nRange for N: 0x0001 - 0x7FFF (0.625msec - 40.9sec)",
             HCIcommandColor,
             select {( (data == 0) || (data > 0x7fff) ): _ERROR; } );
}

ShowSniff_Timeout()
{
    data = Next16Bits();
    AddCell("Sniff_Timeout", Format("%d slots", 2 * data - 1),
            "Number of Baseband receive slots for sniff timeout.\nLength = N * 1.25 msec\nRange for N: 0x0000 - 0x7FFF (0msec - 40.9sec)\nMandatory Range for Controller: 0 to 0x0028",
             HCIcommandColor,
             select {(data > 0x7fff): _ERROR; } );
}

ShowBeacon_Max_Interval()
{
    data = Next16Bits();
    AddCell("Beacon_Max_Interval", Format("%d slots", data),
            "Maximum acceptable number of Baseband slots between consecutive beacons.\nInterval Length = N * 0.625 msec (1 Baseband slot)\nRange for N: 0x000E - 0xFFFE\nTime Range: 8.75 msec to 40.9 sec\nonly even values are valid",
             HCIcommandColor,
             select {((data < 0x000E) || ((data & 1) == 1) ): _ERROR; } );
}

ShowBeacon_Min_Interval()
{
    data = Next16Bits();
    AddCell("Beacon_Min_Interval", Format("%d slots", data),
            "Minimum acceptable number of Baseband slots between consecutive beacons\nInterval Length = N * 0.625 msec (1 Baseband slot)\nRange for N: 0x000E - 0xFFFE\nTime Range: 8.75 msec to 40.9 sec\nonly even values are valid",
             HCIcommandColor,
             select { ((data < 0x000E) || ((data & 1) == 1) ): _ERROR; } );
}

