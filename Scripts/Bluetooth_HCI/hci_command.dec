set TciTestScenarioPageTable = [
 [ 0xFF,  "Reserved" ],
 [ 0x00,  "Return to use the normal Page" ],
 [ 0x01,  "The tester pages the IUT only in the first half of the Tx time slot. \nAfter receiving response, the tester does not send an FHS packet. \nThe test continues according to TP/PHYS/PAG/BV-10-C or TP/PHYS/PAG/BV-11-C test case \naccording to the current Country Code." ],
 [ 0x02,  "The tester pages the IUT only in the second half of the Tx time slot. \nAfter receiving response, the tester does not send an FHS packet. \nThe test continues according to TP/PHYS/PAG/BV-12-C or TP/PHYS/PAG/BV-13-C test case according to the current Country Code." ],
 [ 0x03,  "The tester pages the IUT until the response ID is received. \nThe tester does not respond with FHS, but waits 16 slots, then 8 slots, \nand then an additional randomly chosen 0-1023 slots. \nPerform the test according to TP/PHYS/PAG/BV-14-C test case and current page scheme." ],
 [ 0x04,  "The tester pages the IUT until the response ID is received. \nThe tester does not respond with FHS, but waits 16 slots, then 8 slots, \nand then an additional randomly chosen 0-2047 slots. \nPerform the test according to TP/PHYS/PAG/BV-16-C test case and current page scheme." ],
 [ 0x05,  "The tester pages the IUT until the response ID is received. \nThe tester does not respond with FHS, but waits 16 slots, then 8 slots, \nand then an additional randomly chosen 0-4095 slots. \nPerform the test according to TP/PHYS/PAG/BV-18-C test case and current page scheme." ],
 [ 0x06,  "The tester pages the IUT using page train A until the response ID is received. \nThe tester does not respond with FHS, but waits 16 slots, \nthen 8 slots, and then an additional randomly chosen 0-200 slots. \nPerform the test according to TP/PHYS/PAG/BV-20-C test case and current page scheme." ],
 [ 0x07,  "Supports TP/PHYS/PAG/BV-31-C test case." ],
 [ 0x08,  "Supports TP/PHYS/PAG/BV-32-C test case." ]
];

TCI_CatcPage () 
{
    ShowBD_ADDR(HCIcommandColor);

    data = NextNBits(8);
    _row = Find(TciTestScenarioPageTable, data);
    AddCell("TestScenario",  Format("0x%02X", data), _row[1], HCIcommandColor);
    ShowNumberOfTimes();
}


