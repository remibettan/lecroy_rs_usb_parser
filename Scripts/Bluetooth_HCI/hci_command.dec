    AddCell("AFH_Host_Channel_Classification", text, "", HCIcommandColor ); 
}

Read_Inquiry_Scan_Type()           {}

Write_Inquiry_Scan_Type()
{
    data = NextBits(8);
    select {
      data == 0 : AddCell("Scan_Type", "Standard", "0 - Mandatory: Standard Scan",  HCIcommandColor);
      data == 1 : AddCell("Scan_Type", "Interlaced", "1 - Optional: Interlaced Scan",  HCIcommandColor);
      default   : AddCell("Scan_Type", Format("0x%02X", data) , "Reserved value.",  HCIcommandColor);
    };
}

