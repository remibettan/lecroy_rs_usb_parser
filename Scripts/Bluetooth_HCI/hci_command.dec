ShowEvent_Mask()
{
    dataHi = Next32Bits();
    str = Format("0x%08X", dataHi);

    data = Next32Bits();
    str = str + Format("%08X", data);

    tooltip = "<HTML><TABLE CELLPADDING=2>";
    for (i = 0; i < sizeof(Event_MaskTable); i++)
    {
      tooltip = tooltip + Format("<TR><TD>bit %d</TD>", i) +
        select { data & Event_MaskTable[i][0] : "<TD>1</TD>";
                 default                      : "<TD>0</TD>"; } 
        + "<TD>" + Event_MaskTable[i][1] + "</TD></TR>";
 
    }

    for (i = 0; i < sizeof(Event_MaskTableHi); i++)
    {
      tooltip = tooltip + Format("<TR><TD>bit %d</TD>", i+32) +
        select { dataHi & Event_MaskTableHi[i][0] : "<TD>1</TD>";
                 default                      : "<TD>0</TD>"; } 
        + "<TD>" + Event_MaskTableHi[i][1] + "</TD></TR>";
 
    }
    tooltip = tooltip + Format("<TR><TD></TD><TD>0x%04X</TD><TD>Reserved</TD></TR>", dataHi >> i);

    tooltip += "</TABLE></HTML>";
    AddCell("Event_Mask", str, tooltip, HCIcommandColor);
}



set Inquiry_Result_Filter_Condition_TypeTable = 
[
  [ 0xFF , "reserved"         , "Reserved for Future Use"                                                    ],
  [ 0x00 , "All devices"      , "Return responses from all devices during the Inquiry process."              ],
  [ 0x01 , "specific COD"     , "A device with a specific Class of Device responded to the Inquiry process." ],
  [ 0x02 , "specific BD_ADDR" , "A device with a specific BD_ADDR responded to the Inquiry process."         ] 
];

ShowInquiry_Result_Filter_Condition_Type()
{
  data = NextNBits(8);
  _row = Find(Inquiry_Result_Filter_Condition_TypeTable, data);
  AddCell("Inquiry_Result_Filter_Condition_Type",  _row[1], Format("Inquiry_Result_Filter_Condition_Type\n0x%02X - ", data) + _row[2], HCIcommandColor);
  select 
  {
      _row[0] == 1 : ShowCODcondition();
      _row[2] == 2 : ShowBD_ADDR(HCIcommandColor);
  };
}

ShowCODcondition()
{
  data = NextNBits(24);
  if (data == 0x000000)
  {
    AddCell("Condition-COD", Format("0x%06X", data), "Return all Devices - 000000", HCIcommandColor);
  } 
  else 
  {
    AddCell("Condition-COD", Format("0x%06X", data), Format("Return devices with COD == 0x%06X", data), HCIcommandColor);
  }

  data = NextNBits(24);
  AddCell("Condition-COD Mask", Format("0x%06X", data), "Bit Mask to determine significant COD bits", HCIcommandColor);
}




set Connection_Setup_Filter_Condition_TypeTable = 
[
  [ 0xFF , "reserved"         , "Reserved for Future Use."                                         ],
  [ 0x00 , "all devices"      , "Allow Connections from all devices."                              ],
  [ 0x01 , "specific COD"     , "Allow Connections from a device with a specific Class of Device." ],
  [ 0x02 , "specific BD_ADDR" , "Allow Connections from a device with a specific BD_ADDR."         ]
];

ShowConnection_Setup_Filter_Condition_Type()
{
  data = NextNBits(8);
  _row = Find(Connection_Setup_Filter_Condition_TypeTable, data);
  AddCell("Connection_Setup_Filter_Condition_Type",  _row[1], Format("Connection_Setup_Filter_Condition_Type\n0x%02X - ", data) + _row[2], HCIcommandColor);

  select 
  {
      _row[0] == 0 : ShowAuto_Accept_Flag();
      _row[0] == 1 : { ShowCODcondition();           ShowAuto_Accept_Flag(); }
      _row[0] == 2 : { ShowBD_ADDR(HCIcommandColor); ShowAuto_Accept_Flag(); }
  };
}


set Auto_Accept_Flag_Table = 
[
  [ 0xFF , "reserved"                , "Reserved for Future Use."                                                        ],
  [ 0x01 , "NOT accept"              , "Do NOT Auto accept the connection. (Auto accept is off)"                         ],
  [ 0x02 , "accept, switch disabled" , "Do Auto accept the connection with role switch disabled. (Auto accept is on)."   ],
  [ 0x03 , "accept, switch enabled"  , "Do Auto accept the connection with role switch enabled. (Auto accept is on)./n Note: When auto accepting an incoming SCO connection, no role switch will be performed. /nThe value 0x03 of the Auto_Accept_Flag will then get the same effect as if the value had been 0x02.."         ]
];


ShowAuto_Accept_Flag()
{
    data = NextNBits(8);
    _row = Find(Auto_Accept_Flag_Table, data);
    AddCell("Auto_Accept_Flag",  _row[1], Format("Auto_Accept_Flag\n0x%02X - ", data) + _row[2], HCIcommandColor);
}



set Read_All_FlagTable = 
[
  [ 0xFF , "Reserved for future use."               ],
  [ 0x00 , "Return Link Key for specified BD_ADDR." ],
  [ 0x01 , "Return all stored Link Keys."           ]
];

ShowRead_All_Flag()
{
    data = NextNBits(8);
    _row = Find(Read_All_FlagTable, data);
    AddCell("Read_All_Flag",  Format("0x%02X", data), _row[1], HCIcommandColor);
}


set Delete_All_FlagTable =
[
  [ 0xFF , "Reserved for future use."                         ],
  [ 0x00 , "Delete only the Link Key for specified BD_ADDR."  ],
  [ 0x01 , "Delete all stored Link Keys."                     ]
];

ShowDelete_All_Flag()
{
    data = NextNBits(8);
    _row = Find(Delete_All_FlagTable, data);
    AddCell("Delete_All_Flag",  Format("0x%02X", data), _row[1], HCIcommandColor);
}

ShowConn_Accept_Timeout()
{
    data = Next16Bits();
    AddCell("Conn_Accept_Timeout", Format("%d slots",  data),
            "Connection Accept Timeout measured in Number of Baseband slots.\nInterval Length = N * 0.625 msec (1 Baseband slot)\nRange for N: 0x0001 - 0xB540\nTime Range: 0.625 msec - 29 seconds\nDefault: N = 0x1FA0 Time = 5 Sec",
             HCIcommandColor,
             select {((data > 0xB540) || (data < 1)): _ERROR; } );
}

ShowPage_Timeout()
{
  timeout = Next16Bits();
  if ( timeout )
    AddCell ("Page_Timeout", Format("%d", timeout), "Page Timeout measured in Number of Baseband slots.", HCIcommandColor);
  else
    AddCell ("Page_Timeout", "0", "Illegal Page Timeout. Must be larger than 0.", HCIcommandColor, _ERROR);
}



set TypeTable = 
[
  [ 0xFF , "Reserved"                           ],
  [ 0x00 , "Read Current Transmit Power Level." ],
  [ 0x01 , "Read Maximum Transmit Power Level." ]
];

ShowType()
{
    data = NextNBits(8);
    _row = Find(TypeTable, data);
    AddCell("Type",  Format("0x%02X", data), _row[1], HCIcommandColor);
}



set Flow_Control_EnableTable = 
[
  [ 0xFF , "Reserved"  ],
  [ 0x00 , "Flow control off in direction from Host Controller to Host."  ],
  [ 0x01 , "Flow control on for HCI ACL Data Packets and off for \nHCI SCO Data Packets in direction from Host Controller to Host." ],
  [ 0x02 , "Flow control off for HCI ACL Data Packets and on for\n HCI SCO Data Packets in direction from Host Controller to Host." ],
  [ 0x03 , "Flow control on both for HCI ACL Data Packets and \nHCI SCO Data Packets in direction from Host Controller to Host."    ]
];

ShowFlow_Control_Enable()
{
    data = NextNBits(8);
    _row = Find(Flow_Control_EnableTable, data);
    AddCell("Flow_Control_Enable",  Format("0x%02X", data), _row[1], HCIcommandColor);
}




ShowTransmit_Bandwidth()
{
    data = Next32Bits();
    select {
      data == 0xFFFFFFFF: AddCell("Transmit_Bandwidth", "Don't care", "0xFFFFFFFF - Don't care",  HCIcommandColor);
      default           : AddCell("Transmit_Bandwidth", Format("%d", data), "Transmit bandwidth in bytes per second.",  HCIcommandColor);
   };
}

ShowReceive_Bandwidth()
{
    data = Next32Bits();
    select {
      data == 0xFFFFFFFF: AddCell("Receive_Bandwidth", "Don't care", "0xFFFFFFFF - Don't care",  HCIcommandColor);
      default           : AddCell("Receive_Bandwidth", Format("%d", data), "Receive bandwidth in bytes per second.",  HCIcommandColor);
    };
}

ShowMax_Latency()
{
    data = Next16Bits();
    select {
      data < 4       : AddCell("Max_Latency", Format("%d", data) , "Reserved value",  HCIcommandColor, _ERROR);
      data == 0xFFFF : AddCell("Max_Latency", "Don't care." , "0xFFFF - Don't care.",  HCIcommandColor);
      default        : AddCell("Max_Latency", Format("%d ms", data) , "Representing the upper limit of the sum\nof the synchronous interval and the size of the eSCO window.",  HCIcommandColor);
    };
}

ShowRetransmission_Effort()
{
    data = NextNBits(8);
    select {
      data == 0   : AddCell("Retransmission_Effort", "No ReTX" , "0 - No retransmissions",  HCIcommandColor);
      data == 1   : AddCell("Retransmission_Effort", "optimize power" , "1 - At least one retransmission, optimize for power consumption.",  HCIcommandColor);
      data == 2   : AddCell("Retransmission_Effort", "link quality" , "2 - At least one retransmission, optimize for link quality.",  HCIcommandColor);
      data == 0xFF: AddCell("Retransmission_Effort", "Don't care."  , "0xFF - Don't care.",  HCIcommandColor);
      default     : AddCell("Retransmission_Effort", Format("0x%02X", data) , "Reserved value",  HCIcommandColor, _ERROR);
    };
}

