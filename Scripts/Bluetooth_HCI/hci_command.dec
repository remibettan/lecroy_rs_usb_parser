set Filter_TypeTable = 
[
  [0xFF , "Reserved"            , "" ],
  [0x00 , "Clear All Filters"   , "" ],
  [0x01 , "Inquiry Result"      , "ShowInquiry_Result_Filter_Condition_Type"   ],
  [0x02 , "Connection Setup"    , "ShowConnection_Setup_Filter_Condition_Type" ]
];


Set_Event_Filter()
{
  data = NextNBits(8);
  _row = Find(Filter_TypeTable, data);
  AddCell("Filter_Type",  _row[1], Format("0x%02X - ", data) + _row[1], HCIcommandColor);

  Call ( _row[2] );
}

