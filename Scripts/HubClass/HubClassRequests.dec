#*******************************************************************************
# GET_STATUS    : This request returns the current hub status and the states 
#                 that have changed since the previous acknowledgement
# bmRequestType : 0xA0
# bRequest      : 0x00
# wValue        : 0x0000
# wIndex        : 0x0000
# wLength       : 0x04
# Data          : Hub Status and Change Indicators
#*******************************************************************************
GET_STATUS()
{
#    if( in.DataLength < 12 )
#    {
#        if( !AddSpecPLCellMonoNoDlg("Error", "Short Payload", Format( "Expecting 12 bytes, found %d.", in.DataLength ), __ERROR ) )
#            AddErrorMonoCell( "Error", "Short Payload", Format( "Expecting 12 bytes, found %d.", in.DataLength ) );      #[found in CATCScriptAPI.inc]
#
#        ErrorFlag = 1;
#        out.Decoded = 8;
#        return 0;
#    }

    wHubStatusBits        = GetDataWord(8);
    wHubStatusChangeBits  = GetDataWord(10);
    status = "x";
    change = "y";        
    status = ToBitString(wHubStatusBits, 16);
    change = ToBitString(wHubStatusChangeBits, 16);
        
    if (bReqType == 0xA0)
    {
        AddHubbmRequestType();

        
        if (wIndex == 0)
        {
            #AddCell("wIndex",   Format("0 (Hub Status)"),   "Hub Status Bitmap",  wIndexColor);
                AddWIndexCell( Format("0 (Hub Status)"),   "Hub Status Bitmap");
        }
        else
        {
           # AddCell("wIndex",   Format("Invalid wIndex: 0x%04X", wIndex),   "Expected 0 only",  ErrorColor);       
            AddWIndexCell(   Format("Invalid wIndex: 0x%04X", wIndex),   "Expected 0 only", 1);       
        }

        AddHubwLength( 4 );

        SetFieldOffsetLen( 80, 16 );
        AddPayLoadCell("Hub Status Bits",   status,
            ToBitDecode(HubStatusBitmapTable, wHubStatusBits, "", "Hub Status bits (Bytes 0-1):\n"),
            wDecodeCellColor);
        RestoreFieldOffsetLen();

        SetFieldOffsetLen( 96,16 );
        AddPayLoadCell("Hub Change Bits",   change,  ToBitDecode(HubChangeBitmapTable, wHubStatusChangeBits, "", "Hub Change bits (Bytes 2-3):\n"),
          wDecodeCellColor);

        out.Decoded += 2;  # in case wLength > 4
    }
    else if (bReqType == 0xA3)
    {
        AddWIndexCell(   Format("For Port # %i", wIndex),   "Hub Port Number for this Request",  wIndexColor); 
        
        if ( tempSpeedFlag != Super_Speed_Mode )
        {
            # Hi Speed or lower
            SetFieldOffsetLen( 64+16, 16 );
            AddPayLoadCell("Port Status Bits",   status,
                ToBitDecode(PortStatusBitmapTable, wHubStatusBits, "", "Port Status bits (Bytes 0-1):\n"),  wDecodeCellColor);       
          SetFieldOffsetLen( 64+32, 16 );      
            AddPayLoadCell("Port Change Bits",   change,
                ToBitDecode(PortChangeBitmapTable, wHubStatusChangeBits, "", "Port Change bits (Bytes 2-3):\n"),
                wDecodeCellColor);        
        }  
        else
        {
            if ((wValue & 0xFF) == 0 || (wValue & 0xFF) == 2) # PORT_STATUS, EXT_PORT_STATUS
            {
                str = StartTable("Port Status bits (Bytes 0-1):\n");
                str = ToBitDecodeByIndex(str, PortStatusBitmapTable_USB3, 0,3,wHubStatusBits, "", "");
                str = ToBitsDecodeStringValue(str, PortStatusBitmapTable_USB3, 4,4, wHubStatusBits, "Bits 5-8", PortLinkState);
                str = ToBitDecodeByIndex(str, PortStatusBitmapTable_USB3, 5,5,wHubStatusBits, "", "");
                str = ToBitsDecode      (str, PortStatusBitmapTable_USB3, 6,3, wHubStatusBits, "Bits 10-12", "");
                str = ToBitDecodeByIndex(str, PortStatusBitmapTable_USB3, 7,7,wHubStatusBits, "", "");
                str = EndTable(str);        
            
                SetFieldOffsetLen( 64 + 16, 16 );          
                AddPayLoadCell("Port Status Bits",   status, str, wDecodeCellColor);
                port_state_value =  (wHubStatusBits >> 5) & 0xF;
                port_state_value_string = Format( "%s", PortLinkState[port_state_value][1] ); 
                
                # Add extra cell to trace view, since this is an important value.    
                AddCell("PORT_LINK_STATE",  port_state_value_string , Format( "Bits 5-8 of Port Status Bits: %x", port_state_value), wDecodeCellColor);       
             
                SetFieldOffsetLen( 64+32 , 16 );      
                AddPayLoadCell("Port Change Bits",   change,
                    ToBitDecode(PortChangeBitmapTable_USB3, wHubStatusChangeBits, "", "Port Change bits (Bytes 2-3):\n"),
                    wDecodeCellColor);  
					
				if((wValue & 0xFF) == 2) # EXT_PORT_STATUS
				{
					dwHubExtendedStatusBits        	= GetDataLong(12);					
					
					extended_status = Format("0x%08x", dwHubExtendedStatusBits);
										
					
					str = StartTable("Extended Port Status Bits:\n");					
					
					rx_speed_id =  dwHubExtendedStatusBits & 0x000F;													
					rx_speed_str = Format( "%d", rx_speed_id);
					AddTableRow(str, "Rx Sublink Speed ID", 0, 3, rx_speed_str);                
					
					tx_speed_id =  (dwHubExtendedStatusBits >> 4) & 0x000F;													
					tx_speed_str = Format( "%d", tx_speed_id);
					AddTableRow(str, "Tx Sublink Speed ID", 4, 7, tx_speed_str);                
					
					rx_lane_count =  ((dwHubExtendedStatusBits >> 8) & 0x000F) + 1;
					rx_lane_count_str = Format( "%d", rx_lane_count);
					AddTableRow(str, "Rx Lane Count", 8, 11, rx_lane_count_str);
					
					tx_lane_count =  ((dwHubExtendedStatusBits >> 12) & 0x000F) + 1;
					tx_lane_count_str = Format( "%d", tx_lane_count);
					AddTableRow(str, "Tx Lane Count", 12, 15, tx_lane_count_str);
					
					extended_status_rsvd =  ((dwHubExtendedStatusBits >> 16) & 0xFFFF);
					extended_status_rsvd_str = Format( "0x%04x", extended_status_rsvd);
					AddTableRow(str, "Reserved", 15, 31, extended_status_rsvd_str);
					
					str = EndTable(str);        
            
			
					SetFieldOffsetLen( 64 + 48, 32 );          
					AddPayLoadCell("Extended Port Status", extended_status, str, wDecodeCellColor);										
				}
            }
            else if ((wValue & 0xFF) == 1) # PD_STATUS
            {
                PD_GET_STATUS();
                return 0;
            }
            else if ((wValue & 0xFF) == 2) # EXT_PORT_STATUS
            {
            }
                      
         }      
         out.Decoded += 2;  # in case wLength > 4   
    }
    else
    {
        AddPayLoadCell("Invalid bReqType value",   Format("0x%02X", bReqType),   "Expected 0xA0 or 0xA3 only",  ErrorColor);        
    }  
}

GET_STATUS_Text()
{
    wHubStatusBits        = GetDataWord(8);
    wHubStatusChangeBits  = GetDataWord(10);
    status = ToBitString(wHubStatusBits, 16);
    change = ToBitString(wHubStatusChangeBits, 16);
    temp_str = "GET_STATUS";
    temp_str += NewLine();

    if (bReqType == 0xA0)
    {
        if (wIndex == 0)
        {
            tmp_str1 = ("Hub Status Bitmap") + NewLine();
        }
        else
        {
            tmp_str1 = Format("Invalid wIndex: 0x%04X", wIndex);       
            tmp_str1 += NewLine();
        }
            
        temp_str2 = Format ("Hub Status Bits  %s",   status);
        temp_str2 = temp_str2 + NewLine();       
        temp_str2 = temp_str2 + NewLine();       
        temp_str3 = ToBitDecode(HubStatusBitmapTable, wHubStatusBits, "");        
        temp_str3 = temp_str3 + NewLine();       
        temp_str4 = Format ("Hub Change Bits  %s",   change); 
        temp_str4 = temp_str4 + NewLine();       
        temp_str5 = ToBitDecode(HubChangeBitmapTable, wHubStatusChangeBits, ""); 
        temp_str5 = temp_str5 + NewLine();       
        temp_str = temp_str + temp_str1;       
        temp_str = temp_str + temp_str2;       
        temp_str = temp_str + temp_str3;       
        temp_str = temp_str + temp_str4;       
        temp_str = temp_str + temp_str5;       
    }
    else if (bReqType == 0xA3)
    {
        temp_str1 = Format("For Port # %i", wIndex); 
        temp_str1 = temp_str1 + NewLine();       
        temp_str1 = temp_str1 + NewLine();       
        temp_str2 = Format ("Port Status Bits  %s",   status);
        temp_str2 = temp_str2 + NewLine();       
        
        if ( tempSpeedFlag != Super_Speed_Mode )
            temp_str3 = ToBitDecode(PortStatusBitmapTable, wHubStatusBits, "");        
        else
            temp_str3 = ToBitDecode(PortStatusBitmapTable_USB3, wHubStatusBits, "");                
        
        temp_str3 = temp_str3 + NewLine();       
        temp_str4 = Format ("Port Change Bits  %s",   change); 
        temp_str4 = temp_str4 + NewLine();       
        
        if ( tempSpeedFlag != Super_Speed_Mode )
            temp_str5 = ToBitDecode(PortChangeBitmapTable, wHubStatusChangeBits, ""); 
        else
            temp_str5 = ToBitDecode(PortChangeBitmapTable_USB3, wHubStatusChangeBits, "");     
            
        temp_str5 = temp_str5 + NewLine();       
        temp_str = temp_str + temp_str1;       
        temp_str = temp_str + temp_str2;       
        temp_str = temp_str + temp_str3;       
        temp_str = temp_str + temp_str4;       
        temp_str = temp_str + temp_str5;       
    }
    else
    {
        tmp_str = ( Format("Invalid bReqType value: 0x%02X", bReqType));        
    } 
    return (temp_str); 
}


