#                       USBTracer specific caption cell                            #
####################################################################################

AddSpecCaptionCell(caption, text, tooltip, FieldColor, addparam, addparam1, addparam2 )
{
    AddCell(caption, text, tooltip, FieldColor, _USBBULK_HEADER, addparam, addparam1, addparam2 );
    return 1;
}

DecodeDescriptorsToText_USB3()
{
    #InitText();

    if( in.DataLength < 17 )    # Checking for Short Payload
    {
        if (!AddSpecPLCellMonoNoDlg("Error", "Short Payload", "Descriptor is not being decoded", __ERROR))
            AddErrorMonoCell("Error", "Short Payload", "Descriptor is not being decoded");      #[found in CATCScriptAPI.inc]

        ErrorFlag = 1;
        out.Decoded = 8;
        return "Short Payload, Descriptor not decoded.";
    }
        
    SaveOffset();  
    InitText();
   
    Global_BitField_offset = REQ_DATA_OFFSET;
    CurrentFldInit();

    EntryBaseOffset    = 0;
    EntryFieldGroupLen = 0;
   
    base  = Base;
    bLength             = GetDataByte(8);
    bDescriptorType     = GetDataByte(9);  
    bNbrPorts           = GetDataByte(10);
    wHubCharacteristics = GetDataWord(11);
    bPwrOn2PwrGood      = GetDataByte(13);
    bHubContrCurrent    = GetDataByte(14);
    bHubHdrDecLat       = GetDataByte(15);
    wHubDelay           = GetDataWord(16);
    #DeviceRemovable     = GetDataByte(18);
    if (bNbrPorts > 7)
    {
       DeviceRemovable     = GetDataWord(18);
    }
    else
    {
        DeviceRemovable     = GetDataByte(18);
    }
   

 
    if( tempSpeedFlag != Super_Speed_Mode  )
    {
        if (bNbrPorts > 7)
        {
            PortPwrCtrlMask   = GetDataByte(20);
            PortPwrCtrlMask_2 = GetDataByte(21);
        }
        else
        {
            PortPwrCtrlMask     = GetDataByte(19);
        }
    }

    str  = "";
    
    if  ((bDescriptorType == 0x2A) && ( tempSpeedFlag == Super_Speed_Mode  )) 
    {
         AddDataHeader("HUB Descriptor", bLength);
    }
    else
    {
        str = OutputType;
        str += NewLine();
        str +=  "--> UNKNOWN DESCRIPTOR TYPE: ";
        str +=  Format("0x%02X", bDescriptorType);
        AddDataHeader(str, bLength);
    }
    

    
    AddEntry( 0, "bLength", bLength, 2, "", 1);
    AddDescriptorSizeString(bLength );
    AddFieldBreak();
    
    AddEntry( 1, "bDescriptorType", bDescriptorType, 2, GetDescriptorTypeString("HUB"), 0);
    AddFieldBreak();
    
    str = Format ("The hub has %d", bNbrPorts);
    AddEntry( 2, "bNbrPorts", bNbrPorts, 2, str, 0 );
    AddDescriptionOnly( "downstream ports" );
    if( bNbrPorts > 15 )
        AddDescriptionOnly( "(Error : The maximum number of ports a hub can support is 15.)" );
    AddFieldBreak();
    
    AddHubChars(wHubCharacteristics);

    AddEntry( 5, "bPwrOn2PwrGood", bPwrOn2PwrGood, 2, "Time from start of", 0);
    AddDescriptionOnly( "the power-on sequence" );
    AddDescriptionOnly( "until power is good" );
    AddDescriptionOnly(Format ("is %d ms", bPwrOn2PwrGood*2));
    AddFieldBreak();        
       
    AddEntry( 6, "bHubContrCurrent", bHubContrCurrent, 2, "Max current reqired", 0);
    AddDescriptionOnly( "by Hub Controller");
    if ( tempSpeedFlag == Super_Speed_Mode )
        AddDescriptionOnly( Format ("is %d * aCurrentUnit ma", bHubContrCurrent));
    else
        AddDescriptionOnly( Format ("is %d ma", bHubContrCurrent*8));
    
    
    AddFieldBreak();        

    
    AddEntry( 7, "bHubHdrDecLat", bHubHdrDecLat, 2, "Worst case latency", 0);
    if (bHubHdrDecLat == 0)
         AddDescriptionOnly( "<br>is Much less than 0.1 micro seconds" );
    if ((bHubHdrDecLat > 0) && (bHubHdrDecLat <5))
        AddDescriptionOnly( Format ("<br> is 0.%d micro seconds", bHubHdrDecLat));
    if (bHubHdrDecLat > 4)
         AddDescriptionOnly( "<br> Reserved or not accaptable value " );
       AddFieldBreak(); 
      
      
      AddEntry( 8, "wHubDelay", wHubDelay, 4, "delay in nano seconds ", 0);
      AddDescriptionOnly( Format ("<br> is %d nano seconds", wHubDelay));
      AddFieldBreak();
       
    str = "0 --> Removable , 1 --> Not Removable <br>";
    for (i=1; i<=bNbrPorts; i++)
    { 
         value = DeviceRemovable >> i;
 
        if (value & 0x1)
        {
            str += Format("<br>Port %d : Not Removable",i);
        }
        else
        {
            str += Format("<br>Port %d : Removable",i);
        }
    }
    if ( bNbrPorts < 7)
    { 
        AddEntry( 10, "DeviceRemovable", DeviceRemovable, 2, "Device Removable:", 0);
        AddDescriptionOnly( str );
        AddFieldBreak(); 
    }
    else
    {
        AddEntry( 10, "DeviceRemovable", DeviceRemovable , 4, "Device Removable:", 0);
        AddDescriptionOnly( str );
        AddFieldBreak(); 
    }
      
    SetFieldOffsetLen( B_offset, GetBitOffset() - B_offset );
    return GetFinalText();
    
}
