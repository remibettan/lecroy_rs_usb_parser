#----  Input
# in.Data       - Data_block to decode
# in.DataLength - Length of Data_block 
#
#----  Output
# out.Decoded   - amount of data has been decoded
#


const Tabular_Def_Table = Map( 
[   
    #-----------------------------------------------------------------------------------------------------
    #       id            ,      colId                          ,       containerCellId
    #-----------------------------------------------------------------------------------------------------
    [ CELL_REQUEST        , TABULAR_SCRIPT_COLUMN_ID_SUBTYPE   , TABULAR_SCRIPT_CONTAINER_CELL_ID_NONE ],
    [ CELL_WVALUE         , TABULAR_SCRIPT_COLUMN_ID_NONE      , TABULAR_SCRIPT_CONTAINER_CELL_ID_MISC ]
    
] );

set ModuleType      = "DataBlock Decoder";
set OutputType      = "Hub Class Requests";
set UsbDecodeType   = "Request";
set UsbReqType      = "Class";
set UsbClassCode    = 0x9;
set UsbScriptDecodeType = 1; # explicit text decoding processing

#
# Parsing entry point
#



# User can select the colors for the fields he chooses
set wDecodeCellColor    = 0x494949; 


const ErrorColor = 0x0000FF;

set ErrorFlag = 0;

set bReqType = 0;
set bRequest = 0;
set wValue   = 0;
set wIndex   = 0;
set wLength  = 0;
set bLength             = 0;
set bDescriptorType     = 0;


set IsUsb2Hub = 1; # default value

ProcessData()
{
 
    ProcessDataInit();
    
    Speed        = GetDecoderHeaderByte(2);
    tempSpeedFlag = Speed; # Gets Speed value from in.context[2]
	if(tempSpeedFlag == Super_Speed_Plus_Mode || tempSpeedFlag == SSIC_HS_Mode) 
		tempSpeedFlag = Super_Speed_Mode;
    #UsbSpecLevel = GetDecoderHeaderByte(?);
    out.Decoded = 0;

    ErrorFlag = 0;
    EntryBaseOffset    = 0;
    EntryFieldGroupLen = 0;

    if (in.DataLength < 8)      # Checking for Illegal Payload
    {
        if (!AddSpecPLCellMonoNoDlg("Error", "Illegal Payload", "Nothing is being decoded", __ERROR))
            AddErrorMonoCell("Error", "Illegal Payload", "Nothing is being decoded");      #[found in CATCScriptAPI.inc]
        return Complete();
    }

    out.Decoded = 0;    
    
    bReqType = GetDataByte(0);
    bRequest = GetDataByte(1);
    wValue   = GetDataWord(2);
    wIndex   = GetDataWord(4);
    wLength  = GetDataWord(6);
    
    if( tempSpeedFlag != Super_Speed_Mode )
        _row = Find(HubRequestTable, bRequest);
    else
        _row = Find(HubRequestTable_USB3, bRequest);    
    
    AddSeparator();
    
    AddRequestCell( _row[1] );
   # AddPayLoadCell("bRequest", _row[1], Format("0x%04X - ", bRequest) + _row[2], bRequestColor);
    
# for debugging...
#    AddCell("bReqType", Format("0x%02X", bReqType), "",  bRequestColor);
#    AddCell("wValue",   Format("0x%04X", wValue),   "",  wValueColor);
#    AddCell("wIndex",   Format("%d", wIndex),   "",  wIndexColor);
#    AddCell("wLength",  Format("%d", wLength),  "",  wLengthColor);

    if ( _row != null)
    {

        Call ( _row[1], [ in.DataLength ] );
        out.Decoded = in.DataLength+8;
    }
    else
    {
        AddPayLoadCell("bReqType", Format("0x%02X", bReqType), "",  bRequestColor);
        AddWValueCell(   Format("0x%04X", wValue),   "");
        AddWIndexCell(   Format("%d", wIndex),   "");
        AddWLengthCell( Format("%d", wLength),  "");
        out.Decoded = 8;
    }

    AddSeparator();

############ for Debug purposes
#    GetNBits(in.Data, 0, 0);
#    ShowDataBlock(in.DataLength);
############

   return Complete();
}


