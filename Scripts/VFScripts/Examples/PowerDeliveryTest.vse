AddRequestPDO()
{
    report_str = "";
    
    if ( in.DataObjectCount >= 1 )
    {
        report_str += FormatEx( "\n\t*** Data Object 1 out of %d ***\n", in.DataObjectCount );        
        report_str += DecodeRequestPacketData();

        if ( in.DataObjectCount >= 2 )
        {
            report_str += DecodeUndefinedDataObjects();
        }       
    }
    
    return report_str;
}

DecodeRequestPacketData()
{
    report_str = "";
    field_name = "";
    field_prefix =  "OBJ1_";
    
    if(in.OBJ1_Give_Back)
    {
        field_name = field_prefix + "MinOprCurPow";
        report_str += FormatEx( FormatString_IntValue, field_name, in.OBJ1_MinOprCurPow); 
    }
    else
    {
        field_name = field_prefix + "MaxOprCurPow";
        report_str += FormatEx( FormatString_IntValue, field_name, in.OBJ1_MaxOprCurPow); 
    }    
    
    field_name = field_prefix + "OprCurPow";
    report_str += FormatEx( FormatString_IntValue, field_name, in.OBJ1_OprCurPow); 
        
    ######################################################################################
    #Here is how to use decoder and context methods to retrieve a field's value
    field_name = "Rsvd_1";
    report_str += GetDecodedField(0, field_name); 
    
    field_name = "in." + field_prefix + "Rsvd_1";
    report_str += FormatEx( FormatString_IntValue, field_name, in.OBJ1_Rsvd_1); 
    ######################################################################################
    
    if( in.Spec_Rev >= _PD_SPEC_REV_3 )
    {
        field_name = field_prefix + "Unchunked_Ext";
        report_str += FormatEx( FormatString_IntValue, field_name, in.OBJ1_Unchunked_Ext); 
    }
    
    field_name = field_prefix + "No_USB_Suspend";
    report_str += FormatEx( FormatString_IntValue, field_name, in.OBJ1_No_USB_Suspend); 
    
    field_name = field_prefix + "USB_Com_cap";
    report_str += FormatEx( FormatString_IntValue, field_name, in.OBJ1_USB_Com_cap); 
    
    ######################################################################################
    #Here is how to use decoder and context methods to retrieve a field's value
    field_name = "Cap_Mismatch";
    report_str += GetDecodedField(0, field_name); 
    
    field_name = "in." + field_prefix + "Cap_Mismatch";
    report_str += FormatEx( FormatString_IntValue, field_name, in.OBJ1_Cap_Mismatch); 
    ######################################################################################
    
    field_name = field_prefix + "OBJ1_Give_Back";
    report_str += FormatEx( FormatString_IntValue, field_name, in.OBJ1_Give_Back); 
    
    field_name = field_prefix + "Obj_Pos";
    report_str += FormatEx( FormatString_IntValue, field_name, in.OBJ1_Obj_Pos); 
    
    field_name = field_prefix + "Rsvd_2";
    report_str += FormatEx( FormatString_IntValue, field_name, in.OBJ1_Rsvd_2); 

    return report_str;
}

AddBISTPDO()
{
    report_str = "";
    
    if ( in.DataObjectCount >= 1 )
    {        
        report_str += FormatEx( "\n\t*** %d Data Objects ***\n", in.DataObjectCount );

        if(in.BISTFunction == _PD_BIST_REQ_TYPE_RETURNED_BIST_COUNTERS)
            report_str += DecodeBISTReturnedCounterPacketData();
        else
            report_str += DecodeBISTPacketData();

        if(in.BISTFunction == _PD_BIST_REQ_TYPE_TEST_DATA)
            report_str += DecodeBISTTestData();
        if ( in.DataObjectCount >= 2 )
            report_str += DecodeUndefinedDataObjects();
    }
    
    return report_str;
}

DecodeBISTReturnedCounterPacketData()
{
    return AddFields(NO_DATA_OBJECT, "BISTReturnedCounterPacketData");
}

DecodeBISTPacketData()
{
    return AddFields(NO_DATA_OBJECT, "BISTPacketData");
}

DecodeBISTTestData()
{
    report_str = "";
    data_stream = "";

    val = GetHexPktField("Data");
    for (byte_index = 0; byte_index < 24; byte_index++)
    {
        result = GetNBits(val, byte_index * 8, 8);
        data_stream += FormatEx( "%X ", result );
    }
    
    report_str += FormatEx( FormatString_StringValue, "Data", data_stream );
    
    data_stream = "";
    for (byte_index = 0; byte_index < 24; byte_index++)
    {
        result = GetNBits(in.Data, byte_index * 8, 8);
        data_stream += FormatEx( "%X ", result );
    }
    report_str += FormatEx( FormatString_StringValue, "Data via Context", data_stream );

    return report_str;
}

DecodeBISTTestStream()
{
    report_str = "";
    
    report_str += FormatEx( FormatString_IntValue, "in.Mode", in.Mode );
    report_str += FormatEx( "\t%-20s \t\t= %d bits\n", "in.Length", in.Length );        

    if(in.CorruptedDataLen > 0)
    {
        report_str += FormatEx( FormatString_IntValue, "in.CorruptedDataLen", in.CorruptedDataLen );
        
        data_stream = "";
        for (byte_index = 0; byte_index < in.CorruptedDataLen; byte_index++)
        {
            result = GetNBits(in.Corrupted_Bits, byte_index * 8, 8);
            data_stream += FormatEx( "0x%X ", result );
        }
        report_str += FormatEx( FormatString_StringValue, "Corrupted Bits", data_stream );
        
        data_stream = "0b";
        for (bit_index = 0; bit_index < in.CorruptedDataLen * 8; bit_index++)
        {
            result = GetNBits(in.Corrupted_Bits, bit_index, 1);
            data_stream += FormatEx( "%u", result );
        }
        report_str += FormatEx( FormatString_StringValue, "Corrupted Bits", data_stream );
    }

    return report_str;
}

AddVendorDefPDOs()
{   
    report_str = "";
    data_object_str = "";
  
    if(in.IsStructuredVDM)
    {
        for (obj_num = 0; obj_num < in.DataObjectCount; obj_num++)
        {
            data_object_str += FormatEx( "\n\t*** Data Object %d out of %d ***\n", obj_num + 1, in.DataObjectCount );
            
            all_remaining_data_decoded = FALSE;
            pd_undefined_data_obj = FALSE;
            
            if ( obj_num == 0 )
            {
                data_object_str += DecodeVendorDefVDMHeaderPacketData();
            }
            else
            {
                if ( in.VDMCommandType == _PD_VDM_CMD_TYPE_INIT )
                {
                    if ( in.VDMCommand == _PD_VDM_CMD_ATTENTION )
                    {                       
                        if ( in.VDMVendorID == _PD_SID_DISPLAY_PORT && obj_num == 1 )                    
                        {
                            data_object_str += DecodeVendorDefDPStatusVDO(obj_num);
                        }
                        else
                        {
                            data_object_str += DecodeVendorDefUnstructuredDataObjects(obj_num);
                            all_remaining_data_decoded = TRUE;
                        }
                    }
                    else if ( _PD_VDM_CMD_SVID_SPECIFIC_FIRST___ <= in.VDMCommand && in.VDMCommand <= _PD_VDM_CMD_SVID_SPECIFIC_LAST___ )
                    {
                        if ( in.VDMVendorID == _PD_SID_DISPLAY_PORT && 
                            in.VDMCommand == _PD_VDM_CMD_SVID_SPECIFIC_DP_CONFIGURE )
                        {
                            data_object_str += DecodeVendorDefDPConfigureVDO(obj_num);
                        }
                        else if ( in.VDMVendorID == _PD_SID_DISPLAY_PORT &&
                            in.VDMCommand == _PD_VDM_CMD_SVID_SPECIFIC_DP_STATUS )
                        {
                            data_object_str += DecodeVendorDefDPStatusVDO(obj_num);
                        }
                        else
                        {
                            data_object_str += DecodeVendorDefUnstructuredDataObjects(obj_num);
                            all_remaining_data_decoded = true;
                        }
                    }
                }
                else
                {
                    if(in.VDMCommand == _PD_VDM_CMD_DISCOVER_IDENTITY)                            
                    {
                            if(obj_num == 1) 
                                data_object_str += DecodeVendorDefDiscoverIDResponseIdHeaderVDO(obj_num);
                            if(obj_num == 2)
                                data_object_str += DecodeVendorDefDiscoverIDResponseCertStateVDO(obj_num);
                            if(obj_num == 3)
                                data_object_str += DecodeVendorDefDiscoverIDResponseProductVDO(obj_num);
                            if(obj_num == 4 || obj_num == 5 || obj_num == 6)
                            {
                                if(in.VDMProductType == _PD_VDM_PRODUCT_TYPE_PASSIVE_CABLE)
                                    data_object_str += DecodeVendorDefDiscoverIDResponsePassiveCableVDO(obj_num);
                                else if(in.VDMProductType == _PD_VDM_PRODUCT_TYPE_ACTIVE_CABLE)
                                    data_object_str += DecodeVendorDefDiscoverIDResponseActiveCableVDO(obj_num);
                                else if(in.VDMProductType == _PD_VDM_PRODUCT_TYPE_ALTERNATE_MODE_ADAPTER)
                                    data_object_str += DecodeVendorDefDiscoverIDResponseAlternateModeVDO(obj_num);
                                else
                                {
                                    pd_undefined_data_obj = TRUE;
                                }
                            }
                    }
                    else if(in.VDMCommand == _PD_VDM_CMD_DISCOVER_SVIDS)
                    {
                        if(in.DataObjectCount > 1)
                        {
                            report_str = "";     
                            
                            report_str += FormatEx("\t%-20s \t\t= 0x%s\n", "in.SVID_0", in.SVID_0);
                            report_str += FormatEx("\t%-20s \t\t= 0x%s\n", "in.SVID_1", in.SVID_1);
                            
                            if(in.DataObjectCount > 2)
                            {
                                report_str += FormatEx("\t%-20s \t\t= 0x%s\n", "in.SVID_2", in.SVID_2);
                                report_str += FormatEx("\t%-20s \t\t= 0x%s\n", "in.SVID_3", in.SVID_3);
                            }
                            
                            ReportText ( report_str );
                        }
                        
                        data_object_str += DecodeVendorDefDiscoverSVIDsResponseVDO(obj_num);
                        all_remaining_data_decoded = TRUE;
                    }
                    else if(in.VDMCommand == _PD_VDM_CMD_DISCOVER_MODES)
                    {    
                        if ( in.VDMVendorID == _PD_SID_DISPLAY_PORT )
                        {
                            data_object_str += DecodeVendorDefDiscoverModesDPCapabilityResponseVDO(obj_num);
                        }
                        else
                        {
                            data_object_str += DecodeVendorDefDiscoverModesResponseVDO(obj_num);
                            all_remaining_data_decoded = TRUE;
                        }
                    }
                    else if(in.VDMCommand == _PD_VDM_CMD_ENTER_MODE || in.VDMCommand == _PD_VDM_CMD_EXIT_MODE || in.VDMCommand == _PD_VDM_CMD_ATTENTION)
                    {
                        all_remaining_data_decoded = TRUE;
                        pd_undefined_data_obj = TRUE;
                    }
                    else if(in.VDMCommand == _PD_VDM_CMD_SVID_SPECIFIC_DP_STATUS)
                    {
                        if ( in.VDMVendorID == _PD_SID_DISPLAY_PORT && obj_num == 1 )
                        {
                            data_object_str += DecodeVendorDefDPStatusVDO(obj_num);
                        }
                        else
                        {
                            data_object_str += DecodeVendorDefUnstructuredDataObjects(obj_num);
                            all_remaining_data_decoded = TRUE;
                        }
                    }
                    else if(in.VDMCommand >= _PD_VDM_CMD_SVID_SPECIFIC_1 && in.VDMCommand <= _PD_VDM_CMD_SVID_SPECIFIC_15)
                    {
                        data_object_str += DecodeVendorDefUnstructuredDataObjects(obj_num);
                        all_remaining_data_decoded = TRUE;
                    }
                    else
                        pd_undefined_data_obj = TRUE;
                }
            }
           
            if(pd_undefined_data_obj == TRUE)
            {
                all_remaining_data_decoded = TRUE;
                data_object_str += DecodeUndefinedDataObjects();
            }

            if ( all_remaining_data_decoded == TRUE )
            {
                #This is to break the loop
                obj_num = in.DataObjectCount;
            }
        }
    }
    else
    {
        if ( in.DataObjectCount >= 1 )
        {
            data_object_str += FormatEx( "\n\t*** Data Object %d out of %d ***\n", 1, in.DataObjectCount );
            data_object_str += DecodeVendorDefVDMHeaderPacketData();

            if( in.DataObjectCount >= 2 )
            {
                data_object_str += FormatEx( "\n\t*** Data Object %d out of %d ***\n", 2, in.DataObjectCount );
                data_object_str += DecodeVendorDefUnstructuredDataObjects(1);
            }
        }
    }
    
    report_str = data_object_str;
    
    return report_str;
}

