# It is a main script function called by the application when the script completed   #
# running. Specify in this function some resetting procedures for a successive run   #
# of this script.                                                                    #
#                                                                                    #
######################################################################################
#
OnFinishScript()
{
    return 0;
}

###########################################################
# finds a string in the table by a key value -
# if the key is not found the first string is returned
###########################################################
Find(table, table_key)
{
    if( IsMap( table ) )
    {
        item = table[table_key];

        if( item == null ) item = table[0xFFFFFFFF];  # Legacy script support - when first list item was returned if key isn't found.
        if( item == null ) item = table[0xFFFF];      # Legacy script support - when first list item was returned if key isn't found.
        if( item == null ) item = table[0xFF];        # Legacy script support - when first list item was returned if key isn't found.

        return item;
    }


    if( IsList( table ) )
    {
        not_found = table[0];

        for( item = first( table ); more( table ); item = next( table ) )
        {
           if( head( item ) == table_key ) return item;
        }

        return not_found;
    }

    if( IsArray( table ) )
    {
        not_found = table[0];

        for( i = 0; i < sizeof( table ); i++ )
        {
            item = table[i];
            if( head( item ) == table_key ) return item;
        }

        return not_found;
    }

    return not_found;
}

GetDecodedField(data_object_index, field_name, just_field_value)
{
    report_str = "";
    
    if(data_object_index != NO_DATA_OBJECT)
    {
        field_prefix = FormatEx( "OBJ%d_", data_object_index + 1 );
        field_name = field_prefix + field_name;
    }
        
    if(just_field_value == null)
        report_str = FormatEx( FormatString_StringValue, field_name, GetDecodedPktField(field_name) ); 
    else
        report_str = GetDecodedPktField(field_name); 
        
    return report_str;
}

AddFields(data_object_index, data_object_id)
{
    _row = Find(PowerDeliveryFieldNames, data_object_id);
    
    ReportText ( text_message );
    
    return DecodeDataObject(data_object_index, _row[1]);
}

DecodeDataObject(data_object_index, FieldsArray)
{
    report_str = "";
    
    i = 0;
    while (i < sizeof(FieldsArray))
    {
        field_name = FieldsArray[i];
        report_str += GetDecodedField(data_object_index, field_name);
        i++;
    }
    
    return report_str;
}

AddFieldsHexPkt(data_object_index, field_name)
{
    report_str = "";
    if(data_object_index != NO_DATA_OBJECT)
    {
        field_prefix = FormatEx( "OBJ%d_", data_object_index + 1 );
        field_name = field_prefix + field_name;
    }
        
    report_str += FormatEx( FormatString_IntValue, field_name, GetHexPktField(field_name) );
    return report_str;
}

GetPDMessageTypeDescr()
{
    pd_message_type = select
    {
        in.PacketType == _PD_CONTROL_GOOD_CRC          : "GoodCRC";
        in.PacketType == _PD_CONTROL_GOTO_MIN          : "GotoMin";
        in.PacketType == _PD_CONTROL_ACCEPT            : "Accept";
        in.PacketType == _PD_CONTROL_REJECT            : "Reject";
        in.PacketType == _PD_CONTROL_PING              : "Ping";
        in.PacketType == _PD_CONTROL_PS_RDY            : "PS Ready";
        in.PacketType == _PD_CONTROL_GET_SRC_CAP       : "Get SRC Cap";
        in.PacketType == _PD_CONTROL_GET_SINK_CAP      : "Get SNK Cap";
        in.PacketType == _PD_CONTROL_DR_SWAP           : "DR Swap";
        in.PacketType == _PD_CONTROL_PR_SWAP           : "PR Swap";
        in.PacketType == _PD_CONTROL_VCONN_SWAP        : "VConn Swap";
        in.PacketType == _PD_CONTROL_WAIT              : "Wait";
        in.PacketType == _PD_CONTROL_SOFT_RESET        : "Soft Reset";
        in.PacketType == _PD_CONTROL_NOT_SUPPORTED     : "Not Supported";
        in.PacketType == _PD_CONTROL_GET_SRC_CAP_EXTENDED: "Get Src Cap Extended";
        in.PacketType == _PD_CONTROL_GET_STATUS        : "Get Status";
        in.PacketType == _PD_CONTROL_FR_SWAP           : "FR Swap";
        in.PacketType == _PD_DATA_SRC_CAP              : "Source Cap";    
        in.PacketType == _PD_DATA_REQ                  : "Request";    
        in.PacketType == _PD_DATA_BIST                 : "BIST";    
        in.PacketType == _PD_DATA_SNK_CAP              : "Sink Cap";    
        in.PacketType == _PD_DATA_VENDOR_DEF           : "Vendor Defined";
        in.PacketType == _PD_DATA_BATTERY_STATUS       : "Battery Status";
        in.PacketType == _PD_DATA_ALERT                : "Alert";
        in.PacketType == _PD_EXTENDED_SRC_CAP_EXTENDED : "Src Cap Extended";
        in.PacketType == _PD_EXTENDED_STATUS           : "Status";
        in.PacketType == _PD_EXTENDED_GET_BATTERY_CAP  : "Get Battery Cap";
        in.PacketType == _PD_EXTENDED_GET_BATTERY_STATUS:"Get Battery Status";
        in.PacketType == _PD_EXTENDED_BATTERY_CAP      : "Battery Cap";
        in.PacketType == _PD_EXTENDED_GET_MANUFACTURER_INFO: "Get Manufacturer Info";
        in.PacketType == _PD_EXTENDED_MANUFACTURER_INFO: "Manufacturer Info";
        in.PacketType == _PD_EXTENDED_SECURITY_REQ     : "Security Req";
        in.PacketType == _PD_EXTENDED_SECURITY_RESP    : "Security Resp";
        in.PacketType == _PD_EXTENDED_FW_UPDATE_REQ    : "Firmware Update Req";
        in.PacketType == _PD_EXTENDED_FW_UPDATE_RESP   : "Firmware Update Resp";   
        in.PacketType == _PD_MSG_HARD_RESET            : "Hard Reset";
        in.PacketType == _PD_MSG_CABLE_RESET           : "Cable Reset";
        in.PacketType == _PD_MSG_BIST_TEST_DATA        : "BIST Bit Stream";
		in.PacketType == _PD_MSG_EVENT_FAST_POWER_ROLE_SWAP : "Power Role Swap Event";
        in.PacketType == _PD_MSG_UNKNOWN               : "Unknown Packet";
    };
    return pd_message_type;
}

DecodePDMessage()
{
    if(in.TraceEvent == _PD_PACKET)
    {        
        ReportText( FormatEx("\nTrace Event = %d, EventCount = %d, Packet# = %d, Message Size = %d bytes", in.TraceEvent, EventCount, in.Index, in.BufferLen) );
        report_str = "";
        report_str += DecodeSenderPort();            
        header_str = DecodeHeaderData();

        if( header_str != "" )
        {   
            report_str += header_str;            
            data_object_str = "";
            
            if( in.Spec_Rev < _PD_SPEC_REV_3 )
            {
                data_object_str = select
                {
                    in.PacketType == _PD_DATA_SRC_CAP     : AddCapabilityPDOs();
                    in.PacketType == _PD_DATA_SNK_CAP     : AddCapabilityPDOs();
                    in.PacketType == _PD_DATA_REQ         : AddRequestPDO();
                    in.PacketType == _PD_DATA_BIST        : AddBISTPDO();
                    in.PacketType == _PD_DATA_VENDOR_DEF  : AddVendorDefPDOs();
                    default                               : DecodeUndefinedDataObjects();
                };
            }
            else
            {
                data_object_str = select
                {
                    in.PacketType == _PD_DATA_SRC_CAP                   : AddCapabilityPDOs();
                    in.PacketType == _PD_DATA_SNK_CAP                   : AddCapabilityPDOs();
                    in.PacketType == _PD_DATA_REQ                       : AddRequestPDO();
                    in.PacketType == _PD_DATA_BIST                      : AddBISTPDO();
                    in.PacketType == _PD_DATA_VENDOR_DEF                : AddVendorDefPDOs();
                    in.PacketType == _PD_DATA_BATTERY_STATUS            : AddBatteryStatusPDO();
                    in.PacketType == _PD_DATA_ALERT                     : AddAlertPDO();
                    in.PacketType == _PD_EXTENDED_SRC_CAP_EXTENDED      : AddSourceCapExtendedData();
                    in.PacketType == _PD_EXTENDED_STATUS                : AddStatusData();
                    in.PacketType == _PD_EXTENDED_GET_BATTERY_CAP       : AddGetBatteryCapData();
                    in.PacketType == _PD_EXTENDED_GET_BATTERY_STATUS    : AddGetBatteryStatusData();
                    in.PacketType == _PD_EXTENDED_BATTERY_CAP           : AddBatteryCapData();
                    in.PacketType == _PD_EXTENDED_GET_MANUFACTURER_INFO : AddGetManufacturerInfoData();
                    in.PacketType == _PD_EXTENDED_MANUFACTURER_INFO     : AddManufacturerInfoData();
                    in.PacketType == _PD_EXTENDED_SECURITY_REQ          : AddSecurityReqData();
                    in.PacketType == _PD_EXTENDED_SECURITY_RESP         : AddSecurityRespData();
                    in.PacketType == _PD_EXTENDED_FW_UPDATE_REQ         : AddFirmwareUpdateReqData();
                    in.PacketType == _PD_EXTENDED_FW_UPDATE_RESP        : AddFirmwareUpdateRespData();
                    default                                             : DecodeUndefinedDataObjects();
                };
            }
       
            report_str += data_object_str;
        }
        else
        {
            pd_message_type_descr = GetPDMessageTypeDescr();
            report_str += FormatEx( "\t%-20s \t\t= %s(%d)\n", "Msg Type", pd_message_type_descr, in.PacketType ); 
            
            if(in.PacketType == _PD_MSG_BIST_TEST_DATA)
            {
                report_str += DecodeBISTTestStream();
            }
            
			if(in.PacketType == _PD_MSG_EVENT_FAST_POWER_ROLE_SWAP)
            {
                report_str += DecodePacketEvent();
            }
			
            if(in.PacketType == _PD_MSG_UNKNOWN)
            {
                report_str += DecodeUnknownPacket();
            }
        }
                       
        ReportText ( report_str );
        ReportText( "--------------------------------------------" );
        
        EventCount++;
    }
    else if (in.TraceEvent == _PD_EVENT)
    {        
        ReportText( FormatEx("\nTrace Event = %d, EventCount = %d, Packet# = %d", in.TraceEvent, EventCount, in.Index) );
        ReportText( "\t*** PD Event *** " );
        ReportText( FormatEx(FormatString_StringValue, "Event Type", EventNames[in.EventType]) );
        ReportText( "--------------------------------------------" );
        EventCount++;
    }
}

DecodeSenderPort()
{
    report_str = "";
    
    report_str += FormatEx( FormatString_IntValue, "SenderPort", in.SenderPort );
    
    return report_str;
}

DecodeHeaderData()
{
    report_str = "";
    
    if(in.PacketType >= _PD_MESSAGE_TYPE_START___ && in.PacketType <= _PD_MESSAGE_TYPE_END___)
    {
        report_str = FormatEx( "\n\t*** Message Header ***\n" );
        
        report_str += FormatEx( FormatString_IntValue, "SOP_Type", in.SOP_Type ); 
        
        report_str += FormatEx( FormatString_IntValue, "in.Msg_Type", in.Msg_Type );        
        
        ######################################################################################
        #Here is how to use GetHexPktField method to retrieve a field's value
        report_str += AddFieldsHexPkt(NO_DATA_OBJECT, "Msg_Type");
        ######################################################################################

        pd_message_type_descr = GetPDMessageTypeDescr();
        report_str += FormatEx( "\t%-20s \t\t= %s(%d)\n", "in.PacketType", pd_message_type_descr, in.PacketType ); 

        if(in.SOP_Type == _PD_FRAMING_SOP)
        {
            if( in.Spec_Rev < _PD_SPEC_REV_3 )
                report_str += FormatEx( FormatString_IntValue, "Rsvd 1", in.Rsvd_1 );
            report_str += FormatEx( FormatString_IntValue, "PortDataRole", in.DR );
        }
        else
        {
            report_str += FormatEx( FormatString_IntValue, "Rsvd 1", in.Rsvd_1 );
        }
                       
        report_str += FormatEx( FormatString_IntValue, "Spec Rev", in.Spec_Rev );
        
        if(in.SOP_Type == _PD_FRAMING_SOP)
        {
            report_str += FormatEx( FormatString_IntValue, "PortPowerRole", in.PR );
        }
        else
        {
            report_str += FormatEx( FormatString_IntValue, "Cable Plug", in.Cable_Plug );
        }
        
        report_str += FormatEx( FormatString_IntValue, "Msg ID", in.Msg_ID ); 
        report_str += FormatEx( FormatString_IntValue, "Obj Cnt", in.Obj_Cnt ); 
        
        if(in.Spec_Rev < _PD_SPEC_REV_3)
        {
            report_str += FormatEx( FormatString_IntValue, "Rsvd 2", in.Rsvd_2 );
        }
        else
        {
            report_str += FormatEx( FormatString_IntValue, "Extended", in.Extended );
            
            if( in.Extended == 1 )
            {
                report_str += FormatEx( FormatString_IntValue, "Data Size", in.Data_Size );
                report_str += FormatEx( FormatString_IntValue, "Rsvd 3", in.Rsvd_3 );
                report_str += FormatEx( FormatString_IntValue, "Request Chunk", in.Req_Chunk );
                report_str += FormatEx( FormatString_IntValue, "Chunk Number", in.Chunk_Num );
                report_str += FormatEx( FormatString_IntValue, "Chunked", in.Chunked );
            }
        }
    }
    
    return report_str;
}

AddCapabilityPDOs()
{
    report_str = "";
    
    for (i = 0; i < in.DataObjectCount; i++)
    {
        report_str += FormatEx( "\n\t*** Data Object %d out of %d ***\n", i + 1, in.DataObjectCount );
       
        data_object_str = "";
        
        supply_type = GetDecodedField(i, "Supply_Type", TRUE);        
     
        if( supply_type == PDCapPowerSupplyTypeString[_PD_CAP_PWR_FIXED] )
            data_object_str = DecodeCapFixedPowerSupplyData(i);
        else if( supply_type == PDCapPowerSupplyTypeString[_PD_CAP_PWR_BATTERY] )
            data_object_str = DecodeCapBatteryPowerSupplyData(i);
        else if( supply_type == PDCapPowerSupplyTypeString[_PD_CAP_PWR_VARIABLE] )
            data_object_str = DecodeCapVariablePowerSupplyData(i);
        else
            data_object_str = DecodeCapUndefinedPowerSupplyData(i);

        report_str += data_object_str;
    }   
  
    return report_str;
}

DecodeCapFixedPowerSupplyData(data_object_index)
{    
    if(in.PacketType == _PD_DATA_SNK_CAP)
    {
        report_str = "";
        
        ######################################################################################
        #Here is how to use GetHexPktField method to retrieve a field's value
        report_str += AddFieldsHexPkt(data_object_index, "Rsvd");
        report_str += AddFieldsHexPkt(data_object_index, "Data_DR");
        
        ReportText ( report_str );
        ######################################################################################
        
        ######################################################################################
        #Here is how to use GetDecodedPktField method to retrieve a field's value
        return AddFields(data_object_index, "SinkFixedPowerSupply");
        ######################################################################################
    }
    else
    {
        report_str = "";
        
        ######################################################################################
        #Here is how to use GetHexPktField method to retrieve a field's value
        report_str += AddFieldsHexPkt(data_object_index, "Max_Cur");
        report_str += AddFieldsHexPkt(data_object_index, "Voltage");
        report_str += AddFieldsHexPkt(data_object_index, "Peak_Curr");
        report_str += AddFieldsHexPkt(data_object_index, "Rsvd");
        report_str += AddFieldsHexPkt(data_object_index, "Data_DR");

        ReportText ( report_str );
        ######################################################################################        
        
        ######################################################################################
        #Here is how to use GetDecodedPktField method to retrieve a field's value
        text = FormatEx( FormatString_IntValue, "DR SWAP", in.OBJ1_Data_DR );
        ReportText ( text );
        
        return AddFields(data_object_index, "SourceFixedPowerSupply");                
        ######################################################################################
    }
}

