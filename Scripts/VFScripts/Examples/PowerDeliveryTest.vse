        if(obj_num > data_object_index)
            report_str += FormatEx( "\n\t*** Data Object %d out of %d ***\n", obj_num + 1, in.DataObjectCount );

        field_name = FormatEx("SVID_%d", (obj_num - 1) * 2);
        report_str += GetDecodedField(NO_DATA_OBJECT, field_name);     
        
