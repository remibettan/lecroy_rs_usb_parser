DecodeVendorDefUnstructuredDataObjects(starting_data_object_index)
{
    report_str = "";     
   
    for (obj_num = starting_data_object_index; obj_num < in.DataObjectCount; obj_num++)
    {
        if(obj_num > starting_data_object_index)
            report_str += FormatEx( "\n\t*** Data Object %d out of %d ***\n", obj_num + 1, in.DataObjectCount );

        field_name = FormatEx("Object %d", obj_num);
        report_str += GetDecodedField(NO_DATA_OBJECT, field_name);
    }
    
    return report_str;
}

