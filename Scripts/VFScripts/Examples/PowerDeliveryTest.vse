DecodeUnknownPacket()
{
    report_str = ""; 
    
    report_str += FormatEx( FormatString_IntValue, "in.HasPacketFraming", in.HasPacketFraming ); 
    if(in.HasPacketFraming == 1)
        report_str += FormatEx( FormatString_IntValue, "in.ProbableMessageType", in.ProbableMessageType ); 

    return report_str;
}