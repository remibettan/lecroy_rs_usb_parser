DecodeVendorDefDiscoverIDResponsePassiveCableVDO(data_object_index)
{
    report_str = "";
    report_str += FormatEx( FormatString_StringValue, "OBJ5_SOPDPrime_Con", GetDecodedPktField("OBJ5_SOPDPrime_Con") ); 
    report_str += FormatEx( FormatString_StringValue, "OBJ5_Type-C_to_Plg", GetDecodedPktField("OBJ5_Type_C_to_Plg") ); 
    report_str += FormatEx( FormatString_StringValue, "OBJ5_Type-C_to", GetDecodedPktField("OBJ5_Type_C_to") ); 
    
    report_str += FormatEx( FormatString_IntValue, "in.OBJ5_SOPDPrime_Con", in.OBJ5_SOPDPrime_Con ); 
    report_str += FormatEx( FormatString_IntValue, "in.OBJ5_Type_C_to_Plg", in.OBJ5_Type_C_to_Plg ); 
    report_str += FormatEx( FormatString_IntValue, "in.OBJ5_Type_C_to", in.OBJ5_Type_C_to ); 
    
    ReportText ( report_str );
    
    if( in.Spec_Rev < _PD_SPEC_REV_3 )
        return AddFields(data_object_index, "VDMCableVDO");
    else
        return AddFields(data_object_index, "VDMPassiveCableVDO");
}

