%include "UsbCommon.inc"
%include "CATCScriptAPI.inc"
%include "USER_DEF_Errors_EDIT_ME.inc"

#----  Input
# in.Data       - Data_block to decode
# in.DataLength - Length of Data_block 
#
#----  Output
# out.Decoded   - Amount of Data that has been decoded
# out.State
# out.Data
# out.DataLength
#

const Tabular_Def_Table = Map( 
[   
    #-----------------------------------------------------------------------------------------------------
    #       id                     ,      colId                          , 		containerCellId
    #-----------------------------------------------------------------------------------------------------
    [ CELL_SMART_CARD_MESSAGE_TYPE , TABULAR_SCRIPT_COLUMN_ID_SUBTYPE   , TABULAR_SCRIPT_CONTAINER_CELL_ID_NONE ],
    [ CELL_SMART_CARD_SEQ          , TABULAR_SCRIPT_COLUMN_ID_NONE      , TABULAR_SCRIPT_CONTAINER_CELL_ID_MISC ]
    
] );

set ModuleType  = "DataBlock Decoder";          #?_?
set LevelName   = "CCID Bulk In Messages";      #?_?
set LevelColor  = 0x898989;                     #?_?

set OutputType      = "CCID Bulk In Message";
set UsbDecodeType   = "Endpoint";
set UsbEndpId = 15;                 # Just a unique value for each endpoint of the same Class/Vendor/Product 
                                    # to distinguish them    
set UsbClassCode    = 0x0B;         # Smart Card (CCID)
set UsbProtocol     = 0x0;
set UsbEndpType     = "Bulk";
set UsbEndpDir      = "In";
set UsbScriptDecodeType  = 2;       # Combined decoding for Cells and Text decoding
set UsbMaxXferSize  = 0x7FFFFFFF;   # Trying largest possible positive value  
set UsbMaxPktSize   = 512;          # Will automatically be reduced to 64 if branch is Full Speed 
set UsbMaxXferDecodeSize  = 0xFF;   # Max bytes that we will be decoding. User can up this if desired.
set UsbXferCompleteClue = 1;        # define SD_CLUE_XFER_EMPTY_FRAMES_ALLOWED  1

set dwLength    = 0;             #Declaring global variables
set slotNumber  = 0;
set seqNumber   = 0;
set bmCommandStatus = 0;
 
# User can select the colors for the fields he chooses
set ErrorColor             = 0x0000FF;
set wDecodeCellColor       = 0x898989; 
set CCIDColor              = 0xA45A8A;
set RequestDataFieldColor  = 0x302A2A;
set GreyColor              = 0x888888;
set PINDataColor           = 0xF07000-500;  #0xF1FC3A 0xEB43BE 0x3A8CD1

set CCID_CaptionColor      = 0x7FFFFF;   #Caption Cell (Expansion Indicator)     #9B4A13 - 7700500;  

set RestoreBitCurrentFieldOffset = 0;    #Temp Variables to store a restore value
set RestoreBitCurrentFieldLength = 0;

#Bulk In messages
set BulkINMesgTypeTable =[              
    [ 0xFF, "PC_to_RDR_NoParams",                   "UNKNOWN",             "UNKNOWN Bulk IN Message Type"],
    [ 0x80, "RDR_to_PC_DataBlock",                  "DataBlock" ,          "RDR_to_PC_DataBlock(80h)\nExpected Response to:  PC_to_RDR_IccPowerOn,\n                       PC_to_RDR_XfrBlock,\n                       or PC_to_RDR_Secure"],
    [ 0x81, "RDR_to_PC_SlotStatus",                 "SlotStatus",          "RDR_to_PC_SlotStatus(81h)\n Expected Response to: PC_to_RDR_IccPowerOff,\n                       PC_to_RDR_GetSlotStatus,\n                       PC_to_RDR_Mechanical,\n                       PC_to_RDR_T0APDU,\n                       or PC_to_RDR_Abort\n                         (specific ABORT request)"],
    [ 0x82, "RDR_to_PC_Parameters",                 "Parameters",          "RDR_to_PC_Parameters(82h)\n Expected Response to: PC_to_RDR_GetParameters,\n                       PC_to_RDR_ResetParameters,\n                      or PC_to_RDR_SetParameters"],
    [ 0x83, "RDR_to_PC_Escape",                     "Escape",              "RDR_to_PC_Escape(83h)\n Expected Response to: PC_to_RDR_Escape"],
    [ 0x84, "RDR_to_PC_DataRateAndClockFrequency",  "DataRate&ClockFreq",  "RDR_to_PC_DataRateAndClockFrequency(84h)\n Expected Response to: PC_to_RDR_SetDataRateAndClockFrequency"]
];

ProcessData()
{
  CommonDecoderInit();        # Initialization of SRP common global variables [found in CATCScriptAPI.inc]
 
  SetCellColor(CCID_CaptionColor);
  AddCaptionCell("SmartCard","CCID","This data payload represents a Smart-Card CCID Bulk-IN message.",_MONOCOLOR);  # Will allow for the expansion of certain fields
  RestoreCellColor();
  AddSeparator();
  
  FullyDecoded = 1;            
  out.Decoded = 0;            # Nothing has been decoded yet
  
  if (in.DataLength >9 )
  {
    messagetype = NextNBits_(8);
    mesgM = Find(BulkINMesgTypeTable , messagetype );
    
    AddShortDataHeader(mesgM[2]);
    FieldColor = CCIDColor;
    if(mesgM[0] == 0xFF){
      FieldColor = WarningColor;
      mesgM[3] += Format("(0x%02X)\nDecoding ABORTED, see 'Data' for raw bytes.",messagetype);
    }
    if(SimpleShowItem())
      AddPayLoadCell("MessageType", mesgM[2], "Header offset Byte 0. \n" + " bMessageType = " + mesgM[3], FieldColor, [_TABULARCELL, CELL_SMART_CARD_MESSAGE_TYPE]);
    else
      AddCell(mesgM[2],"","Header offset Byte 0. \n" + " bMessageType = " + mesgM[3],FieldColor,_MONOFIELD, [_TABULARCELL, CELL_SMART_CARD_MESSAGE_TYPE]);

    if (mesgM[0] != 0xFF) 
    {
      dwLength= NextDataDWord_();
      if(dwLength != in.DataLength - 10)
      {
        SetCellColor(WarningColor);
        AddPayLoadCell( "MsgLen", dwLength, Format("!!!ERROR!!!\ndwLength DOES NOT MATCH length\nof data found in PayLoad!\nWill attempt to decode...\n\nHeader offset Bytes 1-4.\n dwLength = 0x%08X",dwLength),_ERROR);
        RestoreCellColor();
      }
      else if(SimpleShowItem())
        AddPayLoadCell( "MsgLen", dwLength, Format("Header offset Bytes 1-4.\n dwLength = 0x%08X",dwLength));

      slotNumber = NextNBits_(8);
      if(SimpleShowItem())
        AddPayLoadCell( "Slot#", slotNumber, Format("Header offset Byte 5.\n bSlot = 0x%02X",slotNumber));
      
      seqNumber= NextNBits_(8);
      if(SimpleShowItem())
        AddPayLoadCell( "Seq#", seqNumber, Format("Header offset Byte 6.\n bSeq = 0x%02X\nThe host can use the sequence number in\na response message to verify that a\nparticular response is the one expected\nin reply to a particular command.",seqNumber), FieldColor, [_TABULARCELL, CELL_SMART_CARD_SEQ, "TEXT_CAPTION"]);
      else
        AddCell(Format("Seq: %d",seqNumber),"",Format("Header offset Byte 6.\n bSeq = 0x%02X\nThe host can use the sequence number in\na response message to verify that a\nparticular response is the one expected\nin reply to a particular command.",seqNumber),FieldColor+5000000,_MONOFIELD);

      prm1=NextNBits_(8);  #Parameter 1
      prm2=NextNBits_(8);  #Parameter 2
      prm3=NextNBits_(8);  #Parameter 3

      AddSeparator();
      out.Decoded=10;
      
      decodedmore=Call(mesgM[1],[prm1,prm2,prm3,dwLength]) + 10;
    }
    else
      decodedmore = 1;
    
    out.Decoded=decodedmore;
    ShowDataBlockReOrder(in.DataLength-decodedmore);
    out.Data = in.Data;
    out.DataLength = in.DataLength;
    out.State = "Complete";
    return Complete();  
  } 
  else {
    if (in.DataLength > 0)
    {
        str = "0x";
        str2= "Byte Data:";
        for(i = 0; i < in.DataLength; i++)
        {
            tmp = Format("%02X", NextNBits_(8));
            str += tmp;
            str2 += " " + tmp;
        } 
        #IncFieldOffset( in.DataLength * 8);
        FieldColor = RED;
        AddPayLoadCell("PayLoad Too Short", str, Format("***ERROR*** \nExpecting at least 10 bytes. \nFound only %d bytes...\n\n" + str2,in.DataLength ), _ERROR);
        out.Decoded = in.DataLength;
    }
    else
    {
        FieldColor = WarningColor;
        AddPayLoadCell("EMPTY PAYLOAD", "**EMPTY**", "No Data!",_ERROR);
    }
    AddSeparator();
    return Complete();
  }
}

RDR_to_PC_DataBlock(prm1,prm2,prm3,dwLength)
{
#RDR_to_PC_DataBlock 80h\nsent in response to:  PC_to_RDR_IccPowerOn, PC_to_RDR_XfrBlock, or PC_to_RDR_Secure"],
  ShowStatus(prm1);
  ShowErrorCode(prm2);
  SetFieldOffsetLen_CCID( 80, 8 );

  tttxt="Use changes depending on the exchange level reported\nby the CCID in the functional descriptor :";
  tttxt=tttxt+"\n• Character level, TPDU level, short APDU level \n    - field is RFU and = 00h.";
  tttxt=tttxt+"\n• Extended APDU level \n    - indicates if the response is complete, to be\n      continued, or if the cmd APDU can continue\n";
  tttxt=tttxt+"\n      00h: the response APDU begins and ends in \n           this command";
  tttxt=tttxt+"\n      01h: the response APDU begins and continues";
  tttxt=tttxt+"\n      02h: this abData field continues the response \n           APDU and ends the response APDU ";
  tttxt=tttxt+"\n      03h: this abData field continues the response\n           APDU and another block is to follow";
  tttxt=tttxt+"\n      10h: empty abData field, continuation of the\n           command APDU is expected in the next \n           PC_to_RDR_XfrBlock command";
  if( ((prm3>0x03)&&(prm3!=0x10))||(prm3>0x10) )
  {
    SetCellColor(WarningColor);
    AddPayLoadCell("ChainParam",Format("0x%02X",prm3),FormatEx("!!! WARNING !!!\nExpected 00-03h or 10h, Found 0x%02X.\n\nHeader offset Byte 9.\n bChainParameter = 0x%02X\n\n",prm3,prm3)+ tttxt, _ERROR);
    RestoreCellColor();
  }
  else
    AddPayLoadCell("ChainParam",Format("0x%02X",prm3),Format("Header offset Byte 9.\n bChainParameter = 0x%02X\n\n",prm3)+ tttxt);
  
  RestoreFieldOffsetLen_CCID();
  CheckCCIDMsgLen();
  return 0;
}

RDR_to_PC_SlotStatus(prm1,prm2,prm3,dwLength)
{
#RDR_to_PC_SlotStatus 81h\n sent in response to: PC_to_RDR_IccPowerOff, PC_to_RDR_GetSlotStatus, PC_to_RDR_Mechanical, PC_to_RDR_T0APDU or PC_to_RDR_Abort, specific ABORT request
  ShowStatus(prm1);
  ShowErrorCode(prm2);
  SetFieldOffsetLen_CCID( 80, 8 );
  tttxt = Format("Header offset Byte 9.\n bClockStatus = 0x%02X\n",prm3);
  if (prm3==0) {
    datF="Running";
    tttxt += "00h: Clock running.";
  } else if (prm3==1) {
    datF="Stop L";
    tttxt += "01h: Clock stopped in state L.";
    
  } else if (prm3==2) {
    datF="Stop H";
    tttxt += "02h: Clock stopped in state H.";
  } else if (prm3==3) {
    datF="Stopped?";
    tttxt += "03h: Clock stopped in an unknown state.";
  } else {
    datF="RESERVED";
    tttxt = Format("!!! WARNING !!!\nExpected 00-03h, Found 0x%02X",prm3) + tttxt + Format("%02Xh: RESERVED",prm3);
  }
  if(datF == "RESERVED")
  {
    SetCellColor(WarningColor);
    AddPayLoadCell("ClockStat",datF,tttxt,_ERROR);
    RestoreCellColor();
  }
  else
    AddPayLoadCell("ClockStat",datF,tttxt);
  
  RestoreFieldOffsetLen_CCID();
  CheckCCIDMsgLen();
  return 0;
}


RDR_to_PC_Parameters(prm1,prm2,prm3,dwLength)
{
#RDR_to_PC_Parameters 82h\nSection 4.2.2.3\n sent in response to: PC_to_RDR_GetParameters, PC_to_RDR_ResetParameters, PC_to_RDR_SetParameters
  ShowStatus(prm1);
  ShowErrorCode(prm2);
  bProtocolNum(prm3,9);
  
  if ((dwLength==5)  && (prm3==0)) 
  {
    if((in.DataLength - out.Decoded)<5)
    {
      AddCell("ERROR","Not Enough Data",Format("ERROR - NOT ENOUGH DATA\n Expecting at least 5 bytes; found %d bytes.\nDecoding Aborted.\nSee 'Data' for raw bytes.",(in.DataLength-out.Decoded)),RED,_ERROR);
      CheckCCIDMsgLen();
      return 0;
    }
      
    FieldColor = CCIDColor-400;
    if(in.Expanded)
      AddCell("Protocol Data","","Protocol Data Structure for T=0",FieldColor,_MONOFIELD);
    else
      AddCell("Protocol Data","","Protocol Data Structure for T=0\n   (Double-Click to Expand)",FieldColor,_MONOFIELD);
    #BEGIN bmFindexDindex
    prm=NextNBits_(8);
    tttxt=Format("FI = %X",(prm>>4) & 0x0F) + " (Bits 7-4) - Index into Table 7\n\tin ISO/IEC 7816-3:1997 selecting \n\ta clock rate conversion factor";
    tttxt=tttxt + Format("\nDI = %X",prm & 0x0F) + " (Bits 3-0) - Index into Table 8\n\tin ISO/IEC 7816-3:1997 selecting \n\ta baud rate conversion factor";
    if(SimpleShowItem())    
      AddPayLoadCell( "FI_DI", Format("0x%02X",prm),  Format("Msg Header offset Byte 10.\n bmFindexDindex = 0x%02X\n",prm) +tttxt);
    #END bmFindexDindex

    #BEGIN bmTCCKST0    
    prm =NextNBits_(8);
    if((prm != 0)&&(prm!= 0x02))
    {
      tempCol = FieldColor;
      FieldColor = WarningColor;
      if(prm&&0x02)
        tttxt="B1=1 : Inverse\n";
      else
        tttxt="B1=0 : Direct\n";
      tttxt2 = Format("!!! WARNING !!! Expected 0x00 or 0x02!\n Found 0x%02X\n For T=0, B0 and B7-2 should = 0\n  i.e. 000000x0b\n",prm);
      AddPayLoadCell( "TCCKST0",prm, tttxt2 + Format("Msg Header offset Byte 11.\n bmTCCKSTO = 0x%02X\n",prm) +tttxt, _ERROR);
      FieldColor = tempCol;
    }
    else
    {
      if(prm == 0)
        tttxt="B1=0 : Direct";
      else
        tttxt="B1=1 : Inverse";
      if(SimpleShowItem())    
        AddPayLoadCell( "TCCKST0",prm,  Format("Msg Header offset Byte 11.\n bmTCCKSTO = 0x%02X\n",prm) +tttxt);
    }
    #END bmTCKST0

    #BEGIN bGuardTimeT0
    prm = NextNBits_(8);
    tttxt="Extra Guardtime between two characters. \nAdd 0 to 254 etu to the normal guardtime of 12etu. \nFFh is the same as 00h.";
    if(prm == 0xFF)
      bGuardTimeT0_val = "0 etu";
    else
      bGuartTimeT0_val = Format("%d etu",prm);
      
    if(SimpleShowItem())    
      AddPayLoadCell( "GuardTimeT0", bGuartTimeT0_val, Format("Msg Header offset Byte 12.\n bGuardTimeT0 = 0x%02X\n",prm) +tttxt);
    #END bGuardTimeT0

    #BEGIN bWaitingIntegerT0    
    prm = NextNBits_(8);
    tttxt="WI for T=0 used to define WWT";
    if(SimpleShowItem())    
      AddPayLoadCell( "WaitIntT0", prm, Format("Msg Header offset Byte 13.\n bWaitingIntegerT0 = 0x%02X\n",prm) +tttxt);
    #END bWaitingIntegerT0    

    #BEGIN bClockStop      
    prm = NextNBits_(8);
    tttxt="ICC Clock Stop Support:";
    if(prm<4){
      if (prm==0) { tttxt=tttxt + "\n 00h = Stopping the Clock is not allowed"; }
      else if (prm==1) { tttxt=tttxt + "\n 01h = Stop with Clock signal Low"; }
      else if (prm==2) { tttxt=tttxt + "\n 02h = Stop with Clock signal High"; }
      else if (prm==3) { tttxt=tttxt + "\n 03h = Stop with Clock either High or Low"; }
      
      if(SimpleShowItem())    
        AddPayLoadCell( "ClkStop", Format("0x%02X",prm), Format("Msg Header offset Byte 14.\n bClockStop = 0x%02X\n",prm) +tttxt);
    }    
    else {
      tttxt=tttxt + "\n UNKNOWN";
      tempCol = FieldColor;
      FieldColor = WarningColor;
      tttxt = Format("!!! WARNING !!!\nExpected 00h-03h; Found 0x%02X\n",prm) + Format("Msg Header offset Byte 14.\n bClockStop = 0x%02X\n",prm) + tttxt;
      AddPayLoadCell( "ClkStop", Format("0x%02X",prm), tttxt,_ERROR);
      FieldColor = tempCol;
    }
    #END bClockStop  
    
    if((in.DataLength - out.Decoded - 5) != 0)
      AddCell("WARNING","Extra Data",Format("!!! WARNING !!!\nFound %d Bytes Un-Accounted for in Pay Load...",(in.DataLength - out.Decoded - 5)),RED,_ERROR);  
    return 5;
  }
  
  else if ((dwLength==7)&&(prm3==1)) 
  {
    if((in.DataLength - out.Decoded)<7)
    {
      AddCell("ERROR","Not Enough Data",Format("ERROR - NOT ENOUGH DATA\n Expecting at least 7 bytes; found %d bytes.\nDecoding Aborted.\nSee 'Data' for raw bytes.",(in.DataLength-out.Decoded)),RED,_ERROR);
      CheckCCIDMsgLen();
      return 0;
    }
      
    FieldColor = CCIDColor-200;
    if(in.Expanded)
      AddCell("Protocol Data","","Protocol Data Structure for T=1",FieldColor,_MONOFIELD);
    else
      AddCell("Protocol Data","","Protocol Data Structure for T=1\n   (Double-Click to Expand)",FieldColor,_MONOFIELD);
    #BEGIN bmFindexDindex    
    prm=NextNBits_(8);
    tttxt=Format("FI = %X",(prm>>4) & 0x0F) + " (Bits 7-4) – Index into Table 7\n\tin ISO/IEC 7816-3:1997 selecting \n\ta clock rate conversion factor";
    tttxt=tttxt + Format("\nFI = %X",prm & 0x0F) + " (Bits 3-0) – Index into Table 8\n\tin ISO/IEC 7816-3:1997 selecting \n\ta baud rate conversion factor";
    if(SimpleShowItem())    
      AddPayLoadCell( "FI_DI", Format("0x%02X",prm),  Format("Msg Header offset Byte 10.\n bmFindexDindex = 0x%02X\n",prm) +tttxt);
    #END bmFindexDindex

    #BEGIN bmTCCKST1
    prm =NextNBits_(8);
    datF=Format("0x%02X",prm);
    tttxt="";
    if ((prm&0x01)) { tttxt=tttxt + "\nB0=1 : CRC"; datF=datF + ",CRC";}
    else { tttxt=tttxt + "\nB0=0 : LCRC"; datF=datF + ",LCRC";}
    if ((prm&0x02)) { tttxt=tttxt + "\nB1=1 : Inverse"; datF=datF + ",Inverse";}
    else { tttxt=tttxt + "\nB1=0 : Direct";datF=datF + ",Direct"; }
    
    if((prm&0xFC)!=0x10)
    {
      tttxt2 = Format("!!! WARNING !!! \nExpected 0x10, 0x11, 0x12, or 0x13;\nFound 0x%02X.\n For T=1, B7-2 should = 000100\n  i.e. 000100xxb\n",prm);
      SetCellColor(WarningColor);
      AddPayLoadCell( "TCCKST1",datF, tttxt2 + Format("Msg Header offset Byte 11.\n bmTCCKST1 = 0x%02X",prm) +tttxt, _ERROR);
      RestoreCellColor();
    }
    else if(SimpleShowItem())
      AddPayLoadCell( "TCCKST1",datF, Format("Msg Header offset Byte 11.\n bmTCCKST1 = 0x%02X",prm) +tttxt);
    #END bmTCCKST1
    
    #BEGIN bGuardTimeT1
    prm =NextNBits_(8);
    tttxt="Extra Guardtime between two characters. \nAdd 0 to 254 etu between 2 characters.\nIf value is FFh, then guardtime is \nreduced by 1 etu.";
    if(prm == 0xFF)
      bGTT1_val = "-1 etu";
    else
      bGTT1_val = Format("%d etu",prm);
      
    if(SimpleShowItem())
      AddPayLoadCell( "GuardTimeT1", bGTT1_val, Format("Msg Header offset Byte 12.\n bGuardTimeT1 = 0x%02X\n",prm) +tttxt);
    #END bGuardTimeT1    

    #BEGIN bwWaitingIntegersT1
    prm =NextNBits_(8);
    tempBWI = ((prm>>4)&0x0F);  # High Nibble
    tempCWI = (prm&0x0F);       # Low Nibble
    if (prm < 0xA0)             # bmWaitingIntegersT1 - valid values 00-9FH
    {
      if(SimpleShowItem())
        AddPayLoadCell( "WaitIntsT1", Format("0x%02X",prm), FormatEx("Msg Header offset Byte 13.\n bmWaitingIntegersT1 = 0x%02X\nBWI = %d (Bits 7-4)\nCWI = %d (Bits 3-0)",prm,tempBWI,tempCWI));
    } 
    else 
    {
      tttxt = "!!! WARNING !!!\n" + Format("BWI (Bits 7-4) - Expected 0-9; Found %d\n",tempBWI);
      SetCellColor(WarningColor);
      AddPayLoadCell( "WaitIntsT1", Format("0x%02X",prm), tttxt + FormatEx("Msg Header offset Byte 13.\n bmWaitingIntegersT1 = 0x%02X\nBWI = %d (Bits 7-4)\nCWI = %d (Bits 3-0)",prm,tempBWI,tempCWI),_ERROR);
      RestoreCellColor();
    }
    #END bwWaitingIntegersT1
    
    #BEGIN bClockStop      
    prm = NextNBits_(8);
    tttxt="ICC Clock Stop Support:";
    if(prm<4){
      if (prm==0) { tttxt=tttxt + "\n 00h = Stopping the Clock is not allowed"; }
      else if (prm==1) { tttxt=tttxt + "\n 01h = Stop with Clock signal Low"; }
      else if (prm==2) { tttxt=tttxt + "\n 02h = Stop with Clock signal High"; }
      else if (prm==3) { tttxt=tttxt + "\n 03h = Stop with Clock either High or Low"; }
      
      if(SimpleShowItem())    
        AddPayLoadCell( "ClkStop", Format("0x%02X",prm), Format("Msg Header offset Byte 14.\n bClockStop = 0x%02X\n",prm) +tttxt);
    }    
    else {
      tttxt=tttxt + "\n UNKNOWN";
      tempCol = FieldColor;
      FieldColor = WarningColor;
      tttxt = Format("!!! WARNING !!!\nExpected 00h-03h; Found 0x%02X\n",prm) + Format("Msg Header offset Byte 14.\n bClockStop = 0x%02X\n",prm) + tttxt;
      AddPayLoadCell( "ClkStop", Format("0x%02X",prm), tttxt,_ERROR);
      FieldColor = tempCol;
    }
    #END bClockStop  

    #BEGIN bIFSC
    prm =NextNBits_(8);
    tttxt="Size of negotiated IFSC (00-FEh)";
    if(prm == 0xFF)
    {
      SetCellColor(WarningColor);
      AddPayLoadCell("IFSC", prm, Format("!!! WARNING !!!\n Expected 00-FEh; Found 0xFF.\nMsg Header offset Byte 15.\n bIFSC = 0x%02X\n",prm) + tttxt,_ERROR);
      RestoreCellColor();
    }
    else if(SimpleShowItem())
      AddPayLoadCell("IFSC", prm, Format("Msg Header offset Byte 15.\n bIFSC = 0x%02X\n",prm) + tttxt);
    #END bIFSC

    #BEGIN bNadValue
    prm =NextNBits_(8);
#   tttxt="Value = 00h if CCID doesn't support\na value other then the default \nvalue. Else, the value respects the\nISO/IEC 7816-3,9.4.2.1";
    tttxt="Nad value used by CCID.";
    if(SimpleShowItem())
      AddPayLoadCell( "NadVal", prm, Format("Msg Header offset Byte 16.\n bNadValue = 0x%02X\n\n",prm) + tttxt);
    #END bNadValue

    if((in.DataLength - out.Decoded - 7) != 0)
      AddCell("WARNING","Extra Data",Format("!!! WARNING !!!\nFound %d Bytes Un-Accounted for in Pay Load...",(in.DataLength - out.Decoded - 7)),RED,_ERROR);  
    return 7;
  }
  else
  {
    error_string = "!!! WARNING !!!\n";
    if(dwLength > 0){
      tval  = ((prm3 == 0x80)||(prm3 == 0x81)||(prm3 == 0x82));
      tval2 = ((dwLength == 5)&&(!tval));
      tval3 = ((dwLength == 7)&&(!tval));
      error_string += "CAN'T DECODE PROTOCOL DATA STRUCTURE\n";
      error_string += select{
        tval2 == 1    : Format("Expected bProtocolNum = 00h (Protocol T=0);\nFound 0x%02X.\n See 'Data' for raw bytes.",prm3);
        tval3 == 1    : Format("Expected bProtocolNum = 01h (Protocol T=1);\nFound 0x%02X.\n See 'Data' for raw bytes.",prm3);
        prm3 == 0     : Format("Expected dwLength = 5 (Size of T=0 structure);\nFound %d.\n See 'Data' for raw bytes.",dwLength);
        prm3 == 1     : Format("Expected dwLength = 7 (Size of T=1 structure);\nFound %d.\n See 'Data' for raw bytes.",dwLength);
        prm3 == 0x80  : "2-Wire Protocol Structure is Reserved for Future Use\nStructure unknown. See 'Data' for raw bytes.";
        prm3 == 0x81  : "3-Wire Protocol Structure is Reserved for Future Use\nStructure unknown. See 'Data' for raw bytes.";
        prm3 == 0x82  : "I2C Protocol Structure is Reserved for Future Use\nStructure unknown. See 'Data' for raw bytes.";
        default       : FormatEx("Erroneous dwLength and Protocol\nExpected (dwLength = 5, bProtocolNum = 00h)\n      or (dwLength = 7, bProtocolNum = 01h)\n  ;\nFound dwLength = %d, bProtocolNum = 0x%02X.\n See 'Data' for raw bytes.",dwLength,prm3);
      };
    }
    else
    {
      error_string += "NO PROTOCOL DATA STRUCTURE FOUND\nExpected dwLength > 0 (5 for T=0 or 7 for T=1).";
    }
    
    AddCell("ERROR","Decoding Aborted",error_string,RED,_ERROR);
    CheckCCIDMsgLen();
    return 0;
  }
}

RDR_to_PC_Escape(prm1,prm2,prm3,dwLength)
{
#RDR_to_PC_Escape 83h\nSection 4.2.2.4\n sent in response to: PC_to_RDR_Escape
  ShowStatus(prm1);
  ShowErrorCode(prm2);
  IsReserved(prm3,9);
}

RDR_to_PC_DataRateAndClockFrequency(prm1,prm2,prm3,dwLength)
{
#RDR_to_PC_DataRateAndClockFrequency 84h\n sent in response to: PC_to_RDR_SetDataRateAndClockFrequency
  ShowStatus(prm1);
  ShowErrorCode(prm2);
  IsReserved(prm3,9);
  
  
  #BEGIN dwClockFrequency
  if(DatLength > 3)
  {
    tttxt="\nCurrent ICC clock frequency in KHz.\nThis is an integer value.";
    dwClockFrequency = NextDataDWord_();
    ClkFreq_val = Format("%u KHz",dwClockFrequency);
    AddPayLoadCell( "ClkFreq",ClkFreq_val, Format("Msg Header offset Byte 10.\n dwClockFrequency = 0x%08X",dwClockFrequency)+ tttxt);
  }
  else
  {
    AddCell("ERROR","Not Enough Data",Format("ERROR - NOT ENOUGH DATA\n Expecting 8 bytes; found %d bytes.\nDecoding Aborted.\nSee 'Data' for raw bytes.",(in.DataLength-out.Decoded)),RED,_ERROR);
    CheckCCIDMsgLen();
    return 0;
  }
  #END dwClockFrequency
  
  #BEGIN dwDataRate  
  if(DatLength > 7)
  {  
    tttxt="\nCurrent ICC data rate in bps.\nThis is an integer value.";
    dwDataRate = NextDataDWord_();
    DR_val = Format("%u bps",dwDataRate);
    AddPayLoadCell( "DataRate",DR_val, Format("Msg Header offset Byte 14.\n dwDataRate = 0x%08X",dwDataRate)+ tttxt);
  }
  else
  {
    AddCell("ERROR","Not Enough Data",Format("ERROR - NOT ENOUGH DATA\n Expecting 4 bytes; found %d bytes.\nDecoding Aborted.\nSee 'Data' for raw bytes.",(in.DataLength-out.Decoded)),RED,_ERROR);
    CheckCCIDMsgLen();
    return 4;
  }
  
  #END dwDataRate
  
  CheckCCIDMsgLen();
  return 8;
}

bProtocolNum(prm,ofst)
{
tttxt="Specifies what protocol data structure follows.\n";
tttxt=tttxt+" 00h = Structure for protocol T=0\n";
tttxt=tttxt+" 01h = Structure for protocol T=1\n";
tttxt=tttxt+"The following values are reserved for future use.\n";
tttxt=tttxt+" 80h = Structure for 2-wire protocol\n";
tttxt=tttxt+" 81h = Structure for 3-wire protocol\n";
tttxt=tttxt+" 82h = Structure for I2C protocol";

  if (prm==0) {
    prot="T=0";
  } else  if (prm==1) {
    prot="T=1";
  } else  if (prm==0x80) {
    prot="2 Wire";
  } else  if (prm==0x81) {
    prot="3 Wire";
  } else  if (prm==0x82) {
    prot="I2C";
  } else   {
    prot="Invalid value";
  }
  
  SetFieldOffsetLen_CCID( 8*ofst+8, 8 );
  if(prot=="Invalid value")
  {
    SetCellColor(RED);
    AddPayLoadCell("ProtocolNum", prot,  FormatEx("!!! WARNING !!!\n Expected 01h or 80-82h; Found 0x%02X.\nHeader offset Byte %d.\n bProtocolNum = %02Xh\n",prm,ofst,prm) + tttxt,_ERROR);
    RestoreCellColor();
  }
  else
    AddPayLoadCell( "ProtocolNum", prot,  FormatEx("Header offset Byte %d.\n bProtocolNum = %02Xh\n",ofst,prm) + tttxt);
  RestoreFieldOffsetLen_CCID();
}


ShowStatus(prm1)
{
    SetFieldOffsetLen_CCID( 64, 8 );
    bmICCStatus=prm1 & 3;  #Bits 1-0
    str1 = ToBitString(bmICCStatus, 2);
    tttxt="Header offset Byte 7.\n Slot Status Register:\n   bmICCStatus (Bits 1-0) = " + str1 + "b.\n\n00b - An ICC is present and active (power\n      is on and stable, RST is inactive)";
    tttxt=tttxt + "\n01b - An ICC is present and inactive (not\n      activated or shut down by hardware\n      error)";
    tttxt=tttxt + "\n10b - No ICC is present";
    tttxt=tttxt + "\n11b - RFU";
    if (bmICCStatus==0) {
      datF="ICC Active";
    } else if (bmICCStatus==1) {
      datF="ICC NOT Active";
    } else if (bmICCStatus==2) {
      datF="No ICC";
    } else {
      SetCellColor(WarningColor);
      datF="Warning:RFU";
    }
    
    if(FieldColor == WarningColor)
    {    
      AddPayLoadCell( "ICCStatus", datF  ,"!!! WARNING !!!\nExpected 00-10b; Found 11b(RESERVED).\n\n" + tttxt, _ERROR );
      RestoreCellColor();
    }
    else
      AddPayLoadCell( "ICCStatus", datF  , tttxt );

    bmRFU = prm1&0x3C;    #Bits 5-2
    if(bmRFU != 0)
    {
      str1 = ToBitString((bmRFU>>2)&0x0F,4) + "b";
      SetCellColor(WarningColor);
      AddPayLoadCell( "RFU", str1  ,"!!! WARNING !!!\nRESERVED - Found Value.\n\nHeader offset Byte 7.\n Slot Status Register:\n   bmRFU (Bits 5-2) = " + str1, _ERROR );
      RestoreCellColor();
    }

    bmCommandStatus= (prm1 >> 6)&0x03;  #Bits 7-6
    
    str1 = ToBitString(bmCommandStatus,2) + "b";
    tttxt="Header offset Byte 7.\n Slot Status Register:\n   bmCommandStatus (Bits 7-6) = " + str1 + ".\n\n00b - Processed without error\n01b - Failed (error code provided by\n      the error register";
    tttxt=tttxt +"\n10b - Time Extension is requested\n11b - RFU";
    if (bmCommandStatus==0) {
      datF="OK";
    } else if (bmCommandStatus==1) {
      datF="Error";
    } else if (bmCommandStatus==2) {
      datF="MoreTime";
    } else {
      SetCellColor(WarningColor);
      datF="Warning:RFU";
    }    
    
    if(FieldColor == WarningColor)
    {
      AddPayLoadCell( "CmdStatus", datF, "!!! WARNING !!!\nExpected 00-10b; Found 11b(RESERVED).\n\n" + tttxt, _ERROR );
      RestoreCellColor();
    }
    else
      AddPayLoadCell( "CmdStatus", datF, tttxt );
      
    RestoreFieldOffsetLen_CCID();
}

set ErrorCodeTable=[
#    Error Name  Possible Causes  
 [  0, "",""],
 [  0xFF,  "CMD_ABORTED",  "\nHost aborted the current activity"  ],
 [  0xFE,  "ICC_MUTE",  "\nCCID timed out while talking to the ICC"  ],
 [  0xFD,  "XFR_PARITY_ERROR",  "\nParity error while talking to the ICC"  ],
 [  0xFC,  "XFR_OVERRUN",  "\nOverrun error while talking to the ICC"  ],
 [  0xFB,  "HW_ERROR",  "\nAn all inclusive hardware error occurred"  ],
 [  0xF8,  "BAD_ATR_TS",  ""    ],
 [  0xF7,  "BAD_ATR_TCK",  ""    ],
 [  0xF6,  "ICC_PROTOCOL_NOT_SUPPORTED",  ""    ],
 [  0xF5,  "ICC_CLASS_NOT_SUPPORTED",  ""    ],
 [  0xF4,  "PROCEDURE_BYTE_CONFLICT",  ""    ],
 [  0xF3,  "DEACTIVATED_PROTOCOL",  ""    ],
 [  0xF2,  "BUSY_WITH_AUTO_SEQUENCE",  "\nAutomatic Sequence Ongoing"  ],
 [  0xF0,  "PIN_TIMEOUT",  ""    ],
 [  0xEF,  "PIN_CANCELLED",  ""    ],
 [  0xE0,  "CMD_SLOT_BUSY",  "\nA second command was sent to a slot which\nwas already processing a command." ]
];

ShowErrorCode(prm)
{
  errorflag = 0;
  SetFieldOffsetLen_CCID( 72, 8 );
  ecode=Find(ErrorCodeTable,prm);
  
  if(bmCommandStatus == 2)                                  #Applying Rule where bError = Multiplier
  {                                                         #when bmCommandStatus == 2.
    ecode_val = prm;
    ecode[0] = prm;
    ecode[1] = "MULTIPLIER";
    ecode[2] = "\nT=0: bError = Multiplier of WWT\nT=1: bError = Multiplier of BWT";
  }
  else if((bmCommandStatus == 0)||(bmCommandStatus == 3))   #Applying Rule where bError is RFU
  {                                                         #when bmCommandStatus == 0 or 3
    ecode[1] = "RFU";
    ecode[0] = prm;
    if(prm!=0)
    {
      errorflag=1;
      ecode[2] = "\nbError is RESERVED when\nbmCommandStatus = 00b or 11b.";
    }
    else
      ecode[2] = "\nbError is Reserved\n (bmCommandStatus = 00b or 11b)";
  }
  else if (ecode[0]==0)                                     #Determining what error bError code represents
  {                                                         #This is the case bmCommandStatus ==1
    ecode_val = prm - 256;
    if ((prm>0x80) && (prm<0xC1))                           #User-Defined errors
    {
      uecode = Find(CCID_USER_ErrorCodeTable,prm);
      if(uecode[0]==0)
      {
        ecode[0]=prm;
        ecode[1]="User Defined: " + Format("0x%02X",prm);
        ecode[2]="\nAdd your user error code to the CCID_USER_ErrorCodeTable\nin file USER_DEF_Errors_EDIT_ME.inc";
      }
      else
      {
        uecode[2] += "\n\nUser Error Mapped in file: USER_DEF_Errors_EDIT_ME.inc"; 
        ecode = uecode;
      }
    } 
    else if (prm==0)                                        #CMD_NOT_SUPPORTED error
    {
      ecode_val = prm;
      ecode[0]=prm;
      ecode[1]="CMD_NOT_SUPPORTED";
      ecode[2]="";
    } 
    else if ((prm>0x00) && (prm<0x80))                      #Errors 1 - 127 (positive) are an index value
    {
      ecode_val = prm;
      ecode[0]=prm;
      ecode[1]="PARAM_NOT_SUPPORTED_INCORRECT (" + Format("%d)",prm);
      ecode[2]="\nIndex of Not Supported/Incorrect Message Parameter";
    }
    else 
    {
      errorflag = 1;
      ecode[0]=prm;
      ecode[1]="RESERVED";
      ecode[2]="\nThis is a RESERVED code\nand should not be used!";
    }
  }
  else                                                      #These are errors in the table, hence assign value
    if(prm > 127)                                           #If (value > 0xC0), it's a negative number
      ecode_val = prm-256;                                  
    else
      ecode_val = prm;                                      #Else it's a positive number
  
  if((bmCommandStatus != 1)&&(bmCommandStatus != 2))
  {
    if(errorflag)
    {
      SetCellColor(WarningColor);
      AddPayLoadCell("ErrCode",ecode[1],Format("!!! WARNING !!!\nRESERVED - Found Value.\n\nHeader offset Byte 8.\n bError = 0x%02X\n",ecode[0]) + ecode[1] + ecode[2],_ERROR);
      RestoreCellColor();
    }
    else
    {
      SetCellColor(GreyColor);
      if(SimpleShowItem())
        AddPayLoadCell("ErrCode",ecode[1],Format("Field Reserved (bmCommandStatus != 1 or 2)\n\nHeader offset Byte 8.\n bError = 0x%02X\n",ecode[0]) + ecode[1] + ecode[2]);
      RestoreCellColor();
    }
  }
  else if(bmCommandStatus == 1)
  {
    if(errorflag)
    {
      SetCellColor(WarningColor);
      AddPayLoadCell("ErrCode",ecode[1],Format("!!! WARNING !!!\nRESERVED CODE\n\nHeader offset Byte 8.\n bError: %d",ecode_val) + Format("(0x%02X)\n",prm) + ecode[1] + ecode[2],_ERROR);
      RestoreCellColor();
    }
    else
      AddPayLoadCell("ErrCode",ecode[1],Format("Header offset Byte 8.\n bError: %d ",ecode_val) + Format("(0x%02X)\n",prm) + ecode[1] + ecode[2]); 
  }
  else
    AddPayLoadCell("ErrCode",Format("%dX",prm),Format("Header offset Byte 8.\n bError: %d ",prm) + Format("(0x%02X)\n",prm) + ecode[1] + ecode[2]); 
  
  RestoreFieldOffsetLen_CCID();
}

IsReserved(bits,offset)
{
  tempstr = Format("Header offset Byte %d.",offset);
  SetFieldOffsetLen_CCID( offset*8+8, 8 );
  
  if (bits==0) 
  {
    SetCellColor(GreyColor);
    if(SimpleShowItem())
      AddPayLoadCell( "R", bits, tempstr + Format("\n Reserved: 0x%02X",bits));
    RestoreCellColor();
  } 
  else 
  {
    SetCellColor(WarningColor);
    AddPayLoadCell( "R", bits, Format("!!! WARNING !!! \nRESERVED - Found Value: 0x%02X\n",bits) + tempstr,_ERROR);
    RestoreCellColor();
  }

  RestoreFieldOffsetLen_CCID();
}

CheckCCIDMsgLen()
{
  if(dwLength != (in.DataLength - out.Decoded))
    AddCell("ERROR","Data Discrepancy",Format("ERROR\nDifference of %d Bytes Found!\n [(Data in PayLoad - Header) - dwLength]",((in.DataLength-out.Decoded)-dwLength)),RED,_ERROR);
}  


func_bmFormatString( value, prefix_string, title )
{
    errorflag = 0;
    
    if(!in.PrepareFldsForDlg)
      tttxt="<p><font size=6>" + Format("Msg Header offset Byte 12.\n bmFormatString = 0x%02X",value) + "\nPIN format options:</font></p>";
    else
      tttxt= Format("Msg Header offset Byte 12.\n bmFormatString = 0x%02X",value) + "<br>PIN format options:";

    strhead = "<HTML>";
    str1 = "";
    if( title != null )
       str1 += "<b>" + title + "</b>";
    
    str1 += tttxt;
    str1 += "<table cellspacing=0 cellpadding=1 border=1>";
    bit7_val = (value >> 7) & 0x01;
    bit6_3_val = (value >> 3) & 0x0F;
    bit6_3_str = ToBitString(bit6_3_val, 4);
    bit2_val = (value >> 2) & 0x01;
    bit1_0_val = (value) & 0x03;
       
    str1 += "<tr align=center><td><b>Bit</b></td><td><b>Name</b></td><td><b>Value</b></td><td><b>Setting</b></td></tr>";
    if(!bit7_val)
      str1 += "<tr><td><font color=#0000FF>Bit 7</font></td><td>System Units</td><td align=center>0</td><td>bits</td></tr>";     
    else
      str1 += "<tr><td><font color=#0000FF>Bit 7</font></td><td>System Units</td><td align=center>1</td><td>bytes</td></tr>";     
      
    str1 += "<tr><td><font color=#0000FF>Bits 6-3</font></td><td>PIN Position</td><td align=center>" + bit6_3_str + Format("</td><td>%d</td></tr>",bit6_3_val);     
       
    if(!bit2_val)
      str1 += "<tr><td><font color=#0000FF>Bit 2</font></td><td>PIN Justification</td><td align=center>0</td><td>Left</td></tr>";     
    else
      str1 += "<tr><td><font color=#0000FF>Bit 2</font></td><td>PIN Justification</td><td align=center>1</td><td>Right</td></tr>";
     
    if(bit1_0_val == 0)
      str1 += "<tr><td><font color=#0000FF>Bits 1-0</font></td><td>PIN Format</td><td align=center>00</td><td>binary</td></tr>";     
    else if(bit1_0_val == 1)
      str1 += "<tr><td><font color=#0000FF>Bits 1-0</font></td><td>PIN Format</td><td align=center>01</td><td>BCD</td></tr>";     
    else if(bit1_0_val == 2)
      str1 += "<tr><td><font color=#0000FF>Bits 1-0</font></td><td>PIN Format</td><td align=center>10</td><td>ASCII</td></tr>";     
    else{
      str1 += "<tr><td><font color=#FF0000>Bits 1-0</font></td><td><font color=#FF0000>PIN Format</font></td><td align=center><font color=#FF0000>11</font></td><td><font color=#FF0000>INVALID</font></td></tr>";
      errorflag = 1;
      if(!in.PrepareFldsForDlg)
        strhead += "<p><font size=6>!!! WARNING !!!\nExpected Bits 1-0 = 00-10b; Found 11b\n</font></p>";
      else
        strhead += "!!! WARNING !!!<br>&nbsp&nbspExpected Bits 1-0 = 00-10b; Found 11b<br>&nbsp&nbsp";
    }
    
    str1 = strhead + str1 + "</table></HTML>";
    if(errorflag){
      SetCellColor(WarningColor);
      AddPayLoadCell("FmtStr",Format("0x%02X",value), str1, _ERROR);
      RestoreCellColor();
    }
    else if (SimpleShowItem())
      AddPayLoadCell("FmtStr",Format("0x%02X",value), str1);
}




# Helper Functions

SetFieldOffsetLen_CCID( offset, len )
{
    RestoreBitCurrentFieldOffset = BitCurrentFieldOffset;
    RestoreBitCurrentFieldLength = BitCurrentFieldLength;
    BitCurrentFieldOffset = offset;
    BitCurrentFieldLength = len;
}

RestoreFieldOffsetLen_CCID()
{
    BitCurrentFieldOffset = RestoreBitCurrentFieldOffset;
    BitCurrentFieldLength = RestoreBitCurrentFieldLength;
}  

GetByteStrFld_CCID( len_in_bytes )
{
    tmp = "0x";        
    for(i = 0; i < len_in_bytes; i++) 
        tmp += Format("%02X", NextNBits_(8));    
    return tmp;
}

####################################################################################
#                       USBTracer specific caption cell                            #
####################################################################################

AddSpecCaptionCell(caption, text, tooltip, FieldColor, addparam, addparam1, addparam2 )
{   
    AddCell(caption, text, tooltip, FieldColor, _USBBULK_HEADER, addparam, addparam1, addparam2 );        
    return 1;        
}