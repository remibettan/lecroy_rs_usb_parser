DecodeHIDKeyboardOutput()
{
    # Keyboard output data sent to host
    SetCellColor( HIDKeyboardColor );
    AddCaptionCell( "HID", "Keyboard", "This data payload represents a Keyboard Human\nInterface Device (HID) Interrupt-IN message.",
                    FieldColor, [_TABULARCELL, CELL_HID_KEYBOARD, "TEXT_CAPTION" ] );  # Will allow for the expansion of certain fields
    RestoreCellColor();

    AddSeparator();

    DecodedBytes = 0;
    
    if( in.HasReportID )
    {
        report_id = GetDataByte(DecodedBytes);
        DecodedBytes++;

        AddViewFieldEntry("Report ID", BitCurrentFieldLength, BitCurrentFieldOffset-8, Format("%d", report_id), "Report ID items are used to indicate which data fields are represented in each report structure.", 1, FieldColor );
        AddCell("Report ID", Format("%d", report_id), "Report ID items are used to indicate which data fields are represented in each report structure.", FieldColor );        
    }
    
    m_key   = GetDataByte(DecodedBytes);
    DecodedBytes++;

    if (m_key == 0)
    {
        ctrlTooltip = "none pressed";
        mod_key_str = "none";
    }
    else
    {
        ctrlTooltip="";
        mod_key_str="";
        ctrl=0;
        alt=0;
        bshift=0;
        if( m_key & 0x01 ) { ctrlTooltip = ctrlTooltip + "Bit 0: <LeftCtrl>\n";   ctrl=1; };
        if( m_key & 0x10 ) { ctrlTooltip = ctrlTooltip + "Bit 4: <RightCtrl>\n";  ctrl=1; };
        if( m_key & 0x02 ) { ctrlTooltip = ctrlTooltip + "Bit 1: <LeftShift>\n";  shift=1; };
        if( m_key & 0x20 ) { ctrlTooltip = ctrlTooltip + "Bit 5: <RightShift>\n"; shift=1; };
        if( m_key & 0x04 ) { ctrlTooltip = ctrlTooltip + "Bit 2: <LeftAlt>\n";    alt=1; } ;
        if( m_key & 0x40 ) { ctrlTooltip = ctrlTooltip + "Bit 6: <RightAlt>\n";   alt=1; } ;
        if( m_key & 0x08 ) { ctrlTooltip = ctrlTooltip + "Bit 3: <LeftWin>\n";    mod_key_str = mod_key_str + "<LeftWin>";};
        if( m_key & 0x80 ) { ctrlTooltip = ctrlTooltip + "Bit 7: <RightWin>\n";   mod_key_str = mod_key_str + "<RightWin>"; };

        if( shift == 1 )
            mod_key_str = mod_key_str + " <Shift>";

        if( ctrl == 1 )
            mod_key_str = mod_key_str + " <Ctrl>";

        if( alt == 1 )
            mod_key_str = mod_key_str + " <Alt>";
    }

    AddViewFieldEntry( "Modifier Keys", BitCurrentFieldLength, BitCurrentFieldOffset-8, mod_key_str, "Modifier keys:" + ToBitString(m_key,8) + "\n" + ctrlTooltip, 1, FieldColor);

    if( SimpleShowItem() )
    {
        AddCell("L-Ctrl" , (m_key & 0x01)>0 , Format("Keyboard modifier keys 0x%02X", m_key), HIDKBModifierBaseColor + m_key );
        AddCell("L-Shift", (m_key & 0x02)>0 , Format("Keyboard modifier keys 0x%02X", m_key), HIDKBModifierBaseColor + m_key );
        AddCell("L-Alt"  , (m_key & 0x04)>0 , Format("Keyboard modifier keys 0x%02X", m_key), HIDKBModifierBaseColor + m_key );
        AddCell("L-Win"  , (m_key & 0x08)>0 , Format("Keyboard modifier keys 0x%02X", m_key), HIDKBModifierBaseColor + m_key );
        AddCell("R-Ctrl" , (m_key & 0x10)>0 , Format("Keyboard modifier keys 0x%02X", m_key), HIDKBModifierBaseColor + m_key );
        AddCell("R-Shift", (m_key & 0x20)>0 , Format("Keyboard modifier keys 0x%02X", m_key), HIDKBModifierBaseColor + m_key );
        AddCell("R-Alt"  , (m_key & 0x40)>0 , Format("Keyboard modifier keys 0x%02X", m_key), HIDKBModifierBaseColor + m_key );
        AddCell("R-Win"  , (m_key & 0x80)>0 , Format("Keyboard modifier keys 0x%02X", m_key), HIDKBModifierBaseColor + m_key );
    }
    else
    {
        if( mod_key_str == "none" )
            AddCell("Modifier Keys", mod_key_str , "Modifier keys:" + ToBitString(m_key,8) + "\n" + ctrlTooltip +"\n-->Tip:expand HidDev block for details", GreyColor, _MONOCOLOR );
        else
            AddCell("Modifier Keys", mod_key_str , "Modifier keys:" + ToBitString(m_key,8) + "\n" + ctrlTooltip +"\n-->Tip:expand HidDev block for details", HIDKBModifierBaseColor + m_key );
    }

    oem_val = GetDataByte(1);
    DecodedBytes++;

    if( SimpleShowItem() )
    {
        SetCellColor( HIDKBOEMBaseColor + m_key );
        AddPayLoadCell("OEM", Format("0x%02X", oem_val), "OEM reserved" );
        RestoreCellColor();
    }

    key_buffer = "";

    if( m_key == 0 )
        ctrlToolTip = "";

    key_last=0;

    while( in.DataLength > DecodedBytes )
    {
        key = GetDataByte(DecodedBytes);
        if( key_last == 0 )
            key_last = key;

        if( (key>0) && (key<128) && (shift == 1) )
            key=key+128;

        DecodedBytes = DecodedBytes + 1;
        key_str = Key_Code2Ascii [ key ];

        #    key_str = Format("%c",key);
        #    if ((key < 32) & (key>0)) key_str = Format("ASCII(%d)", key);
        if( (key_str == "") && (key != 0) )
            key_str = Format("[Kcode=%d]", key);

        if( key != 0 )
        {
            if( alt == 1 )
                key_str = "<Alt>" + key_str;

            if( ctrl == 1 )
                key_str = "<Ctrl>" + key_str;

            key_buffer = key_buffer + key_str;
        }

        if( SimpleShowItem() )
        {
            if( key != 0 )
            {
                SetCellColor( HIDKBKeyBaseColor + m_key );
                AddPayLoadCell( "Key", key_str, Format("Keyboard Keycode data byte 0x%02X", key) );
            }
            else
            {
                SetCellColor( GreyColor );
                AddPayLoadCell( "Key", key_str, Format("Keyboard Keycode data byte 0x%02X", key), _MONOCOLOR );
            }

            RestoreCellColor();
        }
    }

    if( !SimpleShowItem() )
    {
        if( key_last == 0 )
            AddCell("KeyData", key_buffer, Format( "Data in buffer\nLast Keycode=0x%02x\n-->Tip:expand HidDev block for details",key_last), GreyColor, _MONOCOLOR );
        else
            AddCell("KeyData", key_buffer, Format( "Data in buffer\nLast Keycode=0x%02x\n-->Tip:expand HidDev block for details",key_last), HIDKBKeyBaseColor + m_key );
    }
    
    return DecodedBytes;
}

#####################################################
# MOUSE decoding
#####################################################

DecodeMouseOutput()
{
    SetCellColor( HIDMouseColor );
    AddCaptionCell( "HID", "Mouse", "This data payload represents a Mouse Human\nInterface Device (HID) Interrupt-IN message.", 
                FieldColor, [_TABULARCELL, CELL_HID_MOUSE, "TEXT_CAPTION" ]);  # Will allow for the expansion of certain fields
    RestoreCellColor();

    AddSeparator();

    DecodedBytes = 0;
    
    if( in.HasReportID )
    {
        report_id = GetDataByte(DecodedBytes);
        DecodedBytes++;
        
        AddViewFieldEntry("Report ID", BitCurrentFieldLength, BitCurrentFieldOffset-8, Format("%d", report_id), "Report ID items are used to indicate which data fields are represented in each report structure.", 1, FieldColor );
        AddCell("Report ID", Format("%d", report_id), "Report ID items are used to indicate which data fields are represented in each report structure.", FieldColor );
    }
    
    buttons = GetDataByte(DecodedBytes);
    DecodedBytes++;

    tooltip="Status of buttons:";
    if( buttons & 0x01) tooltip += "\n  Left Button pressed";
    if( buttons & 0x02) tooltip += "\n  Right Button pressed";
    if( buttons & 0x04) tooltip += "\n  Middle Button pressed";
    if( buttons & 0x08) tooltip += "\n  B4 Button pressed";
    if( buttons & 0x10) tooltip += "\n  B5 Button pressed";
    if( buttons & 0x20) tooltip += "\n  B6 Button pressed";
    if( buttons & 0x40) tooltip += "\n  B7 Button pressed";
    if( buttons & 0x80) tooltip += "\n  B8 Button pressed";
    if(buttons == 0x00) tooltip += "\n  None Pressed";

    AddViewFieldEntry( "Buttons", BitCurrentFieldLength, BitCurrentFieldOffset-8, Format("0x%02X", buttons), tooltip, 1, FieldColor );

    if( SimpleShowItem() )
    {
        AddCell("Left"  , buttons & 0x01, "Left Mouse Button 1=pressed"   , HIDMouseButtLeftColor );
        AddCell("Right" , buttons & 0x02, "Right Mouse Button 1=pressed"  , HIDMouseButtRightColor );
        AddCell("Middle", buttons & 0x04, "Middle Mouse Button 1=pressed" , HIDMouseButtMiddleColor );
        AddCell("B4"    , buttons & 0x08, "B4 Mouse Button 1=pressed"     , HIDMouseButtOtherColor );
        AddCell("B5"    , buttons & 0x10, "B5 Mouse Button 1=pressed"     , HIDMouseButtOtherColor );
        AddCell("B6"    , buttons & 0x20, "B6 Mouse Button 1=pressed"     , HIDMouseButtOtherColor );
        AddCell("B7"    , buttons & 0x40, "B7 Mouse Button 1=pressed"     , HIDMouseButtOtherColor );
        AddCell("B8"    , buttons & 0x80, "B8 Mouse Button 1=pressed"     , HIDMouseButtOtherColor );
    }
    else
    {
        AddCell("Buttons", Format("0x%02X", buttons), tooltip, 0x335566);
    }

    AddSeparator();

    xVal = GetDataByte(DecodedBytes);
    DecodedBytes++;

    if( xVal & 0x80 )
        xVal = xVal | 0xFFFFFF00;

    SetCellColor( HIDMouseXMoveColor );
    AddPayLoadCell( "XMove", xVal, Format( "Amount of movement in the X direction - 0x%02X", xVal & 0xFF ) );
    RestoreCellColor();

    yVal = GetDataByte(DecodedBytes);
    DecodedBytes++;

    if( yVal & 0x80 )
        yVal = yVal | 0xFFFFFF00;

    SetCellColor( HIDMouseYMoveColor );
    AddPayLoadCell( "YMove", yVal, Format("Amount of movement in the Y direction - 0x%02X", yVal & 0xFF) );
    RestoreCellColor();

    if (in.DataLength > DecodedBytes)
    {
        # wheel information is optional
        wheelVal= GetDataByte(DecodedBytes);
        DecodedBytes++;

        SetCellColor( HIDMouseWheelMoveColor );
        AddPayLoadCell("Wheel", wheelVal-256*(wheelVal>127), Format("Amount of movement on the Wheel 0x%02X",wheelVal) );
        RestoreCellColor();
    }

    while (in.DataLength > DecodedBytes)
    {
        dbyte= GetDataByte(DecodedBytes);
        DecodedBytes++;

        SetCellColor( 0xF2BB80 + dbyte );
        AddPayLoadCell( Format("Byte-%d",DecodedBytes), dbyte, Format("Keyboard Keycode data byte 0x%02X", dbyte) );
        RestoreCellColor();
    }

    AddSeparator();
    
    return DecodedBytes;
}


####################################################################################
#                       USBTracer specific caption cell                            #
####################################################################################

AddSpecCaptionCell(caption, text, tooltip, FieldColor, addparam, addparam1, addparam2 )
{
    AddCell(caption, text, tooltip, FieldColor, _USBBULK_HEADER, addparam, addparam1, addparam2 );
    return 1;
}