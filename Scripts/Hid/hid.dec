  "<s-left>","<s-down>","<up>", ""  , "/" , "*"    , "-"     , "+"      ,"<ENTER>", "1"     , "2"    , "3"    , "4"     , "5"     , "6"   , "7" ,
  "8"     , "9"   , "0"  , "." , ""  , ""     ,"<Power>", "="      , "F13"   , "F14"   , "F15"  , "F16"  , "F17"   ,"F18"    , "F19" ,"F20",
  "F21"   , "F22" , "F23","F24", ""  ,"<help>", "<menu>","<select>", "<stop>","<again>", ""     , ""     , ""      , ""      , ""    , ""  ,
  ""      , ""    , ""   , ""  , ""  , ""     , ""      , ""       , ""      , ""      , ""     , ""     , ""      , ""      , ""    , ""  ,
  ""      , ""    , ""   , ""  , ""  , ""     , ""      , ""       , ""      , ""      , ""     , ""     , ""      , ""      , ""    , ""  ,
