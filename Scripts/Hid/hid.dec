%include "CATCScriptAPI.inc"      #.inc files that are included
%include "UsbCommon.inc"

#----  Input
# in.Data       - Data_block to decode
# in.DataLength - Length of Data_block
#
#----  Output
# out.Decoded   - amount of Data has been decoded
# out.State
# out.Data
# out.DataLength
#

const Tabular_Def_Table = Map( 
[   
    #-----------------------------------------------------------------------------------------------------
    #       id                  ,      colId                          , 		containerCellId
    #-----------------------------------------------------------------------------------------------------
    [ CELL_HID_KEYBOARD         , TABULAR_SCRIPT_COLUMN_ID_SUBTYPE    , TABULAR_SCRIPT_CONTAINER_CELL_ID_NONE ],
    [ CELL_HID_MOUSE            , TABULAR_SCRIPT_COLUMN_ID_SUBTYPE    , TABULAR_SCRIPT_CONTAINER_CELL_ID_NONE ]

] );

set ModuleType  = "DataBlock Decoder";
set LevelName   = "HIDKeyboard";
set LevelColor  = 0x898989;

set OutputType      = "HID Interrupt In Endp";
set UsbDecodeType   = "Endpoint";
set UsbEndpId       = 1;            # Just a unique value for each endpoint of the same Class/Vendor/Product
                                    # to distinguish them

set UsbClassCode    = 0x03; # HID
set UsbEndpType     = "Interrupt";
set UsbEndpDir      = "In";

set UsbScriptDecodeType  = 1; # Combined decoding for Cells and Text decoding

#set UsbSubClass     = 0x01; # Boot Interface
#set UsbProtocol     = 0x01; # Hid Keyboard


#
# Parsing entry point
#

# User can select the colors for the fields he/she chooses
set HIDKeyboardColor        = 0xF2B6AA;
set HIDKBKeyBaseColor       = 0xF2BBAA;
set HIDKBModifierBaseColor  = 0xB2BB8A;
set HIDKBOEMBaseColor       = 0xA2BBAA;

set HIDMouseColor           = 0x22BBAA;
set HIDMouseButtonsColor    = 0x335566;
set HIDMouseButtLeftColor   = 0x737566;
set HIDMouseButtRightColor  = 0x339566;
set HIDMouseButtMiddleColor = 0x335596;
set HIDMouseButtOtherColor  = 0x888888;
set HIDMouseXMoveColor      = 0x336677;
set HIDMouseYMoveColor      = 0x337788;
set HIDMouseWheelMoveColor  = 0x338899;

set wDecodeCellColor        = 0x898989;
set RequestFieldColor       = 0xA42A2A;
set RequestDataFieldColor   = 0x302A2A;
set GreyColor               = 0x888888;

const ErrorColor = 0x0000FF;

ProcessData()
{
    CommonDecoderInit();        # Initialization of SRP common global variables [found in CATCScriptAPI.inc]

    AddSeparator();

    if( in.DataLength < 8 )
    {
          out.Decoded = DecodeMouseOutput() ;
    }
    else if( in.DataLength == 8 )
    {
        out.Decoded = DecodeHIDKeyboardOutput() ;        
    }
    else
    {
        AddShortDataHeader("UNKNOWN HID Interrupt-IN Message");
        AddViewFieldEntry("Data", in.DataLength, 0, "data", "UNKNOWN HID Interrupt IN Message", 1, FieldColor );
        out.Decoded = 0;
    }

    out.Data = in.Data;
    out.DataLength = in.DataLength;
    out.State = "Complete";

    return Complete();
}

# Key scan code to ASCII mapping, code, codes above 0x80 are used for shift key mod
set Key_Code2Ascii = [
