# Define your HID Report Descriptor as in following examples.
# Then the HIDDecoder will decode assigned interrupt-in, out transfers accordingly

#Usage Page (Generic Desktop Ctrls)                                     0x05
#Usage (Joystick)                                                       0x09
#Report Size (8)                                                        0x75
#Report Count (1)                                                       0x95
#Input (Const,Var,Abs,No Wrap,Linear,Preferred State,No Null Position)  0x81
#Output (Data, Variable, Absolute)                                      0x91
#Usage Page (Vendor Defined)                                            0x06

set UseHIDReportDescriptorItems = 0; # To use manually defined HID Report Descriptors below set this value to 1 and comment out following empty list

set HIDReportDescriptorItems =
[
];

