GET_IDLE()
{
    wValue      = GetDataWord(CurrentIndex); CurrentIndex = CurrentIndex + sizeOf_w;
    reportID    =  wValue & 0x00FF;
    reportType  =  wValue >>8;
    str = "Report ID: ";
    str += select
    {
        reportID == 0x00  : "Not used";
        default           :  Format ("0x%02X", reportID );
    };

    str += select
    {
        reportType == 0x0 : ", Type: Zero";
        default           : ", Type: Error, should be zero";
    };

    AddSimplePLCell( "wValue" , Format ("0x%04X", wValue), str, FieldColor, [_TABULARCELL, CELL_WVALUE, "TEXT_CAPTION"]);
    wIndex   = GetDataWord(CurrentIndex); CurrentIndex = CurrentIndex + sizeOf_w;
    AddSimplePLCell( "wIndex" , Format ("0x%04X", wIndex) , "Interface");

    wLength  = GetDataWord(CurrentIndex); CurrentIndex = CurrentIndex + sizeOf_w;
    if (DataAvailable(CurrentIndex) <= 0) # no more data to decode.
    {
        if (wLength > 0)
        {
            AddSimplePLCell( "wLength", Format ("0x%04X", wLength ) , "wLength error", _ERROR);
        }
        else
        {
            AddSimplePLCell( "wLength", Format ("0x%04X", wLength ) , "wLength");
        }
        return CurrentIndex;
    }
    else
    {
        if (wLength != 0x01)
            AddSimplePLCell( "wLength ", Format ("0x%04X", wLength ) , "wLength error", _ERROR);
        else
            AddSimplePLCell( "wLength ", Format ("0x%04X", wLength ) , "One");

        AddDecSeparator();

        actualLen = DataAvailable(CurrentIndex);
        if (actualLen > 1)
        {
            Data  = Format("0x%02X ", GetDataByte (CurrentIndex)); CurrentIndex = CurrentIndex + sizeOf_b;
            for ( i = 1; i < actualLen ; i ++ )
            {
                Data += Format("%02X "  , GetDataByte(CurrentIndex));
                CurrentIndex = CurrentIndex + sizeOf_b;
            }
            SetFieldOffsetLen( GetBitOffset(), actualLen * 8);
            AddSimplePLCell ("Data",Data, "Idle rate should be only one byte.", _ERROR);
        }
        else
        {
            Data  = Format("0x%02X ", GetDataByte (CurrentIndex)); CurrentIndex = CurrentIndex + sizeOf_b;
            str = "Idle rate";
            AddSimplePLCell ("Data", Data, str);
        }

    }

return CurrentIndex;

}


SET_IDLE()
{
    wValue      = GetDataWord(CurrentIndex); CurrentIndex = CurrentIndex + sizeOf_w;
    reportID    =  wValue & 0x00FF;
    duration  =  wValue >>8;

    str = select
    {
        reportID == 0x00  : "Idle rate applies to all input reports generated by device";
        default           :  Format ("Idle rate only applies to this report ID: 0x%02X ", reportID );
    };

    str += select
    {
        duration == 0x00 : ", duration: Infinite";
        default          : Format (", duration: 0x%02X nanosecond", duration * 4 );
    };

    AddPayLoadCell( "wValue" , Format ("0x%04X", wValue), str, FieldColor, [_TABULARCELL, CELL_WVALUE, "TEXT_CAPTION"]);
    wIndex   = GetDataWord(CurrentIndex); CurrentIndex = CurrentIndex + sizeOf_w;
    AddPayLoadCell( "wIndex" , Format ("0x%04X", wIndex) , "Interface");

    wLength  = GetDataWord(CurrentIndex); CurrentIndex = CurrentIndex + sizeOf_w;

    if (wLength != 0)
        AddPayLoadCell( "wLength", Format ("0x%04X", wLength ) , "wLength error, should be zero", _ERROR);
    else
        AddPayLoadCell( "wLength", Format ("%d", wLength ) , "Zero");

    AddDecSeparator();

    if( DataAvailable(CurrentIndex) >0)
    {
        actualLen = DataAvailable(CurrentIndex);
        Data  = Format("0x%02X ", GetDataByte (CurrentIndex)); CurrentIndex = CurrentIndex + sizeOf_b;
        for ( i = 1; i < actualLen ; i ++ )
        {
            Data += Format("%02X "  , GetDataByte(CurrentIndex));
            CurrentIndex = CurrentIndex + sizeOf_b;
        }
        SetFieldOffsetLen( GetBitOffset(), actualLen * 8);
        err_tooltip = "Not applicable for this type of request";
        AddPayLoadCell ("Data", Data, err_tooltip , _ERROR);
    }

return CurrentIndex;
}


GET_PROTOCOL()
{

    wValue      = GetDataWord(CurrentIndex); CurrentIndex = CurrentIndex + sizeOf_w;
    if (wValue == 0x0)
        AddSimplePLCell( "wValue" , Format ("0x%04X", wValue), "Zero", FieldColor, [_TABULARCELL, CELL_WVALUE, "TEXT_CAPTION"]);
    else
        AddSimplePLCell( "wValue" , Format ("0x%04X", wValue), "Should be zero", _ERROR, [_TABULARCELL, CELL_WVALUE, "TEXT_CAPTION"]);

    wIndex   = GetDataWord(CurrentIndex); CurrentIndex = CurrentIndex + sizeOf_w;
    AddSimplePLCell( "wIndex" , Format ("0x%04X", wIndex) , "Interface");

    wLength  = GetDataWord(CurrentIndex); CurrentIndex = CurrentIndex + sizeOf_w;
    if (DataAvailable(CurrentIndex) <= 0) # no more data to decode.
    {
        if (wLength > 0)
        {
            AddSimplePLCell( "wLength", Format ("0x%04X", wLength ) , "wLength error", _ERROR);
        }
        else
        {
            AddSimplePLCell( "wLength", Format ("0x%04X", wLength ) , "wLength");
        }
        return CurrentIndex;
    }
    else
    {
        if (wLength != 0x01)
            AddSimplePLCell( "wLength ", Format ("0x%04X", wLength ) , "wLength error, should be one", _ERROR);
        else
            AddSimplePLCell( "wLength ", Format ("0x%04X", wLength ) , "One");

        AddDecSeparator();

        actualLen = DataAvailable(CurrentIndex);
        if (actualLen > 1)
        {
            Data  = Format("0x%02X ", GetDataByte (CurrentIndex)); CurrentIndex = CurrentIndex + sizeOf_b;
            for ( i = 1; i < actualLen ; i ++ )
            {
                Data += Format("%02X "  , GetDataByte(CurrentIndex));
                CurrentIndex = CurrentIndex + sizeOf_b;
            }
            SetFieldOffsetLen( GetBitOffset(), actualLen * 8);
            AddSimplePLCell ("Data",Data, "Protocol field should be only one byte.", _ERROR);
        }
        else
        {
            Data  = Format("0x%02X ", GetDataByte (CurrentIndex)); CurrentIndex = CurrentIndex + sizeOf_b;
            str = select
            {
                Data == 0x00 : "Boot Protocol";
                Data == 0x01 : "Report Protocol";
                default      : Format ("Protocol: 0x%02X Unknown", Data );
            };

            AddSimplePLCell ("Data", Data, str);
        }

    }

return CurrentIndex;

}



SET_PROTOCOL()
{

    wValue      = GetDataWord(CurrentIndex); CurrentIndex = CurrentIndex + sizeOf_w;
    str = select
    {
        wValue == 0x00  : "Boot Protocol";
        wValue == 0x01  : "Report Protocol";
        default         : Format ("Protocol: 0x%02X Unknown", wValue );
    };

    if (wValue < 0x2)
        AddSimplePLCell( "wValue" , Format ("0x%04X", wValue), str, FieldColor, [_TABULARCELL, CELL_WVALUE, "TEXT_CAPTION"]);
    else
        AddSimplePLCell( "wValue" , Format ("0x%04X", wValue), str, _ERROR, [_TABULARCELL, CELL_WVALUE, "TEXT_CAPTION"]);

    wIndex   = GetDataWord(CurrentIndex); CurrentIndex = CurrentIndex + sizeOf_w;
    AddSimplePLCell( "wIndex" , Format ("0x%04X", wIndex) , "Interface");

    wLength  = GetDataWord(CurrentIndex); CurrentIndex = CurrentIndex + sizeOf_w;

    if (DataAvailable(CurrentIndex) <= 0) # no more data to decode.
    {
        if (wLength > 0)
        {
            AddSimplePLCell( "wLength", Format ("0x%04X", wLength ) , "wLength error", _ERROR);
        }
        else
        {
            AddSimplePLCell( "wLength", Format ("0x%04X", wLength ) , "wLength");
        }
        return CurrentIndex;
    }
    else
    {
        if (wLength != 0x00)
            AddSimplePLCell( "wLength ", Format ("0x%04X", wLength ) , "wLength error, should be one", _ERROR);
        else
            AddSimplePLCell( "wLength ", Format ("0x%04X", wLength ) , "Zero");

        AddDecSeparator();

        actualLen = DataAvailable(CurrentIndex);
        if (actualLen > 0)
        {
            Data  = Format("0x%02X ", GetDataByte (CurrentIndex)); CurrentIndex = CurrentIndex + sizeOf_b;
            for ( i = 1; i < actualLen ; i ++ )
            {
                Data += Format("%02X "  , GetDataByte(CurrentIndex));
                CurrentIndex = CurrentIndex + sizeOf_b;
            }
            SetFieldOffsetLen( GetBitOffset(), actualLen * 8);
            AddSimplePLCell ("Data",Data, "Data is not applicable for this type of request.", _ERROR);
        }
    }

return CurrentIndex;
}
