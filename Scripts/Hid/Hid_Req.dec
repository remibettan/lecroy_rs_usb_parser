            AddSimplePLCell( "wLength ", Format ("0x%04X", wLength ) , "wLength error", _ERROR);
        else
            AddSimplePLCell( "wLength ", Format ("0x%04X", wLength ) , "Report lenght");

        AddDecSeparator();

