    bit_offset = 64;
    AddTypeCField( "ErrorInfo", bit_offset, PPM_GET_ERROR_STATUS_data_Fields );
}

PD_NOTIFICATION()
{
    bParam1 = GetDataByte(1);
    bParam2 = GetDataByte(2);
    bParam3 = GetDataByte(3);
    out.Decoded = out.Decoded + 3;
    FieldColor = PD_NOTIFICATION_COLOR;

    AddPayLoadCell( "bParam1 (Connector Number)", FormatEx("%d", bParam1), "");
    
    if( bParam2 == 1 )
    {
        AddPayLoadCell( "bParam2", "AUTH");
        
        bParam3Text = FormatEx("Invalid Value (%d)", bParam3);
        if( bParam3 == 0 )
            bParam3Text = "Success";
        else if( bParam3 == 0x80 )
            bParam3Text = "Error";
        AddPayLoadCell( "bParam3", bParam3Text, "");
    }
    else if( bParam2 == 2 )
    {
        AddPayLoadCell( "bParam2", "FWU", "");
        
        bParam3Text = FormatEx("Invalid Value (%d)", bParam3);
        if( bParam3 == 0 )
            bParam3Text = "0";
        AddPayLoadCell( "bParam3", bParam3Text, "");
    }
    else
    {
        AddPayLoadCell( "bParam2", FormatEx("Invalid Value (%d)", bParam2), "" );
        AddPayLoadCell( "bParam3", FormatEx("Invalid Value (%d)", bParam3), "" );
    }    
}

BILLBOARD_NOTIFICATION()
{
    bParam1 = GetDataByte(1);
    bParam2 = GetDataByte(2);
    bParam3 = GetDataByte(3);
    out.Decoded = out.Decoded + 3;
    FieldColor = BB_NOTIFICATION_COLOR;
    AddZeroValuedParam(1, bParam1);
    AddZeroValuedParam(2, bParam2);
    AddZeroValuedParam(3, bParam3);
}
