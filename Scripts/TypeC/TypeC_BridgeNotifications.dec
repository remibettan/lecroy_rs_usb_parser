GET_CONNECTOR_STATUS_data()
{
    FieldColor = PPM_GET_CONNECTOR_STATUS_COLOR;
    byte_offset = 8;
    bit_offset = byte_offset * 8;
    
    AddTypeCField( "ConnStatusChange", bit_offset, PPM_GET_CONNECTOR_STATUS_data_Fields );
    
    connection_status = GetTypeCFieldValue("ConnStatus", PPM_GET_CONNECTOR_STATUS_data_Fields, bit_offset);
    if( connection_status )
    {
        AddTypeCField( "PowOprMode", bit_offset, PPM_GET_CONNECTOR_STATUS_data_Fields );
    }
    else
    {
        AddTypeCField( "NoConnectionReserved0", bit_offset, PPM_GET_CONNECTOR_STATUS_data_Fields );         
    }
    
    AddTypeCField( "ConnStatus", bit_offset, PPM_GET_CONNECTOR_STATUS_data_Fields );
    
    if( connection_status )
    {
        AddTypeCField( "PowerDir", bit_offset, PPM_GET_CONNECTOR_STATUS_data_Fields );
        AddTypeCField( "ConnPartnerFlags", bit_offset, PPM_GET_CONNECTOR_STATUS_data_Fields );
        AddTypeCField( "ConnPartnerType", bit_offset, PPM_GET_CONNECTOR_STATUS_data_Fields );
        
        is_provider = GetTypeCFieldValue("PowerDir", PPM_GET_CONNECTOR_STATUS_data_Fields, bit_offset);
        if( is_provider )
        {
            AddTypeCField( "BatteryChargingStatus", bit_offset, PPM_GET_CONNECTOR_STATUS_data_Fields );
            AddTypeCField( "ProvCapLimitedReason", bit_offset, PPM_GET_CONNECTOR_STATUS_data_Fields );
            AddTypeCField( "Reserved", bit_offset, PPM_GET_CONNECTOR_STATUS_data_Fields );
        }
        else
        {
            AddTypeCField( "NonProviderReserved", bit_offset, PPM_GET_CONNECTOR_STATUS_data_Fields );
        }
        
        power_opr_mode = GetTypeCFieldValue("PowOprMode", PPM_GET_CONNECTOR_STATUS_data_Fields, bit_offset);
        if( power_opr_mode == 3 ) # If Power Operation Mode field is set to PD
        {
            AddRequestDataObjectFields( byte_offset );
        }

    }
    else
    {
        AddTypeCField( "NoConnectionReserved", bit_offset, PPM_GET_CONNECTOR_STATUS_data_Fields );        
    }
}

AddRequestDataObjectFields( byte_offset )
{
    DecodeRequestDataObject( byte_offset, 0 );
}

