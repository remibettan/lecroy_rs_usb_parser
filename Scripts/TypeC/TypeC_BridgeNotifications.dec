%include "CATCScriptAPI.inc"
%include "ErrorHandlingMessages.inc"
%include "UsbCommon.inc"
%include "TypeC_Common.inc"
%include "..\PowerDelivery\PDObjectDecodings.inc"

#----  Input
# in.Data       - Data_block to decode
# in.DataLength - Length of Data_block 
#
#----  Output
# out.Decoded   - amount of data has been decoded
#

set UsbDecodeType   = "Endpoint";
set UsbReqType      = "Class";
set OutputType      = "USB Type-C Bridge Notifications";
set ModuleType      = "DataBlock Decoder";
set UsbClassCode    = 0x12;
set UsbSubClass     = 0x00;
set UsbProtocol     = 0x00;
set UsbEndpType     = "Interrupt";
set UsbEndpDir      = "In";
#set UsbScriptDecodeType = 1; # explicit text decoding processing

const ErrorColor = 0x0000FF;

set TypeC_NotificationTypesTable = [
    [ 0xff, "Reserved"                 , "Reserved Value" ],
    [ 0x01, "PPM_NOTIFICATION"         , "PPM Command Responses or PPM Asynchronous Notifications" ],
    [ 0x02, "PD_NOTIFICATION"          , "Indicates that the USB Type-C Bridge has received an Authentication Request or Response from a Connector" ],
    [ 0x03, "BILLBOARD_NOTIFICATION"   , "The Billboard Notification shall be sent by the USB Type-C Bridge to indicate that there is a change to the Billboard Capability in the Device Container" ]
];

ProcessData()
{
    bNotificationType = GetDataByte(0);
    out.Decoded = 1;
    
    _row = Find(TypeC_NotificationTypesTable, bNotificationType);
    
    AddSeparator();
    
    FieldColor = [121, 18, 200];
    if( _row != null && _row[0] != 0xff )
    {
        AddPayLoadCell( "bNotificationType", _row[1], _row[2]);
        Call( _row[1] );
    }
    else
    {
        AddPayLoadCell( "bNotificationType", FormatEx("Reserved(%d)", bNotificationType), _row[2]);
    }
    
    AddSeparator();
}

AddZeroValuedParam(param_num, value)
{
    caption = FormatEx("bParam%d", param_num);
    text    = FormatEx("%d", value);
    if( value == 0 )
        AddPayLoadCell( caption, text, "Correct Value of 0");
    else
        AddPayLoadCell( caption, text, FormatEx(_err_Illegal_Value, caption, value, 0 ));
}

set PPM_Notification_Fields = [
    ["Reserved0",           0,  1, 0x1,   "Reserved",             "0x%X", null, 0, "Reserved and shall be set to 0."],
    ["ConnChangeIndicator", 1,  7, 0x7F,  "Connector Change",     "%d",   null, 0, "Connectors are indexed from 1. If this field is set to zero, then no change occurred on any of the Connectors."],
    ["DataLen",             8,  8, 0xFF,  "Data Length",          "%d",   null, 0, "This field indicates the number of additional bytes of data that follow a PPM Command Response."],
    ["Reserved1",           16, 9, 0x1FF, "Reserved",             "0x%X", null, 0, "Reserved and shall be set to 0."],
    ["NotSupported",        25, 1, 0x1,   "Not Supported",        "%d",   null, 0, "The PPM sets this field to one to indicate that it wants to indicate that it does not currently support a PPM Command. This field shall only be valid when the Command Completed Indicator field is set to one."],
    ["CancelCompleted",     26, 1, 0x1,   "Cancel Completed",     "%d",   null, 0, "The PPM sets this field to one to indicate that it has completed a CANCEL Command. This field shall only be valid when the Command Completed Indicator field is set to one."],
    ["ResetCompleted",      27, 1, 0x1,   "Reset Completed",      "%d",   null, 0, "The PPM sets this field to one to indicate that it has completed a PPM_RESET Command. If this field is set to one, then no other bits in this Data Structure shall be set by the PPM. The PPM shall clear this field on reception of the next PPM Command (not PPM_RESET) from the OSPM."],
    ["Busy",                28, 1, 0x1,   "Busy",                 "%d",   null, 0, "The value in this field shall be ignored as the field is not supported in the current version of the specification."],
    ["AckCommand",          29, 1, 0x1,   "Acknowledge Command",  "%d",   null, 0, "The PPM sets this field to one to indicate that it completes the ACK_PCR_PAN (Acknowledge PPM Command Response and/or PPM Asynchronous Notification) Command. The PPM shall automatically reset this bit when it receives the next PPM Command from the OSPM. If this field is set to one, then the only other field that can be set is the Connector Change Indicator field."],
    ["Error",               30, 1, 0x1,   "Error",                "%d",   null, 0, "The PPM sets this field to one to indicate that it encounters an error when executing the PPM Command sent to it by the OSPM. This field shall only be valid when the Command Completed Indicator field is set to one."],
    ["CommandCompleted",    31, 1, 0x1,   "Command Completed",    "%d",   null, 0, "The PPM sets this field to one to indicate that it wants to indicate that it completed the PPM Command sent to it by the OSPM."]
];

set PPMCommandResponseTable =
[
    [0xFF, "NoResponseData"                 ],
    [0x06, "GET_CAPABILITY_data"            ],
    [0x07, "GET_CONNECTOR_CAPABILITY_data"  ],
    [0x12, "GET_CONNECTOR_STATUS_data"      ],
    [0x13, "GET_ERROR_STATUS_data"          ]
];

PPM_NOTIFICATION()
{
    bParam1 = GetDataByte(1);
    bParam2 = GetDataByte(2);
    bParam3 = GetDataByte(3);
    out.Decoded = out.Decoded + 3;
    FieldColor = PPM_NOTIFICATION_COLOR;
    
    AddZeroValuedParam(1, bParam1);
    AddZeroValuedParam(2, bParam2);
    AddZeroValuedParam(3, bParam3);
    
    AddSeparator();
    
    DECODE_ABORTED_FLAG = 0;
    bit_offset = 32;
    for( i = 0; PPM_Notification_Fields[i][0] != null; i++ )
    {
        AddTypeCField( PPM_Notification_Fields[i][0], bit_offset, PPM_Notification_Fields );
    }
    data_len = GetTypeCFieldValue( "DataLen", PPM_Notification_Fields, bit_offset );
    out.Decoded = out.Decoded + 4 + data_len;
    if( data_len > 0 )
    {
        cmd = Find( PPMCommandResponseTable, Last_TypeC_PPM_Command );
        if( cmd[0] != 0xFF )
        {
            AddSeparator();
            
            Call( cmd[1] );
        }
    }
}

