%include "MS_UASPOutEndpoint.inc"


#------------------------  Common Globals -----------------------------------

set OutputType    = "Mass Strg UASP Data Out Endp";
set UsbEndpId     = 41; # just a unique value for each endpoint of the same Class/Vendor/Product to distinguish them
set UsbUASPipeId  = 4;

#
# Parsing entry point
#

ProcessData()
{
	process_as_data = 1;
	ProcessUASOutData(process_as_data);   
}