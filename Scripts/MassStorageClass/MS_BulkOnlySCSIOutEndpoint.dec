DoFormatData()
{
} 
DoReassignBlocksData()
{
} 
DoModeSelectData()
{
}
DoCopyData()
{
}
DoSendDiagnosticData()
{
}
  

ProcessTransfer()
{    
	InitType2Decoder();
    
    ProcessBulkOnlyCBW();
    
    ProcessCDBs();
	 
    return Complete();
}