 #----  Input
 # in.Data       - Data_block to decode
 # in.DataLength - Length of Data_block

 #----  Output
 # out.Decoded   - amount of data has been decoded


set OutputType      = "Standard Requests";
set UsbDecodeType   = "Request";
set UsbReqType      = "Standard";
set UsbClassCode    = 0x00;    # Class code for Standard
set UsbScriptDecodeType = 1;   # Combined decoding for Cells and Text decoding


set bReqType = 0;     #Declaring global variables
set bRequest = 0;
set wValue   = 0;
set wIndex   = 0;
set wLength  = 0;
set wPayloadColor = 0x2F5FCF;
set wDataColor = 0xABCDEF;
set wSubDataColor = 0xFEDCFF;
#set ERROR_COLOR = 0x0000FF;



set FullyDecoded = 1;  # Variable that will determine if request has been fully decoded

#
# Decoder entry point
#

ProcessData()
{
	
    CommonDecoderInit();
    ClassDescriptorTable = null;
    #SaveFieldSettings();
    UnitDecoderInit("WSB");

    FullyDecoded = 1;
    #ProcessDataInit();

    Speed        = GetDecoderHeaderByte(2);    
    tempSpeedFlag = Speed; # Gets Speed value from in.context[2]
	if(tempSpeedFlag == Super_Speed_Plus_Mode || tempSpeedFlag == SSIC_HS_Mode) 
		tempSpeedFlag = Super_Speed_Mode;
    
#    UsbSpecLevel = GetDecoderHeaderByte(?); # currently not supported in SW
#    gDeviceCompliantSpec = UsbSpecLevel; # currently uses hard coded value in StandardRequests_EDIT_OTG_WUSB_FLAG.inc
    
    out.Decoded = 0;

#    DoRequestStringTop();   # function used for text decoding

    bReqType = GetDataByte(0);
    bRequest = GetDataByte(1);
    wValue   = GetDataWord(2);
    wIndex   = GetDataWord(4);
    wLength  = GetDataWord(6);


    #AddCell( "Request", Format( "0x%X", bRequest ) );

    #FieldColor = 0x9218d4;
    #AddPayLoadCell("Script","Decoding","");


    
    _row = Find(AllStandardRequestsTable, bRequest);  # will determine which request is being used

    if (_row[0] == 0xFF)
    {
        AddSeparator();
        AddDecodedTextHeader();  # header for the text decoding
        AddReqTypeCell();
        AddRequestCell( _row[1] );
        AddWValueCell ();
        AddWIndexCell ();
        AddWLengthCell();

        out.Decoded = 8;
    }
    else
    {
   
  
        AddRequestCell( _row[1] );
        Call ( _row[1] );  # will call function for the specified request
    }

    AddSeparator();

    ############ for Debug purposes#########
    #GetNBits(in.Data, 0, 0);             #
    #ShowDataBlock(in.DataLength);        #
    ########################################

    return Complete();
}



