#***********************************************************************************
#  SET_SECURITY_DATA :
#
# bRequestType      :0x00
# bRequest          :0x12
# wValue            :Data number
# wIndex            :Zero
# wLength           :Data Length
# Data              :Security Data
#***********************************************************************************
SET_SECURITY_DATA()
{
     out.Decoded = 8;
    if( bReqType == 0x00 )
    {
        AddWValueCell(Format("%d",wValue),"Data number that represents a stage or message number");
        AddWIndexCell();
        AddWLengthCell();


        ###################################
        #     Security Data               #
        ###################################
        if (in.DataLength - 8 > 0)
        {
            AddDecSeparator();
            FieldColor = wPayloadColor;
            AddPLCellMonoNoDlg("Sec Data","Sec Data");
            ShowDataBlock(in.DataLength - 8);
            out.Decoded += in.DataLength - 8;
        }
    }
    else
    {
        AddIllegalTypeCell("SET SECURITY DATA");
    }

}
