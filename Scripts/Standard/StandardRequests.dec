#***********************************************************************************
#  GET_HANDSHAKE :
#
# bRequestType      :0x80
# bRequest          :0x10
# wValue            :2
# wIndex            :zero
# wLength           :46
# Data              :handshake 2
#***********************************************************************************

GET_HANDSHAKE()
{
    out.Decoded = 8;
    if (bReqType == 0x80)
    {
        if ( wValue == 2 ) # handshake 2
        {
           DoHandshakeDecoding(wValue);
        }
        else
        {
            AddWValueCell(Format("%d", wValue), "Only 2 is allowed for GET HANDSHAKE request");
        }
    }
    else
    {
        AddIllegalTypeCell("GET HANDSHAKE request");
    }

}
/*


