{
    return "No data to decode for SET FEATURE";
}

*/

#*******************************************************************************
# SET_ADDRESS   : This request sets the device address for all future device
#                 accesses
# bReqType : 0x00
# bRequest      : 0x05
# wValue        : Device Address
# wIndex        : 0x0000
# wLength       : 0x00
# Data          : None
#*******************************************************************************
SET_ADDRESS()
{
    if (bReqType == 0x00)
    {
        FieldColor = wValueColor;
        AddWValueCell( Format ("New address %d" , wValue), Format ("New address = 0x%04X" , wValue));
        
        if (wIndex != 0)
            AddWIndexCell("", FormatEx(_err_Illegal_Value,"wIndex",wIndex,0 ) ,1 );  
         else
            AddWIndexCell("", "Correct Value of 0",0 ); 
        
        
         if (wLength != 0)
            AddWLengthCell( FormatEx(_err_Illegal_Value,"wLength",wLength,0 ) ,1 );  
         else
            AddWLengthCell( "Correct Value of 0",0 );   
    }
    else
    {
        AddIllegalTypeCell( "SET ADDRESS" );
    }
    out.Decoded = 8;
}

# end SET_ADDRESS

SET_ADDRESS_text()
{
   return "No data to decode for SET ADDRESS";
}

#*******************************************************************************
# GET_DESCRIPTOR: This request returns the specified descriptor if the descriptor
#                 exists
# bReqType : 0x80
# bRequest      : 0x06
# wValue        : Desriptor Type and Descriptor Index
# wIndex        : 0x0000 or Language ID
# wLength       : Descriptor Length
# Data          : Descriptor
#*******************************************************************************
GET_DESCRIPTOR()
{
   # do_descriptor();

    if (bReqType == 0x80) # for device or configuation descriptor only.
    {
        do_descriptor();
    }
    else if((bReqType == 0x81) && (wValue == 0x2100)||(wValue == 0x2200)||(wValue == 0x2300)) # may be class's descriptor request here  ? (Hid 1.1 spec page 49)
    {
        DecodeHidDescriptor();
    }
    else
    {
        AddIllegalTypeCell( "GET DESCRIPTOR" );
    }

    out.Decoded = in.DataLength; # start with the setup bytes
}


# end GET_DESCRIPTOR
