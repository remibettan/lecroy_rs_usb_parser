#*******************************************************************************
# SET_DESCRIPTOR : This request may be used to update existing descriptors or
#                  new descriptors may be added
# bReqType : 0x00
# bRequest      : 0x07
# wValue        : Descriptor Type and Descriptor Index
# wIndex        : Language ID
# wLength       : Descriptor Length
# Data          : Descriptor
#*******************************************************************************
SET_DESCRIPTOR()
{
    if (bReqType == 0x00)
    {
        do_descriptor();
    }
    else if(bReqType == 0x01) # may be class's descriptor request here  ? (Hid 1.1 spec page 49)
    {
        DecodeHidDescriptor();
    }
    else
    {
        AddIllegalTypeCell( "SET DESCRIPTOR" );
    }
    out.Decoded = in.DataLength; # start with the setup bytes

}
# end SET_DESCRIPTOR
