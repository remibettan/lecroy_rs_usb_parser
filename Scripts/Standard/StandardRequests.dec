#         Security-related Wireless USB Requests                                   #
####################################################################################

#***********************************************************************************
#  SET_HANDSHAKE :
#
# bRequestType      :0x00
# bRequest          :0x0F
# wValue            :1 or 3
# wIndex            :zero
# wLength           :46
# Data              :handshake1 or handshake3
#***********************************************************************************

SET_HANDSHAKE()
{
    out.Decoded = 8;
    if (bReqType == 0x00)
    {
        if ( wValue == 1 ) # handshake 1
        {
           DoHandshakeDecoding(wValue);
        }
        else if ( wValue == 3) # handshake 3
        {
            DoHandshakeDecoding(wValue);
        }
        else
        {
            FieldColor = ERROR_COLOR;
            AddWValueCell(Format("%d", wValue), "Only 1 or 3 is allowed for SET HANDSHAKE request");
        }
    }
    else
    {
        AddIllegalTypeCell("SET HANDSHAKE");
    }

}

