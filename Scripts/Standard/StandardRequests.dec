        #################################
        temp_str1 = "Handshake Type";
        temp_str1 += Format("Handshake%d",ID);
        temp_str1 += NewLine();
        #################################
        #   bStatus                     #
        #################################
        bStatus = GetDataByte(9);
        result = Find(HandshakeStatusTable, bStatus);
        temp_str1 += "Status: ";
        if (result[0] != 0xff)
        {
            temp_str1 += result[1];
            temp_str1 += " - ";
            temp_str1 += result[2];
        }
        else
        {
            temp_str1 += "Invalid";
        }
        temp_str1 += NewLine();
        ##################################
        #   tTKID                        #
        ##################################

        val = NextNBits_(24);
        if (LittleEndian == 1)
        {
            tTKID = ((val & 0xFF0000) >> 16)  |
               (val & 0x00FF00)          |
               ((val & 0x0000FF) << 16);
        }
        else
        {
            tTKID = val;
        }
        temp_str1 += "tTKID: ";
        temp_str1 += Format("0x6X", tTKID);
        temp_str1 += NewLine();
        ###################################
        #    bReserved                    #
        ###################################
        bReserved = GetDataByte(13);
        if (bReserved != 0)
        {
            temp_str1 += "Reserved: ";
            temp_str1 += Format("%d",bReserved);
            temp_str1 += " -  !ERROR, this value has to be 0";
        }
        else
            temp_str1 += "Reserved: 0";

        temp_str1 += NewLine();

        ###################################
        #     CDID                        #
        ###################################
        temp_str1 += "CDID: ";
        temp_str1 += Get16BytesData();
        temp_str1 += NewLine();

        ###################################
        #     Nonce                       #
        ###################################
        temp_str1 += "Nonce: ";
        temp_str1 += Get16BytesData();
        temp_str1 += NewLine();

        ###################################
        #     MIC                         #
        ###################################
        temp_str1 += "MIC: ";
        temp_str1 += Get8BytesData();
        temp_str1 += NewLine();
    }
    else
    {
        temp_str1 = "Conflict!";
        temp_str1 += NewLine();
        temp_str1 += Format("The bRequest & wValue indicate handshake%d",ID);
        temp_str1 += NewLine();
        temp_str1 += Format("The bMessageNumber indicates handshake%d",bMessageNumber);
        temp_str1 += NewLine();
    }
    return temp_str1;
}

