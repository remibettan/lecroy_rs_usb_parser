#*******************************************************************************
# SET_CONFIGURATION : This request sets the device configuration
# bReqType : 0x00
# bRequest      : 0x09
# wValue        : Configuration Value
# wIndex        : 0x0000
# wLength       : 0x00
# Data          : None
#*******************************************************************************
SET_CONFIGURATION()
{
    if (bReqType == 0x00)
    {
         AddWValueCell(Format ("New Configuration %d" , wValue), Format ("Set New Configuration # = 0x%04X" , wValue));

         if (wIndex != 0)
            AddWIndexCell("", FormatEx(_err_Illegal_Value,"wIndex",wIndex,0 ) ,1 );  
         else
            AddWIndexCell("", "Correct Value of 0",0 ); 
        
         if (wLength != 0)
            AddWLengthCell( FormatEx(_err_Illegal_Value,"wLength",wLength,0 ) ,1 );  
         else
            AddWLengthCell( "Correct Value of 0",0 );   
    }
    else
    {
        AddIllegalTypeCell( "SET CONFIGURATION" );
    }
    out.Decoded = 8;
}
# end SET_CONFIGURATION
