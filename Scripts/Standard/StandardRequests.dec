#*******************************************************************************
# CLEAR_FEATURE : This request is used to clear or disable a specific feature
# bReqType : 0x00/01/02
# bRequest      : 0x01
# wValue        : Feature Selector
# wIndex        : Zero/Interface/Endpoint
# wLength       : 0x00
# Data          : None
#*******************************************************************************
CLEAR_FEATURE()
{

    if( tempSpeedFlag == Super_Speed_Mode )
		{
			  DoClearFeatureForUSB3();
			  return 0;
		}
    ##############################################
    #               Device                       #
    ##############################################
    if (bReqType == 0x00)
    {

        row = Find(DeviceFeatureSelectorTable, wValue);
        AddWValueCell( "", row[1] );
        
        if (wIndex != 0)
            AddWIndexCell("", FormatEx(_err_Illegal_Value,"wIndex",wIndex,0 ) ,1 );  
         else
            AddWIndexCell("", "Correct Value of 0",0 ); 
        
        
         if (wLength != 0)
            AddWLengthCell( FormatEx(_err_Illegal_Value,"wLength",wLength,2 ) ,1 );  
         else
            AddWLengthCell( "Correct Value of 0",0 );   
        
        if ( row[1] == "WUSB_DEVICE" )
        {
            WUSBSelector = GetDataByte(4); # The lower byte of wIndex is WUSB feature selector (WUSB 1.0 7.3.1.1)
            FeatureValue = GetDataByte(5); # The higher byte of wIndex is zero or WUSB feature value
            indexRow = Find(WUSBFeatureSelectorTable, WUSBSelector);

            FieldColor = wDataColor;
            SetFieldOffsetLen( 48, 8 );
            AddPayLoadCell("Feature", indexRow[1], Format("0x%02X",WUSBSelector));

            FieldColor = wDataColor;
            IncFieldOffset( 8 );
            AddPayLoadCell("Value", Format("0x%02X", FeatureValue), "WUSB Feature Value");
            AddWLengthCell ("Length of the payload, should set to 0");
        }

    }
    ##############################################
    #               Interface                    #
    ##############################################
    else if (bReqType == 0x01)
    {
        FieldColor = ERROR_COLOR;
        FormatValue=Format("Clear Interface # %d Feature", wIndex);
        AddGenWValueCell( FormatValue, Format ("0x%04X", wValue) , "Error: Interface CLEAR_FEATURE not defined!");
        
         if (wLength != 0)
            AddWLengthCell( FormatEx(_err_Illegal_Value,"wLength",wLength,2 ) ,1 );  
         else
            AddWLengthCell( "Correct Value of 0",0 );   
    }
    ##############################################
    #              Endpoint                      #
    ##############################################
    else if (bReqType == 0x02)
    {
        FieldColor = wDataColor;
        if (wIndex & 0x80)
        {
            FormatValue=Format("Clear Endpoint # %d IN Feature", wIndex & 0xF);
        }
        else
        {
            FormatValue=Format("Clear Endpoint # %d OUT Feature", wIndex & 0x0F );
        }
        if (wValue == 0)
        {
            AddGenWValueCell( "wValue" , "ENDPOINT_HALT" , "value = 0");
            if (wIndex & 0x80)          
                AddGenWIndexCell( "wIndex" , Format ("Endpoint %d IN", wIndex & 0xF), FormatValue);
            else
                AddGenWIndexCell( "wIndex" , Format ("Endpoint %d OUT", wIndex & 0xF), FormatValue);           
        }
        else
        {
            FieldColor = ERROR_COLOR;
            AddGenWValueCell( "wValue", Format ("Undefined: 0x&04X", wValue) , "Error.  Only legal value is 0." );
        }
         if (wLength != 0)
            AddWLengthCell( FormatEx(_err_Illegal_Value,"wLength",wLength,2 ) ,1 );  
         else
            AddWLengthCell( "Correct Value of 0",0 );  
    }
    ###############################################
    #            ReqType Illegal                  #
    ###############################################
    else
    {
        AddIllegalTypeCell( "CLEAR FEATURE" );
    }

    out.Decoded = 8;

}
# end CLEAR_FEATURE
/*
CLEAR_FEATURE_text()
{
    return "No Data to decode for CLEAR FEATURE";
}
*/

#*******************************************************************************
# SET_FEATURE   : This request is used to set or enable a specific feature
# bReqType : 0x00/0x01/0x02
# bRequest      : 0x03
# wValue        : Feature Selector
# wIndex        : Zero/Interface/Endpoint
# wLength       : 0x00
# Data          : None
#*******************************************************************************
SET_FEATURE()
{
    if ( IsPDFeature( wValue ) )
	{
        PD_DecodeSetPDFeature();
		return 0;
    }
	if( tempSpeedFlag == Super_Speed_Mode )
	{
		  DoSetFeatureForUSB3();
		  return 0;
	}

    ##############################################
    #               Device                       #
    ##############################################
    if (bReqType == 0x00)
    {     	 	
        row = Find(DeviceFeatureSelectorTable, wValue);
        #AddWValueCell("", row[1] );  --> This line is replicated in instances below to add customization for OTG_DEVICE under WUSB_DEVICE (they conflict)

        if (row[1] == "TEST_MODE" )
        {
            AddWValueCell(row[1], FormatEx("wValue = 0x%04X\n\n",wValue) + row[1]);
            TestModeSelector = GetDataByte(5);
            TestModeText = GetTestModeSelectorTooltip(TestModeSelector);
            FieldColor = wDataColor;
            SetFieldOffsetLen( 40, 8 );
            AddPayLoadCell("Test Mode", Format("0x%02X", TestModeSelector), TestModeText);
            AddWLengthCell ("Length of the payload, should set to 0");
        }

        else if ( row[1] == "WUSB_DEVICE" )
        {
            #Are WUSB_Devices what the USER is decoding? (Flag defined/set in "StandardRequests_EDIT_OTG_WUSB_FLAG.inc".) If so decode.
            if( StdReqDeviceTypeFLAG == WUSB_Device )
            {
                AddWValueCell(row[1], FormatEx("wValue = 0x%04X\n\n",wValue) + row[1] + "\n\nNOTE: If this device is an OTG device, to decode\ndecode properly, set the StdReqDeviceTypeFLAG in\nfile 'StandardRequests_EDIT_OTG_WUSB_FLAG.inc'\nlocated in the Scripts\Standard folder." );
                WUSBSelector = GetDataByte(4); # The lower byte of wIndex is WUSB feature selector (WUSB 1.0 7.3.1.1)
                FeatureValue = GetDataByte(5); # The higher byte of wIndex is zero or WUSB feature value
                indexRow = Find(WUSBFeatureSelectorTable, wIndex);

                FieldColor = wDataColor;
                SetFieldOffsetLen( 40, 8 );
                AddPayLoadCell("Feature", indexRow[1], Format("0x%02X",WUSBSelctor));
                IncFieldOffset( 8 );
                AddPayLoadCell("Value", Format("0x%02X", featureValue), "WUSB Feature Value");
                AddWLengthCell ("Length of the payload, should set to 0");
            }
            #Else, the USER is decoding OTG_Devices --> The Flag is set/defined in "StandardRequests_EDIT_OTG_WUSB_FLAG.inc".
            else
            {
                AddWValueCell("b_hnp_enable", Format("wValue = 0x%04X\n\nOTG Feature: b_hnp_enable\n\nNOTE: If this device is a WUSB device, to decode\ndecode properly, set the StdReqDeviceTypeFLAG in\nfile 'StandardRequests_EDIT_OTG_WUSB_FLAG.inc'\nlocated in the Scripts\\Standard folder.",wValue) );
                SetCellColor(FieldColor);
                index_tooltip = Format("wIndex = 0x%04X",wIndex);
                length_tooltip= Format("wLength = 0x%04X",wLength);
                if(wIndex != 0)
                {
                    SetCellColor(ERROR_COLOR);
                    index_tooltip += "\n\n ERROR - Only Legal Value is 0!";
                }
                AddWIndexCell( "", index_tooltip);
                RestoreCellColor();
                if(wLength != 0)
                {
                    SetCellColor(ERROR_COLOR);
                    length_tooltip += "\n\n ERROR - Only Legal Value is 0!";
                }
                AddWLengthCell(length_tooltip);
                RestoreCellColor();
            }
        }
        else
        {
            AddWValueCell(row[1], FormatEx("wValue = 0x%04X\n\n",wValue) + row[1] );
            SetCellColor(FieldColor);                               #Going to Call RestoreCellColor below regardless of color not changing, saving the color value
            index_tooltip = Format("wIndex = 0x%04X",wIndex);
            length_tooltip= Format("wLength = 0x%04X",wLength);
            if( (row[0]==4)||(row[0]==5) )                          #If Feature Selector = 4 or 5, check for zeroes
            {
                if(wIndex != 0)
                {
                    SetCellColor(0x0000FF);
                    index_tooltip += "\n\n ERROR - Only Legal Value is 0!";
                }
            }
            AddWIndexCell("", index_tooltip);
            RestoreCellColor();
            if( (row[0] == 4)||(row[0]==5) )
            {
                if(wLength != 0)
                {
                    SetCellColor(ERROR_COLOR);
                    length_tooltip += "\n\n ERROR - Only Legal Value is 0!";
                }
            }
            AddWLengthCell(length_tooltip);
            RestoreCellColor();
        }
    }
    ##############################################
    #               Interface                    #
    ##############################################
    else if (bReqType == 0x01)
    {
        FieldColor = ERROR_COLOR;
        FormatValue=Format("Set Interface # %d Feature", wIndex);
        AddGenWValueCell(FormatValue, Format ("0x%04X", wValue) , "Error: Interface SET_FEATURE not defined!");
        AddWLengthCell ("Length of the payload, should set to 0");
    }
    ##############################################
    #              Endpoint                      #
    ##############################################
    else if (bReqType == 0x02)
    {
        if (wIndex & 0x80)
        {
            FormatValue=Format("Set Endpoint # %d IN Feature", wIndex & 0xF);
        }
        else
        {
            FormatValue=Format("Set Endpoint # %d OUT Feature", wIndex & 0x0F );
        }
        if (wValue == 0)
        {
            AddGenWValueCell(FormatValue, "ENDPOINT_HALT" , "value = 0");
        }
        else
        {
            FieldColor = ERROR_COLOR;
            AddGenWValueCell(FormatValue, Format ("Undefined: 0x&04X", wValue) , "Error.  Only legal value is 0." );
        }
        AddWLengthCell ("Length of the payload, should set to 0");
    }
    ###############################################
    #            ReqType Illegal                  #
    ###############################################
    else
    {
        AddIllegalTypeCell( "SET FEATURE" );
    }
    out.Decoded = 8;
}

# end SET_FEATURE
