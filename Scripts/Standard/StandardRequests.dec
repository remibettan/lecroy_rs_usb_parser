DoHandshakeDecoding(ID)
{
    AddWValueCell();
    AddWIndexCell();
    AddWLengthCell();


    # End the Setup Data table and start a new one starting at offset 0
    Global_BitField_offset = 64;
    CurrentFldInit();

    AddCaptionToDlg("Handshake Message Data");

    if (in.DataLength - 8 >= 1)
    {
        bMessageNumber = NextNBits_(8);
        #AddPayLoadCell ("message", Format("%d", bMessageNumber), "");
        if (bMessageNumber == ID)
        {
            #################################
            #   bMessageNumber              #
            #################################
            FieldColor = wDataColor;
            AddPayLoadCell("Hndshk Type", Format("Handshake%d",ID), "Handshake Type");
            #################################
            #   bStatus                     #
            #################################
            if (in.DataLength - 8 >= 1 + 1 )
            {
                FieldColor = wDataColor;
                bStatus = NextNBits_(8);
                result = Find(HandshakeStatusTable, bStatus);
                if (result[0] != 0xFF)
                    AddPayLoadCell("Status", result[1], result[2]);
                else
                {
                    FieldColor = ERROR_COLOR;
                    AddPayLoadCell("Status", Format("%d", bStatus), "This status ID is invalid");
                }
            out.Decoded ++;
            }
            ##################################
            #   tTKID                        #
            ##################################
            if (in.DataLength - 8 >= 1 + 1 + 3)
            {
                FieldColor = wDataColor;
                tTKID = NextData3Bytes_();
                AddPayLoadCell("tTKID", Format("0x%06X", tTKID), "The base name for the PTK to be derived");
                out.Decoded += 3;
            }
            ###################################
            #    bReserved                    #
            ###################################
            if (in.DataLength - 8 >= 1 + 1 + 3 + 1)
            {
                PLReservedCheck(8);
                out.Decoded ++;
            }

            ###################################
            #     CDID                        #
            ###################################
            if (in.DataLength - 8 >= 1 + 1 + 3 + 1 + 16)
            {
                FieldColor = wDataColor;
                AddPayLoadCell("CDID",Get16BytesData(),"The device's CDID");
                out.Decoded += 16;
            }

            ###################################
            #     Nonce                       #
            ###################################
            if (in.DataLength - 8 >= 1 + 1 + 3 + 1 + 16 + 16)
            {
                FieldColor = wDataColor;
                AddPayLoadCell("Nonce",Get16BytesData(),"The Nonce exchanged for the handshake");
                out.Decoded += 16;
            }
            ###################################
            #     MIC                         #
            ###################################
            if (in.DataLength - 8 >= 1 + 1 + 3 + 1 + 16 + 16 + 8)
            {
                FieldColor = wDataColor;
                AddPayLoadCell("MIC",Get8BytesData(),"The MIC calculated over previous fields of this packet payload");
                out.Decoded += 8;
            }
        }
        else
        {
            FieldColor = ERROR_COLOR;
            AddErrorMonoCell("Hndshk Num", "Conflict", Format("The bRequest & wValue indicate handshake%d,",ID) + Format(" but bMessageNumber indicates handshake%d", bMessageNumber));
        }
    out.Decoded++;
    }
    if (out.Decoded < 46)
        AddErrorMonoCell("Error", "Not enough data", "Not enough data to decode current request");
}


