#####################################################################
#            Common Used sub Functions                              #
#####################################################################


DoMACHeaderDecoding(length)
{
    #########################################################################
    #   Define Mac Header Color group according to the Application standard #
    #########################################################################
    MAC_HEADER_color                 = 0x0D784D;
    MAC_FRAME_CONTROL_color          = 0x0D784D;
    MAC_FC_PROTOCOL_VERS_color       = 0x15C77C;
    MAC_FC_FRAME_TYPE_UNKNOWN_color  = 0x0000FF;
    MAC_FC_FRAME_TYPE_BEACON_color   = 0xEECCFD;
    MAC_FC_FRAME_TYPE_CONTROL_color  = 0xE0E000;
    MAC_FC_FRAME_TYPE_COMMAND_color  = 0x48A4FF;
    MAC_FC_FRAME_TYPE_DATA_color     = 0x005EBB;
    MAC_FC_FRAME_TYPE_AGG_DATA_color = 0x003A75;
    MAC_FC_SECURE_color              = 0x0D784D;
    MAC_FC_ACK_POLICY_color          = 0x15C77C;
    MAC_FC_RETRY_color               = 0x16DA87;
    MAC_FC_USER_PRIORITY_color       = 0x16DA87;
    MAC_FC_STREAM_INDEX_color        = 0x16DA87;
    MAC_FC_CONTROL_TYPE_color        = 0x1ED68D;
    MAC_FC_COMMAND_TYPE_color        = 0x1ED68D;
    MAC_FC_COMMAND_DIR_color         = 0x16DA87;
    MAC_FC_RESERVED_color            = 0x16DA87;
    MAC_DEST_ID_color                = 0x0D8D58;
    MAC_SRC_ID_color                 = 0x11A768;
    MAC_SEQUENCE_CONTROL_color       = 0x42EAA3;
    MAC_SC_RESERVED_color            = 0x42EAA3;
    MAC_MXDU_NUMBER_color            = 0x30E896;
    MAC_FRAG_NUMBER_color            = 0x30E896;
    MAC_MORE_FRAGS_color             = 0x42EA9F;
    MAC_MORE_FRAMES_color            = 0x65DFB6;
    MAC_DURATION_color               = 0x54DCAC;
    MAC_ACCESS_METHOD_color          = 0x78E0BA;


    if (!(length == 10 || length == 6 ))
        return null;
    ProtocolVersion = NextNBits_(3);
    SEC             = NextNBits_(1);
    ACKPolicy       = NextNBits_(2);
    FrameType       = NextNBits_(3);
    DelivId_CtrlType = NextNBits_(4);
    Retry           = NextNBits_(1);
    Resv            = NextNBits_(2);
    DestId          = GetDataWord(startingByte + 2);
    SrcId           = GetDataWord(startingByte + 4);
    if (length == 10)
    {
        FragmentNumber = NextNBits_(3);
        MXDUNumber     = NextNBits_(11);
        MoreFragments  = NextNBits_(1);
        SCReserved     = NextNBits_(1);
        Duration       = NextNBits_(14);
        MoreFrames     = NextNBits_(1);
        AccessMethod   = NextNBits_(1);
    }
    FieldColor = MAC_HEADER_color;
    AddPayLoadCell("MAC", "MAC", "MAC header Field (Expand/Collapse)", _MONOFIELD);
    if (FrameType == 0)
    {
        FieldColor = MAC_FC_FRAME_TYPE_BEACON_color;
        AddPayLoadCell("Beacon","Beacon", Format("Frame Type - %d: Beacon Frame", FrameType), _MONOFIELD);
    }
    else if (FrameType == 1)
    {
        FieldColor = MAC_FC_FRAME_TYPE_CONTROL_color;
        AddPayLoadCell("Control","Control", Format("Frame Type - %d: Control Frame", FrameType), _MONOFIELD);
    }
    else if (FrameType == 2)
    {
        FieldColor = MAC_FC_FRAME_TYPE_COMMAND_color;
        AddPayLoadCell("Command","Command", Format("Frame Type - %d: Command Frame", FrameType), _MONOFIELD);
    }
    else if (FrameType == 3)
    {
        FieldColor = MAC_FC_FRAME_TYPE_DATA_color;
        AddPayLoadCell("Data","Data", Format("Frame Type - %d: Data Frame", FrameType), _MONOFIELD);
    }
    else if (FrameType == 4)
    {
        FieldColor = MAC_FC_FRAME_TYPE_AGG_DATA_color;
        AddPayLoadCell("Agg Data","Agg Data", Format("Frame Type - %d: Aggregated Data Frame", FrameType), _MONOFIELD);
    }
    else
    {
        FieldColor = MAC_FC_FRAME_TYPE_UNKNOWN_color;
        AddPayLoadCell("Unknown","UnKnown", Format("Frame Type - %d: Known Frame", FrameType), _MONOFIELD);
    }

    FieldColor = MAC_DEST_ID_color;
    AddPayLoadCell("Dest ID", Format("0x%04X",DestId), "Destination ID");

    FieldColor = MAC_SRC_ID_color;
    AddPayLoadCell("Src ID", Format("0x%04X",SrcId), "Source ID");


    FieldColor = MAC_FC_PROTOCOL_VERS_color;
    AddPayLoadCell("Vers", Format("%d",ProtocolVersion), "Protocol Version Number");

    FieldColor = MAC_FC_SECURE_color;
    AddPayLoadCell("Sec", Format("%d",SEC), "Security bit");

    select
    {
        ACKPolicy == 0:
        {
            Text = "No";
            toolTip = "0:Ack Policy - No-ACK";
        }
        ACKPolicy == 1:
        {
            Text = "Imm";
            toolTip = "1:Ack Policy - Imm-ACK";
        }
        ACKPolicy == 2:
        {
            Text = "B";
            toolTip = "2:Ack Policy - B-ACK";
        }
        ACKPolicy == 3:
        {
            Text = "Request";
            toolTip = "3:Ack Policy - B-ACK Request";
        }
    };

    FieldColor = MAC_FC_ACK_POLICY_color;
    AddPayLoadCell("Policy", Text, toolTip);

    FieldColor = MAC_FC_RETRY_color;
    AddPayLoadCell("Rtry", Format("%d",Retry), "Retry");

    FieldColor = MAC_FC_STREAM_INDEX_color;
    AddPayLoadCell("D Id", Format("%d",DelivId_CtrlType), "Frame Subtype / Delivery ID");

    if (length == 10)
    {
        FieldColor = MAC_FRAG_NUMBER_color;
        AddPayLoadCell("Frag Num", Format("0x%X",FragmentNumber), "Fragment Number");

        FieldColor = MAC_MXDU_NUMBER_color;
        AddPayLoadCell("DU Num", Format("0x%03X",MXDUNumber), "MSDC or MCDU Number");

        FieldColor = MAC_MORE_FRAGS_color;
        AddPayLoadCell("M Frg", Format("%X",MoreFragments), "More Fragments");

        FieldColor = MAC_DURATION_color;
        AddPayLoadCell("Duration", Format("%d",Duration), "Duration");

        FieldColor = MAC_MORE_FRAMES_color;
        AddPayLoadCell("M Dat", Format("%X",MoreFrames),"More Frames");

        FieldColor = MAC_ACCESS_METHOD_color;
        if (AccessMethod)
            toolTip = "1:Access Method is Distributed Reservation Protocol";
        else
            toolTip = "0:Access Method is Prioritized Channel Access";
        AddPayLoadCell("Acc", Format("%d",AccessMethod), toolTip);

    }

}


