######################################################
# WUSB 1.0 Table 7-10 Definition of LQI values       #
######################################################

GetLQIValueTooltip( LQIValue )
{
    if (LQIValue < 0 || LQIValue > 255 )
        return "LQI Value out of range";
    else if (LQIValue == 0)
        return "Too low to be accurately measured";
    else if (LQIValue > 31)
        return "Reserved";
    else # 1-31
        return Format("%d dB", LQIValue - 7 );
}



