# bRequest          :0x13
# wValue            :Data number
# wIndex            :Zero
# wLength           :Data Length
# Data              :Security Data
#***********************************************************************************
GET_SECURITY_DATA()
{
     out.Decoded = 8;
    if( bReqType == 0x80 )
    {
        AddWValueCell(Format("%d",wValue),"Data number that represents a stage or message number");
        AddWIndexCell();
        AddWLengthCell();

        ###################################
        #     Security Data               #
        ###################################
        if (in.DataLength - 8 > 0)
        {
            FieldColor = wPayloadColor;
            AddDecSeparator();
            AddPLCellMonoNoDlg("Sec Data","Sec Data","Security Data payload", _MONOFIELD);
            ShowDataBlock(in.DataLength - 8);
            out.Decoded += in.DataLength - 8;
        }
    }
    else
    {
        AddIllegalTypeCell("GET SECURITY DATA");
    }

}
