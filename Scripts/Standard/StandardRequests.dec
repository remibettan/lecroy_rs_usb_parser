#***********************************************************************************
#  SET_ENCRYPTION :
#
# bRequestType      :0x00
# bRequest          :0x0D
# wValue            :Encryption Value
# wIndex            :zero
# wLength           :zero
# Data              :None
#***********************************************************************************
SET_ENCRYPTION()
{
    if( bReqType == 0x00 )
    {
        result = Find(EncryptionTypeTable, wValue);
        AddWValueCell(Format("%d",wValue), result[1]);
        #AddWIndexCell();
        #AddWLengthCell();
        if (wIndex != 0)
            AddWIndexCell("", FormatEx(_err_Illegal_Value,"wIndex",wIndex,0 ) ,1 );  
         else
            AddWIndexCell(); 
        
        
         if (wLength != 0)
            AddWLengthCell( FormatEx(_err_Illegal_Value,"wLength",wLength,0 ) ,1 );  
         else
            AddWLengthCell( );   
    }
    else
    {
        AddIllegalTypeCell("SET ENCRYPTION");
    }

    out.Decoded = 8;
}
