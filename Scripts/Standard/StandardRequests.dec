##########################################################################
#  USB 2.0 Table 9-7 Test Mode Selectors                                 #
##########################################################################
GetTestModeSelectorTooltip(value)
{
    if (value == 0x00)
        return "Reserved";
    else if (value == 0x01)
        return "Test_J";
    else if (value == 0x02)
        return "Test_K";
    else if (value == 0x03)
        return "Test_SE0_NAK";
    else if (value == 0x04)
        return "Test_Packet";
    else if (value == 0x05)
        return "Test_Force_Enable";
    else if (value >= 0x06 && value <= 0x3E )
        return "Reserved for standard test selectors";
    else if (value >= 0x3F && value <= 0xBF)
        return "Reserved";
    else if (value >= 0xC0 && value <= 0xFF)
        return "Reserved for vendor-specific test modes";
    else
        return "Invalid";
}


DecodeChannelTime()
{
    val = NextNBits_(24);
    if (LittleEndian == 1)
    {
        ReceptionTime = ((val & 0xFF0000) >> 16)  |
               (val & 0x00FF00)          |
               ((val & 0x0000FF) << 16);
    }
    else
    {
        ReceptionTime = val;
    }
    return Format ("0x%05X:%02X", ReceptionTime>> 7, ReceptionTime & 0x7F);
}

#*******************************************************************************
# GET_STATUS    : This request returns the status for the specified recipient
#                 that have changed since the previous acknowledgement
# bReqType      : 0x80/0x81/0x82
# bRequest      : 0x00
# wValue        : 0x0000
# wIndex        : Device/Interface/Endpoint
# wLength       : Variable
# Data          : Device,Interface, Endpoint Status, or Wireless Data
#*******************************************************************************

GET_STATUS()
{
    ##############################################
    #               Device                       #
    ##############################################
    if( bReqType == 0x80 )
    {
        selector = Find(DeviceStatusSelectorTable, wIndex);

         if (wValue != 0)
            AddWValueCell("", FormatEx(_err_Illegal_Value,"wValue",wValue,0 ) ,1 );  
         else
            AddWValueCell("", "Correct Value of 0",0 ); 
         
         if( StdReqDeviceTypeFLAG == WUSB_Device )
         {
            AddWIndexCell( selector[1], "Status selector",0 );
         }
         else
         {
           if (tempSpeedFlag == Super_Speed_Mode)
                tempstr = "USB 3.0 Standard Status";
           else
                tempstr = "USB 2.0  Standard Status";
            
           if (wIndex != 0)
              AddWIndexCell("", FormatEx(_err_Illegal_Value,"wIndex",wIndex,0 ) ,1 );  
           else
              AddWIndexCell(tempstr, "Status Selector",0 ); 
         }
         
         if (wLength != 2)
            AddWLengthCell( FormatEx(_err_Illegal_Value,"wLength",wLength,2 ) ,1 );  
         else
            AddWLengthCell( "Correct Value of 2",0 );         
        
        # if( StdReqDeviceTypeFLAG == WUSB_Device )
            Call( selector[2] );
    }
    ##############################################
    #                Interface                   #
    ##############################################
    else if (bReqType == 0x81)
    {
    		if ( tempSpeedFlag == Super_Speed_Mode )
             DecodeGetStatusForInterface();
        else
        {
            FieldColor = ERROR_COLOR;
            FormatValue=Format("Interface # %d Status", wIndex);
            out.Decoded = 8;
            if ( in.DataLength >= 10 )
            {
               value = GetDataWord(8);
               AddErrorMonoCell(FormatValue, Format ("0x%04X", value) , "Interface status not defined!");
               out.Decoded += 2;
            }
        }        
    }
    ##############################################
    #                 Endpoint                   #
    ##############################################
    else if (bReqType == 0x82)
    {
       
         if (wValue != 0)
            AddWValueCell("", FormatEx(_err_Illegal_Value,"wValue",wValue,0 ) ,1 );  
         else
            AddWValueCell("", "Correct Value of 0",0 ); 

        if (wLength != 2)
            AddWLengthCell( FormatEx(_err_Illegal_Value,"wLength",wLength,2 ) ,1 );  
        else
            AddWLengthCell( "Correct Value of 2",0 );     
       
       SetCellColor(wIndexColor);
       
        if (wIndex & 0x80)
        {
            FormatValue=Format("Endpoint # %d IN Status", wIndex & 0x0F);
        }
        else
        {
            FormatValue=Format("Endpoint # %d OUT Status", wIndex & 0x0F);
        }
        out.Decoded = 8;

        if ( in.DataLength >= 10 )
        {
            value = GetDataWord(8);
            
            if (value & 1)
            {
                AddGenWIndexCell(FormatValue, "Endpoint Halted" , Format ("Status = 0x%04X", value) );
            }
            else
            {
                AddGenWIndexCell(FormatValue, "Good" ,  Format ("Status = 0x%04X", value) );
            }
            out.Decoded += 2;
         RestoreCellColor();
         }
        else
           AddErrorMonoCell("Error", "Not enough data", "Not enough data to decode current request");
    }
    ###############################################
    #            ReqType Illegal                  #
    ###############################################
    else
    {
        AddIllegalTypeCell( "GET STATUS" );
        out.Decoded = 8;
    }

}

