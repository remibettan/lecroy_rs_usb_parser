const WSB_Swtch_Tm           = [1, 0];
const WSB_DRPIEData          = [1, 0];
const WSB_Rsv_Pri            = [1, 0];
const WSB_Trans_Tm           = [1, 0];
const WSB_Trans_Adj          = [1, 0];
const WSB_Rcv_Flt            = [1, 0];
