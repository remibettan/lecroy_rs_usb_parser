        if ( wValue == 2 ) # handshake 2
        {
           temp_str += DoHandshakeText(wValue);
        }
        else
        {
            temp_str += Format("%d", wValue);
            temp_str += " is not a valid wValue for SET HANDSHAKE request";
            temp_str += NewLine();
        }
    }
    else
    {
        temp_str += Format("The bmRequestType value 0x%02X is illegal.", bReqType);
