#***********************************************************************************
#  GET_ENCRYPTION :
#
# bRequestType      :0x80
# bRequest          :0x0E
# wValue            :zero
# wIndex            :zero
# wLength           :one
# Data              :Encryption Value
#***********************************************************************************

GET_ENCRYPTION()
{
    out.Decoded = 8;
    if( bReqType == 0x80 )
    {
        #AddWValueCell();
        #AddWIndexCell();
        #AddWLengthCell();
         if (wValue != 0)
            AddWValueCell("", FormatEx(_err_Illegal_Value,"wValue",wValue,0 ) ,1 );  
         else
            AddWValueCell(); 
       
         if (wIndex != 0)
            AddWIndexCell("", FormatEx(_err_Illegal_Value,"wIndex",wIndex,0 ) ,1 );  
         else
            AddWIndexCell(); 
        
         if (wLength != 0)
            AddWLengthCell( FormatEx(_err_Illegal_Value,"wLength",wLength,0 ) ,1 );  
         else
            AddWLengthCell(  );   
       
        if (in.DataLength - 8 >= 1)
        {
            EncryptionValue = GetDataByte(8);
            FieldColor = wDataColor;
            FormatValue = "Encrpt Val";
            result = Find(EncryptionTypeTable, EncryptionValue);
            SetFieldOffsetLen(64 + 8, 8);
            AddPayLoadCell(FormatValue, Format("%d",EncryptionValue), result[1]);
            out.Decoded++;
        }
        else
            AddErrorMonoCell("Error", "Not enough data", "Not enough data to decode current request");
    }
    else
    {
        AddIllegalTypeCell("GET ENCRYPTION");
    }

}
