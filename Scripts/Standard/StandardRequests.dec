#*******************************************************************************
# SET_INTERFACE_DS : This request is to instruct the device to switch operation
#                    to a specified alternate setting for an interface at a
#                    specified time.
#
# bReqType      : 0x01
# bRequest      : 0x17
# wValue        : Alternate Setting
# wIndex        : Interface
# wLength       : 0x02
# Data          : Switch Time
#*******************************************************************************
SET_INTERFACE_DS()
{
    out.Decoded = 8;
    if (bReqType == 0x01)
    {
        AddWIndexCell("" , Format ("Interface ID %d" , wIndex));
        AddWValueCell(Format("%d", wValue), Format ("Set Alternate Setting to %d" , wValue));
        #AddWLengthCell("Length of the payload, Should set to 2");
        if (wLength != 2)
            AddWLengthCell( FormatEx(_err_Illegal_Value,"wLength",wLength,2 ) ,1 );  
         else
            AddWLengthCell( "Correct Value of 2",0 );   
        if (in.DataLength - 8 >=2)
        {
            SwitchTime = GetDataWord(8);
            FieldColor = wDataColor;
            SetFieldOffsetLen(64 + 16, 16);
            AddPayLoadCell("Switch Time", Format ("%d ms" , SwitchTime * 8), "Indicates the time that interface should be switched to an alternate setting");
            out.Decoded += 2;
        }
        else
            AddErrorMonoCell("Error", "Not enough data", "Not enough data to decode current request");
    }
    else
    {
        AddIllegalTypeCell("SET INTERFACE DS");
    }
}
