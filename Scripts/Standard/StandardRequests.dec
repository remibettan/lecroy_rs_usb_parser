#***********************************************************************************
#  SET_CONNECTION :
#
# bRequestType      :0x00
# bRequest          :0x11
# wValue            :Zero
# wIndex            :Zero
# wLength           :48
# Data              :Connection Context
#***********************************************************************************
SET_CONNECTION()
{
    out.Decoded = 8;
    if( bReqType == 0x00 )
    {
        AddWValueCell();
        AddWIndexCell();
        AddWLengthCell();

        ###################################
        #     CHID                        #
        ###################################
        if (in.DataLength - 8 >= 16)
        {
            FieldColor = wDataColor;
            SetFieldOffsetLen(64 , 8);
            AddPayLoadCell("CHID", Get16BytesData(),"Unique Host ID");
            out.Decoded += 16;
        }
        ###################################
        #     CDID                        #
        ###################################
        if (in.DataLength - 8 >= 16 + 16)
        {
            AddPayLoadCell("CDID", Get16BytesData(), "The device's CDID");
            out.Decoded += 16;
        }
        ###################################
        #     CK                          #
        ###################################
        if (in.DataLength - 8 >= 16 + 16 + 16)
        {
            AddPayLoadCell("CK",Get16BytesData(),"The Key used to establish reconnections using this context");
            out.Decoded += 16;
        }
        if (out.Decoded < 48)
            AddErrorMonoCell("Error", "Not enough data", "Not enough data to decode current request");
    }
    else
    {
        AddIllegalTypeCell("SET CONNECTION");
    }

}
