#*******************************************************************************
# GET_CONFIGURATION: This request returns the current device configuration value
# bReqType : 0x80
# bRequest      : 0x08
# wValue        : 0x0000
# wIndex        : 0x0000
# wLength       : 0x01
# Data          : Configuration Value
#*******************************************************************************
GET_CONFIGURATION()
{
    out.Decoded = 8;

    if (bReqType == 0x80)
    {
         if (wValue != 0)
            AddWValueCell("", FormatEx(_err_Illegal_Value,"wValue",wValue,0 ) ,1 );  
         else
            AddWValueCell("", "Correct Value of 0",0 ); 

        if (wIndex != 0)
            AddWIndexCell("", FormatEx(_err_Illegal_Value,"wIndex",wIndex,0 ) ,1 );  
         else
            AddWIndexCell("", "Correct Value of 0",0 ); 
        
         if (wLength != 1)
            AddWLengthCell( FormatEx(_err_Illegal_Value,"wLength",wLength,0 ) ,1 );  
         else
            AddWLengthCell( "Correct Value of 1",0 );   

        if (in.DataLength - 8 >= 1)
        {
            value  = GetDataByte(8);
            FieldColor = wDataColor;
            SetFieldOffsetLen( 64 + 8, 8 );
            AddPayLoadCell("Config", Format ("Configuration %d" , value), Format ("Configuration # = 0x%04X" , value));
            out.Decoded ++;
        }
        else
            AddErrorMonoCell("Error", "Not enough data", "Not enough data to decode current request");

    }
    else
    {
        AddIllegalTypeCell( "GET CONFIGURATION" );
    }
}
# end GET_CONFIGURATION
