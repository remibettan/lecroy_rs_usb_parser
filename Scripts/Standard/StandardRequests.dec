#*******************************************************************************
# SET_INTERFACE : This request allows the host to select an alternate setting for
#                 the specified interface
# bReqType : 0x01
# bRequest      : 0x0B
# wValue        : Alternative Setting
# wIndex        : Interface
# wLength       : 0x00
# Data          : None
#*******************************************************************************
SET_INTERFACE()
{
    if (bReqType == 0x01)
    {
        AddWIndexCell(Format ("%d" , wIndex), Format ("Interface # 0x%04X" , wIndex));
        FieldColor = wDataColor;
        AddGenWValueCell("Altr Setting", Format ("%d" , wValue), Format ("Set Alternate Setting  = 0x%04X" , wValue));
        #AddWLengthCell("Length of the payload, should set to 0");

         if (wLength != 0)
            AddWLengthCell( FormatEx(_err_Illegal_Value,"wLength",wLength,0 ) ,1 );  
         else
            AddWLengthCell( "Correct Value of 0",0 );   
    }
    else
    {
        AddIllegalTypeCell( "SET INTERFACE" );
    }
    out.Decoded = 8;
}

# end SET_INTERFACE

SET_INTERFACE_text()
{
    return "No data to decode for SET INTERFACE";
}



#*******************************************************************************
# SYNC_FRAME : This request synchronizes an isochronous endpoint
#
# bReqType      : 0x82
# bRequest      : 0x0C
# wValue        : 0
# wIndex        : Endpoint
# wLength       : 0x02
# Data          : Frame Number
#*******************************************************************************
SYNC_FRAME()
{

    out.Decoded = 8;
    if (bReqType == 0x82)
    {
        FieldColor = wIndexColor;
        if (wIndex & 0x80)
        {
            FormatValue=Format("Endpoint # %d IN", wIndex & 0x0F);
        }
        else
        {
            FormatValue=Format("Endpoint # %d OUT", wIndex & 0x0F);
        }
        AddWIndexCell(FormatValue, Format ("Endpoint # 0x%04X" , wIndex & 0x0F));
        #AddWLengthCell("Length of the payload, Should set to 2");
        if (wLength != 2)
            AddWLengthCell( FormatEx(_err_Illegal_Value,"wLength",wLength,2 ) ,1 );  
         else
            AddWLengthCell( "Correct Value of 2",0 );   
        
        if (in.DataLength - 8 >=2)
        {
            value  = GetDataWord(8);
            FieldColor = wDataColor;
            SetFieldOffsetLen( 64 + 16, 16 );
            AddPayLoadCell("Sync Frame", Format ("Frame: %d" , value), Format ("Frame = %d" , value));
            out.Decoded +=2;
        }
        else
            AddErrorMonoCell("Error", "Not enough data", "Not enough data to decode current request");
    }
    else
    {
        AddIllegalTypeCell( "SYNC FRAME" );
    }
}

# end SYNC_FRAME
