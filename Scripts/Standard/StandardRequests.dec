#  Text based portion------------------------------------------------
#  Text based portion------------------------------------------------
#  Text based portion------------------------------------------------
#  Text based portion------------------------------------------------
#  Text based portion------------------------------------------------
#  Text based portion------------------------------------------------


DecodeDataToText()
{
    InitText();
    bLength             = GetDataByte(8);
    bDescriptorType     = GetDataByte(9);
    if (bDescriptorType == 0x29)
    {
         AddDataHeader("Standard Descriptor", bLength);
         return DecodeDescriptorsToText();
    }
    else
    {
        _row = Find(AllStandardRequestsTable, bRequest);

        if ( _row[0] != 0xFF)
        {
            return (Call ( _row[2], [ in.DataLength ] ));

        }
        else
        {
            return ("Other than a Descriptor!");
        }
    }
}

DecodeDescriptorsToText()
{
    return ("No done with DecodeDescriptorsToText");
    InitText();

    bNbrPorts           = GetDataByte(10);
    wHubCharacteristics = GetDataWord(11);
    bPwrOn2PwrGood      = GetDataByte(13);
    bHubContrCurrent    = GetDataByte(14);
    DeviceRemovable     = GetDataByte(15);
    if (bNbrPorts > 7)
    {
        DeviceRemovable_2 = GetDataByte(16);
        PortPwrCtrlMask   = GetDataByte(17);
        PortPwrCtrlMask_2 = GetDataByte(18);
    }
    else
    {
        PortPwrCtrlMask     = GetDataByte(16);
    }

    str  = "";

    if (bDescriptorType == 0x29)
    {
         AddDataHeader("HUB Descriptor", bLength);
    }
    else
    {
        str = OutputType;
        str += NewLine();
        str +=  "--> UNKNOWN DESCRIPTOR TYPE: ";
        str +=  Format("0x%04X", bDescriptorType);
        AddDataHeader(str, bLength);
    }
    AddEntry( 0, "bLength", bLength, 2, "", 1);
    AddDescriptorSizeString(bLength);
    AddFieldBreak();

    AddEntry( 1, "bDescriptorType", bDescriptorType, 2, GetDescriptorTypeString("HUB"), 0);
    AddFieldBreak();

    str = Format ("The hub has %d", bNbrPorts);
    AddEntry( 2, "bNbrPorts", bNbrPorts, 2, str, 0 );
    AddDescriptionOnly( "downstream ports" );
    AddFieldBreak();

    AddHubChars(wHubCharacteristics);

    AddEntry( 5, "bPwrOn2PwrGood", bPwrOn2PwrGood, 2, "Time from start of", 0);
    AddDescriptionOnly( "the power-on sequence" );
    AddDescriptionOnly( "until power is good" );
    AddDescriptionOnly(Format ("is %d ms", bPwrOn2PwrGood*2));
    AddFieldBreak();

    AddEntry( 6, "bHubContrCurrent", bHubContrCurrent, 2, "Max current reqired", 0);
    AddDescriptionOnly( "by Hub Controller");
    AddDescriptionOnly( Format ("is %d ma", bHubContrCurrent*2));
    AddFieldBreak();

    if ( bNbrPorts < 7)
    {
        AddEntry( 7, "DeviceRemovable", DeviceRemovable, 2, "Device Removable:", 0);
    }
    else
    {
        AddEntry( 7, "DeviceRemovable", DeviceRemovable + (DeviceRemovable_2 << 8), 4, "Device Removable:", 0);
    }
    for (i=1; i<=bNbrPorts; i++)
    {
        str = Format("Bit %d: Port ", i);
        if (i < 8)
        {
            value = DeviceRemovable >> i;
        }
        else
        {
            value = DeviceRemovable_2 >> (i - 8);
        }
        if (value & 0x1)
        {
            str += Format("%d Removable",i);
        }
        else
        {
            str += Format("%d Not Removable",i);
        }
        AddDescriptionOnly( str );
    }
    AddFieldBreak();

    if ( PortPwrCtrlMask == 0xFF)
    {
        AddEntry( 8, "PortPwrCtrlMask", PortPwrCtrlMask, 2, "0xFF for 1.0 Compatibility", 0);
    }
    else
    {
        AddEntry( 8, "PortPwrCtrlMask", PortPwrCtrlMask, 2, "ERROR: Should have been", 0);
        AddDescriptionOnly( "0xFF for USB Version 1.0");
        AddDescriptionOnly( "Compatibility");
    }
    AddFieldBreak();

    return GetFinalText();

}




DecodeRequestToText()
{
    InitText();
    return DecodeRequestToTextCommon(AllStandardRequestsTable);
}



RequestDecode()
{
    NewLineMode = 1;
    Speed        = GetDecoderHeaderByte(2);
    tempSpeedFlag = Speed; # Gets Speed value from in.context[2]
	if(tempSpeedFlag == Super_Speed_Plus_Mode || tempSpeedFlag == SSIC_HS_Mode) 
		tempSpeedFlag = Super_Speed_Mode;
    #UsbSpecLevel = GetDecoderHeaderByte(?);

    UsbReqStr        = DecodeRequestToText();
    if (wLength == 0)
    {
        UsbDataDecodeStr = "No data associated with this request";
    }
    else
    {
        UsbDataDecodeStr = DecodeDataToText();
    }

    return Complete();
}

Decode_wValue(w_value)
{
    if ((bRequest == 1) ||  (bRequest == 3))                   # CLEAR_FEATURE / SET_FEATURE
    {
        if (bReqType == 0x00)
        {
            if (value == 0x0001)
            {
                return ("DEVICE_REMOTE_WAKEUP");
            }
            else if (value == 0x0003)
            {
                return ("b_hnp_enable");
            }
            else if (value == 0x0004)
            {
                return ("a_hnp_support");
            }
            else if (value == 0x0005)
            {
                return ("a_alt_hnp_support");
            }
        }
        else if (bReqType == 0x02)
        {
            if (value == 0)
            {
                return ("ENDPOINT_HALT");
            }
        }
    }
    else if (bRequest == 5)                                  # SET_ADDRESS
    {
        return Format("New Address %d", wValue);
    }
    else if ((bRequest == 6) ||  (bRequest == 7))            # GET_DESCRIPTOR / SET_DESCRIPTOR
    {
        descriptor_index =  wValue & 0xFF;
        descriptor_type  = (wValue >> 8) & 0xFF;

        _row_dt = FindDescriptorEntry( descriptor_type );

        dt_str = Format("Descriptor type 0x%02X", descriptor_type);

        di = Format(", Index %d", descriptor_index);

        if (_row_dt[0] != 0xFF)
        {
            dt_str = _row_dt[1];
        }

        if (descriptor_type)
        {
            if (descriptor_type == 0x03)
            {
                if (descriptor_index)
                {
                    dt_str = dt_str + di;
                }
                else
                {
                    dt_str = dt_str + ", LANGID codes requested";
                }
            }
            else if (descriptor_type == 0x02)
            {
                dt_str = dt_str + di;
            }
        }
        else
        {
             dt_str = dt_str + di;
        }
        return (dt_str);
    }
    else if (bRequest == 9)                                      # SET_CONFIGURATION
    {
        return Format("Config# %d", wValue);
    }
    else if (bRequest == 0xB)                                    # SET_INTERFACE
    {
        return Format("Alt. Setting# %d", wValue);
    }
}




Decode_wIndex(w_index)
{
    temp_str1 = "";
    if (bRequest == 0)                                           # GET_STATUS
    {
        if (bReqType == 0x82)
        {
            temp_str1 = Format("Endpoint %i ", wIndex & 0xF);
            if (wIndex & 0x80)
                return (temp_str1 + "IN");
            else
                return (temp_str1 + "OUT");
        }
    }
    else if ((bRequest == 1) || (bRequest == 3))                 # CLEAR_FEATURE / SET_FEATURE
    {
        if (bReqType == 0x02) # endpoint
        {
            temp_str1 = Format("Endpoint %i ", wIndex & 0xF);
            if (wIndex & 0x80)
                return (temp_str1 + "IN");
            else
                return (temp_str1 + "OUT");
        }
    }
    else if ((bRequest == 0xA) || (bRequest == 0xB))             # GET_INTERFACE / SET_INTERFACE
    {
        return Format("Interface# %d", wIndex);
    }
    else if (bRequest == 0xC)                                    # SYNC_FRAME
    {
        temp_str1 = Format("Endpoint %i ", wIndex & 0xF);
        if (wIndex & 0x80)
            return (temp_str1 + "IN");
        else
            return (temp_str1 + "OUT");
    }
    else if ((bRequest == 6) || (bRequest == 7))                 # GET_DESCRIPTOR / SET_DESCRIPTOR
    {
        if ((wValue & 0xFF00) == 0x0300)
            return Format("Language ID: 0x%04X", wIndex);
        else
            return (Format ("0x%04X", wIndex));

    }
    else
    {
        return (Format ("0x%04X", wIndex));
    }
}

