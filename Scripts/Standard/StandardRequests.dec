#####################################################################
#            GET_STATUS sub Functions                               #
#####################################################################
DoGetStatusUSBStandardStatusDecoding()
{
    out.Decoded = 8;
    if (in.DataLength - 8 >=2)
    {
        value = GetDataWord(8);
        FieldColor = wDataColor;
        FormatValue = "Data Select";
        if ( tempSpeedFlag == Super_Speed_Mode )
           toolTip = ToBitDecode( USB3DeviceStatusBitmapTable, value, "" );
        else
           toolTip = ToBitDecode( DeviceStatusBitmapTable, value, "" );
        AddPayLoadCell(FormatValue, Format("0x%04X",value), toolTip);
        out.Decoded += 2;
    }
    if (out.Decoded < 10)
        AddErrorMonoCell("Error", "Not enough data", "Not enough data to decode current request");
}

DoGetStatusWUSBFeatureDecoding()
{
    out.Decoded = 8;
    if (in.DataLength - 8 >=1)
    {
        value = GetDataByte(8);
        FieldColor = wDataColor;
        FormatValue = "Data Select";
        toolTip = ToBitDecode( WUsbStatusBitmapTable, value, "" );
        AddPayLoadCell(FormatValue, Format("0x%02X",value), toolTip);
        out.Decoded += 1;
    }
    if (out.Decoded < 9)
        AddErrorMonoCell("Error", "Not enough data", "Not enough data to decode current request");
}

DoGetStatusChannelInfoDecoding()
{
    out.Decoded = 8;
    if (in.DataLength - 8 >=1)
    {
        value = GetDataByte(8);
        FieldColor = wDataColor;
        FormatValue = "LQI";
        toolTip = GetLQIValueTooltip (LQI);;
        AddPayLoadCell(FormatValue, Format("0x%02X",value), toolTip);
        out.Decoded += 1;
    }
    if (out.Decoded < 9)
        AddErrorMonoCell("Error", _err_NotEnoughData_Header, _err_NotEnoughData_ToolTip);
}

DoGetStatusReceivedDataDecoding()
{
    ##########################################################
    # because we do not have previous packet info            #
    # we need to use the following way to determine          #
    # either count packets data format or                    #
    # Capture Packet data format                             #
    ##########################################################
    out.Decoded = 8;
    if (in.DataLength - 8 >=1)
    {
        first_byte = PeekNBits_(8);
        FieldColor = wDataColor;

    # By specification, if Capture Packet data format, bits[7:2] are reserved
    # and must be set to zero
        if ((first_byte & 0b11111100) != 0)
            DoCountPacketsDecoding();
    # then we check if the size indicated by the bits[6:0] match the actural
    # length
        else if ((first_byte & 0b01111111) * 10 + 1 == in.DataLength - 8)
            DoCountPacketsDecoding();
        else
            DoCapturePacketDecoding();
    }

}

DoGetStatusMASAvailabilityDecoding()
{
    out.Decoded = 8;
    if (in.DataLength - 8 >=4)
    {
        toolTip = "256-bit map, where each bit location corresponds to a MAS slot in the MAC layer superframe";
        AddDecSeparator();
        FieldColor = wPayloadColor;
        AddPayLoadCell( "MAS Availability", "MAS Availability", toolTip, _MONOFIELD);
        ShowDataBlock(32);
        out.Decoded += 4;
    }
    if (out.Decoded < 12)
        AddErrorMonoCell("Error", "Not enough data", "Not enough data to decode current request");
}

DoGetStatusCurrentTransmitPowerDecoding()
{
    out.Decoded = 8;
    if (in.DataLength - 8 >= 1)
    {
        FieldColor = wDataColor;
        bTxNotificationTP = GetDataByte(8);
        AddPayLoadCell("Notif TP", Format("%d",bTxNotificationTP), "Notification Transmit Power");
        out.Decoded ++;
    }
    if (in.DataLength - 8 >= 2)
    {
        bTxBeaconTP       = GetDataByte(9);
        AddPayLoadCell("Bcn TP", Format("%d",bTxBeaconTP), "Beacon Transmit Power");
        out.Decoded ++;
    }
    if (out.Decoded < 10)
        AddErrorMonoCell("Error", "Not enough data", "Not enough data to decode current request");
}

DoCountPacketsDecoding()
{
    FieldColor = wDataColor;
    AddPLCellMonoNoDlg("Count Packets", "Count Packets");
    if (in.DataLength - 8 >= 1)
    {
        overrun     = NextNBits_(1);
        if (overrun)
            overrunText = "Overrun";
        else
            overrunText = "Not Overrun";
        AddPayLoadCell("Overrun", Format("%d",overrun), overrunText);
        packetCount = NextNBits_(7);
        AddPayLoadCell("Packet Counts", Format("%d",packetCount), "Total number of packets");
        out.Decoded ++;
    }


    for (i = 0; i < packetCount ; i++)
    {
        AddDecSeparator();
        if (in.DataLength - 8 >= i * 10 + 3 + 1)
        {
            value = DecodeChannelTime();
            AddPayLoadCell("Channel Time",value , "Channel Time of the packet");
            out.Decoded +=3;
        }
        if (in.DataLength - 8 >= i * 10 + 9 + 1)
        {
            DoMACHeaderDecoding(6);
            out.Decoded +=6;
        }
        if (in.DataLength - 8 >= i * 10 + 10 + 1)
        {
            FieldColor = wSubDataColor;
          LQI    = GetDataByte(i * 10 + 18);
          toolTip = GetLQIValueTooltip (LQI);
          AddPayLoadCell("LQI", Format("%d",LQI), toolTip);
          out.Decoded ++;
       }
    }
    if (out.Decoded < 10 * packetCount + 1)
        AddErrorMonoCell("Error", "Not enough data", "Not enough data to decode current request");
}

DoCapturePacketDecoding()
{

    FieldColor = wDataColor;
    AddPLCellMonoNoDlg("Capture Packet", "Capture Packet");
    if (in.DataLength - 8 >= 1)
    {
        PLReservedCheck(6);
        bufferOverflow = NextNBits_(1);
        if ( bufferOverflow )
            OverflowText = "buffer overflowed";
        else
            OverflowText = "buffer overflowed";
        AddPayLoadCell("Buffer Ovrflw", Format("%d",bufferOverflow), OverflowText);
        invalidFCS = NextNBits_(1);
        if (invalidFCS)
            FCSText = "FCS valid";
        else
            FCSText = "FCS invalid";
        AddPayLoadCell("FCS", Format("%d",invalidFSC), FCSText);
        out.Decoded ++;
    }
    if (in.DataLength - 8 >= 1 + 3)
    {
        value = DecodingCannelTime();
        AddPayLoadCell("Channel Time",value, "Channel Time of the packet");
        out.Decoded += 3;
    }
    if (in.DataLength - 8 >= 1 + 3 + 10)
    {
        DoMACHeaderText(10);
        out.Decoded += 10;
    }
    AddDecSeparator();
    FieldColor = wPayLoadColor;
    if (in.DataLength - 8 > 16)
    {
        AddPLCellMonoNoDlg("PayLoad","PayLoad");
        ShowDataBlock(in.DataLength - 8 - 15);
        AddDecSeparator();
        FieldColor = wDataColor;
        LQI = GetDataByte( in.DataLength - 1 );
        toolTip = GetLQIValueTooltip (LQI);
        AddPayLoadCell("LQI", Format("%d",LQI), toolTip);
        out.Decoded = in.DataLength;
    }
    else
        AddErrorMonoCell("Error", "Not enough data", "Not enough data to decode current request");

}


