#*******************************************************************************
# GET_INTERFACE : This request returns the selected alternate setting for the
#                 specified interface
# bReqType : 0x81
# bRequest      : 0x0A
# wValue        : 0x0000
# wIndex        : Interface
# wLength       : 0x01
# Data          : Alternate Setting
#*******************************************************************************
GET_INTERFACE()
{
    out.Decoded = 8;
    if (bReqType == 0x81)
    {
         if (wValue != 0)
            AddWValueCell("", FormatEx(_err_Illegal_Value,"wValue",wValue,0 ) ,1 );  
         else
            AddWValueCell("", "Correct Value of 0",0 ); 

        #AddWValueCell("", "Should set to 0");
        AddWIndexCell( Format ("%d" , wIndex), Format ("Interface # 0x%04X" , wIndex) );
        #AddWLengthCell("Length of the payload, should set to 1");

        if (wLength != 1)
            AddWLengthCell( FormatEx(_err_Illegal_Value,"wLength",wLength,0 ) ,1 );  
         else
            AddWLengthCell( "Correct Value of 1",0 );   

        if (in.DataLength - 8 >= 1)
        {
            value  = GetDataByte(8);
            FieldColor = wDataColor;
            SetFieldOffsetLen( 64 + 8, 8 );
            AddPayLoadCell("Altr Setting", Format ("%d" , value), Format ("New Alternate Setting for Interface %d = 0x%02X" , wIndex, value));
            out.Decoded ++;
        }
        else
            AddErrorMonoCell("Error", "Not enough data", "Not enough data to decode current request");
    }
    else
    {
        AddIllegalTypeCell( "GET INTERFACE" );
    }
}
# end GET_INTERFACE
