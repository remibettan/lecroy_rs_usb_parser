# wValue          : 0x0000
# wIndex          : Interface
# wLength         : 0x0000
# Data            : None
#*******************************************************************************
DFU_CLEAR_STATUS() {
#Request(0x04)={
   AddCell("Interface #",wIndex,Format("wIndex holds Interface #%i",wIndex),usbDFU_colour );
}
# end DFU_CLEAR_STATUS


#*******************************************************************************
# DFU_GET_STATE   : Get State Request
#
# bmRequestType   : 0xA1
# bRequest        : 0x05
# wValue          : 0x0000
# wIndex          : Interface
# wLength         : 0x0001
# Data            : State ( 0x00 - 0x0A )
#*******************************************************************************
DFU_GET_STATE() {
#Request(0x05)={
   AddCell("Interface #",wIndex,Format("wIndex holds Interface #%i",wIndex),usbDFU_colour );
    vDFUState = GetNBits(in.Data,8*8,8);
   vDFUStateText  = Format("Undefined 0x%02X",DFUStat);

     select {
        vDFUState== 0x00: vDFUStateText ="Application Idle";
        vDFUState== 0x01: vDFUStateText ="Application Detach";
        vDFUState== 0x02: vDFUStateText ="Dfu Idle";
        vDFUState== 0x03: vDFUStateText ="Dfu Download Sync";
        vDFUState== 0x04: vDFUStateText ="Dfu Download Busy";
        vDFUState== 0x05: vDFUStateText ="Dfu Download Idle";
        vDFUState== 0x06: vDFUStateText ="Dfu Manifest Sync";
        vDFUState== 0x07: vDFUStateText ="Dfu Manifest";
        vDFUState== 0x08: vDFUStateText ="Dfu Manifest Wait Reset";
        vDFUState== 0x09: vDFUStateText ="Dfu Upload Idle";
        vDFUState== 0x0A: vDFUStateText ="Dfu Error";
   
     };
      AddCell("DFU State",vDFUStateText ,Format("DFU State %d",vDFUState),usbDFU_colour);
    decoded++;

}
# end DFU_GET_STATE


#*******************************************************************************
# DFU_ABORT       : Abort Request
#
# bmRequestType   : 0x21
