TREBLE_CONTROL()
{

	if ((wValue & 0x00FF) == 0xFF)
	{
		for (i = 0; i < wLength; i++ )	
		{
			bTreble = NextNBits_(8);
			if (bTreble > 0x7F)
			{
				bTreble = bTreble | 0xFFFFFF00; # make 2's comp for dword value
			}
			toolTip = Format("Settings for Treble Control 0x%02X: ",bBase) + Format("%d * 0.25 dB", bBase);
			VS= "ADR_bTreble";
			AddBlockPLCell(Format("bTreble %d",i), Format("0x%02X", bTreble), toolTip);
		}
		return 2 + i;
	}
	else if (wLength == 1)
	{
		bTreble = NextNBits_(8);
		if (bTreble > 0x7F)
		{
			bTreble = bTreble | 0xFFFFFF00; # make 2's comp for dword value
		}
		toolTip = Format("Settings for Treble Control 0x%02X: ",bBase) + Format("%d * 0.25 dB", bBase);
		AddPayLoadCell("bTreble", Format("0x%02X", bTreble), toolTip);
		return 2 + 1;
	}/*
	else if (wLength > 0)
	{
		AddExtraBytesPayloadCell(wLength);
		return 2 + wLength;			
	}*/
	else
	{
		return 2;		
	}
}

GRAPHIC_EQUALIZER_CONTROL()
{
	if (wLength >= 4)
	{
		bmBandsPresent = NextNBits_(32);
		AddPayLoadCell("bmBandsPresent", Format("0x%08X", bmBandsPresent), "A bit set indicates the band is present:\nD0: Band 14\nB1: Band 15\n...\nD29:Band 43\nD30: Reserved\n...");
		for (i = 4; i < wLength ; i ++)
		{
			bBand = NextNBits_(8);
			if (bBand > 0x7F)
			{
				bBand = bBand | 0xFFFFFF00; # make 2's comp for dword value
			}
			toolTip = Format("Settings for Band Control 0x%02X: ",bBase) + Format("%d * 0.25 dB", bBase);
			VS= "ADR_bBand";
			AddBlockPLCell(Format("bBand %d",i-4), Format("0x%02X", bBand), toolTip);
		}
	}/*
	else if (wLength > 0)
	{
		AddExtraBytesPayloadCell(wLength);
		return 2 + wLength;			
	}*/
	else
	{
		return 2;		
	}
}
	
AUTOMATIC_GAIN_CONTROL()
{

	if ((wValue & 0x00FF) == 0xFF)
	{
		for (i = 0; i < wLength; i++ )	
		{
			bAGC = NextNBits_(8);
			VS= "ADR_bAGC";
			AddBlockPLCell(Format("bAGC %d",i), Format("0x%02X", bAGC), "The setting for the attribute of the addressed Automatic Gain Control.\nOn when TRUE, off when FALSE.");
		}
		return 2 + i;
	}
	else if (wLength == 1)
	{
		bAGC = NextNBits_(8);
		AddPayLoadCell("bAGC", Format("0x%02X", bAGC), "The setting for the attribute of the addressed Automatic Gain Control.\nOn when TRUE, off when FALSE.");
		return 2 + 1;
	}/*
	else if (wLength > 0)
	{
		AddExtraBytesPayloadCell(wLength);
		return 2 + wLength;			
	}*/
	else
	{
		return 2;		
	}
}	
		
DELAY_CONTROL()
{

	if ((wValue & 0x00FF) == 0xFF)
	{
		for (i = 0; 2 * i < wLength; i++ )	
		{
			wDelay = NextDataWord_();
			VS= "ADR_wDelay";
			AddBlockPLCell(Format("wDelay %d",i), Format("0x%04X", wDelay), Format("0x%04X", wDelay) + Format(":  %d * 0.015625 ms", wDelay));
		}
		return 2 + i * 2;
	}
	else if (wLength == 2)
	{
		wDelay = NextDataWord_();
		AddPayLoadCell("wDelay", Format("0x%04X", wDelay), Format("0x%04X", wDelay) + Format(":  %d * 0.015625 ms", wDelay));
		return 4;
	}/*
	else if (wLength > 0)
	{
		AddExtraBytesPayloadCell(wLength);
		return 2 + wLength;			
	}*/
	else
	{
		return 2;		
	}
}

