			toolTip = Format("Settings for Bass Control 0x%02X: ",bBase) + Format("%d * 0.25 dB", bBase);
			VS= "ADR_bBass";
			AddBlockPLCell(Format("bBase %d",i), Format("0x%02X", bBase), toolTip);
		}
		return 2 + i;
	}
	else if (wLength == 1)
	{
		bBase = NextNBits_(8);
		if (bBase > 0x7F)
		{
			bBase = bBase | 0xFFFFFF00; # make 2's comp for dword value
		}
		toolTip = Format("Settings for Bass Control 0x%02X: ",bBase) + Format("%d * 0.25 dB", bBase);
		AddPayLoadCell("bBase", Format("0x%02X", bBase), toolTip);
		return 2 + 1;
	}/*
	else if (wLength > 0)
	{
		AddExtraBytesPayloadCell(wLength);
		return 2 + wLength;			
	}*/
	else
	{
		return 2;		
	}
}

