ExtensionUnit()
{
	_row = Find(AudioExtensionUnitControlSelectors_v1_Table, wValue);
	AddPayLoadCell("wValue", _row[1], "Control Selector", FieldColor, [_TABULARCELL, CELL_WVALUE, "TEXT_CAPTION"]);

	number = NextNBits_(8);
	if (bReqType == 0xA1 || bReqType == 0x21)
	{
			VS= "ADR_LwIndex";
			AddBlockPLCell("Interface", Format("0x%02X",number), Format("Interface %d",number));
	}
	else
	{
			VS= "ADR_LwIndex";
			AddBlockPLCell("Unknown", Format("0x%02X",number), Format("Unknonw %d",number), _ERROR);
	}
	EntityId = NextNBits_(8);
	AddPayLoadCell("EntityId", "Terminal ID", Format("EntityId = 0x%02X", EntityId));
	if (_row[0] != 0xFF && _row[0] != 0x00)
	{
		wLength = NextDataWord_();
		AddPayLoadCell("wLength", Format("%d",wLength), Format("wLength = %d", wLength));
		return 2 + Call(_row[1]);
	}
	else
	{
		wLength = NextDataWord_();
		AddPayLoadCell("wLength", Format("%d",wLength), Format("wLength = %d", wLength));
		/*
		if (wLength > 0)
		{
			AddExtraBytesPayloadCell(wLength);
			return 4 + wLength;			
		}
		else
		{
			return 4;		
		}
		*/
		return 4;
	}
}


XU_ENABLE_CONTROL()
{

	if (wLength == 1)
	{
		bOn = NextNBits_(8);
		AddPayLoadCell("bOn", Format("0x%02X", bOn), "The setting for the Enable Processing Control.\nEnabled when TRUE, disabled when FALSE.");
		return 2 + 1;
	}/*
	else if (wLength > 0)
	{
		AddExtraBytesPayloadCell(wLength);
		return 2 + wLength;			
	}*/
	else
	{
		return 2;		
	}
}

SAMPLING_FREQ_CONTROL()
{
	  wIndex = NextDataWord_();
	  AddPayLoadCell("wIndex", Format("Endpoint 0x%04X", wIndex), Format(" Endpoint = %d", wIndex));
	  wLength = NextDataWord_();
	  
		if (wLength == 3)
		{
			tSampleFreq = NextData3Bytes_();
			AddPayLoadCell("tSampleFreq", Format("0x%06X Hz", tSampleFreq), "The sampling frequency expressed in Hz.");
			return 4 + 3;
		}/*
		else if (wLength > 0)
		{
			AddExtraBytesPayloadCell(wLength);
			return 4 + wLength;			
		}*/
		else
		{
			return 4;		
		}
}  

PITCH_CONTROL()
{
	  wIndex = NextDataWord_();
	  AddPayLoadCell("wIndex", Format("Endpoint 0x%04X", wIndex), Format(" Endpoint = %d", wIndex));
	  wLength = NextDataWord_();
		if (wLength == 1)
		{
			bPitchEnable = NextNBits_(8);
			AddPayLoadCell("bPitchEnable", Format("0x%02X", bPitchEnable), "Pitch Control on when TRUE, off when FALSE.");
			return 4 + 1;
		}/*
		else if (wLength > 0)
		{
			AddExtraBytesPayloadCell(wLength);
			return 4 + wLength;			
		}*/
		else
		{
			return 4;		
		}
}

ASSOCIATION_CONTROL()
{
	  wIndex = NextDataWord_();
	  AddPayLoadCell("wIndex", Format("Endpoint 0x%04X", wIndex), Format(" Endpoint = %d", wIndex));
	  wLength = NextDataWord_();
		if (wLength == 1)
		{
			bEntityID = NextNBits_(8);
			AddPayLoadCell("bEntityID", Format("0x%02X", bEntityID), "The ID of the Entity that is currently associated with this endpoint.");
			return 4 + 1;
		}/*
		else if (wLength > 0)
		{
			AddExtraBytesPayloadCell(wLength);
			return 4 + wLength;			
		}*/
		else
		{
			return 4;		
		}
}

####################################################################################
#                       USBTracer specific caption cell                            #
####################################################################################

AddSpecCaptionCell(caption, text, tooltip, FieldColor, addparam, addparam1, addparam2 )
{
    AddCell(caption, text, tooltip, FieldColor, _USBBULK_HEADER, addparam, addparam1, addparam2 );
    return 1;
}