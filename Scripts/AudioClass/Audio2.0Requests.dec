%include "CATCScriptAPI.inc"             #.inc files that are included
%include "UsbCommon.inc"
%include "Audio2.0CurrentEntityIdMap_EditMe.inc"
%include "AudioCellColors.inc"
%include "Audio2.0RequestsHelper.inc"
