        AddStringToDlg("No enough data for this SEGMENT",FormatEx("Length required %d bytes, Actual Length %d bytes", wLength, in.DataLength - descriptor_start_offset), OutputUnknownData(in.DataLength - descriptor_start_offset, 0));
        return 0;
    }
    
    AddEntry(0, "wLength", wLength, 4, "Length of the this Segment, in bytes.", 0);
    AddFieldBreak();
        
    AddEntry(2, "bSegmentType", bSegmentType, 2, segment_type, 0);
    AddFieldBreak();
    
    frequency_pairs_count = (wLength - 3) / 8;
    counter = 0;
    data_offset = descriptor_start_offset + 3;
    while (frequency_pairs_count > 0)
    {
        dFreq        = GetDataLong(data_offset);
        wMagnitude   = GetDataWord(data_offset + 4);
        wPhase       = GetDataWord(data_offset + 6);

        AddEntry(data_offset, FormatEx("dFreq(%d)", counter), dFreq, 8, "Frequency point(HZ).", 0, 1);
        AddFieldBreak();
        
        AddEntry(data_offset + 4, FormatEx("wMagnitude(%d)", counter), wMagnitude, 4, "Magnitude value.", 0, 1);
        AddFieldBreak();
        
        AddEntry(data_offset + 6, FormatEx("wPhase(%d)", counter), wPhase, 4, "wPhase value.", 0, 1);
        AddFieldBreak();
        
        data_offset += 8;
        frequency_pairs_count -= 1;
        counter += 1;
    }
    
    return wLength;
}

