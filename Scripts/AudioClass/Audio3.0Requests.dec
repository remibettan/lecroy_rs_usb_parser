Audio_CS_CLUSTER(descriptor_start_offset)
{   
    decoded_offset     = 0;
    
    wLength            = GetDataWord(descriptor_start_offset);
    bDescriptorType    = GetDataByte(descriptor_start_offset + 2);
    bDescriptorSubtype = GetDataByte(descriptor_start_offset + 3);
    wDescriptorID      = GetDataWord(descriptor_start_offset + 4);
    bNrChannels        = GetDataByte(descriptor_start_offset + 6);
    
    AddShortDataHeader(FormatEx ("%s Descriptor (%d bytes)", "CLUSTER", wLength));
    
    if (wLength > in.DataLength - descriptor_start_offset )
    {
        AddStringToDlg("No enough data for this descriptor",FormatEx("Length required %d bytes, Actual Length %d bytes", wLength, in.DataLength - descriptor_start_offset), OutputUnknownData(in.DataLength - descriptor_start_offset, 0));
        return 0;
    }
    
    AddEntry(0, "wLength", wLength, 4, "Total length of the Cluster descriptor, in bytes.", 0);
    AddFieldBreak();
    
    AddEntry(2, "bDescriptorType", bDescriptorType, 2, "CS_CLUSTER descriptor type.", 0);
    AddFieldBreak();
    
    if(bDescriptorSubtype == 0) #Should be equal to SUBTYPE_UNDEFINED(0)
    {
        AddEntry(3, "bDescriptorSubtype", bDescriptorSubtype, 2, "SUBTYPE_UNDEFINED descriptor subtype.", 0);
        AddFieldBreak();
    }
    else
    {
        AddStringToDlg(FormatEx("Unknown subtype 0x%02X for DescriptorType 0x%02X", bDescriptorSubType, bDescriptorType),"","",_ERROR);
    }
    
    
    AddEntry(4, "wDescriptorID", wDescriptorID, 4, "Unique ID of this Cluster descriptor.", 0);
    AddFieldBreak();
    
    AddEntry(6, "bNrChannels", bNrChannels, 2, "Number of channels present in the Cluster.", 0);
    AddFieldBreak();
    
    decoded_offset = 7;
    
    data_remained = wLength - decoded_offset;
    
    while (data_remained > 0)
    {
        #SEGMENTS
        
        bSegmentType     = GetDataByte(decoded_offset + 9);
        desc_segment_row = Find(ClusterDescriptorSegmentTypeTable, bSegmentType);
        
        descriptor_start_offset += decoded_offset;
        decoded          = Call(desc_segment_row[2], descriptor_start_offset, desc_segment_row[1]);
        
        data_remained -= decoded;
        
        if((decoded == 0) || (data_remained < 0))
            data_remained = 0;
        
        decoded_offset += decoded;
    }
        
    return decoded_offset;
}

