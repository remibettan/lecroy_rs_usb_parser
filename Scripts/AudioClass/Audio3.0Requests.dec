%include "CATCScriptAPI.inc"             #.inc files that are included
%include "UsbCommon.inc"
%include "Audio3.0CurrentEntityIdMap_EditMe.inc"
%include "AudioCellColors.inc"
%include "Audio3.0RequestsHelper.inc"
%include "AudioTables.inc"

#----  Input
# in.Data       - Data_block to decode
# in.DataLength - Length of Data_block
#
#----  Output
# out.Decoded   - amount of data has been decoded
#

const Tabular_Def_Table = Map(
[
    #----------------------------------------------------------------------------------------------------------------------
    #       id                     ,      colId                          , 		containerCellId
    #----------------------------------------------------------------------------------------------------------------------
    [ CELL_REQUEST                 , TABULAR_SCRIPT_COLUMN_ID_SUBTYPE    , TABULAR_SCRIPT_CONTAINER_CELL_ID_NONE ],
    [ CELL_WVALUE                  , TABULAR_SCRIPT_COLUMN_ID_NONE       , TABULAR_SCRIPT_CONTAINER_CELL_ID_MISC ],
    [ CELL_AUDIO_CONTROL_SELECTOR  , TABULAR_SCRIPT_COLUMN_ID_NONE       , TABULAR_SCRIPT_CONTAINER_CELL_ID_MISC ]
] );

#############################################################################
#                               View Settings                               #
#############################################################################
#
#    In this section user can set up which fields are to be shown and
#    which are to be hidden in expanded and collapsed states.
#    Zero-value everywhere means that fields will not be shown,
#    otherwise means opposite.
#


# ----------------------- All Field View Settings ---------------------------
#   These settings have priority above separate field View Settings in
#   expanded state ONLY.
#   In order separate field View Settings to work properly
#   BOTH All Field View Settings should be set to 0.
#
#   Due to the fact that ViewAll-setting and HideAll-setting are
#   exceptive propositions - ViewAll has been set a higher priority.
# ---------------------------------------------------------------------------

const ADT_ViewAll              = 0;
const ADT_HideAll              = 0;
# ---------------------------------------------------------------------------


# -----------------------  Separate Field View Settings ---------------------
# The FIRST value in list-variables defines if the field is to be shown or
# hidden in COLLAPSED state.
# 0 - means the field is to be shown.
# 1 - means the field is to be hidden.
#
# The SECOND value in list-variables defines if the field is to be shown or
# hidden in EXPANDED state.
# 0 - means the field is to be shown.
# 1 - means the field is to be hidden.
#
# i.e.  const RPD_Field = [0, 1]# - means that field 'Field' will be hidden
# in collapsed state and will be shown in expanded state.
#




#                       [collapsed, expanded]
const ADT_bmRequestType       = [1, 1];
const ADT_HiIndex             = [1, 1];
const ADT_LoIndex             = [1, 1];
const ADT_HiValue             = [1, 1];
const ADT_LoValue             = [1, 1];
const ADT_wValue              = [1, 1];
const ADT_wLength             = [1, 1];
const ADT_wIndex              = [1, 1];
const ADT_wNumSubRanges       = [1, 1];
const ADT_bCUR                = [1, 1];
const ADT_bMIN                = [1, 1];
const ADT_bMAX                = [1, 1];
const ADT_bRES                = [1, 1];
const ADT_wCUR                = [1, 1];
const ADT_wMIN                = [1, 1];
const ADT_wMAX                = [1, 1];
const ADT_wRES                = [1, 1];
const ADT_dCUR                = [1, 1];
const ADT_dMIN                = [1, 1];
const ADT_dMAX                = [1, 1];
const ADT_dRES                = [1, 1];
const ADT_bNrChannels         = [1, 1];
const ADT_bmChannelConfig     = [1, 1];
const ADT_iChannelNames       = [1, 1];
const ADT_bmBandsPresent      = [1, 1];
const ADT_bBand               = [1, 1];
const ADT_bControlSize        = [1, 1];
const ADT_bCUR_Lo             = [1, 1];
const ADT_bCUR_Hi             = [1, 1];


#-----------------------------------------------------------------------------


set OutputType      = "Audio 3.0 Class Requests";
set UsbDecodeType   = "Request";
set UsbReqType      = "Class";
set UsbClassCode    = 0x01;    # Class code for Audio
set UsbScriptDecodeType = 1;   # Combined decoding for Cells and Text decoding
set UsbProtocol     = 0x30;         # this is used to seperate the 1.0, 2.0 and 3.0


set bReqType = 0;     #Declaring global variables
set bRequest = 0;
set wValue   = 0;
set wIndex   = 0;
set wLength  = 0;
set EntiyId  = 0;
set AttributeString = "";
set BaseColor = 0;
set EntityString = "";



set FullyDecoded = 1;  # Variable that will determine if request has been fully decoded
ProcessData()
{
    CommonDecoderInit();

    UnitDecoderInit("ADT");

    SetCellColor(AudioCaptionColor);

    AddCaptionCell("Audio","Class","In order to view comments in text field, user must expand this caption cell",_MONOCOLOR);  # will allow for the expansion of certain fields
    RestoreCellColor();
    AddSeparator();

    FullyDecoded = 1;
    out.Decoded  = 0;

    if (in.DataLength < 8)
    {
        AddPLCellMonoNoDlg("Error", "Illegal Payload", "Nothing is being decoded", __ERROR);
        return Complete();
    }

    GetNBits( in.Data, 0, 0 );      #Initialize pointer/counter for NextNBits_()

    bReqType = NextNBits_(8);
    bRequest = NextNBits_(8);
    
    _row = Find(AudioCSRequesCodes_v3_Table, bRequest);  # will determine which request is being used
    
    AddRequestCell (_row[1]);
    
    if (bRequest == 0x01 || bRequest == 0x02 || bRequest == 0x04) # CUR. RANGE and INTEN
    {
        if (bReqType == 0x21 || bReqType == 0xA1) #Interface
        {
            data = PeekNBits_(32); # wValue and wIndex
            
            CN = (data & 0xFF000000) >> 24;
            CS = (data & 0x00FF0000) >> 16;
            
            Interface = (data & 0x0000FF00) >> 8;
            EntityID  = (data & 0x000000FF);
            
            EntityRow   = Find(CurrentEntityIdMap, EntityID);
            InternalRow = Find (AudioControlSelectors_v3_Table, EntityRow[2]);
            
            if (InternalRow[2] != null)
                controlRow = Find (InternalRow[2], CS);
            else
                controlRow = null;
                
            FieldColor = wValueColor;
            
            CN = NextNBits_(8);
            
            if (controlRow != null && controlRow[1] == "MU_MIXER_CONTROL")
            {
                AddPayLoadCell("MCN", Format("0x%02X", CN), Format("The Mix Control Number (MCN) = %d", CN));
            }
            else
            {
                AddPayLoadCell("CN", Format("0x%02X", CN), Format("The Channel Number (CN) = %d", CN));
            }

            CS = NextNBits_(8);
            
            if (EntityID == 0)
                AddPayLoadCell("Control Selector", Format("0x%02X", CS), Format("Control Selector = %d", CS), FieldColor, [_TABULARCELL, CELL_AUDIO_CONTROL_SELECTOR, "TEXT_CAPTION"]);
            else if (controlRow == null)
                AddPayLoadCell("Control Selector", Format("0x%02X", CS), WARNING_SIGN + "We don't have the Entity ID information!", _WARNING, [_TABULARCELL, CELL_AUDIO_CONTROL_SELECTOR, "TEXT_CAPTION"]);
            else
                AddPayLoadCell("Control Selector", controlRow[1], Format("The Control Selector value is 0x%02X", CS), FieldColor, [_TABULARCELL, CELL_AUDIO_CONTROL_SELECTOR, "TEXT_CAPTION"]);

            FieldColor = wIndexColor;
            
            Interface = NextNBits_(8);
            AddPayLoadCell("Interface", Format("0x%02X", Interface), Format("Interface %d", Interface));

            EntityID = NextNBits_(8);
            if (EntityID == 0)
                AddPayLoadCell("Entity ID", "0", "This entity is addressing the interface itself");
            else if (EntityRow[0] != 0xFF)
                AddPayLoadCell("Entity ID", EntityRow[0] , Format("The Entity ID is 0x%02X", EntityID));
            else
                AddPayLoadCell("Entity ID", Format("0x%02X", EntityID), WARNING_SIGN + "Unknown EntityID, you might need to set up the Audio3.0CurrentEntityIdMap according to your descriptors",_WARNING);

            FieldColor = wLengthColor;
            
            wLength = NextDataWord_();
            AddPayLoadCell("wLength", Format("%d", wLength), Format("Length of the payload = 0x%04X", wLength));
            AddSeparator();
            
            if (controlRow != null && controlRow[2]!= null)
                decoded = Call(controlRow[2], [controlRow[3], controlRow[4], controlRow[5], controlRow[6]]);
            else
                decoded = 0;
        }
        else if (bReqType == 0x22 || bReqType == 0xA2) # Endpoint
        {
            lowByte  = NextNBits_(8);
            FieldColor = wValueColor;
            AddPayLoadCell("CN/MCN", Format("0x%02X", lowByte), Format("The logical channel %d of the cluster is to be influenced", lowByte));

            highByte = NextNBits_(8);
            func_row = Find(AudioEndpointControlSelectors_v3_Table, highByte);

            AddPayLoadCell("CS", func_row[1], Format(" Control Selector = 0x%02X", highByte));

            FieldColor = wIndexColor;
            wIndex = NextDataWord_();
            lowByte = wIndex & 0x00FF;
			AddPayLoadCell("Endpoint", Format("0x%02X",lowByte), Format("Endpoint %d",lowByte));

			FieldColor = wLengthColor;
			wLength = NextDataWord_();
            AddPayLoadCell("wLength", Format("%d", wLength), Format("Length of the payload = 0x%04X", wLength));
            AddSeparator();
            if (func_row[2] != null)
                decoded = Call(func_row[2], [ func_row[3], func_row[4], func_row[5],func_row[6] ]);
            else
                decoded = 0;
        }
        else
        {
            wValue = NextDataWord_();
            AddPayLoadCell("wValue", Format("0x%04X", wValue), Format("wValue = 0x%04X", wValue), FieldColor, [_TABULARCELL, CELL_WVALUE, "TEXT_CAPTION"]);
            wIndex = NextDataWord_();
            AddPayLoadCell("wIndex", Format("0x%04X", wIndex), Format("wIndex = 0x%04X", wIndex));
            wLength = NextDataWord_();
            AddPayLoadCell("wLength", Format("%d", wLength), Format("Length of the payload = 0x%04X", wLength));

            decoded = 0;
        }
    }
    else if (bRequest == 0x03 ) #MEN
    {
        AddWValueCell("", "Zero-based offset value that can be used to access only parts of the Entity's memory space");

        if (bReqType == 0x21 || bReqType == 0xA1) #Interface
        {
            lowByte = NextNBits_(8);
			AddPayLoadCell("Interface", Format("0x%02X",lowByte), Format("Interface %d",lowByte));

            highByte = NextNBits_(8);
            AddPayLoadCell("EntityId", Format("0x%02X", highByte), Format("Entity ID = %d", highByte));

        }
        else if (bReqType == 0x22 || bReqType == 0xA2) # Endpoint
        {
            wIndex = NextDataWord_();
            lowByte = wIndex & 0x00FF;
			AddPayLoadCell("Endpoint", Format("0x%02X",lowByte), Format("Endpoint %d",lowByte));
        }
        else
        {
            wIndex = NextDataWord_();
			AddPayLoadCell("wIndex", Format("0x%04X", wIndex), Format("wIndex = 0x%04X", wIndex));
	    }
	    wLength = NextDataWord_();
	    AddPayLoadCell("wLength", Format("%d", wLength), Format("Length of the payload = 0x%04X", wLength));
	    decoded = 0;
    }
    else if (bReqType == 0xA1 && bRequest == 0x05 ) # CLASS-SPECIFIC STRING REQUEST
    {
        wStrDescrID = NextDataWord_(); # wValue of the request
        AddPayLoadCell("wStrDescrID", Format("0x%04X", wStrDescrID), Format("wStrDescrID = %d", wStrDescrID));
        
        wIndex = NextDataWord_();
        
        iLangIDRequest   = (wIndex & 0xFF00) >> 8;
        Interface        = (wIndex & 0x00FF);
        
        AddPayLoadCell("Interface", Format("0x%02X", Interface), Format("Interface %d", Interface));
        AddPayLoadCell("iLangID", Format("0x%02X", iLangIDRequest), Format("iLangID %d", iLangIDRequest));
        
        wLengthRequest = NextDataWord_();
        AddPayLoadCell("wLength", Format("0x%04X", wLengthRequest), Format("wLength(length of the string descriptor) = %d", wLengthRequest));
        
        
        # Descriptor
        DescriptorStartOffset = 8;
        wLength            = GetDataWord(DescriptorStartOffset);
        bDescriptorType    = GetDataByte(DescriptorStartOffset + 2);
        bDescriptorSubtype = GetDataByte(DescriptorStartOffset + 3);
        wStrDescrID        = GetDataWord(DescriptorStartOffset + 4);
        iLangID            = GetDataByte(DescriptorStartOffset + 6);
        
        AddShortDataHeader(FormatEx ("%s Descriptor (%d bytes)", "Audio Class Specific STRING Descriptor", wLength));
        
        AddEntry( 0, "wLength", wLength, 4, "Unicode String Length is", 0);
        AddDescriptionOnly(FormatEx("%d bytes (%d chars)", bLength , (bLength-7)/2));
        AddFieldBreak();

        AddEntry( 2, "bDescriptorType", bDescriptorType, 2, "CS_STRING. Type of this descriptor.", 0);
        AddFieldBreak();

        AddEntry( 3, "bDescriptorSubtype", bDescriptorType, 2, "SUBTYPE_UNDEFINED", 0);
        AddFieldBreak();
        
        AddEntry( 4, "wStrDescrID", wStrDescrID, 4, "Unique ID for this class-specific String descriptor.", 0);
        AddFieldBreak();
        
        AddEntry( 6, "iLangID", iLangID, 2, "Zero-based index into the LANGID code array as returned by the device.", 0);
        AddFieldBreak();
        
        length_to_decode = in.DataLength - (DescriptorStartOffset + 7);
        DescriptorCellString = ObtainUnicodeString(DescriptorStartOffset + 7, length_to_decode);
        AddEntry( 7, "STRING", "", 2, "String:" + DescriptorCellString, 0);
        AddFieldBreak();
    
        GetNBits( in.Data, DescriptorStartOffset + 7 + length_to_decode, 0 );
        
        decoded = length_to_decode + 7;
    }
    else if ((bReqType == 0xA1 || bReqType == 0xA2) && (bRequest == 0x06)) #CLASS-SPECIFIC HIGH CAPABILITY_DESCRIPTOR REQUEST
    {
        wDescriptorID = NextDataWord_(); # wValue of the request
        AddPayLoadCell("wDescriptorID", Format("0x%04X", wDescriptorID), Format("wDescriptorID = %d", wDescriptorID));
        
        wIndex = NextDataWord_() & 0x00FF ;
        
        if(bReqType == 0xA1)
        {
            AddPayLoadCell("Interface", Format("0x%02X", wIndex), Format("Interface %d", wIndex));
        }
        else # bReqType == 0xA2
        {
            AddPayLoadCell("Endpoint", Format("0x%02X", wIndex), Format("Endpoint %d", wIndex));
        }
        
        wLengthRequest = NextDataWord_();
        AddPayLoadCell("wLength", Format("0x%04X", wLengthRequest), Format("The length of the descriptor to return: %d", wLengthRequest));
 
        # Descriptor
        bDescriptorType = GetDataByte(10);
        
        desc_type_row   = null;
        desc_type_row   = Find(AudioDescriptorType_v3_Table, bDescriptorType);
        
        decoded = 0;
        if((desc_type_row != null) && (desc_type_row[0] != 0xFF))
        {
            decoded = Call(desc_type_row[1], 8);
        }
                
        GetNBits(in.Data, 8 + decoded, 0);
    }
    else
    {
        # bRequest that's unknown, so we use standard stuff
        wValue = NextDataWord_();
        AddPayLoadCell("wValue", Format("0x%04X", wValue), Format("wValue = 0x%04X", wValue), FieldColor, [_TABULARCELL, CELL_WVALUE, "TEXT_CAPTION"]);
        wIndex = NextDataWord_();
        AddPayLoadCell("wIndex", Format("0x%04X", wIndex), Format("wIndex = 0x%04X", wIndex));
        wLength = NextDataWord_();
        AddPayLoadCell("wLength", Format("%d", wLength), Format("Length of the payload = 0x%04X", wLength));
        decoded = 0;
    }
    out.Decoded = 8 + decoded;

    ############ for Debug purposes#########
    # GetNBits(in.Data, 0, 0);             #
    # ShowDataBlock(in.DataLength);        #
    ########################################

    return Complete();
}

Audio_CS_UNDEFINED()
{
    AddStringToDlg("The CS_UNDEFINED descriptor type is not supported in HIGH CAPABILITY_DESCRIPTOR REQUEST","","",_ERROR);
    return 0;
}

Audio_CS_DEVICE()
{
    AddStringToDlg("The CS_DEVICE descriptor type is not supported in HIGH CAPABILITY_DESCRIPTOR REQUEST","","",_ERROR);
    return 0;
}

Audio_CS_CONFIGURATION()
{
    AddStringToDlg("The CS_CONFIGURATION descriptor type is not supported in HIGH CAPABILITY_DESCRIPTOR REQUEST","","",_ERROR);
    return 0;
}

Audio_CS_STRING()
{
    AddStringToDlg("The CS_STRING descriptor type is not supported in HIGH CAPABILITY_DESCRIPTOR REQUEST","","",_ERROR);
    return 0;
}

Audio_CS_ENDPOINT()
{
    AddStringToDlg("The CS_ENDPOINT descriptor type is not supported in HIGH CAPABILITY_DESCRIPTOR REQUEST","","",_ERROR);
    return 0;
}

Audio_CS_INTERFACE(descriptor_start_offset)
{
    decoded_offset     = 0;
    
    wLength            = GetDataWord(descriptor_start_offset);
    bDescriptorType    = GetDataByte(descriptor_start_offset + 2);
    bDescriptorSubtype = GetDataByte(descriptor_start_offset + 3);
    
    AddShortDataHeader(FormatEx ("%s Descriptor  (%d bytes)", "Audio Class Specific INTERFACE", wLength ));
    
    if (wLength > in.DataLength - descriptor_start_offset)
    {
        AddStringToDlg("No enough data for this descriptor", FormatEx("Length required %d bytes, Actual Length %d bytes", wLength, in.DataLength - descriptor_start_offset), OutputUnknownData(in.DataLength - descriptor_start_offset, 0));
        return 0;
    }
    
    AddEntry(0, "wLength", wLength, 4, "Size of the descriptor, in bytes.", 0);
    AddFieldBreak();

    AddEntry(2, "bDescriptorType", bDescriptorType, 2, "CS_CLUSTER descriptor type.", 0);
    AddFieldBreak();

    # Calling appropriate descriptor's sub type
    subtype_row = Find(ACDescriptorSubType_v3_Table, bDescriptorSubType);
    
    if((subtype_row[0] == 0x04) || (subtype_row[0] == 0x0F)) # Only EXTENDED_TERMINAL and CONNECTORS subtypes using the HIGH CAPABILITY_DESCRIPTOR REQUEST.
    {
        AddEntry(3, "bDescriptorSubtype", bDescriptorSubtype, 2, Format ("%s descriptor subtype", func_row[1]), 0);
        AddFieldBreak();
    }
    else
    {
        AddStringToDlg(FormatEx("The Subtype 0x%02X(%s) not supported in HIGH CAPABILITY_DESCRIPTOR REQUEST", bDescriptorSubType, subtype_row[1]),"","",_ERROR);
        return decoded_offset;
    }
    
    decoded_offset = 4;
    if (func_row[2] != null)
    {
        decoded_offset += Call(func_row[2], decoded_offset);
    }
    else
    {
        AddStringToDlg(FormatEx("Unknown subtype 0x%02X", bDescriptorSubType), "", "" ,_ERROR);
    }
    
    return decoded_offset;
}

EXTENDED_TERMINAL_sub(descriptor_start_offset)
{
    decoded_offset     = 0;
    
    wLength            = GetDataWord(descriptor_start_offset);
    bDescriptorType    = GetDataByte(descriptor_start_offset + 2);
    bDescriptorSubtype = GetDataByte(descriptor_start_offset + 3);
    wDescriptorID      = GetDataWord(descriptor_start_offset + 4);
    bNrChannels        = GetDataByte(descriptor_start_offset + 6);
    
    AddShortDataHeader(FormatEx ("%s Descriptor (%d bytes)", "EXTENDED TERMINAL", wLength));
    
    if (wLength > in.DataLength - descriptor_start_offset )
    {
        AddStringToDlg("No enough data for this descriptor",FormatEx("Length required %d bytes, Actual Length %d bytes", wLength, in.DataLength - descriptor_start_offset), OutputUnknownData(in.DataLength - descriptor_start_offset, 0));
        return 0;
    }
    
    AddEntry(0, "wLength", wLength, 4, "Total length of the EXTENDED TERMINAL descriptor, in bytes.", 0);
    AddFieldBreak();
    
    AddEntry(2, "bDescriptorType", bDescriptorType, 2, "CS_INTERFACE descriptor type.", 0);
    AddFieldBreak();
    
    if(bDescriptorSubtype == 0x04) #Should be equal to EXTENDED_TERMINAL
    {
        AddEntry(3, "bDescriptorSubtype", bDescriptorSubtype, 2, "EXTENDED_TERMINAL descriptor subtype.", 0);
        AddFieldBreak();
    }
    else
    {
        AddStringToDlg(FormatEx("Unknown subtype 0x%02X for DescriptorType 0x%02X", bDescriptorSubType, bDescriptorType),"","",_ERROR);
    }
    
    
    AddEntry(4, "wDescriptorID", wDescriptorID, 4, "Unique ID of this Extended Terminal descriptor.", 0);
    AddFieldBreak();
    
    AddEntry(6, "bNrChannels", bNrChannels, 2, "Number of channels present in the Cluster of the Terminal.", 0);
    AddFieldBreak();
    
    decoded_offset = 7;
    
    data_remained = wLength - decoded_offset;
    
    while (data_remained > 0)
    {
        #SEGMENTS
        bSegmentType     = GetDataByte(decoded_offset + 9);
        desc_segment_row = Find(ExtendedTerminalSegmentTypeTable, bSegmentType);
        
        descriptor_start_offset += decoded_offset;
        decoded          = Call(desc_segment_row[2], descriptor_start_offset, desc_segment_row[1]);
        
        data_remained -= decoded;
        
        if((decoded == 0) || (data_remained < 0))
            data_remained = 0;
        
        decoded_offset += decoded;
    }
        
    return decoded_offset;
}

CONNECTORS_sub(descriptor_start_offset)
{
    decoded_offset     = 0;
    
    wLength            = GetDataWord(descriptor_start_offset);
    bDescriptorType    = GetDataByte(descriptor_start_offset + 2);
    bDescriptorSubtype = GetDataByte(descriptor_start_offset + 3);
    wDescriptorID      = GetDataWord(descriptor_start_offset + 4);
    bNrConnectors      = GetDataByte(descriptor_start_offset + 6);
    
    AddShortDataHeader(FormatEx ("%s Descriptor (%d bytes)", "CONNECTORS", wLength));
    
    if (wLength > in.DataLength - descriptor_start_offset )
    {
        AddStringToDlg("No enough data for this descriptor",FormatEx("Length required %d bytes, Actual Length %d bytes", wLength, in.DataLength - descriptor_start_offset), OutputUnknownData(in.DataLength - descriptor_start_offset, 0));
        return 0;
    }
    
    AddEntry(0, "wLength", wLength, 4, "Size of this descriptor, in bytes.", 0);
    AddFieldBreak();
    
    AddEntry(2, "bDescriptorType", bDescriptorType, 2, "CS_INTERFACE descriptor type.", 0);
    AddFieldBreak();
    
    if(bDescriptorSubtype == 0x04) #Should be equal to CONNECTORS
    {
        AddEntry(3, "bDescriptorSubtype", bDescriptorSubtype, 2, "CONNECTORS descriptor subtype.", 0);
        AddFieldBreak();
    }
    else
    {
        AddStringToDlg(FormatEx("Unknown subtype 0x%02X for DescriptorType 0x%02X", bDescriptorSubType, bDescriptorType),"","",_ERROR);
    }
    
    AddEntry(4, "wDescriptorID", wDescriptorID, 4, "Unique ID of this Connectors descriptor.", 0);
    AddFieldBreak();
    
    AddEntry(6, "bNrConnectors", bNrConnectors, 2, "The number of Connectors associated with this Terminal.", 0);
    AddFieldBreak();
    
    connector_count = (wLength - 7) / 11;
    counter = 0;
    data_offset = descriptor_start_offset + 7;
    
    while (connector_count > 0)
    {
        baConID          = GetDataByte(data_offset);
        waClusterDescrID = GetDataWord(data_offset + 1);
        baConType        = GetDataByte(data_offset + 3);
        bmaConAttributes = GetDataByte(data_offset + 4);
        waConDescrStr    = GetDataWord(data_offset + 5);
        daConColor       = GetDataLong(data_offset + 7);

        AddEntry(data_offset, FormatEx("baConID(%d)", counter), baConID, 2, "ID for Connector.", 0, 1);
        AddFieldBreak();
        
        AddEntry(data_offset + 1, FormatEx("waClusterDescrID(%d)", counter), waClusterDescrID, 4, "ID of the physical Cluster descriptor transported over Connector.", 0, 1);
        AddFieldBreak();
        
        conn_type_row = null;
        conn_type_row = Find(ConnectorTypeTable, baConType);
        
        if(conn_type_row != null)
        {
            AddEntry(data_offset + 3, FormatEx("baConType(%d)", counter), baConType, 2, FormatEx("The Connector Type of Connector: %s", conn_type_row[1]), 0, 1);
            AddFieldBreak();
        }
        else
        {
            AddStringToDlg(FormatEx("Unknown connector type 0x%02X.", baConType),"","",_ERROR);
        }
        
        gender        = (bmaConAttributes & 0x3);      # D1..0
        Insertion_rep = (bmaConAttributes & 0x4) >> 2; # D2
        
        gender_row = Find(ConAttributeGenderTable, gender);
        
        if(Insertion_rep)
            Insertion_rep_str = "YES";
        else
            Insertion_rep_str = "NO";
        
        AddEntry(data_offset + 4, FormatEx("bmaConAttributes(%d)", counter), bmaConAttributes, 2, FormatEx("D1..0: Gender: %s  and  D2: Insertion/Removal Reporting: %s", gender_row[1], Insertion_rep_str), 0, 1);
        AddFieldBreak();
        
        AddEntry(data_offset + 5, FormatEx("waConDescrStr(%d)", counter), waConDescrStr, 4, "ID of a String descriptor that provides a physical description of Connector.", 0, 1);
        AddFieldBreak();
        
        
        AddEntry(data_offset + 7, FormatEx("daConColor(%d)", counter), daConColor, 8, "The Connector color of Connector.", 0);
        AddFieldBreak();
        
        data_offset += 11;
        connector_count -= 1;
        counter += 1;
    }
}


CHANNEL_BANDWIDTH_sub(descriptor_start_offset, segment_type)
{
    segment_size = 11;
    
    if ((in.DataLength - descriptor_start_offset) < segment_size)
    {
        AddStringToDlg("No enough data for this SEGMENT",FormatEx("Length required %d bytes, Actual Length %d bytes", segment_size, in.DataLength - descriptor_start_offset), OutputUnknownData(in.DataLength - descriptor_start_offset, 0));
        return 0;
    }
    
    wLength       = GetDataWord(descriptor_start_offset);
    bSegmentType  = GetDataByte(descriptor_start_offset + 2);
    dMinFreq      = GetDataLong(descriptor_start_offset + 3);
    dMaxFreq      = GetDataLong(descriptor_start_offset + 7);
    
    if(wLength == segment_size)
    {
        AddEntry(0, "wLength", wLength, 4, "Length of the this Segment, in bytes.", 0);
        AddFieldBreak();
    }
    else
    {
        AddStringToDlg(FormatEx("Unknown size 0x%02X for this SegmentType", wLength),"","",_ERROR);
    }
    
    AddEntry(2, "bSegmentType", bSegmentType, 2, segment_type, 0);
    AddFieldBreak();
    
    AddEntry(3, "dMinFreq", dMinFreq, 8, "Lower -3 dB frequency point in Hz.", 0);
    AddFieldBreak();
    
    AddEntry(7, "dMaxFreq", dMaxFreq, 8, "Upper -3 dB frequency point in Hz.", 0);
    AddFieldBreak();
    
    return segment_size;
}

CHANNEL_MAGNITUDE_RESPONSE_sub(descriptor_start_offset, segment_type)
{
    wLength       = GetDataWord(descriptor_start_offset);
    bSegmentType  = GetDataByte(descriptor_start_offset + 2);

    if ((in.DataLength - descriptor_start_offset) < wLength)
    {
        AddStringToDlg("No enough data for this SEGMENT",FormatEx("Length required %d bytes, Actual Length %d bytes", wLength, in.DataLength - descriptor_start_offset), OutputUnknownData(in.DataLength - descriptor_start_offset, 0));
        return 0;
    }
    
    AddEntry(0, "wLength", wLength, 4, "Length of the this Segment, in bytes.", 0);
    AddFieldBreak();
        
    AddEntry(2, "bSegmentType", bSegmentType, 2, segment_type, 0);
    AddFieldBreak();
    
    frequency_pairs_count = (wLength - 3) / 6;
    counter = 0;
    data_offset = descriptor_start_offset + 3;
    while (frequency_pairs_count > 0)
    {
        dFreq        = GetDataLong(data_offset);
        wMagnitude   = GetDataWord(data_offset + 4);

        AddEntry(data_offset, FormatEx("dFreq(%d)", counter), dFreq, 8, "Frequency point(HZ).", 0, 1);
        AddFieldBreak();
        
        AddEntry(data_offset + 4, FormatEx("wMagnitude(%d)", counter), wMagnitude, 4, "Magnitude value.", 0, 1);
        AddFieldBreak();
        
        data_offset += 6;
        frequency_pairs_count -= 1;
        counter += 1;
    }
    
    return wLength;
}

CHANNEL_MAGNITUDE_PHASE_RESPONSE_sub(descriptor_start_offset, segment_type)
{
    wLength       = GetDataWord(descriptor_start_offset);
    bSegmentType  = GetDataByte(descriptor_start_offset + 2);

    if ((in.DataLength - descriptor_start_offset) < wLength)
