TE_INSERTION_CONTROL_sub(validBit, cellColor, validate_func, tooltip_func)
{
    FieldColor = cellColor;
    
    if (wLength > in.DataLength - 8)
        wLength = in.DataLength - 8;

    decoded = 0;

    if (bRequest == 0x01) # only valid with CUR
    {
        if(wLength >= 1)
        {
            bSize = NextNBits_(8);
            AddPayLoadCell("bSize", Format("0x%02X", bSize), "Indicates the number of bytes in the bmConInserted bitmap.");
            decoded = 1;
            
            if(wLength >= (bSize + 1))
            {
                AddPayLoadCell("bmConInserted", Format("Size = 0x%02X", bSize), "Each set bit represents a currently inserted connector.");
                ShowDataBlock(bSize);
                decoded = bSize + 1;
            }
            else
                AddNoEnoughDataCell();
        }
        else
            AddNoEnoughDataCell();
    }
    
    return decoded;
}

GRAPHIC_EQUALIZER_CONTROL_v3_sub(validBit, cellColor, validate_func, tooltip_func)
{
    if (wLength > in.DataLength - 8)
        wLength = in.DataLength - 8;
    FieldColor = cellColor;

    if (bRequest == 0x01) # CUR
    {
        if (wLength >= 4)
        {
            bmBandsPresent = NextNBits_(32);
            AddPayLoadCell("bmBandsPresent", Format("0x%08X", bmBandsPresent), "A bit set indicates the band is present:\nD0: Band 14\nB1: Band 15\n...\nD29:Band 43\nD30: Reserved\n...");
            for (i = 4; i < wLength ; i ++)
            {
                bBand = NextNBits_(8);
                if (bBand > 0x7F)
                {
                    bBand = bBand | 0xFFFFFF00; # make 2's comp for dword value
                }
                toolTip = Format("Settings for Band Control 0x%02X: ",bBase) + Format("%d * 0.25 dB", bBase);
                VS = "ADT_bBand";
                AddBlockPLCell(Format("bBand %d",i-4), Format("0x%02X", bBand), toolTip);
            }
            return 4;
        }
        else
        {
            return 0;
        }
    }
    else if (bRequest == 0x02) #RANGE
    {
        if (wLength >= 2)
        {
            wNumSubRanges = NextDataWord_();
            AddPayLoadCell("wNumSubRanges", Format("%d", wNumSubRanges), "The number of subranges of the Graphic Equalizer Control.");
        }
        else
        {
            AddNoEnoughDataCell();
            return 0;
        }
        isEnoughData = 0;
        if (wLength < 2 + wNumSubRanges * 3)
            wNumSubRanges = (wLength - 2) / 3;
        else
            isEnoughtData = 1;
        for(i = 0; i < wNumSubRanges; i++)
        {
            bMin = NextNBits_(8);
            if (bMin > 0x7F)
            {
                bMin = bMin | 0xFFFFFF00; # make 2's comp for dword value
            }
            toolTip = Format("Settings for Graphic Equalizer Control 0x%02X: ",bMin) + Format("%d * 0.25 dB", bMin);
            VS = "ADT_bMIN";
            AddBlockPLCell(Format("bMin %d",i + 1), Format("0x%02X", bMin), toolTip);

            bMax = NextNBits_(8);
            if (bMax > 0x7F)
            {
                bMax = bMax | 0xFFFFFF00; # make 2's comp for dword value
            }
            toolTip = Format("Settings for Graphic Equalizer Control 0x%02X: ",bMax) + Format("%d * 0.25 dB", bMax);
            VS = "ADT_bMAX";
            AddBlockPLCell(Format("bMax %d",i + 1), Format("0x%02X", bMax), toolTip);

            bRes = NextNBits_(8);
            if (bRes > 0x7F)
            {
                bRes = bRes | 0xFFFFFF00; # make 2's comp for dword value
            }
            toolTip = Format("Settings for Graphic Equalizer Control 0x%02X: ",bRes) + Format("%d * 0.25 dB", bRes);
            VS = "ADT_bRES";
            AddBlockPLCell(Format("bRes %d",i + 1), Format("0x%02X", bRes), toolTip);
        }
        if (isEnoughData == 0)
            AddNoEnoughDataCell();
        return 2 + wNumSubRanges * 3;
    }
    else
        return 0;
}

AS_VAL_ALT_SETTINGS_CONTROL_v3_sub (validBit, cellColor, validate_func, tooltip_func)
{
    if (wLength > in.DataLength - 8)
        wLength = in.DataLength - 8;
    FieldColor = cellColor;
    if (bRequest == 0x01) # CUR
    {
        if (wLength >= 1)
        {
            bControlSize = NextNBits_(8);
            AddPayLoadCell("bControlSize", Format("%d", bControlSize), "Indicates the number of bytes in the bmValidAltSetting bit map");
        }
        else
        {
            AddNoEnoughDataCell();
            return 0;
        }
        if (wLenth >= 1 + bControlSize)
        {
            ShowDataBlock (bControlSize);
            return 1 + bControlSize;
        }
        else
        {
            AddNoEnoughDataCell();
            return 1;
        }
    }
    else
        return 0;
}

AudioLayout1(validBit, cellColor, func_valid, func_tooltip)
{
    if (wLength > in.DataLength - 8)
        wLength = in.DataLength - 8;

    FieldColor = cellColor;
    validCur   =  validBit >> 2;
    validRange = (validBit & 0b010) >> 1;
    validINTEN =  validBit & 0b001; # INTEN is just valid in Layout1

    if (bRequest == 0x01 && validCur == 1) # CUR
    {
        if (wLength >= 1)
        {
            bCur  = NextNBits_(8);
            Error = null;
            
            if (func_valid != null)
            {
                correct = Call (func_valid, [ bCur ]);
                if (correct == 0)
                    Error == _ERROR;
            }

            if (func_tooltip == null)
                value_string = Format("0x%02X", bCur);
            else
                value_string = Call(func_tooltip, [bCur]);

            AddPayLoadCell("bCUR", value_string , "The setting for the CUR attribute of the addressed Control.", Error);
            return 1;
        }
        else
        {
            AddNoEnoughDataCell();
            return 0;
        }
    }
    else if (bRequest == 0x02 && validRange == 1) # RANGE
    {
        if (wLength >= 2)
        {
            wNumSubRanges = NextDataWord_();
            AddPayLoadCell("wNumSubRanges", Format("%d", wNumSubRanges), "The number of subranges of the addressed Control.");
        }
        else
        {
            AddNoEnoughDataCell();
            return 0;
        }

        isEnoughData = 0;
        if (wLength <  2 + 3 * wNumSubRanges)
            wNumSubRanges = (wLength - 2) / 3;
        else
            isEnoughData = 1;

        for (i = 0; i< wNumSubRanges; i++)
        {
            bMIN = NextNBits_(8);
            Error = null;
            if (func_valid != null)
            {
                correct = Call (func_valid, [ bMIN ]);
                if (correct == 0)
                    Error == _ERROR;
            }

            if (func_tooltip == null)
                value_string = Format("0x%02X", bMIN);
            else
                value_string = Call(func_tooltip, [bMIN]);
            VS = "ADT_bMIN";
            AddBlockPLCell(Format("bMIN(%d)", i+1), value_string, Format("The setting for the MIN attribute of the %d subrange of the addressed Control", i + 1), Error);

            bMAX = NextNBits_(8);
            Error = null;
            if (func_valid != null)
            {
                correct = Call (func_valid, [ bMAX ]);
                if (correct == 0)
                    Error == _ERROR;
            }

            if (func_tooltip == null)
                value_string = Format("0x%02X", bMAX);
            else
                value_string = Call(func_tooltip, [bMAX]);

            VS = "ADT_bMAX";
            AddBlockPLCell(Format("bMAX(%d)", i+1), value_string, Format("The setting for the MAX attribute of the %d subrange of the addressed Control", i + 1), Error);

            bRES = NextNBits_(8);
            Error = null;

            if (func_valid != null)
            {
                correct = Call (func_valid, [ bRES ]);
                if (correct == 0)
                    Error == _ERROR;
            }

            if (func_tooltip == null)
                value_string = Format("0x%02X", bRES);
            else
                value_string = Call(func_tooltip, [bRES]);
            VS = "ADT_bRES";
            AddBlockPLCell(Format("bRES(%d)", i+1), value_string, Format("The setting for the RES attribute of the %d subrange of the addressed Control", i + 1), Error);
        }

        if (isEnoughData == 0)
            AddNoEnoughDataCell();
        return 2 + 3 * wNumSubRanges;
    }
    if (bRequest == 0x04 && validINTEN == 1) # INTEN
    {
        if (wLength >= 1)
        {
            bINTEN  = NextNBits_(8);
            Error = null;
            
            if (bINTEN != 0 && bINTEN != 1)
                Error == _ERROR;

            if (func_tooltip == null)
                value_string = Format("0x%02X", bINTEN);
            else
                value_string = Call(func_tooltip, [bINTEN]);

            AddPayLoadCell("bINTEN", value_string , "The setting for the INTEN attribute of the addressed Control.", Error);
            return 1;
        }
        else
        {
            AddNoEnoughDataCell();
            return 0;
        }
    }
    else
        return 0;
}


AudioLayout2(validBit, cellColor, func_valid, func_tooltip)
{
    validCur   =  validBit >> 2;
    validRange = (validBit & 0b010) >> 1;

    if (wLength > in.DataLength - 8)
        wLength = in.DataLength - 8;
    FieldColor = cellColor;

    if (bRequest == 0x01 && validCur == 1) # CUR
    {
        if (wLength >= 2)
        {
            wCur = NextDataWord_();
            Error = null;
            if (func_valid != null)
            {
                correct = Call (func_valid, [ wCur ]);
                if (correct == 0)
                    Error == _ERROR;
            }

            if (func_tooltip == null)
                value_string = Format("0x%04X", wCur);
            else
                value_string = Call(func_tooltip, [wCur]);

            AddPayLoadCell("wCUR", value_string , "The setting for the CUR attribute of the addressed Control.", Error);
            return 2;
        }
        else
        {
            AddNoEnoughDataCell();
            return 0;
        }
    }
    else if (bRequest == 0x02 && validRange == 1) # RANGE
    {
        if (wLength >= 2)
        {
            wNumSubRanges = NextDataWord_();
            AddPayLoadCell("wNumSubRanges", Format("%d", wNumSubRanges), "The number of subranges of the addressed Control.");
        }
        else
        {
            AddNoEnoughDataCell();
            return 0;
        }

        isEnoughData = 0;
        if (wLength <  2 + 3 * wNumSubRanges)
            wNumSubRanges = (wLength - 2) / 3;
        else
            isEnoughData = 1;

        for (i = 0; i< wNumSubRanges; i++)
        {
            wMIN = NextDataWord_();
            Error = null;
            if (func_valid != null)
            {
                correct = Call (func_valid, [ wMIN ]);
                if (correct == 0)
                    Error == _ERROR;
            }

            if (func_tooltip == null)
                value_string = Format("0x%04X", wMIN);
            else
                value_string = Call(func_tooltip, [wMIN]);
            VS = "ADT_wMIN";
            AddBlockPLCell(Format("wMIN(%d)", i+1), value_string, Format("The setting for the MIN attribute of the %d subrange of the addressed Control", i + 1), Error);

            wMAX = NextDataWord_();
            Error = null;
            if (func_valid != null)
            {
                correct = Call (func_valid, [ wMAX ]);
                if (correct == 0)
                    Error == _ERROR;
            }

            if (func_tooltip == null)
                value_string = Format("0x%04X", wMAX);
            else
                value_string = Call(func_tooltip, [wMAX]);

            VS = "ADT_wMAX";
            AddBlockPLCell(Format("wMAX(%d)", i+1), value_string, Format("The setting for the MAX attribute of the %d subrange of the addressed Control", i + 1), Error);

            wRES = NextDataWord_();
            Error = null;

            if (func_valid != null)
            {
                correct = Call (func_valid, [ wRES ]);
                if (correct == 0)
                    Error == _ERROR;
            }

            if (func_tooltip == null)
                value_string = Format("0x%04X", wRES);
            else
                value_string = Call(func_tooltip, [wRES]);

            VS = "ADT_wRES";
            AddBlockPLCell(Format("wRES(%d)", i+1), value_string, Format("The setting for the RES attribute of the %d subrange of the addressed Control", i + 1), Error);
        }

        if (isEnoughData == 0)
            AddNoEnoughDataCell();
        return 2 + ( 3 * 2 * wNumSubRanges );

    }
    else
        return 0;
}


AudioLayout3(validBit, cellColor, func_valid, func_tooltip)
{
    validCur   =  validBit >> 2;
    validRange = (validBit & 0b010) >> 1;

    if (wLength > in.DataLength - 8)
        wLength = in.DataLength - 8;
    FieldColor = cellColor;

    if (bRequest == 0x01 && validCur == 1) # CUR
    {
        if (wLength >= 4)
        {
            dCur = NextDataDWord_();
            Error = null;
            if (func_valid != null)
            {
                correct = Call (func_valid, [ dCur ]);
                if (correct == 0)
                    Error == _ERROR;
            }

            if (func_tooltip == null)
                value_string = Format("0x%08X", dCur);
            else
                value_string = Call(func_tooltip, [dCur]);

            AddPayLoadCell("dCUR", value_string , "The setting for the CUR attribute of the addressed Control.", Error);
            return 4;
        }
        else
        {
            AddNoEnoughDataCell();
            return 0;
        }

    }
    else if (bRequest == 0x02 && validRange == 1) # RANGE
    {
        if (wLength >= 2)
        {
            wNumSubRanges = NextDataWord_();
            AddPayLoadCell("wNumSubRanges", Format("%d", wNumSubRanges), "The number of subranges of the addressed Control.");
        }
        else
        {
            AddNoEnoughDataCell();
            return 0;
        }

        isEnoughData = 0;
        if (wLength <  2 + 3 * wNumSubRanges)
            wNumSubRanges = (wLength - 2) / 3;
        else
            isEnoughData = 1;

        for (i = 0; i< wNumSubRanges; i++)
        {
            dMIN = NextDataDWord_();
            Error = null;
            if (func_valid != null)
            {
                correct = Call (func_valid, [ dMIN ]);
                if (correct == 0)
                    Error == _ERROR;
            }

            if (func_tooltip == null)
                value_string = Format("0x%08X", dMIN);
            else
                value_string = Call(func_tooltip, [dMIN]);

            VS = "ADT_dMIN";
            AddBlockPLCell(Format("dMIN(%d)", i+1), value_string, Format("The setting for the MIN attribute of the %d subrange of the addressed Control", i + 1), Error);

            dMAX = NextDataDWord_();
            Error = null;
            if (func_valid != null)
            {
                correct = Call (func_valid, [ dMAX ]);
                if (correct == 0)
                    Error == _ERROR;
            }

            if (func_tooltip == null)
                value_string = Format("0x%08X", dMAX);
            else
                value_string = Call(func_tooltip, [dMAX]);
            VS = "ADT_dMAX";
            AddBlockPLCell(Format("dMAX(%d)", i+1), value_string, Format("The setting for the MAX attribute of the %d subrange of the addressed Control", i + 1), Error);

            dRES = NextDataDWord_();
            Error = null;
            if (func_valid != null)
            {
                correct = Call (func_valid, [ dRES ]);
                if (correct == 0)
                    Error == _ERROR;
            }

            if (func_tooltip == null)
                value_string = Format("0x%08X", dRES);
            else
                value_string = Call(func_tooltip, [dRES]);

            VS = "ADT_dRES";
            AddBlockPLCell(Format("dRES(%d)", i+1), value_string, Format("The setting for the RES attribute of the %d subrange of the addressed Control", i + 1), Error);
        }

        if (isEnoughData == 0)
            AddNoEnoughDataCell();

        return 2 + ( 3 * 4 * wNumSubRanges );
    }
    else
        return 0;
}

####################################################################################
#                       USBTracer specific caption cell                            #
####################################################################################

AddSpecCaptionCell(caption, text, tooltip, FieldColor, addparam, addparam1, addparam2 )
{
    AddCell(caption, text, tooltip, FieldColor, _USBBULK_HEADER, addparam, addparam1, addparam2 );
    return 1;
}