%include "CATCScriptAPI.inc"
%include "UsbCommon.inc"
%include "Video_Common.inc"
%include "VideoTables.inc"
%include "VideoCellColors.inc"

#----  Input
# in.Data       - Data_block to decode
# in.DataLength - Length of Data_block 
#
#----  Output
# out.Decoded   - amount of data has been decoded
#


set OutputType    = "Video Bulk Out";
set UsbDecodeType = "Endpoint";
set UsbEndpId = 6; # just a unique value for each endpoint of the same Class/Vendor/Product to distinguish them
set UsbClassCode = 0x0E;
set UsbEndpType = "Bulk";
set UsbEndpDir = "Out";
set UsbMaxXferSize = 0xFFFFFF;
set UsbMaxPktSize       = 512; # will automatically be reduced to 64 if branch is Full Speed     
set UsbMaxXferDecodeSize   = 12;  # Max bytes that we will be decoding   User can up this if he likes
#set UsbXferCompleteClue    = 1; # Transfer not necessarily over when empty frame seen.  See USBCommon.inc for explanation.


set UsbScriptDecodeType = 2; ######changed this from 1; explicit text decoding processing

#
# Parsing entry point
#
  


# User can select the colors for the fields he chooses


set ContainerLength = 0;    # these are global variables
set ContainerType = 0;
set Code = 0;
set TransactionID = 0;
set Payload = 0;
set numOfParams = 0;


set FullyDecoded = 1;
#set IsUsb2Hub = 1; # default value

ProcessData()
{
    DoProcessDataFirstPart();
    CurrentPayloadColor = VideoBulkOutColor;
    DoVideoPayloadHeader();
    
    return Complete();
}



Data()
{

}

