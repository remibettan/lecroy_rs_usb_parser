ExtensionUnit() 
{
    selector_val = wValue >> 8;
    #selector_val = 1; #for debugging, force it to a value
    if(SimpleShowItem())
    {
    	SetFieldOffsetLen(32,16);
    	AddPayLoadCell("ControlSelector",Format ("Undefined: 0x%02X", selector_val), FormatEx("Control Selector word.  wValue= 0x%04X\nExtension Unit is Vendor Specific\nhence controls undefined\/not known.", wValue));
    }
    SetFieldOffsetLen(48,16);
	if (Ds5SkuType == 0)	# PSR/ASR/AWG
	{
		_if_row_x = Find(CurrentInterfacesMapPSR, wIndex & 0xFF);  # will determine interface name
	}
	else
	{
		_if_row_x = Find(CurrentInterfacesMapAWGT, wIndex & 0xFF);  # will determine interface name
	}
	AddPayLoadCell("Interface", _if_row_x[1], FormatEx("Interface: 0x%02X (Low Byte of wIndex)\nwIndex=0x%04X", wIndex & 0x0FF, wIndex));
    AddPayLoadCell("ExtensionUnitID", Format("%d",(wIndex>>8)&0xFF), FormatEx("ExtensionUnitId: 0x%02X (High Byte of wIndex)\nwIndex=0x%04X",(wIndex>>8)&0xFF,wIndex));
    if(SimpleShowItem())
    {
    	FieldColor = wLengthColor;
    	SetFieldOffsetLen(64,16);
    	AddPayLoadCell("wLength",wLength,"wLength");
    }
    else
    	SetFieldOffsetLen(64,16);
    FullyDecoded = 0;
    return 1;
}
  


VideoStreaming() 
{
    selector_val = wValue >> 8;
    #selector_val = 10; #for debugging, force it to a value
    _row_z = Find(VideoStreamingInterfaceControlSelectorsTable, selector_val);
    if (_row_z[0] != 0xFF)
    {
        if (_row_z[1] == "VS_CONTROL_UNDEFINED")
        {
        		SetFieldOffsetLen(32,16);
            AddPayLoadCell("ControlSelector", _row_z[1], FormatEx("Control Selector word.  wValue= 0x%04X", wValue));
        }
        else if (SimpleShowItem())
        {
        		SetFieldOffsetLen(32,16);
            AddPayLoadCell("ControlSelector", _row_z[1], FormatEx("Control Selector word.  wValue= 0x%04X", wValue));
        }
        doIndexAndLength();
        #EndOfRequest();
        AddSeparator();
        RequestRightSide();
        Call ( _row_z[1]);        
    }
    else return 0;
    
    return 1;    
}

VS_CONTROL_UNDEFINED()
{
    #AddPayLoadCell("ControlSelector", "Undefined", FormatEx("Control Selector word.  wValue= 0x%04X", wValue));
}
VS_PROBE_CONTROL() 
{
    if (!in.Expanded)
        AddCell("Probe", "Control", "VS_PROBE_CONTROL",FieldColor);
    do_probe_commit_controls();    
}
VS_COMMIT_CONTROL() 
{
    if (!in.Expanded)
        AddCell("Commit", "Control", "VS_COMMIT_CONTROL",FieldColor);
    do_probe_commit_controls();
}

set HintBitmapTable =
[
    [  0, "dwFrameInterval" ],
    [  1, "wKeyFrameRate  " ],
    [  2, "wPFrameRate    " ],
    [  3, "wCompQuality   " ],
    [  4, "wCompWindowSize" ]
];

set FramingInfoBitmapTable =
[
		[		0,	"Frame ID(FID)"],
		[		1,	"End of Frame(EOF)"]
];		


do_probe_commit_controls() #Version 2.0 - Added last five fields (wLength is now 34 from 26)
{
# Check the length for each individual field, could also do a top level check (i.e. is payload length appopriate for all fields combined (wlength).
#~#

	if (ProbeCommitIVCAM == 1)
	{
		bmHint = NextDataWord_();
		out.Decoded += 2;
	}
	else
	{
		if((in.DataLength - out.Decoded) > 1)
		{ 
			bmHint = NextDataWord_();
			out.Decoded += 2;
			temp_str3 = ToBitDecode(HintBitmapTable, bmHint, "");        
			AddPayLoadCell("bmHint", Format ("0x%02X", bmHint), temp_str3 + "<p>&nbsp&nbsp&nbspKeep set Params Fixed</p>");
		}
		else
		{
			temp_Dif = (in.DataLength - out.Decoded);
			if(temp_Dif > 0)
				bmHint = NextNBits_(8);
			else
				bmHint = 0;
			SetCellColor(RED);
			temp_str3 = ToBitDecode(HintBitmapTable, bmHint, "");        
			AddPayLoadCell("bmHint", FormatEx ("PAYLOAD IS SHORT, VALUE IS ONLY %d BYTES LONG - 0x%02X", temp_Dif, bmHint), temp_str3 + "<p>&nbsp&nbsp&nbspKeep set Params Fixed</p>");
			RestoreCellColor();
			out.Decoded += temp_Dif;	
		}   	    
	}
#~#    	
#~#
		if((in.DataLength - out.Decoded) > 0)
		{ 
			bFormatIndex = NextNBits_(8);    
			out.Decoded += 1;
			if (1 == interfaceNum)
			{
				formatStringEntry = Find(depthCameraFormats, bFormatIndex);
			}
			else if (2 == interfaceNum)
			{
				formatStringEntry = Find(YCameraFormats, bFormatIndex);    
			}
			else if (4 == interfaceNum)
			{
				formatStringEntry = Find(fishEyeCameraFormats, bFormatIndex);
			}

			AddPayLoadCell("bFormatIndex", formatStringEntry[1], Format("Stream format index %d according to descriptor", bFormatIndex));
		}
		else
		{	
			bFormatIndex = 0;
			SetCellColor(RED);
			AddPayLoadCell("bFormatIndex", bFormatIndex, Format ("PAYLOAD IS SHORT, EMPTY VALUE - 0x%02X", bFormatIndex));
			RestoreCellColor();	
		}
#~#    
#~#
		if((in.DataLength - out.Decoded) > 0)
		{ 
# TODO: return it to index
			bFrameIndex = NextNBits_(8);    
			out.Decoded += 1;
			if (1 == interfaceNum)
			{
				resolutionStringEntry = Find(depthCameraResolutions, bFormatIndex);
			}
			else if (2 == interfaceNum)
			{
				resolutionStringEntry = Find(depthCameraResolutions, bFormatIndex); 
#YCalibCameraResolutions				
			}
			else if (4 == interfaceNum)
			{
				resolutionStringEntry = Find(fishEyeCameraResolutions, bFormatIndex);
			}
			
			AddPayLoadCell("bFrameIndex", resolutionStringEntry[1], Format ("Stream resolution index %d according to descriptor", bFrameIndex));
		}
		else
		{
			bFrameIndex = 0;
			SetCellColor(RED);
			AddPayLoadCell("bFrameIndex", bFrameIndex, Format ("PAYLOAD IS SHORT, EMPTY VALUE - 0x%02X", bFrameIndex));
			RestoreCellColor();
		}			
