ProcessingUnit() 
{
    selector_val = wValue >> 8;
    #selector_val = 16; #for debugging, force it to a value
    _row_z = Find(ProcessingUnitControlSelectorsTable_V1_1, selector_val);
    if (_row_z[0] != 0xFF)
    {
        if (_row_z[1] == "PU_CONTROL_UNDEFINED")
        {
        		SetFieldOffsetLen(32,16);
            AddPayLoadCell("ControlSelector", _row_z[1], FormatEx("Control Selector word.  wValue= 0x%04X", wValue));
        }
        else if (SimpleShowItem())
        {
        		SetFieldOffsetLen(32,16);
            AddPayLoadCell("ControlSelector", _row_z[1], FormatEx("Control Selector word.  wValue= 0x%04X", wValue));
        }
        doIndexAndLength();
        #EndOfRequest();
        AddSeparator();
        RequestRightSide();
        Call ( _row_z[1]);        
    }
    else 
    		return 0;
    return 1;    
}

PU_CONTROL_UNDEFINED()
{
    #AddPayLoadCell("ControlSelector", "Undefined", FormatEx("Control Selector word.  wValue= 0x%04X", wValue));
}
    
