CT_EXPOSURE_TIME_ABSOLUTE_CONTROL() 
{
#~#
		if((in.DataLength - out.Decoded) > 3){

    	dwExposureTimeAbsolute = NextDataDWord_();    

			out.Decoded += 4;
			AddPayLoadCell("dwExposureTimeAbsolute", FormatEx ("%d.%04d sec", dwExposureTimeAbsolute/10000, dwExposureTimeAbsolute%10000), Format ("hex val = 0x%08X", dwExposureTimeAbsolute));
		}
		else{
			temp_Dif = (in.DataLength - out.Decoded);
			select{
				temp_Dif > 2 : dwExposureTimeAbsolute = NextData3Bytes_();
				temp_Dif > 1 : dwExposureTimeAbsolute = NextDataWord_();
				temp_Dif > 0 : dwExposureTimeAbsolute = NextNBits_(8);
				default			 : dwExposureTimeAbsolute = 0;
			};
			SetCellColor(RED);		
			AddPayLoadCell("dwExposureTimeAbsolute", FormatEx ("PAYLOAD IS SHORT, VALUE IS ONLY %d BYTES LONG - %d.%04d sec", temp_Dif, dwExposureTimeAbsolute/10000, dwExposureTimeAbsolute%10000), Format ("hex val = 0x%08X", dwExposureTimeAbsolute));
			RestoreCellColor();    	
		}
#~#    	
}
 
