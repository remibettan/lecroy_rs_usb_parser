set OutputType      = "Video 1.1 Class Requests";      
set UsbDecodeType   = "Request";
set UsbReqType      = "Class";
set UsbClassCode    = 0x0E;    # Class code for Video
set UsbScriptDecodeType = 1;   # Combined decoding for Cells and Text decoding 
set UsbProtocol     = 0x020; 
#set UsbSpecVersion 	= 0x0110;


set bReqType = 0;     #Declaring global variables
set bRequest = 0;
set wValue   = 0;
set wIndex   = 0;
set wLength  = 0;
set EntiyId  = 0;
set AttributeString = "";
set BaseColor = 0;
set EntityString = "---";

#%include "VideoDescriptors.inc"

set FullyDecoded = 1;  # Variable that will determine if request has been fully decoded
ProcessData()
{ 
    DoProcessDataFirstPart();
    
    CommonDecoderInit();    
    
    UnitDecoderInit("VC2");    
    
    #DoRequestStringTop();   # function used for text decoding
    
    AddShortDataHeader("Request");
    
    FullyDecoded = 1;
        
    out.Decoded = 0;   
    
    if (in.DataLength < 8)    
    { 
 				if ( !AddSpecPLCellMonoNoDlg("Error", "Illegal Payload", "Nothing is being decoded", __ERROR) )  
 						# Check if some specific AddPLCellMonoNoDlg hook handled call
          	#	Original color: AddCell("Error", "Illegal Payload", "Nothing is being decoded", _ERROR); 
          	#	Originally scripted: AddCell("Error", "Illegal Payload", "Nothing is being decoded", FieldColor, _MONOCOLOR, _ERROR);
          	#	Same as below: AddCell("Error", "Illegal Payload", "Nothing is being decoded", ERROR_COLOR, _ERROR);
         		AddErrorMonoCell("Error", "Illegal Payload", "Nothing is being decoded");
     		
     #   AddPLCellMonoNoDlg("Error", "Illegal Payload", "Nothing is being decoded", __ERROR);
        return Complete();
    }
    GetNBits(in.Data, 0, 0);        #Initialize pointer/counter for NextNBits_
    
    bReqType = NextNBits_(8); 			#0-7
    bRequest = NextNBits_(8);   	 	#8-15
  	wValue   = NextDataWord_();  		#16-31
	  wIndex   = NextDataWord_();   	#32-47
    wLength  = NextDataWord_();			#48-63
    
    out.Decoded = 8;

    _row = Find(VideoRequestTable, bRequest);  # will determine which request is being used
    
    AddShortDataHeader(_row[1]);
    if (_row[0] == 0)
    {
        AddSeparator();
        AddDecodedTextHeader();  # header for the text decoding
        SetFieldOffsetLen(8,8);  
        FieldColor = bRequestColor;
        AddPayLoadCell("bmRequestType",Format("0x%04X",bReqType),Format("bitmap with decimal value of %d",bReqType) + "\n\nCharacteristics of Request:\n   D7      Data xfer direction\n\t   0 = Host to Device\n\t   1=Device to host\n\n   D6..5   Type\n\t   0 = Standard\n\t   1 = Class\n\t   2 = Vendor\n\t   3 = Reserved\n\n   D4..0   Recipient\n\t   0 = Device\n\t   1 = Interface\n\t   2 = Endpoint\n\t   3 = Other\n\t   4..31 = Reserved\n");
        SetFieldOffsetLen(16,8);
        FieldColor = bRequestColor;
        AddPayLoadCell("bRequest", _row[1], Format("bRequest HexVal: 0x%04X", bRequest), FieldColor, [_TABULARCELL, CELL_REQUEST]);
        SetFieldOffsetLen(32,16);
        FieldColor = wValueColor;
        AddPayLoadCell("wValue", wValue, "", FieldColor, [_TABULARCELL, CELL_WVALUE, "TEXT_CAPTION"]);
        SetFieldOffsetLen(48,16);
        FieldColor = wIndexColor;
        AddPayLoadCell("wIndex",wIndex,"");
        SetFieldOffsetLen(64,16);
        FieldColor = wLengthColor;
        AddPayLoadCell("wLength",wLength,"");
    }
    if ( _row[0] != 0)
    {
        AttributeString = _row[1];
        
        Call ( _row[1], [ in.DataLength ] );  # will call function for the specified request
        if(FullyDecoded == 1)                 # if the request is fully decoded
        {
            out.Decoded = in.DataLength;
        }
        else if(FullyDecoded == 0)
        {
            out.Decoded = BitCurrentFieldOffset/8;
        }
    }
    else
    {
        out.Decoded = 8;
    }

    AddSeparator();

    ############ for Debug purposes#########
    # GetNBits(in.Data, 0, 0);             #
    # ShowDataBlock(in.DataLength);        #
    ########################################       

    return Complete();
}

# Add Request Decoding by Application [request table in Dialog View]
DecodeRequestToText()
{
    return DecodeRequestToTextCommon( VideoRequestTable );    
}

# List of different requests for Video Class
set VideoRequestTable = 
[
    [   0x00, "RC_UNDEFINED" ],                  
    [   0x01, "SET_CUR" ],
    [   0x81, "GET_CUR" ],
    [   0x82, "GET_MIN" ],
    [   0x83, "GET_MAX" ],
    [   0x84, "GET_RES" ],
    [   0x85, "GET_LEN" ],
    [   0x86, "GET_INFO"],
    [   0x87, "GET_DEF" ]
];

set ControlSelectorMap = 
[
    [   0x00, "NotFound",                TerminalControlSelectorsTable                		,NotFoundBaseColor               ],   #dummy             
    [   0x01, "VideoControlInterface",   VideoControlInterfaceControlSelectorsTable_V1_1	,VideoControlInterfaceBaseColor  ],
    [   0x02, "Terminal",                TerminalControlSelectorsTable                		,TerminalBaseColor               ],           
    [   0x03, "SelectorUnit",            SelectorUnitControlSelectorsTable            		,SelectorUnitBaseColor           ],
    [   0x04, "Camera",                  CameraTerminalControlSelectorsTable          		,CameraBaseColor                 ],
    [   0x05, "ProcessingUnit",          ProcessingUnitControlSelectorsTable_V1_1         	,ProcessingUnitBaseColor         ],         
    [   0x06, "ExtensionUnit",           DepthExtensionUnitControlSelectorsTable           	,ExtensionUnitBaseColor          ],
    [   0x07, "ExtensionUnit",           RgbExtensionUnitControlSelectorsTable           	,ExtensionUnitBaseColor          ],
    [   0x08, "VideoStreamInterface",    VideoStreamingInterfaceControlSelectorsTable 		,VideoStreamingBaseColor         ]         
];

set CapabilitiesBitmapTable =
[
    [  0, "Supports GET request      " ],
    [  1, "Supports SET request      " ],
    [  2, "Disabled by Automatic Mode" ],
    [  3, "AutoUpdate Control        " ],
    [  4, "Async Control             " ],
    [  5, "Reserved (0)              " ],
    [  6, "Reserved (0)              " ],
    [  7, "Reserved (0)              " ]
];


