Terminal() 
{
    selector_val = wValue >> 8;
    #selector_val = 1; #for debugging, force it to a value
    if(SimpleShowItem()){
    	if(selector_val == 0)
    	{
        	AddPayLoadCell("ControlSelector", Format ("Undefined: 0x%02X", selector_val) , FormatEx("Control Selector (High Byte of wValue)\nwValue= 0x%04X\nTerminal Control Selectors are UNDEFINED", wValue));
    	}
    	else
    	{
	    	AddPayLoadCell("ControlSelector", Format ("Unknown: 0x%02X", selector_val) , FormatEx("Control Selector (High Byte of wValue)\nwValue= 0x%04X\nTerminal Control Selector Unknown\n (only 0x00 defined as UNDEFINED)", wValue));
    	}
    }
    doIndexAndLength();
    FullyDecoded = 0;
    SetFieldOffsetLen(64,16);
    return 1;    
}


    
SelectorUnit() 
{
    selector_val = wValue >> 8;
    #selector_val = 1; #for debugging, force it to a value
    _row_z = Find(SelectorUnitControlSelectorsTable, selector_val);
    if (_row_z[0] != 0xFF)
    {
        if (_row_z[1] =="SU_CONTROL_UNDEFINED")
        {
        		SetFieldOffsetLen(32,16);
            AddPayLoadCell("ControlSelector", _row_z[1], FormatEx("Control Selector word.  wValue= 0x%04X", wValue));
        }
        else if (SimpleShowItem())
        {
        		SetFieldOffsetLen(32,16);
            AddPayLoadCell("ControlSelector", _row_z[1], FormatEx("Control Selector word.  wValue= 0x%04X", wValue));
        }
        doIndexAndLength();
        #EndOfRequest();
        AddSeparator();
        RequestRightSide();
        Call ( _row_z[1]);        
    }
    else return 0;
    
    return 1;    
}

SU_CONTROL_UNDEFINED() 
{
    #AddPayLoadCell("ControlSelector", "Undefined", FormatEx("Control Selector word.  wValue= 0x%04X", wValue));
}

SU_INPUT_SELECT_CONTROL() 
{
#~#
		if((in.DataLength - out.Decoded) > 0){ 
    	bSelector = NextNBits_(8);    
			out.Decoded += 1;
    	AddPayLoadCell("bSelector", Format ("0x%02X", bSelector), Format ("Selector = %d", bSelector));			
    }
    else{
    	bSelector=0;
      SetCellColor(RED);
      AddPayLoadCell("bSelector", Format ("PAYLOAD IS SHORT, EMPTY VALUE - 0x%02X", bSelector), Format ("Selector = %d", bSelector));
      RestoreCellColor(); 
    }   		
#~#
}



Camera() 
{
    selector_val = wValue >> 8;
    #selector_val = 17; #for debugging, force it to a value
    _row_z = Find(CameraTerminalControlSelectorsTable, selector_val);
    if (_row_z[0] != 0xFF)
    {
        if (_row_z[1] == "CT_CONTROL_UNDEFINED")
        {
        		SetFieldOffsetLen(32,16);
            AddPayLoadCell("ControlSelector", _row_z[1], FormatEx("Control Selector word.  wValue= 0x%04X", wValue));
        }
        else if (SimpleShowItem())
        {
        		SetFieldOffsetLen(32,16);
            AddPayLoadCell("ControlSelector", _row_z[1], FormatEx("Control Selector word.  wValue= 0x%04X", wValue));
        }
        doIndexAndLength();
        #EndOfRequest();
        AddSeparator();
        RequestRightSide();
        Call ( _row_z[1]);        
    }
    else return 0;
    
    return 1;    
}

CT_CONTROL_UNDEFINED() 
{
    #AddPayLoadCell("ControlSelector", "Undefined", FormatEx("Control Selector word.  wValue= 0x%04X", wValue));
}         
CT_SCANNING_MODE_CONTROL() 
{
#~#
		if((in.DataLength - out.Decoded) > 0){ 
			bScanningMode = NextNBits_(8); 
			out.Decoded += 1;
    	s_str = "Interlaced";
    	if (bScanningMode == 1)
        s_str = "Progressive";     
    	else if (bScanningMode != 0) 
        s_str = "Undefined";   
    	AddPayLoadCell("bScanningMode", s_str, Format ("0x%02X", bScanningMode));
    }
    else{
    	bScanningMode = 0;
    	s_str = "";
    	SetCellColor(RED);
    	AddPayLoadCell("bScanningMode", s_str, Format ("PAYLOAD IS SHORT, EMPTY VALUE - 0x%02X", bScanningMode));
    	RestoreCellColor(); 
    }    				
#~#    	
}
     
