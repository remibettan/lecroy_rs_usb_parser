			Focus_str = "full range";
		else if(bFocus ==  0x01)
			Focus_str = "macro. Less than 0.3 meters";
		else if(bFocus == 0x02)
			Focus_str = "people. 0.3m to 3m";
		else if(bFocus == 0x03)
			Focus_str = "scene. 3m to infinity";			
		else
			Focus_str = "Reserved";	
			
		AddPayLoadCell("bFocus",Focus_str, Format ("0x%04X", bFocus));
	}
	else
	{
		ShowInvalidBuffer();
    }
} 

