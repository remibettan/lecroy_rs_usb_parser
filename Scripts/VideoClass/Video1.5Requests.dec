const VC2_bExposureTimeRelative					= [1, 1];
const VC2_wFocusAbsolute								= [1, 1];
const VC2_bFocusRelative								= [1, 1];
const VC2_bSpeed												= [1, 1];
const VC2_bFocusAuto										= [1, 1];
const VC2_wIrisAbsolute									= [1, 1];
const VC2_bIrisRelative									= [1, 1];
const VC2_wObjectiveFocalLength					= [1, 1];
const VC2_bZoom													= [1, 1];
const VC2_bDigitalZoom									= [1, 1];										
const VC2_dwPanAbsolute									= [1, 1];
const VC2_dwTiltAbsolute								= [1, 1];
const VC2_bPanRelative									= [1, 1];
