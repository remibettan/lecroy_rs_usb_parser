set SyncFrameTypeTable =
[
    [  0,    "Reset"                                                                        ],
    [  1,    "Generate an IDR frame for all of the dependency layers of the current stream" ],
	[  2,    "Generate an IDR frame that is a long-term reference frame"                    ],
	[  3,    "Generate a non-IDR random-access for the associated dependency layers"        ],
	[  4,    "Generate a non-IDR random-access for the a long-term reference frame"         ],
	[  5,    "Generate a P frame that is a-long term reference frame"                       ],
	[  6,    "Gradual Decoder Refresh (GDR)"                                                ]
];

#	Synchronization and Long Term Reference Frame Control
EU_SYNC_REF_FRAME_CONTROL()
{
	if((in.DataLength - out.Decoded) >= 4)
	{
		bSyncFrameType = NextNBits_(8);
		
		if ( bSyncFrameType <= 6)
		{
			_row_zzz = Find(SyncFrameTypeTable, bSyncFrameType);
			AddPayLoadCell("bSyncFrameType", _row_zzz[1], Format ("0x%02X", bSyncFrameType));
		}
		else
		{
			Reserved_str = "Reserved";
			AddPayLoadCell("bSyncFrameType", Reserved_str, Format ("0x%02X", bSyncFrameType));
		}
		wSyncFrameInterval = NextDataWord_(); 
		
		bGradualDecoderRefresh = NextNBits_(8);
		
		GradualDecoderRefresh_str = "";
		if(bGradualDecoderRefresh <= 6)
			GradualDecoderRefresh_str = "recovery_frame_cnt";
		else
			GradualDecoderRefresh_str = "Reserved";
		
		out.Decoded += 4;
		
		AddPayLoadCell("wSyncFrameInterval", wSyncFrameInterval, Format ("0x%04X", wSyncFrameInterval));
		AddPayLoadCell("bGradualDecoderRefresh", GradualDecoderRefresh_str, Format ("0x%02X", bGradualDecoderRefresh));
    }
	else
	{
		ShowInvalidBuffer();
	}

}
#////////////////////////////////////////////////////

#	Long-Term Buffer Control
EU_LTR_BUFFER_CONTROL()
{
	if((in.DataLength - out.Decoded) >= 2)
	{
		bNumHostControlLTRBuffers = NextNBits_(8); 
		bTrustMode = NextNBits_(8);
		
		TrustMode_str = "";
		if(bTrustMode == 0)
			TrustMode_str = "Don't Trust Until";
		else if(bTrustMode == 1)
			TrustMode_str = "Trust Until";
		else
			TrustMode_str = "Undefined value";
		
		out.Decoded +=2;
		
    	AddPayLoadCell("bNumHostControlLTRBuffers", Format ("0x%02X", bNumHostControlLTRBuffers), Format ("bNumHostControlLTRBuffers = %d", bNumHostControlLTRBuffers));			
        AddPayLoadCell("bTrustMode", TrustMode_str, Format ("0x%02X", bTrustMode));
	}
	else
	{
		ShowInvalidBuffer();
	}
}
#////////////////////////////////////////////////////////
#	Long-Term Reference Picture Control
EU_LTR_PICTURE_CONTROL()
{
	if((in.DataLength - out.Decoded) >= 2)
	{
		bPutAtPositionInLTRBuffer = NextNBits_(8);
		
		PutAtPositionInLTRBuffer_str = "";
		if(bPutAtPositionInLTRBuffer == 0)
			PutAtPositionInLTRBuffer_str = "Encoder is free to choose where to save the frame inside the encoder controlled buffers";
		else
			PutAtPositionInLTRBuffer_str = Format("bPutAtPositionInLTRBuffer %d ",bPutAtPositionInLTRBuffer );
		
		bLTRMode = NextNBits_(8);
		
		LTRMode_str = "";
		if(bLTRMode == 0)
			LTRMode_str = "Encoder is restricted to valid host managed LTR frames";
		else if(bLTRMode == 1)
			LTRMode_str = "Encoder may use any valid host or encoder controlled LTR frames";
		else if(bLTRMode == 2)
			LTRMode_str = "Encoder may use any valid reference in the DPB";			
		else
			LTRMode_str = "Undefined Value";
		
		out.Decoded += 2;
		    
        AddPayLoadCell("bPutAtPositionInLTRBuffer", PutAtPositionInLTRBuffer_str, Format ("0x%02X", bPutAtPositionInLTRBuffer));	
        AddPayLoadCell("bLTRMode", LTRMode_str, Format ("0x%02X", bLTRMode));
    }
    else
	{
		ShowInvalidBuffer();
	}
}
#////////////////////////////////////////////////////

#	Long-Term Reference Validation Control
EU_LTR_VALIDATION_CONTROL()
{
	if((in.DataLength - out.Decoded) >= 2)
	{ 
    	bmValidLTRs = NextDataWord_();    
		out.Decoded += 2;
		
		ValidLTRs_str="";
		for(i = 0; i <= 15; i++)
		{
			if((bmValidLTRs>>i) & 0x01)
			{
				ValidLTRs_str += Format("LTR frame with index = %d \n", i);
			}
		}
		 AddPayLoadCell("bmValidLTRs", ValidLTRs_str, Format ("0x%02X", bmValidLTRs));
    }
    else
	{
		ShowInvalidBuffer();
    }    		
}
#///////////////////////////////////////////////////

#	Level IDC Control
EU_LEVEL_IDC_LIMIT_CONTROL()
{
	if((in.DataLength - out.Decoded) >= 1)
	{ 
	  	bLevelIDC = NextNBits_(8);    
		out.Decoded += 1;
		AddPayLoadCell("bLevelIDC", bLevelIDC, Format ("0x%02X", bLevelIDC));
	}
	else
	{
		ShowInvalidBuffer();
	}

	}
