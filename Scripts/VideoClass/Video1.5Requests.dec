#/////////////////////////////////////////////////////////

#	Start or Stop Layer Control
EU_START_OR_STOP_LAYER_CONTROL()
{
	if((in.DataLength - out.Decoded) >= 1)
	{ 
    	bUpdate = NextNBits_(8);    
		out.Decoded += 1;
		
		Update_str = "";
		if(bUpdate == 0)
			Update_str = "Stop streaming the current layer and all layers";
		else if(bUpdate == 1)
			Update_str = "Start streaming the current layer";
		else
		
			Update_str = "Undefined Value";	
			
		AddPayLoadCell("bUpdate", Update_str, Format ("0x%04X", bUpdate));		
    }
    else
	{
		ShowInvalidBuffer();
    }    	
}
#////////////////////////////////////////////

#	Error Resiliency Control
EU_ERROR_RESILIENCY_CONTROL()
{
	if((in.DataLength - out.Decoded) >= 2)
	{
		bmErrorResiliencyFeatures =NextDataWord_(); 
		out.Decoded +=2;
    	AddPayLoadCell("bmErrorResiliencyFeatures",bmErrorResiliencyFeatures, Format ("0x%04X",bmErrorResiliencyFeatures));
	}
	else
	{
		ShowInvalidBuffer();
	}
}

ShowInvalidBuffer()
{
	SetCellColor(RED);
	str = "";
	for( i=0 ; i <(in.DataLength - out.Decoded); i++)
	{
		byte = NextNBits_(8);
		str += FormatEx ("0x%02X ", byte);
	}
	
	AddDescriptionOnly(str);
#	AddPayLoadCell("Data",str, Format ("0x%04X",byte));   
	out.Decoded += (in.DataLength - out.Decoded);
}





























