const VC2_wValue			        					= [1, 1];
const VC2_wIndex			        					= [1, 1];
const VC2_wLength			        					= [1, 1];
const VC2_bDevicePowerMode							= [1, 1];
const VC2_bErrorCode										= [1, 1];
const VC2_dwHostClockFreq								= [1, 1];
const VC2_bSelector											= [1, 1];
const VC2_bScanningMode									= [1, 1];
const VC2_bAutoExposureMode							= [1, 1];
const VC2_bAutoExposurePriority					= [1, 1];
