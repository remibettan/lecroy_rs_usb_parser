#	SEI Message Control
EU_SEI_PAYLOADTYPE_CONTROL()
{
	if((in.DataLength - out.Decoded) >= 8)
	{
		bmSEIMessages = NextDataDWord_() | (NextDataDWord_()  >> 32);
		
		i = 0;
		for(i = 0; i <= 45; i++)
		{
			if((bmSEIMessages>>i) & 0x01)
			{
				_row_zzz = Find(SyncFrameTypeTable, i);
				AddPayLoadCell("bmSEIMessages", _row_zzz[1], Format ("<br>0x%8X", bmSEIMessages));
				break;
			}
		}	
		if((i>45) && (i<64))
		{
			AddPayLoadCell("bmSEIMessages", bmSEIMessages, Format ("<br>Reserved = 0x%02X", bmSEIMessages));
		}
		out.Decoded += 8;
    }
	else
	{
		ShowInvalidBuffer();
	}
}
#//////////////////////////////////////////////////////////

#	Quantization Parameter Range Control
EU_QP_RANGE_CONTROL()
{
	if((in.DataLength - out.Decoded) >= 2)
	{
		bMinQp = NextNBits_(8); 
		bMaxQp = NextNBits_(8);
		
		out.Decoded +=2;
		
    	AddPayLoadCell("bMinQp", Format ("0x%02X", bMinQp), Format ("bMinQp = %d", bMinQp));
		AddPayLoadCell("bMaxQp", Format ("0x%02X", bMaxQp), Format ("bMaxQp = %d", bMaxQp));
	}
	else
	{
		ShowInvalidBuffer();
	}
}
