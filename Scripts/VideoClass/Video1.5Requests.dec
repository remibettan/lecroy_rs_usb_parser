EU_SELECT_LAYER_CONTROL()
{
	if((in.DataLength - out.Decoded) >= 2)
	{ 
    	wLayerOrViewID = NextDataWord_();
		out.Decoded += 2;
		AddPayLoadCell("wLayerOrViewID",wLayerOrViewID, Format ("0x%04X", wLayerOrViewID));
	}
	else
	{
		ShowInvalidBuffer();
	}	
}
#/////////////////////////////////////////////////////////////////
#	Profile Toolset Control

EU_PROFILE_TOOLSET_CONTROL()
{
	if((in.DataLength - out.Decoded) >= 5)
	{ 
    	wProfile 			= NextDataWord_();
		wConstrainedToolset = NextDataWord_();  
		wConstrainedToolset = NextNBits_(8);
		out.Decoded += 5;
		AddPayLoadCell("wProfile", wProfile, Format ("0x%04X", wProfile));
		AddPayLoadCell("wConstrainedToolset", wConstrainedToolset, Format ("0x%04X", wConstrainedToolset));
		AddPayLoadCell("bmSettings", bmSettings, Format ("0x%02X", bmSettings));
	}
	else
	{
		ShowInvalidBuffer();
	}	
}
#////////////////////////////////////////////////////

#	Video Resolution Control
EU_VIDEO_RESOLUTION_CONTROL()
{
	if((in.DataLength - out.Decoded) >= 4)
	{ 
    	wWidth  = NextDataWord_();
		wHeight = NextDataWord_();
		
		out.Decoded += 4;
		
		AddPayLoadCell("wWidth", wWidth, Format ("0x%04X", wWidth));
		AddPayLoadCell("wHeight", wHeight, Format ("0x%04X", wHeight));
	}
	else
	{
		ShowInvalidBuffer();
	}	
}
#/////////////////////////////////////////////////////////////////

#	Minimum Frame Interval Control
EU_MIN_FRAME_INTERVAL_CONTROL()
{
	if((in.DataLength - out.Decoded) >= 4)
	{ 
    	dwFrameInterval = NextDataDWord_();
		out.Decoded += 4;
		AddPayLoadCell("dwFrameInterval", dwFrameInterval, Format ("0x%08X", dwFrameInterval));
	}
	else
	{
		ShowInvalidBuffer();
	}	
}

#//////////////////////////////////////////////////////////////

#	Slice Mode Control
EU_SLICE_MODE_CONTROL()
{
	if((in.DataLength - out.Decoded) >= 4)
	{ 
    	wSliceMode = NextDataWord_();    
		out.Decoded += 2;
		wSlice_MSB = ( wSliceMode >> 8);
		
		wSlice_str = "";
		if(wSlice_MSB == 0)
			wSlice_str = "Maximum number of MBs per slice mode";
		else if(wSlice_MSB == 1)
			wSlice_str = "Target compressed size per slice mode";
		else if(wSlice_MSB == 2)
			wSlice_str = "Number of slices per frame mode";
		else if(wSlice_MSB == 3)
			wSlice_str = "Number of Macroblock rows per slice mode";
		else
			wSlice_str = "Reserved";
		
		wSliceConfigSetting = NextDataWord_();
		out.Decoded += 2;
		
		wSliceConfigSetting_str = "";
		if(wSliceConfigSetting == 0)
			wSliceConfigSetting_str = "Maximum number of MBs per slice";
		else if(wSliceConfigSetting == 1)
			wSliceConfigSetting_str = "Target size for each slice NALU in bytes";
		else if(wSliceConfigSetting == 2)
			wSliceConfigSetting_str = "Number of slices per frame";
		else if(wSliceConfigSetting == 3)
			wSliceConfigSetting_str = "Number of macroblock rows per slice";
		else
			wSliceConfigSetting_str = "Undefined Value";
		
		AddPayLoadCell("wSliceMode", wSlice_str, Format ("0x%04X", wSliceMode));
		AddPayLoadCell("wSliceConfigSetting", wSliceConfigSetting_str, Format ("0x%04X", wSliceConfigSetting));
		
    }
    else
	{
		ShowInvalidBuffer();
    }    	
}
#/////////////////////////////////////////////////////////////

set RateControlModeTable =
[
    [  0,      "Reserved"                               ],
    [  1,      "Variable Bit Rate low delay (VBR)"      ],
    [  2,      "Constant bit rate (CBR)"                ],
	[  3,      "Constant QP"                            ],
	[  4,      "Global VBR low delay (GVBR)"            ],
	[  5,      "Variable bit rate non-low delay (VBRN)" ],
	[  6,      "Global VBR non-low delay (GVBRN)"       ]
	
];

#	Rate Control Mode Control
EU_RATE_CONTROL_MODE_CONTROL()
{
	if((in.DataLength - out.Decoded) >= 1)
	{ 
    	bRateControlMode = NextNBits_(8);
		
		if( bRateControlMode <= 6)
		{
			_row_zzz = Find(RateControlModeTable, bRateControlMode);
			AddPayLoadCell("bRateControlMode", _row_zzz[1], Format ("bRateControlMode = 0x%02X", bRateControlMode));
		}
		else
		{
			Reserved_str = "Reserved";
			AddPayLoadCell("bRateControlMode", Reserved_str, Format ("bRateControlMode = 0x%02X", bRateControlMode));
		}
		out.Decoded += 1;
    }
    else
	{
    	ShowInvalidBuffer();
    }    	
}
