doEndpointInterface()
{
    SetFieldOffsetLen(48,16);
    retval = 1;
    if ((bReqType & 0xF) == 1) # Class/Interface
    {
		if ((Ds5SkuType == 0) || (Ds5SkuType == 3))	# PSR/ASR/AWG or DS5U F416
		{
			_if_row_x = Find(CurrentInterfacesMapPSR, wIndex & 0xFF);  # will determine interface name
		}
		else if (Ds5SkuType == 1)	# AWGT
		{
			_if_row_x = Find(CurrentInterfacesMapAWGT, wIndex & 0xFF);  # will determine interface name
		}
		else if ((Ds5SkuType == 5) || (Ds5SkuType == 6))	# S585 D585
		{
			_if_row_x = Find(CurrentInterfacesMapS585, wIndex & 0xFF);  # will determine interface name
		}
		else # ASRC or AWGC
		{
			_if_row_x = Find(CurrentInterfacesMapASRC, wIndex & 0xFF);  # will determine interface name
		}

        AddPayLoadCell("Interface", _if_row_x[1], FormatEx("Interface: 0x%02X (Low Byte of wIndex)\nwIndex=0x%04X", wIndex & 0x0FF, wIndex));
    }
    else if ((bReqType & 0xF) == 2)# Endpoint
    {
        if (wIndex & 0x80)
        {
            AddPayLoadCell("Endpoint", Format ("%d In", (wIndex & 0x0F)), FormatEx("Endpoint: 0x%01X In   wIndex=0x%04X", wIndex & 0x0F, wIndex));
        }
        else
        {
            AddPayLoadCell("Endpoint", Format ("%d Out", (wIndex & 0x0F)), FormatEx("Endpoint: 0x%01X Out   wIndex=0x%04X", wIndex & 0x0F, wIndex));
        }
    }
    else
    {
        SaveFieldColor = FieldColor;
 #       FieldColor = bReqTypeColor;
 #       SetFieldOffsetLen(32,16);
 #       AddPayLoadCell("bmRequestType",Format("0x%04X",bReqType),Format("bitmap with decimal value of %d",bReqType) + "\n\nCharacteristics of Request:\n   D7      Data xfer direction\n\t   0 = Host to Device\n\t   1=Device to host\n\n   D6..5   Type\n\t   0 = Standard\n\t   1 = Class\n\t   2 = Vendor\n\t   3 = Reserved\n\n   D4..0   Recipient\n\t   0 = Device\n\t   1 = Interface\n\t   2 = Endpoint\n\t   3 = Other\n\t   4..31 = Reserved\n");
        FieldColor = wIndexColor;
        SetFieldOffsetLen(48,16);
        AddPayLoadCell("wIndex",wIndex,"wIndex");
        FieldColor = wLengthColor;
        SetFieldOffsetLen(64,16);
        AddPayLoadCell("wLength",wLength,"wLength");
        FieldColor = SaveFieldColor;
        retval = 0;
    }
    return (retval);
}
    
 
doIndexAndLength()
{
    doEndpointInterface();
    SetFieldOffsetLen(48,16);
    if ((EntityString == "")||(EntityString=="---"))
        AddPayLoadCell("Entity Id", Format ("%d", EntiyId), FormatEx("Entity Id: 0x%02X (High Byte of wIndex)\nwIndex=0x%04X\n\nTo decode properly, the user must provide the mapping of Entity Id to Interface Control types\n\n See file:  VideoCurrentEntityIdMap_EditMe.inc", EntiyId, wIndex));
    else
        AddPayLoadCell("Entity Id", EntityString, FormatEx("Entity Id: 0x%02X = %s \nMapped by user in file: VideoCurrentEntityIdMap_EditMe.inc", EntiyId, EntityString));

    if (SimpleShowItem())
    {
        SetFieldOffsetLen(64,16);
        AddPayLoadCell("wLength",wLength,"wLength");
    }
}
