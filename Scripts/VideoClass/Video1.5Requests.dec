set SyncFrameTypeTable =
[
    [  0,    "Auto Exposure"                                                                        ],
    [  1,    "Auto Iris" 			 ],
	[  2,    "Auto White Balance"    ],
	[  3,    "Auto Focus"        	 ],
	[  4,    "Auto Face Detect"      ],
	[  5,    "Auto Detect and Track" ],
	[  6,    "Image Stabilization"   ],
	[  7,    "Higher Quality"        ]
];

CT_REGION_OF_INTEREST_CONTROL()
{
		if((in.DataLength - out.Decoded) >=10)
	{ 
     	wROI_Top = NextDataWord_(); 
		wROI_Left = NextDataWord_();
		wROI_Bottom = NextDataWord_();
		wROI_Right = NextDataWord_();
		bmAutoControls = NextDataWord_();
		
		out.Decoded += 10;
		
		AddPayLoadCell("wROI_Top", Format ("0x%02X", wROI_Top), Format ("wROI_Top = %d", wROI_Top));
		AddPayLoadCell("wROI_Left", Format ("0x%02X", wROI_Left), Format ("wROI_Left = %d", wROI_Left));
		AddPayLoadCell("wROI_Bottom", Format ("0x%02X", wROI_Bottom), Format ("wROI_Bottom = %d", wROI_Bottom));
		AddPayLoadCell("wROI_Right", Format ("0x%02X", wROI_Right), Format ("wROI_Right = %d", wROI_Right));
		i = 0;
		for(i = 0; i <= 7; i++)
		{
			if((bmAutoControls>>i) & 0x01)
			{
				_row_zzz = Find(SyncFrameTypeTable, i);
				bmAutoControls("bmAutoControls", _row_zzz[1], Format ("0x%8X", bmAutoControls));
				break;
			}
		}	
		if((i>7) && (i<16))
		{
			AddPayLoadCell("bmAutoControls", bmAutoControls, Format ("Reserved = 0x%02X", bmAutoControls));
		}
		
	}
	else
	{
		ShowInvalidBuffer();
	}

}

