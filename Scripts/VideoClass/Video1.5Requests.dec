# Sets up header for left window in text decoding
DoRequestStringTop()
{
    str = "";
    for (i=0; i<8; i++)
    {
        str += Format ("%02X ", GetDataByte(i));
    }
    AddCaptionToDlg("Video ", "Request  ", "");          
    AddCaptionToDlg("Setup Data", str+"  ", "");
    AddCaptionToDlg("------------------------------------", "", "");
    if (bReqType & 0x80)
    {
        str = "Host-to-device  ";
    }
    else
    {
        str = "Device-to-host  ";
    }
    AddCaptionToDlg("Direction", str, "");
    select 
    {
        ((bReqType & 0x60) == 0x00) : str = "Standard  ";
        ((bReqType & 0x60) == 0x20) : str = "Class  ";
        ((bReqType & 0x60) == 0x40) : str = "Vendor  ";
        ((bReqType & 0x60) == 0x60) : str = "RESERVED  ";
    };
    AddCaptionToDlg("     Type", str, "");
    select 
    {
        ((bReqType & 0x1F) == 0x00) : str = "Device  ";
        ((bReqType & 0x1F) == 0x01) : str = "Interface  ";
        ((bReqType & 0x1F) == 0x02) : str = "Endpoint  ";
        ((bReqType & 0x1F) == 0x03) : str = "Other  ";
        default                     : str = "RESERVED  ";
    };
    AddCaptionToDlg("Recipient", str, "");
    AddCaptionToDlg("------------------------------------", "", "");
}

RC_UNDEFINED()
{
    AddSeparator();
    SetFieldOffsetLen(80,16);
    FieldColor = ErrorColor;
    AddPayLoadCell("Error","error","bRequest is not a defined request");
}


set interfaceNum = 0;
do_common_controls()
{
    AddSeparator();
    AddDecodedTextHeader();  # header for the text decoding
    if (SimpleShowItem())
    {
        SetFieldOffsetLen(8,8);  
        AddPayLoadCell("bReqType", Format ("0x%02X", bReqType) ,"bmRequestType");
    }
    
    SetFieldOffsetLen(16,8);  
    AddPayLoadCell("Request", AttributeString, Format("bRequest HexVal: 0x%04X", bRequest));
    
    SetFieldOffsetLen(48,16);
    EntiyId = ((wIndex>>8) & 0xFF);
	interfaceNum = wIndex & 0xFF;
	if ((interfaceNum == 0) || (interfaceNum == 3))
	{
		_row_x = Find(CurrentEntityIdMap, EntiyId);  # will determine which request is being used
	}
	else
	{
		_row_x = Find(CurrentStreamInterfacesMap, interfaceNum);  # will determine which request is being used 
	}
    
    
 
    if (_row_x[2] == 0) # Cant find match for id
    {
    		EntityString = "---";
        SetFieldOffsetLen(32,16);
        AddPayLoadCell("ControlSelector", Format ("0x%02X", wValue >> 8), FormatEx("To obtain the decoding for the control selectors,\nthe user must edit the file\n\nVideoCurrentEntityIdMap_EditMe.inc\n\nto provide the mapping of the Entity Id to the Control Type\nThis info may be found in the enumeration \ninformation in the Device Descriptors.\n\nNormally a Control Selector: wValue=%d", wValue));
        doIndexAndLength();
        #EndOfRequest();
        AddSeparator();
        RequestRightSide();

        GetNBits(in.Data, 8*8, 0);             # mgd added for no data shown when mapping not done
        ShowDataBlockReOrder(in.DataLength-8); # changed to re-order
    }
    else
    {
        _row_y = Find(ControlSelectorMap, _row_x[2]); # _row_y[2] has control table
        FieldColor += _row_y[3];   
        if (bRequest == 0x85) # GET_LEN
        {
            _row_yy = Find(_row_y[2], wValue >> 8); # _row_yy[2] has control selector
           	EntityString = _row_x[1];
            SetFieldOffsetLen(32,16);
            AddPayLoadCell("ControlSelector", _row_yy[1], FormatEx("Control Selector: 0x%02X (high byte of wValue)\nwValue = 0x%04X", wValue >> 8, wValue));
            doIndexAndLength();
            #EndOfRequest();
            AddSeparator();
            RequestRightSide();
#~#         
            if((in.DataLength - out.Decoded) > 0)
			{   
            	len = NextNBits_(8) | (NextNBits_(8) << 8);
            	out.Decoded += 2;
            	AddPayLoadCell("Control Length", len, Format("Control Length is %d bytes", len), temp_str3);
            }
            else
			{
            	len = 0;
            	SetCellColor(RED);
            	AddPayLoadCell("Control Length", len, Format("PAYLOAD IS SHORT, EMPTY VALUE - 0x%02X bytes", len), temp_str3);
            	RestoreCellColor();
            }
#~#            	
        }       
        else if (bRequest == 0x86) # GET_INFO
        {
            _row_yy = Find(_row_y[2], wValue >> 8); # _row_yy[2] has control selector
           	EntityString = _row_x[1];
            SetFieldOffsetLen(32,16);
            AddPayLoadCell("ControlSelector", _row_yy[1], FormatEx("Control Selector: 0x%02X (high byte of wValue)\nwValue = 0x%04X", wValue >> 8, wValue));
            doIndexAndLength();
            #EndOfRequest();
            AddSeparator();
            RequestRightSide();
#~#           
			if((in.DataLength - out.Decoded) > 0)
			{ 
            	caps = NextNBits_(8);
            	out.Decoded += 1;
            	temp_str3 = ToBitDecode(CapabilitiesBitmapTable, caps, "");        
            	temp_str3 = temp_str3 + NewLine();
                AddPayLoadCell("Capabilities", Format("0x%02X", caps), temp_str3);
				
            }
            else{
            	caps = 0;
            	SetCellColor(RED);
            	AddPayLoadCell("Capabilities", Format("%s", "PAYLOAD IS SHORT, EMPTY VALUE"), "no control info value returned");
            	RestoreCellColor();
            }
#~#            	       
        } 
		# GET_MIN, GET_MAX, GET_DEF, GET_RES, GET_CUR
        else if ((bRequest == 0x01) || (bRequest == 0x81) || (bRequest == 0x82) || (bRequest == 0x83) || (bRequest == 0x84) || (bRequest == 0x87))
        {
			controlSelector = wValue >> 8;
			#interfaceNum = wIndex & 0xFF;
			#entityId = wIndex >> 8;
            _row_yy = Find(_row_y[2], wValue >> 8); # _row_yy[2] has control selector
           	EntityString = _row_x[1];
            SetFieldOffsetLen(32,16);
            AddPayLoadCell("ControlSelector", _row_yy[1], FormatEx("Control Selector: 0x%02X (high byte of wValue)\nwValue = 0x%04X", wValue >> 8, wValue));
            doIndexAndLength();
            #EndOfRequest();
            AddSeparator();
            RequestRightSide();
#~#           
			if((in.DataLength - out.Decoded) > 0)
			{ 
				formatString = "0x%08X";
				if (wLength == 1)
				{
					formatString = "0x%02X";
					tempVal = NextNBits_(8);
				}
				if (wLength == 2)
				{
					formatString = "0x%04X";
					tempVal = NextDataWord_(wLength);
				}
				if (wLength == 4)
				{
					formatString = "0x%08X";
					tempVal = NextDataDWord_(wLength);
				}
            	
				if (wLength <= 4)
				{
					out.Decoded += wLength;
					if (bRequest == 0x01)
					{
						AddPayLoadCell("Set value", Format(formatString, tempVal), "new value for control");
					}
					if (bRequest == 0x81)
					{
						# case of UVC ERROR_CODE request
						if (((controlSelector == 2) && (interfaceNum == 0) && (EntiyId == 0)) ||
							((controlSelector == 2) && (interfaceNum == 3) && (EntiyId == 0)))
						{
							_row_zz = Find(ErrorCodeTable, tempVal);
							AddPayLoadCell(" Error Code ", _row_zz[1], "Current value for control");
						}
						if ((controlSelector == 7) && (interfaceNum == 0) && (EntiyId == 3)) # XU error control
						{
							xuErrCtrl = Find(ErrorControlMap, tempVal);
							AddPayLoadCell(" Error Code ", xuErrCtrl[1], "Current value for control");
						}
						else
						{
							AddPayLoadCell("Current value", Format(formatString, tempVal), "Current value for control");
						}
					}
					if (bRequest == 0x82)
					{
						AddPayLoadCell("Min value", Format(formatString, tempVal), "Minimum value for control");
					}
					if (bRequest == 0x83)
					{
						AddPayLoadCell("Max value", Format(formatString, tempVal), "Maximum value for control");
					}
					if (bRequest == 0x84)
					{
						AddPayLoadCell("Resolution value", Format(formatString, tempVal), "Control value steps");
					}
					if (bRequest == 0x87)
					{
						AddPayLoadCell("Default value", Format(formatString, tempVal), "Default value for control");
					}
				}
				else
				{
					if ((wLength == 48) || (wLength == 34))
					{
						do_probe_commit_controls();
					}
					else
					{
						if ((controlSelector == 1) && (interfaceNum == 0) && (EntiyId == 3) && (bRequest == 0x01))
						{
							wCmdSize = NextDataWord_(2);
							out.Decoded +=2;
							AddPayLoadCell(" Length ", Format("0x%04X", wCmdSize), "HWM command Length (without header)");

							wMagicDword = NextDataWord_(2);
							out.Decoded +=2;
							if (0xCDAB == wMagicDword)
							{
								AddPayLoadCell(" Magic Word ", "0xCDAB", "Magic Word for HWM WinUsb Command");
							}

							opCode = NextDataDWord_(4);
							out.Decoded +=4;
							_row_x = Find(CommandsOpcodeLUT, opCode);
							AddPayLoadCell(" OpCode ", _row_x[1], Format("opcode for HWM command 0x%x", opCode));
						
							param1 = NextDataDWord_(4);
							out.Decoded +=4;
							AddPayLoadCell(" Param1 ", Format("0x%04X", param1), "first param for HWM command - see cmd description for more info");

							param2 = NextDataDWord_(4);
							out.Decoded +=4;
							AddPayLoadCell(" param2 ", Format("0x%04X", param2), "second param for HWM command - see cmd description for more info");

							param3 = NextDataDWord_(4);
							out.Decoded +=4;
							AddPayLoadCell(" param3 ", Format("0x%04X", param3), "first param for HWM command - see cmd description for more info");

							param4 = NextDataDWord_(4);
							out.Decoded +=4;
							AddPayLoadCell(" param4 ", Format("0x%04X", param4), "first param for HWM command - see cmd description for more info");
						}
						AddPayLoadCell("wLength", Format("%d", wLength), "Control data length in bytes");
					}
				}
            }
            else{
            	tempVal = 0;
            	SetCellColor(RED);
            	#AddPayLoadCell("Value", Format("%s", "PAYLOAD IS SHORT, EMPTY VALUE"), "no value returned");
            	RestoreCellColor();
            }
#~#            	       
        } 
        else if (((bRequest > 0) && (bRequest <= 0x84)) || (bRequest == 0x87))
        {            
            SetFieldOffsetLen(32,16);
            EntityString = _row_x[1];
            retval = Call ( _row_x[1]);
            if (retval == 0)
            {
                SetFieldOffsetLen(32,16);
                AddPayLoadCell("Unknown ControlSelector", Format ("Unknown:0x%02X", wValue >> 8)  , FormatEx("Control Selector: wValue = 0x%04X", wValue));
                if(SimpleShowItem())
                {
                	FieldColor = wIndexColor;
        					SetFieldOffsetLen(48,16);
        					AddPayLoadCell("wIndex",Format("0x%04X",wIndex),"wIndex");
                	FieldColor = wLengthColor;
        					SetFieldOffsetLen(64,16);
        					AddPayLoadCell("wLength",wLength,"wLength");
        					FullyDecoded = 0;
        				}
            }
        }
        else
        {
        		EntityString = "---";
            AddCell("Unknown Attribute", Format ("Unknown:0x%02X", bRequest), FormatEx("bRequest unknown = 0x%04X", bRequest),RED);
        		SetFieldOffsetLen(32,16);
        		FieldColor = wValueColor;
        		AddPayLoadCell("wValue", wValue, "", FieldColor, [_TABULARCELL, CELL_WVALUE, "TEXT_CAPTION"]);            
            FieldColor = wIndexColor;
        		SetFieldOffsetLen(48,16);
        		AddPayLoadCell("wIndex",Format("0x%04X",wIndex),"wIndex");
            FieldColor = wLengthColor;
        		SetFieldOffsetLen(64,16);
        		AddPayLoadCell("wLength",wLength,"wLength");
        		FullyDecoded = 0;
        }
    }
}
    
