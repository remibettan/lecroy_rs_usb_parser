Terminal() 
{
    selector_val = wValue >> 8;
    #selector_val = 1; #for debugging, force it to a value
    if(SimpleShowItem()){
    	if(selector_val == 0)
    	{
        	AddPayLoadCell("ControlSelector", Format ("Undefined: 0x%02X", selector_val) , FormatEx("Control Selector (High Byte of wValue)\nwValue= 0x%04X\nTerminal Control Selectors are UNDEFINED", wValue));
    	}
    	else
    	{
	    	AddPayLoadCell("ControlSelector", Format ("Unknown: 0x%02X", selector_val) , FormatEx("Control Selector (High Byte of wValue)\nwValue= 0x%04X\nTerminal Control Selector Unknown\n (only 0x00 defined as UNDEFINED)", wValue));
    	}
    }
    doIndexAndLength();
    FullyDecoded = 0;
    SetFieldOffsetLen(64,16);
    return 1;    
}


    
