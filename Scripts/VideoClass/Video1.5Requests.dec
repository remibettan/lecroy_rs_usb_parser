ExtensionUnit() 
{
    selector_val = wValue >> 8;
    #selector_val = 1; #for debugging, force it to a value
    if(SimpleShowItem())
    {
    	SetFieldOffsetLen(32,16);
    	AddPayLoadCell("ControlSelector",Format ("Undefined: 0x%02X", selector_val), FormatEx("Control Selector word.  wValue= 0x%04X\nExtension Unit is Vendor Specific\nhence controls undefined\/not known.", wValue));
    }
    SetFieldOffsetLen(48,16);
	if ((Ds5SkuType == 0) || (Ds5SkuType == 3))	# PSR/ASR/AWG or DS5U F416
	{
		_if_row_x = Find(CurrentInterfacesMapPSR, wIndex & 0xFF);  # will determine interface name
	}
	else if (Ds5SkuType == 1)	# AWGT
	{
		_if_row_x = Find(CurrentInterfacesMapAWGT, wIndex & 0xFF);  # will determine interface name
	}
	else if ((Ds5SkuType == 5) || (Ds5SkuType == 6))	# S585 D585
	{
		_if_row_x = Find(CurrentInterfacesMapS585, wIndex & 0xFF);  # will determine interface name
	}
	else	# ASRC & AWGC
	{
		_if_row_x = Find(CurrentInterfacesMapASRC, wIndex & 0xFF);  # will determine interface name
	}
	
	AddPayLoadCell("Interface", _if_row_x[1], FormatEx("Interface: 0x%02X (Low Byte of wIndex)\nwIndex=0x%04X", wIndex & 0x0FF, wIndex));
    AddPayLoadCell("ExtensionUnitID", Format("%d",(wIndex>>8)&0xFF), FormatEx("ExtensionUnitId: 0x%02X (High Byte of wIndex)\nwIndex=0x%04X",(wIndex>>8)&0xFF,wIndex));
    if(SimpleShowItem())
    {
    	FieldColor = wLengthColor;
    	SetFieldOffsetLen(64,16);
    	AddPayLoadCell("wLength",wLength,"wLength");
    }
    else
    	SetFieldOffsetLen(64,16);
    FullyDecoded = 0;
    return 1;
}
  


VideoStreaming() 
{
    selector_val = wValue >> 8;
    #selector_val = 10; #for debugging, force it to a value
    _row_z = Find(VideoStreamingInterfaceControlSelectorsTable, selector_val);
    if (_row_z[0] != 0xFF)
    {
        if (_row_z[1] == "VS_CONTROL_UNDEFINED")
        {
        		SetFieldOffsetLen(32,16);
            AddPayLoadCell("ControlSelector", _row_z[1], FormatEx("Control Selector word.  wValue= 0x%04X", wValue));
        }
        else if (SimpleShowItem())
        {
        		SetFieldOffsetLen(32,16);
            AddPayLoadCell("ControlSelector", _row_z[1], FormatEx("Control Selector word.  wValue= 0x%04X", wValue));
        }
        doIndexAndLength();
        #EndOfRequest();
        AddSeparator();
        RequestRightSide();
        Call ( _row_z[1]);        
    }
    else return 0;
    
    return 1;    
}

VS_CONTROL_UNDEFINED()
{
    #AddPayLoadCell("ControlSelector", "Undefined", FormatEx("Control Selector word.  wValue= 0x%04X", wValue));
}
VS_PROBE_CONTROL() 
{
    if (!in.Expanded)
        AddCell("Probe", "Control", "VS_PROBE_CONTROL",FieldColor);
    do_probe_commit_controls();    
}
VS_COMMIT_CONTROL() 
{
    if (!in.Expanded)
        AddCell("Commit", "Control", "VS_COMMIT_CONTROL",FieldColor);
    do_probe_commit_controls();
}

EncodingUnitControlSelectors()
{
    selector_val = wValue >> 8;
    
    _row_z = Find(EncodingUnitControlSelectorsTable_V1_5, selector_val);
    if (_row_z[0] != 0xFF)
    {
        if (_row_z[1] == "EU_CONTROL_UNDEFINED")
        {
        	SetFieldOffsetLen(32,16);
            AddPayLoadCell("ControlSelector", _row_z[1], FormatEx("Control Selector word.  wValue= 0x%04X", wValue));
        }
        else if (SimpleShowItem())
        {
        	SetFieldOffsetLen(32,16);
            AddPayLoadCell("ControlSelector", _row_z[1], FormatEx("Control Selector word.  wValue= 0x%04X", wValue));
        }
        doIndexAndLength();
        #EndOfRequest();
        AddSeparator();
        RequestRightSide();
        Call ( _row_z[1]);        
    }
    else return 0;
    return 1;    

}

set HintBitmapTable =
[
    [  0, "dwFrameInterval" ],
    [  1, "wKeyFrameRate  " ],
    [  2, "wPFrameRate    " ],
    [  3, "wCompQuality   " ],
    [  4, "wCompWindowSize" ]
];

set FramingInfoBitmapTable =
[
	[  0,	"Frame ID(FID)"],
	[  1,	"End of Frame(EOF)"],
	[  2,	"End of Slice (EOS)"]
];		

do_probe_commit_controls()  #Version 1.5 - Added last Six fields (wLength is now 48 Byte)
{
# Check the length for each individual field, could also do a top level check (i.e. is payload length appopriate for all fields combined (wlength).

#////////////////////////////////////////////////////////
#	bmHint field
	
	if((in.DataLength - out.Decoded) > 1)
	{ 
		if (ProbeCommitIVCAM == 1)
		{
			bmHint = NextDataWord_();
			out.Decoded += 2;
		}
		else
		{
			bmHint  = NextDataWord_();
			out.Decoded += 2;
			temp_str3 = ToBitDecode(HintBitmapTable, bmHint, "");        
			AddPayLoadCell("bmHint", Format ("0x%02X", bmHint), temp_str3 + "<p>&nbsp&nbsp&nbspKeep set Params Fixed</p>");
		}
    }
    else
	{
    	temp_Dif = (in.DataLength - out.Decoded);
		if(temp_Dif > 0)
			bmHint = NextNBits_(8);
		else
		bmHint = 0;
		SetCellColor(RED);
    	temp_str3 = ToBitDecode(HintBitmapTable, bmHint, "");        
    	AddPayLoadCell("bmHint", FormatEx ("PAYLOAD IS SHORT, VALUE IS ONLY %d BYTES LONG - 0x%02X", temp_Dif, bmHint), temp_str3 + "<p>&nbsp&nbsp&nbspKeep set Params Fixed</p>");
    	RestoreCellColor();
    	out.Decoded += temp_Dif;	
	}   
	
#/////////////////////////////////////////////////////////    	
#	bFormatIndex field
	if((in.DataLength - out.Decoded) >= 1)
	{ 
    	bFormatIndex = NextNBits_(8);    
		out.Decoded += 1;
		if (1 == interfaceNum)
		{
			formatStringEntry = Find(depthCameraFormats, bFormatIndex);
		}
		else if (2 == interfaceNum)
		{
			if (Ds5SkuType == 6)	# S585
			{
				formatStringEntry = Find(S585YCameraFormats, bFormatIndex);    
			}
			else
			{
				formatStringEntry = Find(YCameraFormats, bFormatIndex);    
			}
		}
		else if (4 == interfaceNum)
		{
			if ((Ds5SkuType == 2) || (Ds5SkuType == 4) || (Ds5SkuType == 6)) # ASRC or AWGC or S585
			{
				formatStringEntry = Find(rgbCameraFormats, bFormatIndex);
			}
			else
			{
				formatStringEntry = Find(fishEyeCameraFormats, bFormatIndex);
			}
		}
		
		if (Ds5SkuType == 6)	# S585
		{
			if (12 == interfaceNum)	# safety camera
			{
				formatStringEntry = Find(S585SafetyCameraFormats, bFormatIndex);
			}
			
			if (14 == interfaceNum)	# occupancy camera
			{
				formatStringEntry = Find(S585OccupancyCameraFormats, bFormatIndex);
			}
		}
		
		#AddPayLoadCell("bFormatIndex", bFormatIndex, Format ("0x%02X", bFormatIndex));
		AddPayLoadCell("bFormatIndex", Format(" %d ( %s ) ", bFormatIndex, formatStringEntry[1]), Format("Stream format index %d according to descriptor", bFormatIndex));
		
	}

#//////////////////////////////////////////////////////
#	bFrameIndex field
	if((in.DataLength - out.Decoded) >= 1)
	{ 
    	bFrameIndex = NextNBits_(8);    
		out.Decoded += 1;
		
		if (1 == interfaceNum)
		{
			if (Ds5SkuType == 3) # DS5U F416
			{
				resolutionStringEntry = Find(F416DepthCameraResolutions, bFrameIndex);
			}
			else if ((Ds5SkuType == 4) || (Ds5SkuType == 1)) # AWGC or AWGT (wide)
			{
				resolutionStringEntry = Find(AwgDepthCameraResolutions, bFrameIndex);
			}
			else if (Ds5SkuType == 5) # D585
			{
				resolutionStringEntry = Find(D585DepthCameraResolutions, bFrameIndex);
			}
			else if (Ds5SkuType == 6) # S585
			{
				resolutionStringEntry = Find(S585DepthCameraResolutions, bFrameIndex);
			}
			else
			{
				resolutionStringEntry = Find(depthCameraResolutions, bFrameIndex);
			}
		}
		else if (2 == interfaceNum)
		{
			if (bFormatIndex <= 4)
			{
				if (Ds5SkuType == 3) # DS5U F416
				{
					resolutionStringEntry = Find(F416DepthCameraResolutions, bFrameIndex);
				}
				else if ((Ds5SkuType == 4) || (Ds5SkuType == 1)) # AWGC or AWGT (wide)
				{
					resolutionStringEntry = Find(AwgDepthCameraResolutions, bFrameIndex);
				}
				else if (Ds5SkuType == 5) # D585
				{
					resolutionStringEntry = Find(D585DepthCameraResolutions, bFrameIndex);
				}
				else if (Ds5SkuType == 6) # S585
				{
					if (bFormatIndex == 1)
					{
						resolutionStringEntry = Find(S585YCameraResolutions, bFrameIndex);
					} else 
					{
						resolutionStringEntry = Find(S585CalibCameraResolutions, bFrameIndex);
					}
				}
				else
				{
					resolutionStringEntry = Find(depthCameraResolutions, bFrameIndex);
				}
			}
			else if (bFormatIndex == 5) # calib mode
			{
				if (Ds5SkuType == 3) # DS5U F416
				{
					resolutionStringEntry = Find(F416YCalibCameraResolutions, bFrameIndex);
				}
				else if ((Ds5SkuType == 4) || (Ds5SkuType == 1)) # AWGC or AWGT (wide)
				{
					resolutionStringEntry = Find(WideYCalibCameraResolutions, bFrameIndex);
				}
				else if (Ds5SkuType == 5)
				{
					resolutionStringEntry = Find(S585CalibCameraResolutions, bFrameIndex);
				}
				else
				{
					resolutionStringEntry = Find(YCalibCameraResolutions, bFrameIndex);
				}
			}
			else
			{
				if (Ds5SkuType == 3) # DS5U F416
				{
					resolutionStringEntry = Find(F416YCalibCameraResolutions, bFrameIndex);
				}
				else
				{
					resolutionStringEntry = Find(YW10CameraResolutions, bFrameIndex);
				}
			}
		}
		else if (4 == interfaceNum)
		{
			if ((Ds5SkuType == 2) || (Ds5SkuType == 4)) # ASRC or AWGC
			{
				if (bFormatIndex == 1)	# YUY2
				{
					resolutionStringEntry = Find(rgbCameraResolutions, bFrameIndex);
				}
				else if (bFormatIndex == 2)	# RAW16
				{
					resolutionStringEntry = Find(raw16CameraResolutions, bFrameIndex);
				}
			}
			else if (Ds5SkuType == 5)
			{
				if (bFormatIndex == 3)	# RAW16
				{
					resolutionStringEntry = Find(S585Raw16CameraResolutions, bFrameIndex);
				}
				else 
				{
					resolutionStringEntry = Find(D585RgbCameraResolutions, bFrameIndex);
				}
			}
			else if (Ds5SkuType == 6)
			{
				if (bFormatIndex == 3)	# RAW16
				{
					resolutionStringEntry = Find(S585Raw16CameraResolutions, bFrameIndex);
				}
				else 
				{
					resolutionStringEntry = Find(S585RgbCameraResolutions, bFrameIndex);
				}
			}
			else
			{
				resolutionStringEntry = Find(fishEyeCameraResolutions, bFrameIndex);
			}
		} else if (12 == interfaceNum)
		{
			if (Ds5SkuType == 6) # S585
			{
				resolutionStringEntry = Find(S585SaferyCameraResolutions, bFrameIndex);
			}
		}
		else if (14 == interfaceNum)
		{
			if (Ds5SkuType == 6) # S585
			{
				resolutionStringEntry = Find(S585OccupancyCameraResolutions, bFrameIndex);
			}
		}

#		AddPayLoadCell("bFrameIndex", bFrameIndex, Format ("0x%02X", bFrameIndex));
		AddPayLoadCell("bFrameIndex", Format(" %d ( %s ) ", bFrameIndex, resolutionStringEntry[1]), Format ("Stream resolution index %d according to descriptor", bFrameIndex));
	}
		
#/////////////////////////////////////////////////////////////////   	
#	dwFrameInterval field
	if((in.DataLength - out.Decoded) >= 4)
	{ 
    	dwFrameInterval = NextDataDWord_();
		out.Decoded += 4;
#		AddPayLoadCell("dwFrameInterval", dwFrameInterval, Format ("0x%08X", dwFrameInterval));
		AddPayLoadCell(" FPS ", 10000000 / dwFrameInterval, Format ("0x%08X", dwFrameInterval));
	}
	else
	{
		ShowInvalidBuffer();
	}	
#/////////////////////////////////////////////////////////////////////////   	
#	wKeyFrameRate field
	if((in.DataLength - out.Decoded) >= 2)
	{
		wKeyFrameRate = NextDataWord_();    
		out.Decoded += 2;
		if (ProbeCommitIVCAM == 0)
		{
			AddPayLoadCell("wKeyFrameRate", wKeyFrameRate, Format ("0x%04X", wKeyFrameRate));
		}
	}
	else
	{
		ShowInvalidBuffer();
	}
#////////////////////////////////////////////////////////////////   	
#	wPFrameRate field
	if((in.DataLength - out.Decoded) >= 2)
	{ 
    	wPFrameRate = NextDataWord_();        
		out.Decoded += 2;
		if (ProbeCommitIVCAM == 0)
		{
			AddPayLoadCell("wPFrameRate", wPFrameRate, Format ("0x%04X", wPFrameRate));
		}
	}
	else
	{
		ShowInvalidBuffer();
	}
#////////////////////////////////////////////////////////   	
#	 wCompQuality field
	if((in.DataLength - out.Decoded) >= 2)
	{ 
	    wCompQuality = NextDataWord_();    
		out.Decoded += 2;
		if (ProbeCommitIVCAM == 0)
		{
			AddPayLoadCell("wCompQuality", wCompQuality, Format ("0x%04X", wCompQuality));
		}
	}
	else
	{
		ShowInvalidBuffer();
	}
#////////////////////////////////////////////////////////////// 		
#	wCompWindowSize field
	if((in.DataLength - out.Decoded) >= 2)
	{ 
    	wCompWindowSize = NextDataWord_();    
		out.Decoded += 2;
		if (ProbeCommitIVCAM == 0)
		{
			AddPayLoadCell("wCompWindowSize", wCompWindowSize, Format ("0x%04X", wCompWindowSize));
		}
	}
	else
	{
		ShowInvalidBuffer();
	}
#/////////////////////////////////////////////////////////////   	
#	wDelay field
	if((in.DataLength - out.Decoded) >= 2)
	{ 
    	wDelay = NextDataWord_();    
		out.Decoded += 2;
		if (ProbeCommitIVCAM == 0)
		{
			AddPayLoadCell("wDelay", wDelay, Format ("0x%04X", wDelay));
		}
	}		    	
	else
	{
		ShowInvalidBuffer();
	}
#//////////////////////////////////////////////////////////    	
#	dwMaxVideoFrameSize field
	if((in.DataLength - out.Decoded) >= 4)
	{ 
    	dwMaxVideoFrameSize       = NextDataDWord_();    
		out.Decoded += 4;
		AddPayLoadCell("dwMaxVideoFrameSize", dwMaxVideoFrameSize, Format ("0x%08X", dwMaxVideoFrameSize));
	}
	else
	{
		ShowInvalidBuffer();
	}
#///////////////////////////////////////////////
#	dwMaxPayloadTransferSize field	
	if((in.DataLength - out.Decoded) >= 4)
	{ 
    	dwMaxPayloadTransferSize  = NextDataDWord_();
		out.Decoded += 4;
		AddPayLoadCell("dwMaxPayloadTransferSize", dwMaxPayloadTransferSize, Format ("0x%08X", dwMaxPayloadTransferSize));
	}
	else
	{
		ShowInvalidBuffer();
	}
	
#////////////////////////////////////////////////////
#	dwClockFrequency field   
	if((in.DataLength - out.Decoded) >= 4)
	{
		dwClockFrequency = NextDataDWord_();
		out.Decoded += 4;
		if (ProbeCommitIVCAM == 0)
		{
			AddPayLoadCell("dwClockFrequency", dwClockFrequency, Format ("0x%08X", dwClockFrequency));
		}
	}
	else
	{
		ShowInvalidBuffer();
	}
		
#//////////////////////////////////////////////////////
#	bmFramingInfo field  
	
	bmFramingInfo = NextNBits_(8);
	out.Decoded += 1;

	if (ProbeCommitIVCAM == 0)
	{
		i = 0;
		for(i = 0; i <= 45; i++)
		{
			if((bmFramingInfo>>i) & 0x01)
			{
				row_zzz = Find(FramingInfoBitmapTable, i);
				AddPayLoadCell("bmFramingInfo", _row_zzz[1], Format ("0x%8X", bmFramingInfo));
				break;
			}
		}	
		
		if((i>2) && (i<8))
		{
			AddPayLoadCell("bmFramingInfo", bmFramingInfo, Format ("Reserved = 0x%02X", bmFramingInfo));
		}
		else
		{
			ShowInvalidBuffer();
		}
	}
	
#////////////////////////////////////////////////
#bPreferedVersion Field		
	if((in.DataLength - out.Decoded) >= 1)
	{
		bPreferedVersion = NextNBits_(8);
		out.Decoded += 1;
		if (ProbeCommitIVCAM == 0)
		{
			AddPayLoadCell("bPreferedVersion", bPreferedVersion, Format ("0x%02X", bPreferedVersion));
		}
	}
    else
	{
		ShowInvalidBuffer();
	}
#////////////////////////////////////////
#	bMinVersion Field		
    if((in.DataLength - out.Decoded) >= 1)
	{
    	bMinVersion = NextNBits_(8);
		out.Decoded += 1;
		if (ProbeCommitIVCAM == 0)
		{
			AddPayLoadCell("bMinVersion", bMinVersion, Format ("0x%02X", bMinVersion));
		}
    }
    else
	{
		ShowInvalidBuffer();
	}
#////////////////////////////////////////
#	bMaxVersion Field		
    if((in.DataLength - out.Decoded) >= 1)
	{
    	bMaxVersion = NextNBits_(8);
		out.Decoded += 1;
		if (ProbeCommitIVCAM == 0)
		{
			AddPayLoadCell("bMaxVersion", bMaxVersion, Format ("0x%02X", bMaxVersion));
		}
    }
    else
	{
		ShowInvalidBuffer();
	}
		
#/////////////////////////////////////////////
#   bUsage field
    if((in.DataLength - out.Decoded) >= 1)
	{
    	bUsage = NextNBits_(8);
		out.Decoded += 1;
		if (ProbeCommitIVCAM == 0)
		{
			AddPayLoadCell("bUsage", bUsage, Format ("0x%02X", bUsage));
		}
    }
    else
	{
		ShowInvalidBuffer();
	}
		
#////////////////////////////////////////////
#   bBitDepthLuma Field
    if((in.DataLength - out.Decoded) >= 1)
	{
    	bBitDepthLuma = NextNBits_(8);
		out.Decoded += 1;
		if (ProbeCommitIVCAM == 0)
		{
			AddPayLoadCell("bBitDepthLuma", bBitDepthLuma, Format ("0x%02X", bBitDepthLuma));
		}
    }
    else
	{
		ShowInvalidBuffer();
	}
		
#///////////////////////////////////////////
#	bmSettings Field
    if((in.DataLength - out.Decoded) >= 1)
	{
    	bmSettings = NextNBits_(8);
		out.Decoded += 1;
		if (ProbeCommitIVCAM == 0)
		{
			AddPayLoadCell("bmSettings", bmSettings, Format ("0x%02X", bmSettings));
		}
    }
    else
	{
		ShowInvalidBuffer();
	}
#/////////////////////////////////////////////
#	bMaxNumberOfRefFramesPlus1 Field
    if((in.DataLength - out.Decoded) >= 1)
	{
    	bMaxNumberOfRefFramesPlus1 = NextNBits_(8);
		out.Decoded += 1;
		if (ProbeCommitIVCAM == 0)
		{
			AddPayLoadCell("bMaxNumberOfRefFramesPlus1", bMaxNumberOfRefFramesPlus1, Format ("0x%02X", bMaxNumberOfRefFramesPlus1));
		}
    }
    else
	{
		ShowInvalidBuffer();
	}

#//////////////////////////////////////////////////
#	bmRateControlModes Field
	if((in.DataLength - out.Decoded) >= 2)
	{ 
    	bmRateControlModes= NextDataWord_();    
		out.Decoded += 2;
		if (ProbeCommitIVCAM == 0)
		{
			AddPayLoadCell("bmRateControlModes", bmRateControlModes, Format ("0x%04X", bmRateControlModes));
		}
	}
	else
	{
		ShowInvalidBuffer();
	}
#//////////////////////////////////////////////////
#	bmLayoutPerStream Field
		if((in.DataLength - out.Decoded) >= 8)
		{ 
		    bmLayoutPerStream = NextData3Bytes_() + NextData3Bytes_() + NextDataWord_();
			#bmLayoutPerStream = NextNBits(8) | (NextNBits(8) << 8) | (NextNBits(8) << 16) | (NextNBits(8) << 24);
			out.Decoded += 8;
			if (ProbeCommitIVCAM == 0)
			{
				AddPayLoadCell("bmLayoutPerStream", bmLayoutPerStream, Format ("0x%16X", bmLayoutPerStream));
			}
		}
		else
		{
			ShowInvalidBuffer();
		}
}
 
VS_STILL_PROBE_CONTROL() 
{
    if (!in.Expanded)
        AddCell("Still", "Probe", "VS_STILL_PROBE_CONTROL",FieldColor);
    do_still_probe_commit_controls();    
}

VS_STILL_COMMIT_CONTROL() 
{
    if (!in.Expanded)
         AddCell("Still", "Commit", "VS_STILL_COMMIT_CONTROL",FieldColor);
    do_still_probe_commit_controls();    
}

do_still_probe_commit_controls()
{
#~#
	if((in.DataLength - out.Decoded) > 0)
	{ 
    	bFormatIndex = NextNBits_(8);    
  		out.Decoded += 1;
		AddPayLoadCell("bFormatIndex", bFormatIndex, Format ("0x%02X", bFormatIndex));
	}
	else
	{
		bFormatIndex = 0;
		SetCellColor(RED);
		AddPayLoadCell("bFormatIndex", bFormatIndex, Format ("PAYLOAD IS SHORT, EMPTY VALUE - 0x%02X", bFormatIndex));
		RestoreCellColor();
	}
#~#    
#~#
	if((in.DataLength - out.Decoded) > 0)
	{ 
    	bFrameIndex = NextNBits_(8);    
		out.Decoded += 1;
		AddPayLoadCell("bFrameIndex", bFrameIndex, Format ("0x%02X", bFrameIndex));
	}
	else
	{
		bFrameIndex = 0;
		SetCellColor(RED);
		AddPayLoadCell("bFrameIndex", bFrameIndex, Format ("PAYLOAD IS SHORT, EMPTY VALUE - 0x%02X", bFrameIndex)); 
		RestoreCellColor();
	}   	
#~#    
#~#
	if((in.DataLength - out.Decoded) > 0)
	{ 
		bCompressionIndex        = NextNBits_(8);    
		out.Decoded += 1;
		AddPayLoadCell("bCompressionIndex", bCompressionIndex, Format ("0x%02X", bCompressionIndex));
	}
	else
	{
		bCompressionIndex = 0;
		SetCellColor(RED);
		AddPayLoadCell("bCompressionIndex", bCompressionIndex, Format ("PAYLOAD IS SHORT, EMPTY VALUE - 0x%02X", bCompressionIndex));
		RestoreCellColor();
	}			    	
#~#    
#~#
	if((in.DataLength - out.Decoded) > 3)
	{ 
    	dwMaxVideoFrameSize      = NextDataDWord_();    
		out.Decoded += 4;
		AddPayLoadCell("dwMaxVideoFrameSize", dwMaxVideoFrameSize, Format ("0x%08X", dwMaxVideoFrameSize));
	}
	else
	{
		temp_Dif = (in.DataLength - out.Decoded);
		select
		{
			temp_Dif > 2 : dwMaxVideoFrameSize = NextData3Bytes_();
			temp_Dif > 1 : dwMaxVideoFrameSize = NextDataWord_();
			temp_Dif > 0 : dwMaxVideoFrameSize = NextNBits_(8);
			default			 : dwMaxVideoFrameSize = 0;
		};
		SetCellColor(RED);
		AddPayLoadCell("dwMaxVideoFrameSize", dwMaxVideoFrameSize, FormatEx ("PAYLOAD IS SHORT, VALUE IS ONLY %d BYTES LONG - 0x%08X", temp_Dif, dwMaxVideoFrameSize));
		RestoreCellColor();
		out.Decoded += temp_Dif;
	}
#~#    
#~#
	if((in.DataLength - out.Decoded) > 3)
	{ 
	    dwMaxPayloadTransferSize = NextDataDWord_();
		out.Decoded += 4;
		AddPayLoadCell("dwMaxPayloadTransferSize", dwMaxPayloadTransferSize, Format ("0x%08X", dwMaxPayloadTransferSize));
	}
	else
	{
		temp_Dif = (in.DataLength - out.Decoded);
		select
		{
			temp_Dif > 2 : dwMaxPayloadTransferSize = NextData3Bytes_();
			temp_Dif > 1 : dwMaxPayloadTransferSize = NextDataWord_();
			temp_Dif > 0 : dwMaxPayloadTransferSize = NextNBits_(8);
			default			 : dwMaxPayloadTransferSize = 0;
		};
		SetCellColor(RED);
		AddPayLoadCell("dwMaxPayloadTransferSize", dwMaxPayloadTransferSize, FormatEx ("PAYLOAD IS SHORT, VALUE IS ONLY %d BYTES LONG - 0x%08X", temp_Dif, dwMaxPayloadTransferSize));    	
		RestoreCellColor();
		out.Decoded += temp_Dif;
	}
#~#    
}

