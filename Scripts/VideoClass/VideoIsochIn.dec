%include "CATCScriptAPI.inc"  
%include "UsbCommon.inc" 
%include "Video_Common.inc"
%include "VideoTables.inc"       #has all the tables that are accessed in this file
%include "VideoCellColors.inc"


#----  Input
# in.Data       - Data_block to decode  
# in.DataLength - Length of Data_block  
#
#----  Output
# out.Decoded   - amount of data has been decoded
#


set OutputType      = "Video Isoch In";
set UsbDecodeType = "Endpoint";
set UsbEndpId = 17; # just a unique value for each endpoint of the same Class/Vendor/Product to distinguish them
set UsbClassCode = 0x0E;
set UsbEndpType = "Isochronous";
set UsbEndpDir = "In";
set UsbMaxXferSize = 0xC00; # Hi Speed Isoch is 3 packets max
set UsbMaxPktSize          = 1024; # will automatically be reduced to 64 if branch is Full Speed     
set UsbMaxXferDecodeSize   = 12;  # Max bytes that we will be decoding   User can up this if he likes
set UsbDecodeLevel = "Transaction";
set UsbDecHdrType = 3; # This type references decoder byte containing the data_only flag  
set UsbDecHdrLen  = 2; # This 1 byte is passed in to this via the in context
set Usb1HeaderPerHSIsochFrame = 1;
#set UsbXferCompleteClue    = 1; # Transfer not necessarily over when empty frame seen.  See USBCommon.inc for explanation.

 
set UsbScriptDecodeType = 2; # Combined decoding for Cells and Text decoding 

#
# Parsing entry point
#
  


# User can select the colors for the fields he chooses
set wDecodeCellColor    = 0x494949; 


set ContainerLength = 0;
set ContainerType = 0;
set Code = 0;
set TransactionID = 0;
set Payload = 0;
set numOfParams = 0;



set FullyDecoded = 1;

ProcessData()
{
    DoProcessDataFirstPart();
    
    DataOnly = GetNBits(in.DecodeParams, 0, 8);
    HiBandWidth = GetNBits(in.DecodeParams, 8, 8);

    if (in.Expanded)
    {
        if (HiBandWidth == 2)
        {
            FieldColor = HiBandwidthColor;
            AddPayLoadCell("BW", "Hi", "This transaction is part of a Hi Bandwidth sequence");
    
        }
        else if (HiBandWidth == 1)

        {
            FieldColor = RegBandwidthColor;
            AddPayLoadCell("BW", "-", "This transaction is the only one in this frame for this endpoint");
        }
    }
 
    if (DataOnly)
    {
        out.Decoded= 0;
    }
    else
    {
        CurrentPayloadColor = VideoBulkInColor;
        DoVideoPayloadHeader();
    }
    
    return Complete();

}
    
    
    
