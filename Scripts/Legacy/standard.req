;*******************************************************************************
;*
;*  FILENAME: standard.req
;*
;*  Copyright (C) 1999 Computer Access Technology Corporation
;*
;*  DESCRIPTION
;*    This is the request file for standard USB device requests.
;*    This file is prepared as per the Specification Revision 1.0.
;*
;*  REVISION HISTORY
;*            File Created -mp-
;*    27MAY99 Added description for the requests -ag-
;*    09AUG99 Modified to correct typo -ag-
;*    01OCT01 Added OTG SET_FEATURE Feature Selectors -dhj-
;*
;*******************************************************************************


;*******************************************************************************
; Specify the name for this set of requests as GroupName. Since this set of
; requests represents the standard USB requests, the GroupName and GroupType
; entries souldn't be modified
;*******************************************************************************
GroupName=Standard
GroupType=Standard

AllRequests={
0x00=GET_STATUS
0x01=CLEAR_FEATURE
0x02=Reserved
0x03=SET_FEATURE
0x04=Reserved
0x05=SET_ADDRESS
0x06=GET_DESCRIPTOR
0x07=SET_DESCRIPTOR
0x08=GET_CONFIGURATION
0x09=SET_CONFIGURATION
0x0A=GET_INTERFACE
0x0B=SET_INTERFACE
0x0C=SYNC_FRAME
}

;*******************************************************************************
; GET_STATUS    : This request returns the status for the specified recipient
;                 that have changed since the previous acknowledgement
; bmRequestType : 0x80/0x81/0x82
; bRequest      : 0x00
; wValue        : 0x0000
; wIndex        : Zero/Interface/Endpoint
; wLength       : 0x02
; Data          : Device,Interface, or Endpoint Status
;*******************************************************************************
; start GET_STATUS
Request(0x00)=
{
   
  wIndex=
  {
    Depends(bmRequestType)=
    {
      0x80={
        FormatValue=Device Status requested
      }
      0x81={
        FormatValue=Interface # %i Status requested
      }
      0x82={
        FormatValue=Endpoint # 0x%02X Status requested
      }
    }
  }
  Data={
    Depends(bmRequestType)={
      0x80={
        Length=2
        Bytes(0,1)={
          Name=Device Status
          Bitmap={
            0=Self Powered
            1=Remote Wakeup
          }
        }
      }
      0x81={
        FormatValue=Interface Status is 0x%04X
      }
      0x82={
        Length=2
        Bytes(0,1)=
        {
          Name=Endpoint Status
          Bitmap=
          {
            0=Endpoint Halted
          }
        }
      }
    }
  }
}
; end GET_STATUS

;*******************************************************************************
; CLEAR_FEATURE : This request is used to clear or disable a specific feature
; bmRequestType : 0x00/01/02
; bRequest      : 0x01
; wValue        : Feature Selector
; wIndex        : Zero/Interface/Endpoint
; wLength       : 0x00
; Data          : None
;*******************************************************************************
; start CLEAR_FEATURE
Request(0x01)={

  wValue={    
    Depends(bmRequestType)={
      0x00={
        WordValue={
          0x0001=DEVICE_REMOTE_WAKEUP
        }
      }
      0x02={
        WordValue={
          0x0000=ENDPOINT_HALT
        }
      }
    }
  }
  wIndex={
    Depends(bmRequestType)={
      0x00={
        FormatValue=For Device
      }
      0x01={
        FormatValue=For Interface # %i
      }
      0x02={
        FormatValue=For Endpoint # 0x%02X
      }
    }
  }
}
; end CLEAR_FEATURE

;*******************************************************************************
; SET_FEATURE   : This request is used to set or enable a specific feature
; bmRequestType : 0x00/0x01/0x02
; bRequest      : 0x03
; wValue        : Feature Selector
; wIndex        : Zero/Interface/Endpoint
; wLength       : 0x00
; Data          : None
;*******************************************************************************
; start SET_FEATURE
Request(0x03)={

  wValue={    
    Depends(bmRequestType)={
      0x00={
        WordValue={
         0x0001=DEVICE_REMOTE_WAKEUP
         0x0003=b_hnp_enable
         0x0004=a_hnp_support
         0x0005=a_alt_hnp_support
        }
      }
      0x02={
        WordValue={
          0x0000=ENDPOINT_HALT
        }
      }
    }    
  }
  wIndex={
    Depends(bmRequestType)={
      0x00={
        FormatValue=For Device
      }
      0x01={
        FormatValue=For Interface # %i
      }
      0x02={
        FormatValue=For Endpoint # 0x%02X
      }
    }
  }
}
; end SET_FEATURE

;*******************************************************************************
; SET_ADDRESS   : This request sets the device address for all future device 
;                 accesses
; bmRequestType : 0x00
; bRequest      : 0x05
; wValue        : Device Address
; wIndex        : 0x0000
; wLength       : 0x00
; Data          : None
;*******************************************************************************
; start SET_ADDRESS
Request(0x05)={
  wValue={
    FormatValue=New address %i
  }
}
; end SET_ADDRESS

;*******************************************************************************
; GET_DESCRIPTOR: This request returns the specified descriptor if the descriptor 
;                 exists
; bmRequestType : 0x80
; bRequest      : 0x06
; wValue        : Desriptor Type and Descriptor Index
; wIndex        : 0x0000 or Language ID
; wLength       : Descriptor Length
; Data          : Descriptor
;*******************************************************************************
; start GET_DESCRIPTOR
Request(0x06)={

  wValue={
    Depends(wValue&0xFF00)={
      0x0300={
        HIBYTE={
          WordValue={
            0x03=STRING type
          }
        }
        LOBYTE={
          WordValue={
            0x00=, LANGID codes requested
          }
          FormatValue=, Index %d
        }
      }
    }
    HIBYTE={ 
      WordValue={
        0x01=DEVICE type
        0x02=CONFIG type
        0x04=INTERFACE type (ERROR! Should only be part of GetDescriptor(Config))
        0x05=ENDPOINT type (ERROR! Should only be part of GetDescriptor(Config))
        0x06=DEVICE_QUALIFIER type
        0x07=OTHER_SPEED_CONFIGURATION type
        0x08=INTERFACE_POWER type (ERROR! Should only be part of GetDescriptor(Config))
        0x09=OTG type (ERROR! Should only be part of GetDescriptor(Config))
      }
      FormatValue=Descriptor type 0x%02X
    }
    
    LOBYTE={
      Depends(HIBYTE(wValue))={
        0x01={ 
          FormatValue=
        }
        0x02={ 
          FormatValue=, Index %d
        }                   
        0x06={ 
          FormatValue=
        }                   
        0x07={ 
          FormatValue=
        }                   
        0x08={ 
          FormatValue=
        }                   
        0x09={ 
          FormatValue=
        }                   
      }
      FormatValue=, Index %d
    }    
  }
  wIndex={
    Depends(wValue&0xFF00)={
      0x0300={
        FormatValue=Language ID 0x%04X
      }
    }     
  }
  Data={    
    Length=?
    Descriptors=TRUE      
  }
}
; end GET_DESCRIPTOR

;*******************************************************************************
; SET_DESCRIPTOR : This request may be used to update existing descriptors or 
;                  new descriptors may be added
; bmRequestType : 0x00
; bRequest      : 0x07
; wValue        : Descriptor Type and Decsriptor Index
; wIndex        : Language ID
; wLength       : Descriptor Length
; Data          : Descriptor
;*******************************************************************************
; start SET_DESCRIPTOR
Request(0x07)={

  wValue={
    WordValue={
      0x0100=DEVICE type
      0x0200=CONFIGURATION type        
      0x0400=INTERFACE type
      0x0500=ENDPOINT type
      0x0600=DEVICE_QUALIFIER type
      0x0700=OTHER_SPEED_CONFIGURATION type
      0x0800=INTERFACE_POWER type
      0x0900=OTG type
    }
  }
  wIndex={
  }
  Data={    
  }
}
; end SET_DESCRIPTOR

;*******************************************************************************
; GET_CONFIGURATION: This request returns the current device configuration value
; bmRequestType : 0x80
; bRequest      : 0x08
; wValue        : 0x0000
; wIndex        : 0x0000
; wLength       : 0x01
; Data          : Configuration Value
;*******************************************************************************
; start GET_CONFIGURATION
Request(0x08)={

  Data={
    Length=1
    Bytes(0,0)={
        Name=Current Configuration
        FormatValue=  configuration # %d
    }
  }
}
; end GET_CONFIGURATION

;*******************************************************************************
; SET_CONFIGURATION : This request sets the device configuration
; bmRequestType : 0x00
; bRequest      : 0x09
; wValue        : Configuration Value
; wIndex        : 0x0000
; wLength       : 0x00
; Data          : None
;*******************************************************************************
; start SET_CONFIGURATION
Request(0x09)={
  wValue={
    FormatValue=New configuration %i
  }
}
; end SET_CONFIGURATION

;*******************************************************************************
; GET_INTERFACE : This request returns the selected alternate setting for the 
;                 specified interface
; bmRequestType : 0x81
; bRequest      : 0x0A
; wValue        : 0x0000
; wIndex        : Interface
; wLength       : 0x01
; Data          : Alternate Setting
;*******************************************************************************
; start GET_INTERFACE
Request(0x0A)={

  wIndex={
    FormatValue=Interface # %i
  }
  Data={
    Length=1
    Bytes(0,0)={
      Name=Alternate setting for this interface
      FormatValue=  %d
    }    
  }
}
; end GET_INTERFACE

;*******************************************************************************
; SET_INTERFACE : This request allows the host to select an alternate setting for 
;                 the specified interface
; bmRequestType : 0x01
; bRequest      : 0x0B
; wValue        : Alternative Setting
; wIndex        : Interface
; wLength       : 0x00
; Data          : None
;*******************************************************************************
; start SET_INTERFACE
Request(0x0B)={
  wValue={
    FormatValue=New alternate setting %i
  } 
  wIndex={
    FormatValue=Interface # %i
  }
}
; end SET_INTERFACE
