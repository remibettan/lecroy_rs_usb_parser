             0x18=  Pairing Not Allowed.
             0x19=  Unknown LMP PDU.
             0x1A=  Unsupported Remote Feature.
             0x1B=  SCO Offset Rejected.
             0x1C=  SCO Interval Rejected.
             0x1D=  SCO Air Mode Rejected.
             0x1E=  Invalid LMP Parameters.
             0x1F=  Unspecified Error.
             0x20=  Unsupported LMP Parameter Value.
             0x21=  Role Change Not Allowed
             0x22=  LMP Response Timeout
             0x23=  LMP Error Transaction Collision
             0x24=  LMP PDU Not Allowed
             0x25=  Encryption Mode Not Acceptable
             0x26=  Unit Key Used
             0x27=  QoS is Not Supported
             0x28=  Instant Passed
             0x29=  Pairing with Unit Key Not Supported
           }
           FormatValue=  Reserved Error code 0x%02X
         }
         Bytes(3,4)={
           Name=Connection_Handle
           FormatValue=  0x%04X
         }
         Bytes(5,5)={
           Name=Flags
           FormatValue=  0x%02X (All values reserved)
         }
         Bytes(6,6)={
           Name=Service_Type
           WordValue={
             0x00=  No Traffic Available
             0x01=  Best Effort Available
             0x02=  Guaranteed Available
           }
           FormatValue=  0x%02X (Reserved in the spec)
         }
         Bytes(7,10)={
           Name=Token_Rate
           FormatValue=  Available Token Rate: %i bytes per second
         }
         Bytes(11,14)={
           Name=Peak_Bandwidth
           FormatValue=  Available Peak Bandwidth: %i bytes per second
         }
         Bytes(15,18)={
           Name=Latency
           FormatValue=  Available Latency: %i microseconds
         }
         Bytes(19,22)={
           Name=Delay_Variation
           FormatValue=  Available Delay Variation: %i microseconds
         }
       }


       ;************ Command Complete event **********************
       0x0E={
         Bytes(2,2)={
           Name=Num_HCI_Command_Packets
           FormatValue=  Host can send %d commands
         }
         Bytes(3,4)={
           Name=Command_Opcode
           Color(0,100,200)
           WordValue={
             0x0000=  NOP (changing number of outstanding HCI commands)

             0x0402=  HCI_Inquiry_Cancel
             0x0403=  HCI_Periodic_Inquiry_Mode
             0x0404=  HCI_Exit_Periodic_Inquiry_Mode
             0x040B=  HCI_Link_Key_Request_Reply
             0x040C=  HCI_Link_Key_Request_Negative_Reply
             0x040D=  HCI_PIN_Code_Request_Reply
             0x040E=  HCI_PIN_Code_Request_Negative_Reply
             
             0x0809=  HCI_Role_Discovery
             0x080C=  HCI_Read_Link_Policy_Settings
             0x080D=  HCI_Write_Link_Policy_Settings
             
             0x0C01=  HCI_Set_Event_Mask
             0x0C03=  HCI_Reset
             0x0C05=  HCI_Set_Event_Filter
             0x0C08=  HCI_Flush
             0x0C09=  HCI_Read_PIN_Type
             0x0C0A=  HCI_Write_PIN_Type
             0x0C0B=  HCI_Create_New_Unit_Key
             0x0C0D=  HCI_Read_Stored_Link_Key
             0x0C11=  HCI_Write_Stored_Link_Key
             0x0C12=  HCI_Delete_Stored_Link_Key
             0x0C13=  HCI_Change_Local_Name
             0x0C14=  HCI_Read_Local_Name
             0x0C15=  HCI_Read_Connection_Accept_Timeout
             0x0C16=  HCI_Write_Connection_Accept_Timeout
             0x0C17=  HCI_Read_Page_Timeout
             0x0C18=  HCI_Write_Page_Timeout
             0x0C19=  HCI_Read_Scan_Enable
             0x0C1A=  HCI_Write_Scan_Enable
             0x0C1B=  HCI_Read_Page_Scan_Activity
             0x0C1C=  HCI_Write_Page_Scan_Activity
             0x0C1D=  HCI_Read_Inquiry_Scan_Activity
             0x0C1E=  HCI_Write_Inquiry_Scan_Activity
             0x0C1F=  HCI_Read_Authentication_Enable
             0x0C20=  HCI_Write_Authentication_Enable
             0x0C21=  HCI_Read_Encryption_Mode
             0x0C22=  HCI_Write_Encryption_Mode
             0x0C23=  HCI_Read_Class_of_Device
             0x0C24=  HCI_Write_Class_of_Device
             0x0C25=  HCI_Read_Voice_Setting
             0x0C26=  HCI_Write_Voice_Setting
             0x0C27=  HCI_Read_Automatic_Flush_Timeout
             0x0C28=  HCI_Write_Automatic_Flush_Timeout
             0x0C29=  HCI_Read_Num_Broadcast_Retransmissions
             0x0C2A=  HCI_Write_Num_Broadcast_Retransmissions
             0x0C2B=  HCI_Read_Hold_Mode_Activity
             0x0C2C=  HCI_Write_Hold_Mode_Activity
             0x0C2D=  HCI_Read_Transmit_Power_Level
             0x0C2E=  HCI_Read_SCO_Flow_Control_Enable
             0x0C2F=  HCI_Write_SCO_Flow_Control_Enable
             0x0C31=  HCI_Set_Host_Controller_To_Host_Flow_Control
             0x0C33=  HCI_Host_Buffer_Size
             0x0C35=  HCI_Host_Number_Of_Completed_Packets
             0x0C36=  HCI_Read_Link_Supervision_Timeout
             0x0C37=  HCI_Write_Link_Supervision_Timeout
             0x0C38=  HCI_Read_Number_Of_Supported_IAC
             0x0C39=  HCI_Read_Current_IAC_LAP
             0x0C3A=  HCI_Write_Current_IAC_LAP
             0x0C3B=  HCI_Read_Page_Scan_Period_Mode
             0x0C3C=  HCI_Write_Page_Scan_Period_Mode
             0x0C3D=  HCI_Read_Page_Scan_Mode
             0x0C3E=  HCI_Write_Page_Scan_Mode
             
             0x1001=  HCI_Read_Local_Version_Information 
             0x1003=  HCI_Read_Local_Supported_Features 
             0x1005=  HCI_Read_Buffer_Size
             0x1007=  HCI_Read_Country_Code
             0x1009=  HCI_Read_BD_ADDR 
             
             0x1401=  HCI_Read_Failed_Contact_Counter
             0x1402=  HCI_Reset_Failed_Contact_Counter
             0x1403=  HCI_Get_Link_Quality
             0x1405=  HCI_Read_RSSI
             
             0x1801=  HCI_Read_Loopback_Mode
             0x1802=  HCI_Write_Loopback_Mode
             0x1803=  HCI_Enable_Device_Under_Test_Mode
           }
           FormatValue=  Undefined command 0x%04X
         }       

         ; Status (every complete has it)
         Bytes(5,5)={
           Name=Status
           Color(200,250,250)
           WordValue={
             0x00=  Command Succeeded

             Color(255,0,0)
             0x01=  Unknown HCI Command.
             0x02=  No Connection.
             0x03=  Hardware Failure.
             0x04=  Page Timeout.
             0x05=  Authentication Failure.
             0x06=  Key Missing.
             0x07=  Memory Full.
             0x08=  Connection Timeout.
             0x09=  Max Number Of Connections.
             0x0A=  Max Number Of SCO Connections To A Device.
             0x0B=  ACL connection already exists.
             0x0C=  Command Disallowed.
             0x0D=  Host Rejected due to limited resources.
             0x0E=  Host Rejected due to security reasons.
             0x0F=  Host Rejected due to remote device is only a personal device.
             0x10=  Host Timeout.
             0x11=  Unsupported Feature or Parameter Value.
             0x12=  Invalid HCI Command Parameters.
             0x13=  Other End Terminated Connection: User Ended Connection.
             0x14=  Other End Terminated Connection: Low Resources.
             0x15=  Other End Terminated Connection: About to Power Off.
             0x16=  Connection Terminated by Local Host.
             0x17=  Repeated Attempts.
             0x18=  Pairing Not Allowed.
             0x19=  Unknown LMP PDU.
             0x1A=  Unsupported Remote Feature.
             0x1B=  SCO Offset Rejected.
             0x1C=  SCO Interval Rejected.
             0x1D=  SCO Air Mode Rejected.
             0x1E=  Invalid LMP Parameters.
             0x1F=  Unspecified Error.
             0x20=  Unsupported LMP Parameter Value.
             0x21=  Role Change Not Allowed
             0x22=  LMP Response Timeout
             0x23=  LMP Error Transaction Collision
             0x24=  LMP PDU Not Allowed
             0x25=  Encryption Mode Not Acceptable
             0x26=  Unit Key Used
             0x27=  QoS is Not Supported
             0x28=  Instant Passed
             0x29=  Pairing with Unit Key Not Supported
           }
           FormatValue=  Reserved Error code 0x%02X
         }

         Depends(Databytes(3,4))={

         ; ****** Link Control **********************************

           ; HCI_Link_Key_Request_Reply
           0x040B={
             Bytes(6,11)={
               Name=BD_ADDR
               FormatValue=   Device: 0x
             }
           }  

           ; HCI_Link_Key_Request_Negative_Reply
           0x040C={
             Bytes(6,11)={
               Name=BD_ADDR
               FormatValue=   Device: 0x
             }
           }

           ; HCI_PIN_Code_Request_Reply
           0x040D=  {
             Bytes(6,11)={
               Name=BD_ADDR
               FormatValue=   Device: 0x
             }
           }

           ; HCI_PIN_Code_Request_Negative_Reply
           0x040E={
             Bytes(6,11)={
               Name=BD_ADDR
               FormatValue=   Device: 0x
             }
           }

         ; ****** Link Policy **********************************

           ; HCI_Role_Discovery
           0x0809={
             Bytes(6,7)={
               Name=Connection_Handle
               FormatValue=  0x%04X
             }        
             Bytes(8,8)={
               Name=Current_Role
               WordValue={
                 0x00=  Currently the Master for this Connection_Handle
                 0x01=  Currently the Slave for this Connection_Handle
               }
               FormatValue=  0x%02X (value not defined in the spec)
             }
           }

           ; HCI_Read_Link_Policy_Settings
           0x080C={
             Bytes(6,7)={
               Name=Connection_Handle
               FormatValue=  0x%04X
             }        
             Bytes(8,9)={
               Name=Link_Policy_Settings
               WordValue={
                   0x0000=  Disable All LM Modes (Default)
                   0x0001=  Enable Master Slave Switch
                   0x0002=  Enable Hold Mode
                   0x0004=  Enable Sniff Mode
                   0x0008=  Enable Park Mode
                   0x0010=  Reserved (0x0010)
                   0x0020=  Reserved (0x0020)
                   0x0040=  Reserved (0x0040)
                   0x0080=  Reserved (0x0080)
                   0x0100=  Reserved (0x0100)
                   0x0200=  Reserved (0x0200) 
                   0x0400=  Reserved (0x0400)
                   0x0800=  Reserved (0x0800)
                   0x1000=  Reserved (0x1000)
                   0x2000=  Reserved (0x2000)
                   0x4000=  Reserved (0x4000)
                   0x8000=  Reserved (0x8000)
               }
               FormatValue=  0x%04X (Value not defined in the spec)
             }
           }

           ; HCI_Write_Link_Policy_Settings
           0x080D={
             Bytes(6,7)={
               Name=Connection_Handle
               FormatValue=  0x%04X
             }        
           }


         ; ****** HC & Baseband ***********************************

           ;  HCI_Flush
           0x0C08={
             Bytes(6,7)={
               Name=Connection_Handle
               FormatValue=  0x%04X connection flushed
             }        
           }

           ;  HCI_Read_PIN_Type
           0x0C09={
             Bytes(6,6)={
               Name=PIN_Type
               WordValue={
                 0x00=  Variable PIN
                 0x01=  Fixed PIN
               }             
               FormatValue=  0x%02 (value not defined in the spec)
             }
           }

           ;  HCI_Read_Stored_Link_Key
           0x0C0D={
             Bytes(6,7)={
               Name=Max_Num_Keys
               FormatValue=  HC can store %d Link Keys
             }
             Bytes(8,9)={
               Name=Num_Keys_Read
               FormatValue=  %d Link Keys read
             }
           }

           ;  HCI_Write_Stored_Link_Key
           0x0C11={
             Bytes(6,7)={
               Name=Num_Keys_Written
               FormatValue=  %d Link Keys successfully written
             }
           }

           ;  HCI_Delete_Stored_Link_Key
           0x0C12={
             Bytes(6,7)={
               Name=Num_Keys_Deleted
               FormatValue=  %d Link Keys deleted
             }
           }

           ;  HCI_Read_Local_Name
           0x0C14={
             Bytes(6,?)={
               FormatValue=Name
             }
           }

           ;  HCI_Read_Connection_Accept_Timeout
           0x0C15={
             Bytes(6,7)={
               Name=Connection_Accept_Timeout
               WordValue={
                 0x0000=  0 (Illegal, must be larger than 0)
               }
               FormatValue=  %d Baseband slots (* 0.625 msec)
             }
           }

           ;  HCI_Read_Page_Timeout
           0x0C17={
             Bytes(6,7)={
               Name=Page_Timeout
               WordValue={
                 0x0000=  0 (Illegal, must be larger than 0)
               }
               FormatValue=  %d Baseband slots ( * 0.625 msec)
             }
           }

           ;  HCI_Read_Scan_Enable
           0x0C19={
             Bytes(6,6)={
               Name=Scan_Enable
               WordValue={
                 0x00=  No Scans enabled. Default.
                 0x01=  Inquiry Scan enabled. Page Scan disabled.
                 0x02=  Inquiry Scan disabled.Page Scan enabled.
                 0x03=  Inquiry Scan enabled. Page Scan enabled.
               }
               FormatValue=  0x%02X (Value not defined in the spec) 
             }
           }

           ;  HCI_Read_Page_Scan_Activity
           0x0C1B={
             Bytes(6,7)={
               Name=Page_Scan_Interval
               FormatValue=  %d Baseband slots ( * 0.625 msec)
             }
             Bytes(8,9)={
               Name=Page_Scan_Window
               FormatValue=  %d Baseband slots ( * 0.625 msec)
             }
           }

           ;  HCI_Read_Inquiry_Scan_Activity
           0x0C1D={
             Bytes(6,7)={
               Name=Inquiry_Scan_Interval
               FormatValue=  %d Baseband slots ( * 0.625 msec)
             }
             Bytes(8,9)={
               Name=Inquiry_Scan_Window
               FormatValue=  %d Baseband slots ( * 0.625 msec)
             }
           }

           ;  HCI_Read_Authentication_Enable
           0x0C1F={
             Bytes(6,6)={
               Name=Authentication_Enable
               WordValue={
                 0x00=  Authentication disabled
                 0x01=  Authentication enabled for all connections
               }
               FormatValue=  0x%02X (Value not defined in the spec) 
             }
           }

           ;  HCI_Read_Encryption_Mode
           0x0C21={
             Bytes(6,6)={
               Name=Encryption_Mode
               WordValue={
                 0x00=  Encryption disabled
                 0x01=  Encryption only for point-to-point packets
                 0x02=  Encryption for both point-to-point and broadcast packets
               }
               FormatValue=  0x%02X (Reserved)
             }
           }

           ; HCI_Read_Class_of_Device
           0x0C23={
             Bytes(6,8)={
               Name=Class_of_Device
               FormatValue=  0x%06X class
             }
           }

           ;  HCI_Read_Voice_Setting
           0x0C25={
             Bytes(6,7)={
               Name=Voice_Setting
               Bitmap={
                 0=Air Coding Format
                 1=Air Coding Format
                 2=Linear_PCM_Bit_Pos
                 3=Linear_PCM_Bit_Pos
                 4=Linear_PCM_Bit_Pos
                 5=Input Sample Size 8/16 bit
                 6=Input Data Format
                 7=Input Data Format
                 8=Input Coding
                 9=Input Coding
               }
             }
           }

           ;  HCI_Read_Automatic_Flush_Timeout
           0x0C27={
             Bytes(6,7)={
               Name=Connection_Handle
               FormatValue=  0x%04X
             }        
             Bytes(8,9)={
               Name=Flush_Timeout
               WordValue={
                 0x0000=  No Automatic Flush
               }
               FormatValue=  %d Baseband slots ( * 0.625 msec)
             }             
           }

           ;  HCI_Write_Automatic_Flush_Timeout
           0x0C28={
             Bytes(6,7)={
               Name=Connection_Handle
               FormatValue=  0x%04X
             }        
           }

           ;  HCI_Read_Num_Broadcast_Retransmissions
           0x0C29={
             Bytes(6,6)={
               Name=Num_Broadcast_Retran:
               FormatValue=  %d retransmissions
             }
           }

           ;  HCI_Read_Hold_Mode_Activity
           0x0C2B={
             Bytes(6,6)={
               Name=Hold_Mode_Activity
               WordValue={
                 0x00=  Maintain current Power State
                 0x01=  Suspend Page Scan
                 0x02=  Suspend Inquiry Scan
                 0x04=  Suspend Periodic Inquiries
               }
               FormatValue=  0x%02X (Reserved)
             }
           }

           ;  HCI_Read_Transmit_Power_Level
           0x0C2D={
             Bytes(6,7)={
               Name=Connection_Handle
               FormatValue=  0x%04X
             }     
             Bytes(8,8)={
               Name=Transmit_Power_Level
               FormatValue=  %d ( -30, in dB )
             }   
           }

           ;  HCI_Read_SCO_Flow_Control_Enable
           0x0C2E={
             Bytes(6,6)={
               Name=SCO_Flow_Control_Enable
               WordValue={
                 0x00=  SCO Flow Control is disabled (Default)
                 0x01=  SCO Flow Control is enabled
               }
               FormatValue=  0x%02X (Value not defined in the spec)
             }
           }

           ;  HCI_Read_Link_Supervision_Timeout
           0x0C36={
             Bytes(6,7)={
               Name=Connection_Handle
               FormatValue=  0x%04X
             }        
             Bytes(8,9)={
               Name=Link_Supervision_Timeout
               WordValue={
                 0x0000=  No Link_Supervision_Timeout
               }
               FormatValue=  %d Baseband slots ( * 0.625 msec)
             }             
           }

           ;  HCI_Write_Link_Supervision_Timeout
           0x0C37={
             Bytes(6,7)={
               Name=Connection_Handle
               FormatValue=  0x%04X
             }        
           }

           ;  HCI_Read_Number_Of_Supported_IAC
           0x0C38={
             Bytes(6,6)={
               Name=Num_Support_IAC
               FormatValue=  Local device can listen for %d IAC during an Inquiry Scan
             }
             Bytes(7,9)={
               Name=IAC_LAP[0]
               FormatValue=  0x%06X
             }
             Bytes(10,12)={
               Name=IAC_LAP[1]
               FormatValue=  0x%06X
             }
             Bytes(13,15)={
               Name=IAC_LAP[0]
               FormatValue=  0x%06X
             }
             Bytes(16,?)={
               FormatValue=The rest of IAC_LAPs
             }
           }

           ;  HCI_Read_Current_IAC_LAP
           0x0C39={
           }

           ;  HCI_Read_Page_Scan_Period_Mode
           0x0C3B={
             Bytes(3,3)={
               Name=Page_Scan_Period_Mode
               WordValue={
                 0x00=  P0 (Default)
                 0x01=  P1
                 0x02=  P2
               }
               FormatValue=  0x%02X (Reserved)
             }
           }

           ;  HCI_Read_Page_Scan_Mode
           0x0C3D={
             Bytes(12,12)={
               Name=Page_Scan_Mode
               WordValue={
                 0x00=  Mandatory Page Scan Mode
                 0x01=  Optional Page Scan Mode I
                 0x02=  Optional Page Scan Mode II
                 0x03=  Optional Page Scan Mode III
               }
               FormatValue=  0x%02X (Reserved)
             }
           }

         ; *** Informational Parameters ****************************

           ;  HCI_Read_Local_Version_Information 
           0x1001={
             Bytes(6,6)={
               Name=HCI_Version
               WordValue={
                 0x00=  Bluetooth HCI Specification 1.0
               }
               FormatValue=  0x%02X
             }
             Bytes(7,8)={
               Name=HCI_Revision
               FormatValue=  0x%04X
             }
             Bytes(9,9)={
               Name=LMP_Version
               FormatValue=  VersNr %d
             }
             Bytes(10,11)={
               Name=Manufacturer_Name
               WordValue={
                 0xFFFF=  CompId: no valid number applies
               }
               FormatValue=  CompId 0x%04X
             }
             Bytes(12,13)={
               Name=LMP_Subversion
               WordValue={
                 0xFFFF=  SubVersNr: no valid number applies
               }
               FormatValue=  SubVersNr 0x%04X
             }
           }

           ;  HCI_Read_Local_Supported_Features 
           0x1003={
             Bytes(6,13)={
               Name=LMP_Features
               FormatValue=  0x
             }
           }

           ;  HCI_Read_Buffer_Size
           0x1005={
             Bytes(6,7)={
               Name=HC_ACL_Data_Packet_Length
               FormatValue=  HC able to accept %d bytes of ACL Data
             }
             Bytes(8,8)={
               Name=HC_SCO_Data_Packet_Length
               FormatValue=  HC able to accept %d bytes of SCO Data
             }
             Bytes(9,10)={
               Name=HC_Total_Num_ACL_Data_Packets
               FormatValue=  %d ACL Data Packets can be stored in HC's buffers
             }
             Bytes(11,12)={
               Name=HC_Total_Num_SCO_Data_Packets
               FormatValue=  %d SCO Data Packets can be stored in HC's buffers
             }
           }

           ;  HCI_Read_Country_Code
           0x1007={
             Bytes(6,6)={
               Name=Country Code
               WordValue={
                 0x00=  North America & Europe
                 0x01=  France
                 0x02=  Spain
                 0x03=  Japan
               }
               FormatValue=  0x%02X (Reserved)
             }
           }

           ;  HCI_Read_BD_ADDR
           0x1009={
             Bytes(6,11)={
               Name=BD_ADDR
               FormatValue=  Device 0x
             }
           }


         ;***** Status Parameters ********************************

           ;  HCI_Read_Failed_Contact_Counter
           0x1401={
             Bytes(6,7)={
               Name=Connection_Handle
               FormatValue=  0x%04X
             }
             Bytes(8,8)={
               Name=Failed_Contact_Counter
               FormatValue=  %d contacts failed
             }
           }

           ;  HCI_Reset_Failed_Contact_Counter
           0x1402={
             Bytes(6,7)={
               Name=Connection_Handle
               FormatValue=  0x%04X
             }
           }

           ;  HCI_Get_Link_Quality
           0x1403={
             Bytes(6,7)={
               Name=Connection_Handle
               FormatValue=  0x%04X
             }
             Bytes(8,8)={
               Name=Link_Quality
               FormatValue=  %d (the higher the better, 0-255)
             }    
           }

           ;  HCI_Read_RSSI
           0x1405={
             Bytes(6,7)={
               Name=Connection_Handle
               FormatValue=  0x%04X
             }
             Bytes(8,8)={
               Name=RSSI
               FormatValue=  %d ( -128, in dB )
             }   
           }

         ;***** Testing Commands ********************************

           ;  HCI_Read_Loopback_Mode  
           0x1801={
             Bytes(6,6)={
               Name=Loopback_Mode
               WordValue={
                 0x00=  No Loopback mode enabled. Default.
                 0x01=  Enable Local Loopback
                 0x02=  Enable Remote Loopback
               }
               FormatValue=  0x%02X (Reserved)
             }
           }

         } ; end opcode dependency

       } ; end Command complete


      ;************ Command Status event **********************
       0x0F={
         Bytes(2,2)={
           Name=Status
           Color(200,250,250)
           WordValue={
             0x00=  Command currently in pending.

             Color(255,0,0)
             0x01=  Unknown HCI Command.
             0x02=  No Connection.
             0x03=  Hardware Failure.
             0x04=  Page Timeout.
             0x05=  Authentication Failure.
             0x06=  Key Missing.
             0x07=  Memory Full.
             0x08=  Connection Timeout.
             0x09=  Max Number Of Connections.
             0x0A=  Max Number Of SCO Connections To A Device.
             0x0B=  ACL connection already exists.
             0x0C=  Command Disallowed.
             0x0D=  Host Rejected due to limited resources.
             0x0E=  Host Rejected due to security reasons.
             0x0F=  Host Rejected due to remote device is only a personal device.
             0x10=  Host Timeout.
             0x11=  Unsupported Feature or Parameter Value.
             0x12=  Invalid HCI Command Parameters.
             0x13=  Other End Terminated Connection: User Ended Connection.
             0x14=  Other End Terminated Connection: Low Resources.
             0x15=  Other End Terminated Connection: About to Power Off.
             0x16=  Connection Terminated by Local Host.
             0x17=  Repeated Attempts.
             0x18=  Pairing Not Allowed.
             0x19=  Unknown LMP PDU.
             0x1A=  Unsupported Remote Feature.
             0x1B=  SCO Offset Rejected.
             0x1C=  SCO Interval Rejected.
             0x1D=  SCO Air Mode Rejected.
             0x1E=  Invalid LMP Parameters.
             0x1F=  Unspecified Error.
             0x20=  Unsupported LMP Parameter Value.
             0x21=  Role Change Not Allowed
             0x22=  LMP Response Timeout
             0x23=  LMP Error Transaction Collision
             0x24=  LMP PDU Not Allowed
             0x25=  Encryption Mode Not Acceptable
             0x26=  Unit Key Used
             0x27=  QoS is Not Supported
             0x28=  Instant Passed
             0x29=  Pairing with Unit Key Not Supported
           }
           FormatValue=  Reserved Error code 0x%02X
         }
         Bytes(3,3)={
           Name=Num_HCI_Command_Packets
           FormatValue=  Host can send %d commands
         }
         Bytes(4,5)={
           Name=Command_Opcode
           Color(0,100,200)
           WordValue={
             0x0000=  NOP (changing number of outstanding HCI commands)

             0x0401=  HCI_Inquiry
             0x0402=  HCI_Inquiry_Cancel
             0x0403=  HCI_Periodic_Inquiry_Mode
             0x0404=  HCI_Exit_Periodic_Inquiry_Mode
