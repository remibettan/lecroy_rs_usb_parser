       ;************ Hardware Error event **********************
       0x10={
         Bytes(2,2)={
           Name=Hardware_Code
           FormatValue=  0x%02X (implementation specific)
         }
       }

       ;************ Flush Occurred event **********************
       0x11={
         Bytes(2,3)={
           Name=Connection_Handle
           FormatValue=  0x%04X was flushed
         }
       }

       ;************ Role Change event **********************
       0x12={

         ; Status 
         Bytes(2,2)={
           Name=Status
           Color(200,250,250)
           WordValue={
             0x00=  Role change has occurred.

             Color(255,0,0)
             0x01=  Unknown HCI Command.
             0x02=  No Connection.
             0x03=  Hardware Failure.
             0x04=  Page Timeout.
             0x05=  Authentication Failure.
             0x06=  Key Missing.
             0x07=  Memory Full.
             0x08=  Connection Timeout.
             0x09=  Max Number Of Connections.
             0x0A=  Max Number Of SCO Connections To A Device.
             0x0B=  ACL connection already exists.
             0x0C=  Command Disallowed.
             0x0D=  Host Rejected due to limited resources.
             0x0E=  Host Rejected due to security reasons.
             0x0F=  Host Rejected due to remote device is only a personal device.
             0x10=  Host Timeout.
             0x11=  Unsupported Feature or Parameter Value.
             0x12=  Invalid HCI Command Parameters.
             0x13=  Other End Terminated Connection: User Ended Connection.
             0x14=  Other End Terminated Connection: Low Resources.
             0x15=  Other End Terminated Connection: About to Power Off.
             0x16=  Connection Terminated by Local Host.
             0x17=  Repeated Attempts.
             0x18=  Pairing Not Allowed.
             0x19=  Unknown LMP PDU.
             0x1A=  Unsupported Remote Feature.
             0x1B=  SCO Offset Rejected.
             0x1C=  SCO Interval Rejected.
             0x1D=  SCO Air Mode Rejected.
             0x1E=  Invalid LMP Parameters.
             0x1F=  Unspecified Error.
             0x20=  Unsupported LMP Parameter Value.
             0x21=  Role Change Not Allowed
             0x22=  LMP Response Timeout
             0x23=  LMP Error Transaction Collision
             0x24=  LMP PDU Not Allowed
             0x25=  Encryption Mode Not Acceptable
             0x26=  Unit Key Used
             0x27=  QoS is Not Supported
             0x28=  Instant Passed
             0x29=  Pairing with Unit Key Not Supported
           }
           FormatValue=  Reserved Error code 0x%02X
         }
         Bytes(3,8)={
           Name=BD_ADDR
           FormatValue=   For device: 0x
         }
         Bytes(9,9)={
           Name=New_Role
           WordValue={
             0x00=  Currently the Master for specified BD_ADDR
             0x01=  Currently the Slave for specified BD_ADDR
           }
           FormatValue=  0x%02X (value not defined in the spec)
         }
       }

       ;************ Number Of Completed Packets ***************************
       0x13={
         Bytes(2,2)={
           Name=Number_of_Handles
           FormatValue=  %d
         }
         Depends(Databytes(2,2))={
           0x01={
             Bytes(3,4)={
               Name=Connection_Handle[1]
               FormatValue=  0x%04X
             }
             Bytes(5,6)={
               Name=HC_Num_Of_Completed_Packets[1]
               FormatValue=  %d
             }
           }
         }
         By_tes(3,?)={
           FormatValue=Completed packets for all connections
         }
       }

       ;************ Mode Change ***************************
       0x14={

         ; Status 
         Bytes(2,2)={
           Name=Status
           Color(200,250,250)
           WordValue={
             0x00=  A Mode Change has occurred.

             Color(255,0,0)
             0x01=  Unknown HCI Command.
             0x02=  No Connection.
             0x03=  Hardware Failure.
             0x04=  Page Timeout.
             0x05=  Authentication Failure.
             0x06=  Key Missing.
             0x07=  Memory Full.
             0x08=  Connection Timeout.
             0x09=  Max Number Of Connections.
             0x0A=  Max Number Of SCO Connections To A Device.
             0x0B=  ACL connection already exists.
             0x0C=  Command Disallowed.
             0x0D=  Host Rejected due to limited resources.
             0x0E=  Host Rejected due to security reasons.
             0x0F=  Host Rejected due to remote device is only a personal device.
             0x10=  Host Timeout.
             0x11=  Unsupported Feature or Parameter Value.
             0x12=  Invalid HCI Command Parameters.
             0x13=  Other End Terminated Connection: User Ended Connection.
             0x14=  Other End Terminated Connection: Low Resources.
             0x15=  Other End Terminated Connection: About to Power Off.
             0x16=  Connection Terminated by Local Host.
             0x17=  Repeated Attempts.
             0x18=  Pairing Not Allowed.
             0x19=  Unknown LMP PDU.
             0x1A=  Unsupported Remote Feature.
             0x1B=  SCO Offset Rejected.
             0x1C=  SCO Interval Rejected.
             0x1D=  SCO Air Mode Rejected.
             0x1E=  Invalid LMP Parameters.
             0x1F=  Unspecified Error.
             0x20=  Unsupported LMP Parameter Value.
             0x21=  Role Change Not Allowed
             0x22=  LMP Response Timeout
             0x23=  LMP Error Transaction Collision
             0x24=  LMP PDU Not Allowed
             0x25=  Encryption Mode Not Acceptable
             0x26=  Unit Key Used
             0x27=  QoS is Not Supported
             0x28=  Instant Passed
             0x29=  Pairing with Unit Key Not Supported
           }
           FormatValue=  Reserved Error code 0x%02X
         }
         Bytes(3,4)={
           Name=Connection_Handle
           FormatValue=  0x%04X
         }
         Bytes(5,5)={
           Name=Current_Mode
           WordValue={
             0x00=  Active Mode
             0x01=  Hold Mode
             0x02=  Sniff Mode
             0x03=  Park Mode
           }
           FormatValue=  0x%02X (Reserved)
         }
         Bytes(6,7)={
           Depends(Databytes(5,5))={
             0x01={
               Name=Interval
               FormatValue=  Wait %d Baseband slots in Hold Mode
             }
             0x02={
               Name=Interval
               FormatValue=  %d Baseband slots between sniff intervals
             }
             0x03={               
               Name=Interval
               FormatValue=  %d Baseband slots between consecutive beacons               
             }
             0x00={               
               Name=Interval
               FormatValue=  0x%02X (not used)               
             }
           }
         }
       }

       ;************ Return Link Keys event **********************
       0x15={
         Bytes(2,2)={
           Name=Num_Keys
           FormatValue=  %d Link Keys contained in this event
         }
         Bytes(3,?)={
           FormatValue=All devices and Link Keys
         }
       }

